load("@rules_bison//bison:bison.bzl", "bison")
load("@rules_cc//cc:defs.bzl", "cc_binary")
load("@rules_flex//flex:flex.bzl", "flex")
load("@rules_license//rules:license.bzl", "license")

package(default_package_metadata = [":license"])

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:GPL-2.0"],
    license_text = "LICENSE",
    visibility = ["//visibility:public"],
)

# Named `y.tab` so the generated header is `y.tab.h`, which `policy_scan.l` hardcodes via #include.
bison(
    name = "y.tab",
    src = "policy_parse.y",
)

flex(
    name = "policy_scan_src",
    src = "policy_scan.l",
)

cc_binary(
    name = "checkmodule",
    srcs = [
        "checkmodule.c",
        "module_compiler.c",
        "module_compiler.h",
        "parse_util.c",
        "parse_util.h",
        "policy_define.c",
        "policy_define.h",
        "queue.c",
        "queue.h",
        ":policy_scan_src",
        ":y.tab",
    ],
    copts = [
        "-O2",
        "-fno-strict-aliasing",
    ],
    local_defines = ["_GNU_SOURCE"],
    # policy_define.c uses glibc-only in6_addr.s6_addr32 and htobe32/be32toh.
    target_compatible_with = ["@platforms//os:linux"],
    visibility = ["//visibility:public"],
    deps = ["@libsepol"],
)
