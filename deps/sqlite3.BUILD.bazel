load("@@//bazel/rules/dd_packaging:dd_cc_packaged.bzl", "dd_cc_packaged")
load("@@//compliance/rules:purl.bzl", "purl_for_generic")
load("@package_metadata//rules:package_metadata.bzl", "package_metadata")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_package_metadata = [":package_metadata"],
    default_visibility = ["//visibility:private"],
)

VERSION = "3.53.2"

package_metadata(
    name = "package_metadata",
    attributes = [
        ":license",
    ],
    purl = purl_for_generic(
        download_url = "https://www.sqlite.org/2026/sqlite-amalgamation-3530200.zip",
        package = "sqlite",
        version = VERSION,
    ),
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:blessing"],
    license_text = "@sqlite3_license//file",
    visibility = ["//visibility:public"],
)

_SQLITE3_PUBLIC_HEADERS = [
    "sqlite3.h",
    "sqlite3ext.h",
]

cc_library(
    name = "libsqlite3",
    srcs = ["sqlite3.c"],
    hdrs = _SQLITE3_PUBLIC_HEADERS,
    copts = [
        "-Wall",
        "-DSQLITE_ENABLE_MATH_FUNCTIONS",
        "-DSQLITE_THREADSAFE=1",
        "-O2",
    ],
    includes = ["."],
    linkstatic = True,
    visibility = ["//visibility:public"],
)

cc_shared_library(
    name = "sqlite3",
    visibility = ["//visibility:public"],
    deps = [":libsqlite3"],
)

dd_cc_packaged(
    name = "sqlite3_pkg",
    dest_dir = "embedded/lib",
    input = ":sqlite3",
    version = VERSION,
    visibility = ["//visibility:public"],
)
