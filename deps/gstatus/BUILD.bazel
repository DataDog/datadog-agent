# gstatus - GlusterFS status tool run by the glusterfs integration.

load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes", "pkg_filegroup", "pkg_files", "strip_prefix")
load("//bazel/rules:dd_agent_expand_template.bzl", "dd_agent_expand_template")

package(
    default_package_metadata = [":license"],
    default_visibility = ["//packages:__subpackages__"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:GPL-3.0-only"],
    license_text = "@gstatus_license//file",
    visibility = ["//visibility:public"],
)

# glustercli is "GPLv2 or LGPLv3+", the latter being the GPLv3-compatible option taken.
license(
    name = "glustercli_license",
    license_kinds = ["@rules_license//licenses/spdx:LGPL-3.0-or-later"],
    license_text = "@gstatus//:glustercli-COPYING-LGPLV3",
)

dd_agent_expand_template(
    name = "bin_files",
    out = "gstatus",
    attributes = pkg_attributes(mode = "0755"),
    prefix = "embedded/sbin",
    template = "gstatus_wrapper.py",
)

pkg_files(
    name = "lib_files",
    srcs = ["@gstatus//:srcs"],
    package_metadata = [
        ":glustercli_license",
        ":license",
    ],
    prefix = "embedded/lib/gstatus",
    strip_prefix = strip_prefix.from_pkg(),
)

pkg_filegroup(
    name = "all_files",
    srcs = [
        ":bin_files",
        ":lib_files",
    ],
)
