# gstatus - release zipapp, extracted to install gstatus and glustercli only
#

http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

VERSION = "1.0.9"

http_file(
    name = "gstatus_binary",
    sha256 = "4731a515ce1b75c7d9f378588be5be369ca0130fb51802de853527310724b0f8",
    urls = [
        "https://github.com/gluster/gstatus/releases/download/v{version}/gstatus".format(version = VERSION),
    ],
)

http_file(
    name = "gstatus_license",
    downloaded_file_path = "LICENSE",
    sha256 = "589ed823e9a84c56feb95ac58e7cf384626b9cbf4fda2a907bc36e103de1bad2",
    urls = [
        "https://raw.githubusercontent.com/gluster/gstatus/v{version}/LICENSE".format(version = VERSION),
    ],
)

extract_zipapp = use_repo_rule("//deps/gstatus:extract_zipapp.bzl", "extract_zipapp")

extract_zipapp(
    name = "gstatus",
    src = "@gstatus_binary//file:downloaded",
)
