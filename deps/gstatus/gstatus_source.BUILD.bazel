"""BUILD file for the fetched gstatus repo.

Exports only the files we need:
- gstatus/__main__.py (entry point, GPLv3)
- gstatus/__init__.py
- gstatus/glusterlib/ (cluster aggregation + display logic)
- LICENSE (GPLv3)
"""

exports_files([
    "gstatus/__init__.py",
    "gstatus/__main__.py",
    "gstatus/glusterlib/__init__.py",
    "gstatus/glusterlib/cluster.py",
    "gstatus/glusterlib/display_status.py",
    "LICENSE",
])

filegroup(
    name = "all_files",
    srcs = [
        "gstatus/__init__.py",
        "gstatus/__main__.py",
        "gstatus/glusterlib/__init__.py",
        "gstatus/glusterlib/cluster.py",
        "gstatus/glusterlib/display_status.py",
        "LICENSE",
    ],
    visibility = ["//visibility:public"],
)
