"""BUILD file for libyaml."""

load("@@//bazel/rules/dd_packaging:dd_cc_packaged.bzl", "dd_cc_packaged")
load("@@//compliance/rules:purl.bzl", "purl_for_generic")
load("@package_metadata//rules:package_metadata.bzl", "package_metadata")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_filegroup", "pkg_files")

package(
    default_package_metadata = [":package_metadata"],
    default_visibility = ["//visibility:public"],
)

VERSION = "0.2.5"

package_metadata(
    name = "package_metadata",
    attributes = [
        ":license",
    ],
    purl = purl_for_generic(
        download_url = "https://pyyaml.org/download/libyaml/yaml-{version}.tar.gz",
        package = "libyaml",
        version = VERSION,
    ),
)

license(
    name = "license",
    copyright_notice = """
    Copyright (c) 2017-2020 Ingy döt Net
    Copyright (c) 2006-2016 Kirill Simonov
    """,
    license_kinds = ["@rules_license//licenses/spdx:MIT"],
    license_text = "LICENSE",
    visibility = ["//visibility:public"],
)

cc_library(
    name = "libyaml",
    srcs = [
        "src/api.c",
        "src/dumper.c",
        "src/emitter.c",
        "src/loader.c",
        "src/parser.c",
        "src/reader.c",
        "src/scanner.c",
        "src/writer.c",
        "src/yaml_private.h",
    ],
    hdrs = ["include/yaml.h"],
    copts = ["-w"],
    includes = ["include"],
    local_defines = [
        "YAML_VERSION_MAJOR=0",
        "YAML_VERSION_MINOR=2",
        "YAML_VERSION_PATCH=5",
        'YAML_VERSION_STRING=\\"0.2.5\\"',
    ],
    visibility = ["//visibility:public"],
)

cc_shared_library(
    name = "yaml",
    visibility = ["//visibility:public"],
    deps = [":libyaml"],
)

pkg_files(
    name = "headers",
    srcs = ["include/yaml.h"],
    prefix = "embedded/include",
)

dd_cc_packaged(
    name = "yaml_pkg",
    dest_dir = "embedded/lib",
    input = ":yaml",
    installed_files = [":headers"],
    version = VERSION,
    visibility = ["//visibility:public"],
)

pkg_filegroup(
    name = "all_files",
    srcs = [
        ":headers",
    ],
    visibility = [
        "@@//deps/openscap:__pkg__",
        "@@//packages:__subpackages__",
    ],
)
