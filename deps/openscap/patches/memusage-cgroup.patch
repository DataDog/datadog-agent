 #define GET_VM_ACT_PAGE_COUNT   "vm.stats.vm.v_active_count"
+#endif /* OS_FREEBSD */
 
 #define BYTES_TO_KIB(x) (x >> 10)
-#endif /* OS_FREEBSD */
 
 #if defined(OS_APPLE)
 #include <mach/mach.h>
 #include <sys/sysctl.h>
-#define BYTES_TO_KIB(x) ((x) >> 10)
