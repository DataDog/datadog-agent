http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

VERSION = "1.9.0"

SOURCE_URL_BASE = "https://binaries.ddbuild.io/saluki"

HASHES = {
    "linux-amd64": "e78965d1f3ce12ec46144dc521933ad121c56a1d2f0f85e54aeabf7041e781d2",
    "linux-arm64": "c19fac87b3190b927af4dd8a7099e92090fed831689e32d5ce36482b47240d41",
    "fips-linux-amd64": "ba55811e29a238b7a2548f178bf004ed0527175d9f3773fecd80c0e8b68c64ee",
    "fips-linux-arm64": "cfb3a374e92901eed01f412227513cd673980992d63853d015991c7378277531",
    "darwin-amd64": "d04147f60e4f7019b52cf4e97574c359de85ed1b8744f19a8c48dc8e8faa834b",
    "darwin-arm64": "276d67f7dae1b522c97d37810b87b9b6237002255509189ce41e0cab428a593a",
    "windows-amd64": "b16da0bd2ca54370b212247e162148ddf2aab08f43f5cd1e5a1575ca2550fd39",
    "windows-amd64-fips": "fb223acd57870d811901c53b6dfcffdb122e1580f5ac10699516d53cb98b9fcd",
}

_BUILD_FILE_CONTENT = """\
filegroup(
    name = "binary",
    srcs = glob(["**/{binary_name}"]),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "license_3rdparty",
    srcs = glob(["**/LICENSE-3rdparty.csv"]),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "license_files",
    srcs = glob(["**/LICENSES/**"], allow_empty = True),
    visibility = ["//visibility:public"],
)
"""

# hash key -> os; the repo name suffix is the hash key with "-" replaced by "_"
_ARTIFACTS = {
    "linux-amd64": "linux",
    "linux-arm64": "linux",
    "fips-linux-amd64": "linux",
    "fips-linux-arm64": "linux",
    "darwin-amd64": "darwin",
    "darwin-arm64": "darwin",
    "windows-amd64": "windows",
    "windows-amd64-fips": "windows",
}

[
    http_archive(
        name = "agent_data_plane_{}".format(hash_key.replace("-", "_")),
        build_file_content = _BUILD_FILE_CONTENT.format(
            binary_name = "agent-data-plane.exe" if os == "windows" else "agent-data-plane",
        ),
        sha256 = HASHES[hash_key],
        url = "{base}/agent-data-plane-{version}-{target}.{ext}".format(
            base = SOURCE_URL_BASE,
            ext = "zip" if os == "windows" else "tar.gz",
            target = hash_key,
            version = VERSION,
        ),
    )
    for hash_key, os in _ARTIFACTS.items()
]
