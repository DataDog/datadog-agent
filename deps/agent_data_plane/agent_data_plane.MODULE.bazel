http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

VERSION = "1.8.1"

SOURCE_URL_BASE = "https://binaries.ddbuild.io/saluki"

HASHES = {
    "linux-amd64": "71ef37e887b7e5bf78af4be311c51bc6743c1465b802e0ab237ea08bfe91c6ba",
    "linux-arm64": "92b025712e9c943db6a07234ebdfe942633113cbd70b6739d45d0dc7698cc3ad",
    "fips-linux-amd64": "d4edfc30c322a7f83c916b1eb49daee08473b6745b7ff3dc73eedec4d4815ab1",
    "fips-linux-arm64": "3c61c0a3f017d9b4ad19a9248818583a75cdcadd23cd9752bab41ec654afdcdc",
    "darwin-amd64": "d945973285121db9e593d7bd5e8d4b5ec14c22e1a41eaf71a321683a16f5b82a",
    "darwin-arm64": "45829fa2dfd425197134b94919279ab60195ee0b4ff13de0ce96b583d01cae73",
    "windows-amd64": "9ebbb2c1aaa7edd9eab5099cf3d6c3cb708cd94190f4c7fc200b3f9fc410b96b",
    "windows-amd64-fips": "c673e204d0ec8148879dd9f100b72f76407c319230f2c5326889323463a408d2",
}

_BUILD_FILE_CONTENT = """\
filegroup(
    name = "binary",
    srcs = glob(["**/{binary_name}"]),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "license_3rdparty",
    srcs = glob(["**/LICENSE-3rdparty.csv"]),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "license_files",
    srcs = glob(["**/LICENSES/**"], allow_empty = True),
    visibility = ["//visibility:public"],
)
"""

# hash key -> os; the repo name suffix is the hash key with "-" replaced by "_"
_ARTIFACTS = {
    "linux-amd64": "linux",
    "linux-arm64": "linux",
    "fips-linux-amd64": "linux",
    "fips-linux-arm64": "linux",
    "darwin-amd64": "darwin",
    "darwin-arm64": "darwin",
    "windows-amd64": "windows",
    "windows-amd64-fips": "windows",
}

[
    http_archive(
        name = "agent_data_plane_{}".format(hash_key.replace("-", "_")),
        build_file_content = _BUILD_FILE_CONTENT.format(
            binary_name = "agent-data-plane.exe" if os == "windows" else "agent-data-plane",
        ),
        sha256 = HASHES[hash_key],
        url = "{base}/agent-data-plane-{version}-{target}.{ext}".format(
            base = SOURCE_URL_BASE,
            ext = "zip" if os == "windows" else "tar.gz",
            target = hash_key,
            version = VERSION,
        ),
    )
    for hash_key, os in _ARTIFACTS.items()
]
