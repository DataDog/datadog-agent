http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

VERSION = "1.7.1"

SOURCE_URL_BASE = "https://binaries.ddbuild.io/saluki"

HASHES = {
    "linux-amd64": "2f4ae8aae4452473db9332e8695b43e55eb15ac50c9acab13da8d25f942b3f17",
    "linux-arm64": "6444ee057ab969b930f952fb2c9b99471c62fe01804a69ec722d555fa1ab3568",
    "fips-linux-amd64": "ef2dcd25be058cd3463ef656e7a2ff34a331272e43df908eccb14ba9c451e800",
    "fips-linux-arm64": "a8f33b6dcc782d21714de07ff8a0ec803622e9297572d888fa9b2ddf957860dc",
    "darwin-amd64": "aca6fad7d4b5202e61de814af5f2dc64c9ea486d8b31a9a2824cae6370488897",
    "darwin-arm64": "cb77bb97c16f4da8345c711032d0d7913caacc5812284e3018d4286230afcc01",
    "windows-amd64": "eec98fa2ed7bc983714679aadfc85da5f14d1b7f3b9294826c4d3e76c6859bc8",
    "windows-amd64-fips": "e321da13f1f6776b0916e68a8e5cabce40175b467772d2c36414e0d3123d25ac",
}

_BUILD_FILE_CONTENT = """\
filegroup(
    name = "binary",
    srcs = glob(["**/{binary_name}"]),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "license_3rdparty",
    srcs = glob(["**/LICENSE-3rdparty.csv"]),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "license_files",
    srcs = glob(["**/LICENSES/**"], allow_empty = True),
    visibility = ["//visibility:public"],
)
"""

# hash key -> os; the repo name suffix is the hash key with "-" replaced by "_"
_ARTIFACTS = {
    "linux-amd64": "linux",
    "linux-arm64": "linux",
    "fips-linux-amd64": "linux",
    "fips-linux-arm64": "linux",
    "darwin-amd64": "darwin",
    "darwin-arm64": "darwin",
    "windows-amd64": "windows",
    "windows-amd64-fips": "windows",
}

[
    http_archive(
        name = "agent_data_plane_{}".format(hash_key.replace("-", "_")),
        build_file_content = _BUILD_FILE_CONTENT.format(
            binary_name = "agent-data-plane.exe" if os == "windows" else "agent-data-plane",
        ),
        sha256 = HASHES[hash_key],
        url = "{base}/agent-data-plane-{version}-{target}.{ext}".format(
            base = SOURCE_URL_BASE,
            ext = "zip" if os == "windows" else "tar.gz",
            target = hash_key,
            version = VERSION,
        ),
    )
    for hash_key, os in _ARTIFACTS.items()
]
