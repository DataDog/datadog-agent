load("@@//bazel/rules/dd_packaging:dd_cc_packaged.bzl", "dd_cc_packaged")
load("@@//compliance/rules:purl.bzl", "purl_for_generic")
load("@@//compliance/rules:ship_source_offer.bzl", "ship_source_offer")
load("@package_metadata//rules:package_metadata.bzl", "package_metadata")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_flex//flex:flex.bzl", "flex")
load("@rules_license//rules:license.bzl", "license")

package(default_package_metadata = [
    ":package_metadata",
    ":ship_source_offer",
])

VERSION = "3.11"

package_metadata(
    name = "package_metadata",
    attributes = [
        ":license",
        ":ship_source_offer",
    ],
    purl = purl_for_generic(
        download_url = "https://github.com/SELinuxProject/selinux/releases/download/{version}/libsepol-{version}.tar.gz",
        package = "libsepol",
        version = VERSION,
    ),
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:LGPL-2.1"],
    license_text = "LICENSE",
    visibility = ["//visibility:public"],
)

ship_source_offer(name = "ship_source_offer")

flex(
    name = "cil_scan",
    src = "cil/src/cil_lexer.l",
)

cc_library(
    name = "libsepol",
    srcs = glob([
        "src/*.c",
        "src/*.h",
        "cil/src/*.c",
        "cil/src/*.h",
    ]) + [":cil_scan"],
    hdrs = glob([
        "include/sepol/**/*.h",
        "cil/include/cil/*.h",
    ]),
    copts = [
        "-O2",
        "-fPIC",
        "-fno-semantic-interposition",
    ],
    includes = [
        "cil/include",
        "cil/src",
        "include/",
        "include/sepol/",
    ],
    local_defines = [
        "_GNU_SOURCE",
        # If we drop support for glibcs older than 2.28 we can provide this:
        # "-DHAVE_REALLOCARRAY",
    ],
    visibility = ["//visibility:public"],
)

cc_shared_library(
    name = "sepol",
    additional_linker_inputs = [
        "src/libsepol.map.in",
    ],
    user_link_flags = [
        "-Wl,-soname=libsepol.so",
        "-Wl,--version-script=$(execpath src/libsepol.map.in)",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":libsepol",
    ],
)

dd_cc_packaged(
    name = "sepol_pkg",
    dest_dir = "embedded/lib",
    input = ":sepol",
    visibility = ["//visibility:public"],
)
