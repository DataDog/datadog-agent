load("@@//bazel/rules/dd_packaging:dd_cc_packaged.bzl", "dd_cc_packaged")
load("@@//compliance/rules:purl.bzl", "purl_for_generic")
load("@bazel_skylib//rules:copy_file.bzl", "copy_file")
load("@bazel_skylib//rules:expand_template.bzl", "expand_template")
load("@package_metadata//rules:package_metadata.bzl", "package_metadata")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_filegroup", "pkg_files")

VERSION = "2.15.3"

package(default_package_metadata = [":package_metadata"])

PUBLIC_HEADERS = glob(["include/libxml/*.h"]) + [":xmlversion_h"]

package_metadata(
    name = "package_metadata",
    attributes = [
        ":license",
    ],
    purl = purl_for_generic(
        download_url = "https://download.gnome.org/sources/libxml2/2.15/libxml2-2.15.3.tar.xz",
        package = "libxml2",
        version = VERSION,
    ),
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:MIT"],
    license_text = "Copyright",
    visibility = ["//visibility:public"],
)

copy_file(
    name = "copy_config_h",
    src = select({
        "@@//:linux_x86_64": "config-linux-x86_64.h",
        "@@//:linux_arm64": "config-linux-arm64.h",
    }),
    out = "config.h",
    target_compatible_with = ["@platforms//os:linux"],
)

expand_template(
    name = "xmlversion_h",
    out = "include/libxml/xmlversion.h",
    substitutions = {
        "@VERSION@": VERSION,
        "@LIBXML_VERSION_NUMBER@": "21503",
        "@LIBXML_VERSION_EXTRA@": "",
        "@WITH_THREADS@": "1",
        "@WITH_THREAD_ALLOC@": "0",
        "@WITH_PATTERN@": "1",
        "@WITH_READER@": "1",
        "@WITH_SAX1@": "1",
        "@WITH_HTTP@": "0",
        "@WITH_VALID@": "1",
        "@WITH_HTML@": "1",
        "@WITH_C14N@": "1",
        "@WITH_CATALOG@": "0",
        "@WITH_XPATH@": "1",
        "@WITH_XPTR@": "1",
        "@WITH_XINCLUDE@": "1",
        "@WITH_ICONV@": "0",
        "@WITH_ICU@": "0",
        "@WITH_ISO8859X@": "1",
        "@WITH_DEBUG@": "0",
        "@WITH_REGEXPS@": "1",
        "@WITH_RELAXNG@": "1",
        "@WITH_SCHEMAS@": "1",
        "@WITH_SCHEMATRON@": "1",
        "@WITH_MODULES@": "1",
        "@WITH_ZLIB@": "1",
        # Enabled for now but very likely not needed
        "@WITH_OUTPUT@": "1",
        "@WITH_PUSH@": "1",
        "@WITH_WRITER@": "1",
    } | select({
        "@platforms//os:linux": {"@MODULE_EXTENSION@": ".so"},
        "@platforms//os:macos": {"@MODULE_EXTENSION@": ".dylib"},
    }),
    template = "include/libxml/xmlversion.h.in",
)

cc_library(
    name = "xml2_config_h",
    hdrs = [
        ":copy_config_h",
    ],
)

cc_library(
    name = "libxml2",
    srcs = [
        "HTMLparser.c",
        "HTMLtree.c",
        "SAX2.c",
        "buf.c",
        "c14n.c",
        "chvalid.c",
        "codegen/charset.inc",
        "codegen/escape.inc",
        "codegen/html5ent.inc",
        "codegen/ranges.inc",
        "codegen/unicode.inc",
        "dict.c",
        "encoding.c",
        "entities.c",
        "error.c",
        "globals.c",
        "hash.c",
        "libxml.h",
        "list.c",
        "parser.c",
        "parserInternals.c",
        "pattern.c",
        "relaxng.c",
        "schematron.c",
        "threads.c",
        "timsort.h",
        "tree.c",
        "uri.c",
        "valid.c",
        "xinclude.c",
        "xlink.c",
        "xmlIO.c",
        "xmlmemory.c",
        "xmlmodule.c",
        "xmlreader.c",
        "xmlregexp.c",
        "xmlsave.c",
        "xmlschemas.c",
        "xmlschemastypes.c",
        "xmlstring.c",
        "xmlwriter.c",
        "xpath.c",
        "xpointer.c",
    ] + glob(["include/private/*.h"]),
    hdrs = PUBLIC_HEADERS,
    copts = [
        "-O2",
        "-std=gnu11",
    ],
    implementation_deps = [
        ":xml2_config_h",
    ],
    includes = [
        "codegen",
        "include",
        "include/libxml",
    ],
    local_defines = [
        "NDEBUG",
    ],
    strip_include_prefix = "include/",
    visibility = ["//visibility:public"],
    deps = [
        "@zlib",
    ],
)

cc_shared_library(
    name = "xml2",
    dynamic_deps = [
        "@zlib//:z_pkg",
    ],
    visibility = ["//visibility:public"],
    deps = [":libxml2"],
)

pkg_files(
    name = "headers",
    srcs = PUBLIC_HEADERS,
    prefix = "include/libxml2/libxml",
)

dd_cc_packaged(
    name = "xml2_pkg",
    input = ":xml2",
    installed_files = [":headers"],
    version = "16.1.3",
    visibility = ["//visibility:public"],
)

pkg_filegroup(
    name = "all_files",
    srcs = [
        ":headers",
    ],
    prefix = "embedded",
)
