load("@bazel_skylib//rules:diff_test.bzl", "diff_test")
load("//bazel/tools:generate_module_bazel.bzl", "generate_module_bazel")

VERSION = "2.14.5"

generate_module_bazel(
    name = "module_bazel",
    out = "libxml2.MODULE.bazel.new",
    module = "libxml2",
    files = {
        "BUILD.bazel": "//deps/libxml2:overlay/overlay.BUILD.bazel",
        "include/config.h": "//deps/libxml2:overlay/include/config.h",
    },
    sha256 = "03d006f3537616833c16c53addcdc32a0eb20e55443cba4038307e3fa7d8d44b",
    strip_prefix = "libxml2-%s" % VERSION,
    tags = ["manual"],
    url = "https://download.gnome.org/sources/libxml2/2.14/libxml2-{version}.tar.xz".format(version = VERSION),
)

diff_test(
    name = "module_consistency_test",
    failure_message = "To update: cp bazel-bin/deps/libxml2/libxml2.MODULE.bazel.new libxml2.MODULE.bazel",
    file1 = ":libxml2.MODULE.bazel.new",
    file2 = "libxml2.MODULE.bazel",
)
