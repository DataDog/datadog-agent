# Dynamically link openssl-sys against the Agent's OpenSSL instead of
# compiling a second crypto library into Rust cdylibs.
crate = use_extension("@rules_rs//rs:extensions.bzl", "crate")

inject_repo(crate, "openssl")

crate.annotation(
    build_script_data = [
        "@openssl//:gen_dir",
    ],
    build_script_env = {
        "OPENSSL_DIR": "$(execpath @openssl//:gen_dir)",
        "OPENSSL_NO_VENDOR": "1",
        "OPENSSL_STATIC": "0",
    },
    crate = "openssl-sys",
    data = ["@openssl//:gen_dir"],
    deps = ["@openssl"],
)
