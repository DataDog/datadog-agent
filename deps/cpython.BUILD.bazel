load("@@//bazel/rules/dd_packaging:dd_cc_packaged.bzl", "dd_cc_packaged")
load("@@//bazel/rules/dd_packaging:dd_collect_dependencies.bzl", "dd_collect_dependencies")
load("@@//deps/cpython:macros.bzl", "cpython_frozen_modules", "cpython_shared_modules")
load("@@//deps/cpython:srcs.bzl", "BUILTIN_MODULES", "FROZEN_MODULES", "LIBEXPAT_SRCS", "LIBMPDEC_SRCS", "MACOS_SHARED_MODULES", "MODULE_SRCS", "OBJECT_SRCS", "PARSER_SRCS", "PLATFORMS", "PYTHON_SRCS", "SHARED_MODULES", "sysconfig_vars")
load("@//deps/openssl:version.bzl", "OPENSSL_VERSION")
load("@bazel_lib//lib:copy_to_directory.bzl", "copy_to_directory")
load("@bazel_lib//lib:run_binary.bzl", "run_binary")
load("@bazel_skylib//rules:copy_file.bzl", "copy_file")
load("@bazel_skylib//rules:expand_template.bzl", "expand_template")
load("@bazel_skylib//rules:select_file.bzl", "select_file")
load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@cpython_versions//:constants.bzl", "PYTHON_MAJOR_MINOR", "PYTHON_MAJOR_MINOR_FLAT")
load("@pythons_hub//:versions.bzl", "DEFAULT_PYTHON_VERSION")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_import", "cc_library", "cc_shared_library")
load("@rules_pkg//pkg:install.bzl", "pkg_install")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes", "pkg_filegroup", "pkg_files", "pkg_mklink")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

DEFAULT_PYTHON = "@python_{}//:python3".format(DEFAULT_PYTHON_VERSION.replace(".", "_"))

LINUX_SO = "libpython{}.so.1.0".format(PYTHON_MAJOR_MINOR)

MACOS = "@platforms//os:macos"

UNIX_ONLY = select({
    "@platforms//os:windows": ["@platforms//:incompatible"],
    "//conditions:default": [],
})

COPTS = [
    "-fno-strict-overflow",
    "-Wsign-compare",
    "-fwrapv",
    "-O2",
    "-std=c11",
    "-Wextra",
    "-Wno-unused-parameter",
    "-Wno-missing-field-initializers",
    "-Wstrict-prototypes",
    "-Werror=implicit-function-declaration",
    "-fvisibility=hidden",
]

CORE_DEFINES = [
    "NDEBUG",
    "Py_BUILD_CORE",
]

EXT_SUFFIX = select({
    condition: platform["ext_suffix"]
    for condition, platform in PLATFORMS.items()
})

UNIX_SHARED_MODULES = SHARED_MODULES | MACOS_SHARED_MODULES

# Keep in sync with the ones on repos.MODULE.bazel
python_externals = {
    "bzip2": "1.0.8",
    "mpdecimal": "4.0.0",
    "sqlite": "3.53.2.0",
    "xz": "5.2.5",
    "zlib": "1.3.1",
    "libffi": "3.4.4",
    "tcltk": "8.6.15.0",
}

# These rules will make it easier to get a reference to their folder via $(execpath)
# and they add the version in the folder name (as some of the vcxproj stuff relies on that)
[
    copy_to_directory(
        name = "{}_win_dir".format(dep),
        srcs = ["@{}_win".format(dep)],
        out = "{}-{}".format(dep, version),
        include_external_repositories = ["*"],
    )
    for dep, version in python_externals.items()
]

# This sets up OpenSSL files in a layout such as the Python build system for Windows expects
copy_to_directory(
    name = "openssl-bin_win_dir",
    srcs = ["@openssl"],
    # TODO(team:agent-build): Single source of truth for dependency versions
    out = "openssl-bin-{}/amd64".format(OPENSSL_VERSION),
    include_external_repositories = ["*openssl*"],
    # This reproduces the expected layout (libs at root, includes under `include`)
    root_paths = [
        "openssl/bin",
        "openssl/lib",
        "openssl",
    ],
)

run_binary(
    name = "python_win",
    srcs = (
        glob(
            ["**"],
            exclude = [
                "**/*.pyc",
                "BUILD.bazel",
            ],
        ) + [
            "bzip2_win_dir",
            "mpdecimal_win_dir",
            "sqlite_win_dir",
            "xz_win_dir",
            "zlib_win_dir",
            "libffi_win_dir",
            "openssl-bin_win_dir",
            "tcltk_win_dir",
            DEFAULT_PYTHON,
            # Hermetic compiler, SDK and MSBuild; nothing is taken from a host
            # Visual Studio installation.
            "@msvc_toolchains//msvc/tree:toolchain_tree",
            "@msvc_toolchains//msvc/tree:version_marker",
            "@msvc_toolchains//winsdk/tree:toolchain_tree",
            "@msvc_toolchains//winsdk/tree:root_marker",
            "@msvc_toolchains//msbuild:msbuild",
            "@msvc_toolchains//msbuild:toolchain_tree",
            "@msvc_toolchains//msbuild:vctargets_marker",
        ]
    ),
    outs = [
        "build/{}".format(file)
        for file in [
            "python.exe",
            "python3.dll",
            "python{}.dll".format(PYTHON_MAJOR_MINOR_FLAT),
            "pythonw.exe",
            "vcruntime140.dll",
            "vcruntime140_1.dll",
            "LICENSE.txt",
        ]
    ],
    env = {
        "PROCESSOR_ARCHITECTURE": "AMD64",
        # Input and output paths
        "SRCFILE": r"$(execpath LICENSE)",  # Any file at the root of the repo works here
        "OUTDIR": "$(@D)/build",
        # Paths to dependencies:
        "BZ2_DIR": "$(execpath bzip2_win_dir)",
        "MPDECIMAL_DIR": "$(execpath mpdecimal_win_dir)",
        "SQLITE3_DIR": "$(execpath sqlite_win_dir)",
        "XZ_DIR": "$(execpath xz_win_dir)",
        "ZLIB_DIR": "$(execpath zlib_win_dir)",
        "LIBFFI_DIR": "$(execpath libffi_win_dir)",
        "OPENSSL_DIR": r"$(execpath openssl-bin_win_dir)",
        "TCLTK_DIR": r"$(execpath tcltk_win_dir)\amd64",
        "TCL_VERSION": python_externals["tcltk"],
        "MSBUILD": "$(execpath @msvc_toolchains//msbuild:msbuild)",
        "PYTHON_FOR_BUILD": "$(execpath {})".format(DEFAULT_PYTHON),
        # Marker files; build_python.bat derives each toolchain root from them.
        "VCTOOLS_VERSION_FILE": "$(execpath @msvc_toolchains//msvc/tree:version_marker)",
        "WINSDK_MARKER": "$(execpath @msvc_toolchains//winsdk/tree:root_marker)",
        "VCTARGETS_MARKER": "$(execpath @msvc_toolchains//msbuild:vctargets_marker)",
    },
    out_dirs = [
        "build/{}".format(dir)
        for dir in [
            "DLLs",
            "include",
            "Lib",
            "libs",
            "Scripts",
        ]
    ],
    target_compatible_with = ["@platforms//os:windows"],
    tool = "build_python.bat",
    visibility = ["//visibility:public"],
)

select_file(
    name = "headers_win",
    srcs = "python_win",
    subpath = "build/include",
)

select_file(
    name = "python_win_lib",
    srcs = "python_win",
    subpath = "build/python{}.dll".format(PYTHON_MAJOR_MINOR_FLAT),
    visibility = ["//visibility:public"],
)

cc_import(
    name = "_python_dll",
    shared_library = "build/python{}.dll".format(PYTHON_MAJOR_MINOR_FLAT),
    visibility = ["//visibility:private"],
)

# The extra cc_library layer on top of the cc_import is needed so that
# relative paths (like the one for the includes) are resolved correctly
cc_library(
    name = "lib_win",
    hdrs = [":headers_win"],
    includes = ["build/include"],
    visibility = ["//visibility:public"],
    deps = [":_python_dll"],
)

cc_import(
    name = "libpython_import",
    shared_library = ":python_pkg",
    target_compatible_with = UNIX_ONLY,
)

cc_library(
    name = "python_unix_shared",
    target_compatible_with = UNIX_ONLY,
    visibility = ["//visibility:public"],
    deps = [
        ":headers",
        ":libpython_import",
    ],
)

# TODO(ABLD-392): temporary workaround -- remove once the agent build runs the
# Python we ship instead of the host Python for extension module compilation.
# Python extension modules link against these shared libs and need them present
# in {install_dir}/embedded/lib before any Python invocation (e.g. pip, setuptools).
# Collected automatically by walking python_pkg's installed_files and dynamic_deps.
dd_collect_dependencies(
    name = "_runtime_deps",
    srcs = [":python_pkg"],
    visibility = ["//visibility:private"],
)

pkg_filegroup(
    name = "runtime_deps",
    srcs = [":_runtime_deps"],
    visibility = ["//visibility:public"],
)

pkg_files(
    name = "install_files_win",
    srcs = [":python_win"],
    prefix = "embedded3",
    strip_prefix = "build",
)

# On Windows, python_win is built via MSBuild (not cc_shared_library), so there are no
# dynamic_deps edges for dd_collect_dependencies to walk automatically from python_pkg.
# Explicitly collect OpenSSL packaged targets so that embedded3/include/openssl/ and
# embedded3/lib/*.lib are present (required for FIPS cryptography source builds).
dd_collect_dependencies(
    name = "_openssl_deps_win",
    srcs = [
        "@openssl//:libcrypto_shared_pkg",
        "@openssl//:libssl_shared_pkg",
    ],
    visibility = ["//visibility:private"],
)

# Create symlinks for libpython (rules_pkg 1.2+ supports symlinks in pkg_install)
pkg_mklink(
    name = "libpython_symlink",
    attributes = pkg_attributes("0644"),
    link_name = "embedded/lib/libpython{}.so".format(PYTHON_MAJOR_MINOR),
    target = LINUX_SO,
)

BIN_SYMLINKS = {
    "embedded/bin/python3": "python{}".format(PYTHON_MAJOR_MINOR),
    "embedded/bin/python": "python3",
}

[
    pkg_mklink(
        name = "python_bin_symlink_" + target,
        attributes = pkg_attributes("0755"),
        link_name = link,
        target = target,
    )
    for link, target in BIN_SYMLINKS.items()
]

pkg_files(
    name = "install_headers_unix",
    srcs = [":headers_unix"],
    prefix = "embedded",
)

# Grouped helper for python_pkg installed_files: installed_files is non-configurable,
# so the Linux-only libpython_symlink select lives here instead.
pkg_filegroup(
    name = "_python_pkg_common_files",
    srcs = [
        ":install_headers_unix",
    ] + [":python_bin_symlink_" + name for name in BIN_SYMLINKS.values()] + select({
        "@platforms//os:linux": [":libpython_symlink"],
        "//conditions:default": [],
    }),
)

dd_cc_packaged(
    name = "python_pkg",
    dest_dir = "embedded/lib",
    input = ":libpython",
    installed_executables = {
        ":python3_bin": "embedded/bin",
        ":python_lib_dir_group_unix": "embedded/lib",
    } | select({
        "@platforms//os:linux": {":python_stable_lib_linux": "embedded/lib"},
        "//conditions:default": {},
    }),
    installed_files = [":_python_pkg_common_files"],
    visibility = ["//visibility:public"],
)

pkg_filegroup(
    name = "all_files",
    srcs = select({
        "@platforms//os:windows": [
            ":_openssl_deps_win",
            ":install_files_win",
        ],
        "//conditions:default": [
            ":install_headers_unix",
        ] + [":python_bin_symlink_" + name for name in BIN_SYMLINKS.values()],
    }) + select({
        "@platforms//os:linux": [":libpython_symlink"],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
)

pkg_install(
    name = "install",
    srcs = select({
        "@platforms//os:windows": [":all_files"],
        "//conditions:default": [":runtime_deps"],
    }),
)

copy_file(
    name = "pyconfig_h",
    src = select({
        condition: platform["pyconfig"]
        for condition, platform in PLATFORMS.items()
    }),
    out = "pyconfig.h",
    target_compatible_with = UNIX_ONLY,
)

cc_library(
    name = "headers",
    hdrs = glob(["Include/**/*.h"]) + [":pyconfig_h"],
    includes = [
        ".",
        "Include",
    ],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "internal_headers",
    includes = [
        "Include/internal",
        "Include/internal/mimalloc",
        "Objects",
        "Python",
    ],
    textual_hdrs = glob([
        "Modules/**/*.h",
        "Objects/**/*.h",
        "Objects/**/*.inc",
        "Objects/mimalloc/**/*.c",
        "Modules/_blake2/impl/*.c",
        "Modules/_ssl/*.c",
        "Parser/**/*.h",
        "Python/**/*.h",
    ]),
    deps = [":headers"],
)

expand_template(
    name = "config_c",
    out = "Modules/config.c",
    substitutions = {
        "/* -- ADDMODULE MARKER 1 -- */": "\n".join([
            "extern PyObject* PyInit_{}(void);".format(name)
            for name in BUILTIN_MODULES
        ]),
        "/* -- ADDMODULE MARKER 2 -- */": "\n".join([
            "    {{\"{0}\", PyInit_{0}}},".format(name)
            for name in BUILTIN_MODULES
        ]),
    },
    template = "Modules/config.c.in",
)

cc_library(
    name = "builtin_modules",
    srcs = [src for srcs in BUILTIN_MODULES.values() for src in srcs],
    copts = COPTS,
    local_defines = [
        "NDEBUG",
        "Py_BUILD_CORE_BUILTIN",
    ],
    deps = [":internal_headers"],
    alwayslink = True,
)

cc_library(
    name = "core",
    srcs = PARSER_SRCS + OBJECT_SRCS + PYTHON_SRCS + MODULE_SRCS + select({
        MACOS: [":config_c"],
        "//conditions:default": [
            "Python/asm_trampoline.S",
            ":config_c",
        ],
    }),
    copts = COPTS,
    linkopts = select({
        MACOS: [
            "-ldl",
            "-framework",
            "CoreFoundation",
        ],
        "//conditions:default": [
            "-ldl",
            "-lutil",
            "-lm",
            "-lpthread",
            "-lrt",
        ],
    }),
    local_defines = CORE_DEFINES,
    deps = [
        ":builtin_modules",
        ":core_with_defines",
        ":internal_headers",
    ],
    alwayslink = True,
)

cc_library(
    name = "core_with_defines",
    srcs = [
        "Modules/getbuildinfo.c",
        "Python/dynload_shlib.c",
        "Python/getplatform.c",
        "Python/sysmodule.c",
    ],
    copts = COPTS,
    local_defines = CORE_DEFINES + [
        "ABIFLAGS=\\\"\\\"",
        "GITBRANCH=\\\"\\\"",
        "GITTAG=\\\"\\\"",
        "GITVERSION=\\\"\\\"",
    ] + select({
        condition: [
            "PLATFORM=\\\"{}\\\"".format(platform["machdep"]),
            "MULTIARCH=\\\"{}\\\"".format(platform["multiarch"]),
            "SOABI=\\\"cpython-{}-{}\\\"".format(
                PYTHON_MAJOR_MINOR_FLAT,
                platform["multiarch"],
            ),
        ]
        for condition, platform in PLATFORMS.items()
    }),
    target_compatible_with = UNIX_ONLY,
    deps = [":internal_headers"],
    alwayslink = True,
)

cc_library(
    name = "getpath_noop",
    srcs = ["Modules/getpath_noop.c"],
    copts = COPTS,
    local_defines = CORE_DEFINES,
    deps = [":internal_headers"],
)

cc_binary(
    name = "freeze_module",
    srcs = ["Programs/_freeze_module.c"],
    copts = COPTS,
    local_defines = CORE_DEFINES,
    deps = [
        ":core",
        ":getpath_noop",
    ],
)

cpython_frozen_modules(
    modules = FROZEN_MODULES + [("getpath", "Modules/getpath.py")],
    tool = ":freeze_module",
)

cc_library(
    name = "getpath",
    srcs = ["Modules/getpath.c"],
    copts = COPTS,
    local_defines = CORE_DEFINES + [
        "PREFIX=\\\"$(INSTALL_DIR)/embedded\\\"",
        "EXEC_PREFIX=\\\"$(INSTALL_DIR)/embedded\\\"",
        "PYTHONPATH=\\\"\\\"",
        "VERSION=\\\"{}\\\"".format(PYTHON_MAJOR_MINOR),
        "VPATH=\\\"\\\"",
        "PLATLIBDIR=\\\"lib\\\"",
        "PYTHONFRAMEWORK=\\\"\\\"",
    ],
    textual_hdrs = [":frozen_getpath"],
    toolchains = ["@@//:install_dir"],
    deps = [":internal_headers"],
    alwayslink = True,
)

cc_library(
    name = "frozen",
    srcs = ["Python/frozen.c"],
    copts = COPTS,
    local_defines = CORE_DEFINES,
    textual_hdrs = [":frozen_" + name for name, _ in FROZEN_MODULES],
    deps = [":internal_headers"],
    alwayslink = True,
)

cc_shared_library(
    name = "libpython",
    shared_lib_name = select({
        condition: platform["libpython"]
        for condition, platform in PLATFORMS.items()
    }),
    target_compatible_with = UNIX_ONLY,
    user_link_flags = select({
        MACOS: ["-Wl,-install_name,@rpath/libpython{}.dylib".format(PYTHON_MAJOR_MINOR)],
        "//conditions:default": ["-Wl,-soname," + LINUX_SO],
    }),
    deps = [
        ":core",
        ":frozen",
        ":getpath",
        ":libpython_runtime_deps",
    ],
)

# libpython3.so is the stable ABI library (PEP 384). Like upstream, it defines no
# symbols: it only depends on the versioned libpython, which provides them, so extensions
# linked against it keep working across 3.x versions. --no-as-needed keeps that
# dependency.
write_file(
    name = "empty_c",
    out = "empty.c",
    content = [],
)

cc_library(
    name = "libpython3_lib",
    srcs = [":empty_c"],
    target_compatible_with = ["@platforms//os:linux"],
)

cc_shared_library(
    name = "libpython3",
    dynamic_deps = [":libpython"],
    shared_lib_name = "libpython3.so",
    target_compatible_with = ["@platforms//os:linux"],
    user_link_flags = [
        "-Wl,--no-as-needed",
        "-Wl,-soname,libpython3.so",
    ],
    deps = [":libpython3_lib"],
)

cc_binary(
    name = "python",
    srcs = ["Programs/python.c"],
    copts = COPTS,
    dynamic_deps = [":libpython"],
    linkopts = select({
        MACOS: [
            "-Wl,-rpath,@loader_path/../lib",
            "-Wl,-stack_size,1000000",
            "-framework",
            "CoreFoundation",
        ],
        "//conditions:default": [
            "-Wl,--export-dynamic",
            "-Wl,-rpath,$$ORIGIN/../lib",
        ],
    }),
    local_defines = CORE_DEFINES,
    deps = [":headers"],
)

cc_library(
    name = "libmpdec",
    srcs = LIBMPDEC_SRCS,
    copts = COPTS,
    defines = select({
        MACOS: ["UNIVERSAL=1"],
        "//conditions:default": [
            "CONFIG_64=1",
            "ANSI=1",
            "HAVE_UINT128_T=1",
        ],
    }),
    includes = ["Modules/_decimal/libmpdec"],
    local_defines = ["NDEBUG"],
    deps = [":internal_headers"],
)

cc_library(
    name = "expat_headers",
    includes = ["Modules/expat"],
    textual_hdrs = glob(
        ["Modules/expat/*.c"],
        exclude = LIBEXPAT_SRCS,
    ),
    deps = [":internal_headers"],
)

cc_library(
    name = "expat",
    srcs = LIBEXPAT_SRCS,
    copts = COPTS,
    local_defines = ["NDEBUG"],
    deps = [":expat_headers"],
)

cc_library(
    name = "hacl_headers",
    defines = [
        "_BSD_SOURCE",
        "_DEFAULT_SOURCE",
    ],
    includes = [
        "Modules/_hacl/include",
        "Modules/_hacl/internal",
    ],
    textual_hdrs = glob(["Modules/_hacl/**/*.h"]),
    deps = [":internal_headers"],
)

cc_library(
    name = "hacl_sha2",
    srcs = ["Modules/_hacl/Hacl_Hash_SHA2.c"],
    copts = COPTS,
    local_defines = ["NDEBUG"],
    deps = [":hacl_headers"],
)

cc_library(
    name = "multiprocessing_headers",
    includes = ["Modules/_multiprocessing"],
    deps = [":internal_headers"],
)

COMMON_MODULE_TARGETS = cpython_shared_modules(
    copts = COPTS,
    ext_suffix = EXT_SUFFIX,
    modules = SHARED_MODULES,
    target_compatible_with = UNIX_ONLY,
)

MACOS_MODULE_TARGETS = cpython_shared_modules(
    copts = COPTS,
    ext_suffix = EXT_SUFFIX,
    modules = MACOS_SHARED_MODULES,
    target_compatible_with = [MACOS],
)

SHARED_MODULE_TARGETS = COMMON_MODULE_TARGETS + select({
    MACOS: MACOS_MODULE_TARGETS,
    "//conditions:default": [],
})

# Lets dd_collect_dependencies walk from python_pkg to the extension modules and
# their dynamic_deps. It does not follow filegroup srcs, so the modules are listed here.
cc_library(
    name = "libpython_runtime_deps",
    data = SHARED_MODULE_TARGETS + [
        "@openssl//:libcrypto_shared_pkg",
        "@openssl//:libssl_shared_pkg",
    ],
    target_compatible_with = UNIX_ONLY,
)

filegroup(
    name = "shared_modules",
    srcs = SHARED_MODULE_TARGETS,
)

write_file(
    name = "sysconfig_vars",
    out = "sysconfig_vars.json",
    content = select({
        condition: [json.encode(sysconfig_vars(platform))]
        for condition, platform in PLATFORMS.items()
    }),
    target_compatible_with = UNIX_ONLY,
)

run_binary(
    name = "sysconfigdata",
    srcs = [
        ":pyconfig_h",
        ":sysconfig_vars",
        "@@//deps/cpython:gen_sysconfigdata.py",
    ],
    outs = ["sysconfigdata.py"],
    args = [
        "$(execpath @@//deps/cpython:gen_sysconfigdata.py)",
        "--pyconfig",
        "$(execpath :pyconfig_h)",
        "--vars",
        "$(execpath :sysconfig_vars)",
        "--prefix",
        "$(INSTALL_DIR)/embedded",
        "--out",
        "$@",
    ],
    tool = DEFAULT_PYTHON,
    toolchains = ["@@//:install_dir"],
)

copy_file(
    name = "python3_bin",
    src = ":python",
    out = "unix/bin/python{}".format(PYTHON_MAJOR_MINOR),
    is_executable = True,
    target_compatible_with = UNIX_ONLY,
    visibility = ["//visibility:public"],
)

copy_file(
    name = "unix_libpython_linux",
    src = ":libpython",
    out = "unix/lib/" + LINUX_SO,
    target_compatible_with = ["@platforms//os:linux"],
)

copy_file(
    name = "unix_libpython_macos",
    src = ":libpython",
    out = "unix/lib/libpython{}.dylib".format(PYTHON_MAJOR_MINOR),
    target_compatible_with = [MACOS],
)

copy_file(
    name = "python_stable_lib_linux",
    src = ":libpython3",
    out = "unix/lib/libpython3.so",
    target_compatible_with = ["@platforms//os:linux"],
)

copy_to_directory(
    name = "python_lib_dir_group_unix",
    srcs = [
        "LICENSE",
        ":shared_modules",
        ":sysconfigdata",
    ] + glob(
        ["Lib/**"],
        exclude = [
            "Lib/**/__pycache__/**",
            "Lib/__phello__/ham/**",
            "Lib/idlelib/idle_test/**",
            "Lib/test/**",
            "Lib/venv/scripts/nt/**",
        ],
    ),
    out = "unix/lib/python{}".format(PYTHON_MAJOR_MINOR),
    replace_prefixes = select({
        condition: {
            "LICENSE": "LICENSE.txt",
            "Lib/": "",
            "sysconfigdata.py": "_sysconfigdata__{}_{}.py".format(
                platform["machdep"],
                platform["multiarch"],
            ),
        } | {
            name + platform["ext_suffix"]: "lib-dynload/" + name + platform["ext_suffix"]
            for name in UNIX_SHARED_MODULES
        }
        for condition, platform in PLATFORMS.items()
    }),
    target_compatible_with = UNIX_ONLY,
)

copy_to_directory(
    name = "headers_unix",
    srcs = [":pyconfig_h"] + glob(["Include/**/*.h"]),
    out = "unix/include",
    replace_prefixes = {
        "Include/": "python{}/".format(PYTHON_MAJOR_MINOR),
        "pyconfig.h": "python{}/pyconfig.h".format(PYTHON_MAJOR_MINOR),
    },
    target_compatible_with = UNIX_ONLY,
)

filegroup(
    name = "python_unix",
    srcs = [
        ":headers_unix",
        ":python3_bin",
        ":python_lib_dir_group_unix",
    ] + select({
        "@platforms//os:linux": [
            ":python_stable_lib_linux",
            ":unix_libpython_linux",
        ],
        MACOS: [":unix_libpython_macos"],
        "//conditions:default": [],
    }),
    target_compatible_with = UNIX_ONLY,
    visibility = ["//visibility:public"],
)

write_file(
    name = "test_modules",
    out = "test_modules.txt",
    content = SHARED_MODULES.keys() + BUILTIN_MODULES.keys() + select({
        MACOS: MACOS_SHARED_MODULES.keys(),
        "//conditions:default": [],
    }),
)

# Bash only sets the dynamic loader search path before exec'ing the interpreter
# under test. The test only runs on Unix platforms, where Bash is available.
sh_test(
    name = "python_test",
    srcs = ["@@//deps/cpython:python_test.sh"],
    args = [
        "$(rootpath :python3_bin)",
        "$(rootpath @@//deps/cpython:python_test.py)",
        "$(rootpath :test_modules)",
        "$(rootpaths :runtime_deps)",
    ],
    data = [
        ":python3_bin",
        ":python_unix",
        ":runtime_deps",
        ":test_modules",
        "@@//deps/cpython:python_test.py",
    ],
)
