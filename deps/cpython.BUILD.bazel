load("@@//bazel/rules/dd_packaging:dd_cc_packaged.bzl", "dd_cc_packaged")
load("@@//bazel/rules/dd_packaging:dd_collect_dependencies.bzl", "dd_collect_dependencies")
load("@@//bazel/toolchains/hermetic_llvm:windows_gnu.bzl", "windows_gnu_filegroup")
load("@@//deps/cpython:native.bzl", "BUILTIN_MODULES", "FROZEN_MODULES", "LIBEXPAT_SRCS", "LIBMPDEC_SRCS", "MACOS_SHARED_MODULES", "MACOS_SHARED_MODULE_EXTRAS", "MODULE_SRCS", "NATIVE_PLATFORMS", "OBJECT_SRCS", "PARSER_SRCS", "PYTHON_SRCS", "SHARED_MODULES", "WINDOWS_BUILTIN_MODULE_SRCS", "WINDOWS_CORE_SRCS", "WINDOWS_SHARED_MODULES", "cc_interface_libraries", "sysconfig_vars")
load("@bazel_lib//lib:copy_to_directory.bzl", "copy_to_directory")
load("@bazel_lib//lib:transitions.bzl", "platform_transition_filegroup")
load("@bazel_skylib//rules:copy_file.bzl", "copy_file")
load("@bazel_skylib//rules:expand_template.bzl", "expand_template")
load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@cpython_versions//:constants.bzl", "PYTHON_MAJOR_MINOR", "PYTHON_MAJOR_MINOR_FLAT")
load("@platforms//host:constraints.bzl", "HOST_CONSTRAINTS")
load("@pythons_hub//:versions.bzl", "DEFAULT_PYTHON_VERSION")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_import", "cc_library", "cc_shared_library")
load("@rules_pkg//pkg:install.bzl", "pkg_install")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes", "pkg_filegroup", "pkg_files", "pkg_mklink")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

DEFAULT_PYTHON = "@python_{}//:python3".format(DEFAULT_PYTHON_VERSION.replace(".", "_"))

platform_transition_filegroup(
    name = "python_win_install",
    srcs = [":native_win_install"],
    target_compatible_with = ["@platforms//os:windows"],
    target_platform = "@@//bazel/platforms:windows_x86_64_msvc",
    visibility = ["//visibility:public"],
)

filegroup(
    name = "native_libpython_dll",
    srcs = [":native_libpython"],
    output_group = "main_shared_library_output",
    target_compatible_with = ["@platforms//os:windows"],
)

platform_transition_filegroup(
    name = "python_win_lib",
    srcs = [":native_libpython_dll"],
    target_compatible_with = ["@platforms//os:windows"],
    target_platform = "@@//bazel/platforms:windows_x86_64_msvc",
    visibility = ["//visibility:public"],
)

cc_import(
    name = "_python_dll",
    shared_library = ":python_win_lib",
    target_compatible_with = ["@platforms//os:windows"],
    visibility = ["//visibility:private"],
)

cc_library(
    name = "lib_win",
    target_compatible_with = ["@platforms//os:windows"],
    visibility = ["//visibility:public"],
    deps = [
        ":_python_dll",
        ":native_headers",
    ],
)

LINUX_SO = "libpython{}.so.1.0".format(PYTHON_MAJOR_MINOR)

alias(
    name = "python_unix",
    actual = ":native_install",
    visibility = ["//visibility:public"],
)

cc_import(
    name = "native_libpython_import",
    shared_library = ":python_pkg",
    target_compatible_with = select({
        "@platforms//os:windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
)

cc_library(
    name = "python_unix_shared",
    target_compatible_with = select({
        "@platforms//os:windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
    deps = [
        ":native_headers",
        ":native_libpython_import",
    ],
)

dd_collect_dependencies(
    name = "_runtime_deps",
    srcs = [":python_pkg"],
    visibility = ["//visibility:private"],
)

pkg_filegroup(
    name = "runtime_deps",
    srcs = [":_runtime_deps"],
    visibility = ["//visibility:public"],
)

pkg_files(
    name = "install_files_win",
    srcs = [":python_win_install"],
    prefix = "embedded3",
    strip_prefix = "native_win_install",
)

# On Windows, python_win is built via MSBuild (not cc_shared_library), so there are no
# dynamic_deps edges for dd_collect_dependencies to walk automatically from python_pkg.
# Explicitly collect OpenSSL packaged targets so that embedded3/include/openssl/ and
# embedded3/lib/*.lib are present (required for FIPS cryptography source builds).
dd_collect_dependencies(
    name = "_openssl_deps_win",
    srcs = [
        "@openssl//:libcrypto_shared_pkg",
        "@openssl//:libssl_shared_pkg",
    ],
    visibility = ["//visibility:private"],
)

alias(
    name = "python_lib_dir_group_unix",
    actual = ":native_unix_stdlib",
)

alias(
    name = "python3_bin",
    actual = ":native_unix_python3_bin",
    visibility = ["//visibility:public"],
)

# Create symlinks for libpython (rules_pkg 1.2+ supports symlinks in pkg_install)
pkg_mklink(
    name = "libpython_symlink",
    attributes = pkg_attributes("0644"),
    link_name = "embedded/lib/libpython{}.so".format(PYTHON_MAJOR_MINOR),
    target = LINUX_SO,
)

BIN_SYMLINKS = {
    "embedded/bin/python3": "python{}".format(PYTHON_MAJOR_MINOR),
    "embedded/bin/python": "python3",
}

[
    pkg_mklink(
        name = "python_bin_symlink_" + target,
        attributes = pkg_attributes("0755"),
        link_name = link,
        target = target,
    )
    for link, target in BIN_SYMLINKS.items()
]

alias(
    name = "headers_unix",
    actual = ":native_unix_include",
)

filegroup(
    name = "python_lib_unix",
    srcs = [":native_libpython"],
    target_compatible_with = select({
        "@platforms//os:macos": [],
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

alias(
    name = "python_stable_lib_linux",
    actual = ":native_unix_libpython3",
    target_compatible_with = ["@platforms//os:linux"],
)

pkg_files(
    name = "install_headers_unix",
    srcs = [":headers_unix"],
    prefix = "embedded",
)

# Grouped helper for python_pkg installed_files: installed_files is non-configurable,
# so the Linux-only libpython_symlink select lives here instead.
pkg_filegroup(
    name = "_python_pkg_common_files",
    srcs = [
        ":install_headers_unix",
    ] + [":python_bin_symlink_" + name for name in BIN_SYMLINKS.values()] + select({
        "@platforms//os:linux": [":libpython_symlink"],
        "//conditions:default": [],
    }),
)

dd_cc_packaged(
    name = "python_pkg",
    dest_dir = "embedded/lib",
    input = ":native_libpython",
    installed_executables = {
        ":python3_bin": "embedded/bin",
        ":python_lib_dir_group_unix": "embedded/lib",
    } | select({
        "@platforms//os:linux": {":python_stable_lib_linux": "embedded/lib"},
        "//conditions:default": {},
    }),
    installed_files = [":_python_pkg_common_files"],
    visibility = ["//visibility:public"],
)

pkg_filegroup(
    name = "all_files",
    srcs = select({
        "@platforms//os:windows": [
            ":_openssl_deps_win",
            ":install_files_win",
        ],
        "//conditions:default": [
            ":install_headers_unix",
        ] + [":python_bin_symlink_" + name for name in BIN_SYMLINKS.values()],
    }) + select({
        "@platforms//os:linux": [":libpython_symlink"],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
)

pkg_install(
    name = "install",
    srcs = select({
        "@platforms//os:windows": [":all_files"],
        "//conditions:default": [":runtime_deps"],
    }),
)

NATIVE_WINDOWS = "@@//:windows_x86_64"

NATIVE_MACOS = "@platforms//os:macos"

NATIVE_UNIX = select({
    NATIVE_WINDOWS: ["@platforms//:incompatible"],
    "//conditions:default": [],
})

NATIVE_LINUX_COPTS = [
    "-fno-strict-overflow",
    "-Wsign-compare",
    "-fwrapv",
    "-O2",
    "-std=c11",
    "-Wextra",
    "-Wno-unused-parameter",
    "-Wno-missing-field-initializers",
    "-Wstrict-prototypes",
    "-Werror=implicit-function-declaration",
    "-fvisibility=hidden",
]

NATIVE_CLANG_CL = "@rules_cc//cc/compiler:clang-cl"

NATIVE_WINDOWS_HOST = "@platforms//os:windows" in HOST_CONSTRAINTS

NATIVE_CLANG_CL_COPTS = select({
    NATIVE_CLANG_CL: [
        "-Wno-deprecated-non-prototype",
        "-Wno-unused-label",
        "-Wno-pointer-sign",
        "-Wno-incompatible-pointer-types-discards-qualifiers",
        "-Wno-unused-function",
        "-Wno-incompatible-pointer-types",
    ],
    "//conditions:default": [],
})

NATIVE_WINDOWS_COPTS = ["/utf-8"] + NATIVE_CLANG_CL_COPTS

NATIVE_COPTS = select({
    NATIVE_WINDOWS: ["/utf-8"],
    "//conditions:default": NATIVE_LINUX_COPTS,
}) + NATIVE_CLANG_CL_COPTS

NATIVE_WINDOWS_DEFINES = [
    "WIN32",
    "_WIN64",
    "_Py_HAVE_ZLIB",
    "PY3_DLLNAME=L\\\"python3\\\"",
    "Py_ENABLE_SHARED",
    "Py_BUILD_CORE",
    "Py_BUILD_CORE_BUILTIN",
    "_USRDLL",
    "MS_DLL_ID=\\\"{}\\\"".format(PYTHON_MAJOR_MINOR),
]

NATIVE_CORE_DEFINES = [
    "NDEBUG",
    "Py_BUILD_CORE",
] + select({
    NATIVE_WINDOWS: NATIVE_WINDOWS_DEFINES,
    "//conditions:default": [],
})

NATIVE_WINDOWS_DEFAULT_LIBS = [
    "kernel32.lib",
    "user32.lib",
    "gdi32.lib",
    "winspool.lib",
    "comdlg32.lib",
    "advapi32.lib",
    "shell32.lib",
    "ole32.lib",
    "oleaut32.lib",
    "uuid.lib",
    "odbc32.lib",
    "odbccp32.lib",
]

NATIVE_WINDOWS_VPATH = "VPATH=\\\"..\\\\\\\\..\\\""

copy_file(
    name = "native_pyconfig_h",
    src = select({
        condition: platform["pyconfig"]
        for condition, platform in NATIVE_PLATFORMS.items()
    } | {
        NATIVE_WINDOWS: "PC/pyconfig.h.in",
        "//conditions:default": "@platforms//:incompatible",
    }),
    out = "pyconfig.h",
)

cc_library(
    name = "native_headers",
    hdrs = glob(["Include/**/*.h"]) + [":native_pyconfig_h"],
    includes = [
        ".",
        "Include",
    ],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "native_internal_headers",
    includes = [
        "Include/internal",
        "Include/internal/mimalloc",
        "Objects",
        "Python",
    ] + select({
        NATIVE_WINDOWS: ["PC"],
        "//conditions:default": [],
    }),
    textual_hdrs = glob([
        "Modules/**/*.h",
        "Objects/**/*.h",
        "Objects/**/*.inc",
        "Objects/mimalloc/**/*.c",
        "Modules/_blake2/impl/*.c",
        "Modules/_ssl/*.c",
        "PC/**/*.h",
        "Parser/**/*.h",
        "Python/**/*.h",
    ]),
    deps = [":native_headers"],
)

genrule(
    name = "native_msvc_crtversion_h",
    srcs = ["@llvm//runtimes/msvc:msvc_include"],
    outs = ["msvc_include/crtversion.h"],
    cmd = "for f in $(execpaths @llvm//runtimes/msvc:msvc_include); do case $$f in */crtversion.h) cp $$f $@;; esac; done",
    target_compatible_with = ["@platforms//os:windows"],
)

cc_library(
    name = "native_msvc_extra_headers",
    hdrs = [":native_msvc_crtversion_h"],
    includes = ["msvc_include"],
    target_compatible_with = ["@platforms//os:windows"],
)

expand_template(
    name = "native_config_c",
    out = "Modules/config.c",
    substitutions = {
        "/* -- ADDMODULE MARKER 1 -- */": "\n".join([
            "extern PyObject* PyInit_{}(void);".format(name)
            for name in BUILTIN_MODULES
        ]),
        "/* -- ADDMODULE MARKER 2 -- */": "\n".join([
            "    {{\"{0}\", PyInit_{0}}},".format(name)
            for name in BUILTIN_MODULES
        ]),
    },
    template = "Modules/config.c.in",
)

cc_library(
    name = "native_builtin_modules",
    srcs = select({
        NATIVE_WINDOWS: WINDOWS_BUILTIN_MODULE_SRCS,
        "//conditions:default": [src for srcs in BUILTIN_MODULES.values() for src in srcs],
    }),
    copts = NATIVE_COPTS,
    local_defines = [
        "NDEBUG",
        "Py_BUILD_CORE_BUILTIN",
    ] + select({
        NATIVE_WINDOWS: NATIVE_WINDOWS_DEFINES + ["USE_ZLIB_CRC32"],
        "//conditions:default": [],
    }),
    deps = [":native_internal_headers"] + select({
        NATIVE_WINDOWS: [
            ":native_hacl_headers",
            "@zlib",
        ],
        "//conditions:default": [],
    }) + select({
        NATIVE_CLANG_CL: [":native_msvc_extra_headers"],
        "//conditions:default": [],
    }),
    alwayslink = True,
)

cc_library(
    name = "native_core",
    srcs = PARSER_SRCS + OBJECT_SRCS + MODULE_SRCS + select({
        NATIVE_WINDOWS: [src for src in PYTHON_SRCS if src != "Python/frozenmain.c"] + WINDOWS_CORE_SRCS,
        NATIVE_MACOS: PYTHON_SRCS + [":native_config_c"],
        "//conditions:default": PYTHON_SRCS + [
            "Python/asm_trampoline.S",
            ":native_config_c",
        ],
    }),
    copts = NATIVE_COPTS,
    linkopts = select({
        NATIVE_WINDOWS: NATIVE_WINDOWS_DEFAULT_LIBS + [
            "bcrypt.lib",
            "pathcch.lib",
            "version.lib",
            "ws2_32.lib",
        ],
        NATIVE_MACOS: [
            "-ldl",
            "-framework",
            "CoreFoundation",
        ],
        "//conditions:default": [
            "-ldl",
            "-lutil",
            "-lm",
            "-lpthread",
            "-lrt",
        ],
    }),
    local_defines = NATIVE_CORE_DEFINES,
    deps = [
        ":native_builtin_modules",
        ":native_core_with_defines",
        ":native_internal_headers",
    ],
    alwayslink = True,
)

cc_library(
    name = "native_core_with_defines",
    srcs = [
        "Modules/getbuildinfo.c",
        "Python/getplatform.c",
        "Python/sysmodule.c",
    ] + select({
        NATIVE_WINDOWS: ["Python/dynload_win.c"],
        "//conditions:default": ["Python/dynload_shlib.c"],
    }),
    copts = NATIVE_COPTS,
    local_defines = NATIVE_CORE_DEFINES + [
        "GITBRANCH=\\\"\\\"",
        "GITTAG=\\\"\\\"",
        "GITVERSION=\\\"\\\"",
    ] + select({
        condition: [
            "ABIFLAGS=\\\"\\\"",
            "PLATFORM=\\\"{}\\\"".format(platform["machdep"]),
            "MULTIARCH=\\\"{}\\\"".format(platform["multiarch"]),
            "SOABI=\\\"cpython-{}-{}\\\"".format(
                PYTHON_MAJOR_MINOR_FLAT,
                platform["multiarch"],
            ),
        ]
        for condition, platform in NATIVE_PLATFORMS.items()
    } | {
        NATIVE_WINDOWS: [NATIVE_WINDOWS_VPATH],
    }),
    deps = [":native_internal_headers"],
    alwayslink = True,
)

cc_library(
    name = "native_getpath_noop",
    srcs = ["Modules/getpath_noop.c"],
    copts = NATIVE_COPTS,
    local_defines = NATIVE_CORE_DEFINES,
    deps = [":native_internal_headers"],
)

cc_binary(
    name = "native_freeze_module",
    srcs = ["Programs/_freeze_module.c"],
    copts = NATIVE_COPTS,
    local_defines = NATIVE_CORE_DEFINES,
    deps = [
        ":native_core",
        ":native_getpath_noop",
    ],
)

[
    genrule(
        name = "native_frozen_" + name,
        srcs = [src] + ([":native_freeze_module"] if NATIVE_WINDOWS_HOST else []),
        outs = ["Python/frozen_modules/{}.h".format(name)],
        cmd = "$(execpath :native_freeze_module) {} $(execpath {}) $@".format(name, src),
        tools = [] if NATIVE_WINDOWS_HOST else [":native_freeze_module"],
    )
    for name, src in FROZEN_MODULES + [("getpath", "Modules/getpath.py")]
]

cc_library(
    name = "native_getpath",
    srcs = ["Modules/getpath.c"],
    copts = NATIVE_COPTS,
    local_defines = NATIVE_CORE_DEFINES + select({
        NATIVE_WINDOWS: [
            "PREFIX=NULL",
            "EXEC_PREFIX=NULL",
            "VERSION=NULL",
            NATIVE_WINDOWS_VPATH,
            "PYDEBUGEXT=\\\"\\\"",
            "PLATLIBDIR=\\\"DLLs\\\"",
        ],
        "//conditions:default": [
            "PREFIX=\\\"$(INSTALL_DIR)/embedded\\\"",
            "EXEC_PREFIX=\\\"$(INSTALL_DIR)/embedded\\\"",
            "PYTHONPATH=\\\"\\\"",
            "VERSION=\\\"{}\\\"".format(PYTHON_MAJOR_MINOR),
            "VPATH=\\\"\\\"",
            "PLATLIBDIR=\\\"lib\\\"",
            "PYTHONFRAMEWORK=\\\"\\\"",
        ],
    }),
    textual_hdrs = [":native_frozen_getpath"],
    toolchains = ["@@//:install_dir"],
    deps = [":native_internal_headers"],
    alwayslink = True,
)

cc_library(
    name = "native_frozen",
    srcs = ["Python/frozen.c"],
    copts = NATIVE_COPTS,
    local_defines = NATIVE_CORE_DEFINES,
    textual_hdrs = [":native_frozen_" + name for name, _ in FROZEN_MODULES],
    deps = [":native_internal_headers"],
    alwayslink = True,
)

cc_shared_library(
    name = "native_libpython",
    shared_lib_name = select({
        condition: platform["libpython"]
        for condition, platform in NATIVE_PLATFORMS.items()
    } | {
        NATIVE_WINDOWS: "python{}.dll".format(PYTHON_MAJOR_MINOR_FLAT),
    }),
    user_link_flags = select({
        NATIVE_WINDOWS: [],
        NATIVE_MACOS: ["-Wl,-install_name,@rpath/libpython{}.dylib".format(PYTHON_MAJOR_MINOR)],
        "//conditions:default": ["-Wl,-soname," + LINUX_SO],
    }),
    deps = [
        ":native_core",
        ":native_frozen",
        ":native_getpath",
    ] + select({
        NATIVE_WINDOWS: [],
        "//conditions:default": [":native_runtime_deps"],
    }),
)

cc_library(
    name = "native_runtime_deps",
    data = select({
        NATIVE_MACOS: [":native_module_" + name for name in SHARED_MODULES | MACOS_SHARED_MODULES],
        "//conditions:default": [":native_module_" + name for name in SHARED_MODULES],
    }) + [
        "@openssl//:libcrypto_shared_pkg",
        "@openssl//:libssl_shared_pkg",
    ],
    target_compatible_with = select({
        NATIVE_WINDOWS: ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
)

genrule(
    name = "native_empty_c",
    outs = ["native_empty.c"],
    cmd = "touch $@",
)

cc_library(
    name = "native_libpython3_lib",
    srcs = [":native_empty_c"],
    target_compatible_with = ["@platforms//os:linux"],
)

cc_shared_library(
    name = "native_libpython3",
    dynamic_deps = [":native_libpython"],
    shared_lib_name = "libpython3.so",
    target_compatible_with = ["@platforms//os:linux"],
    user_link_flags = [
        "-Wl,--no-as-needed",
        "-Wl,-soname,libpython3.so",
    ],
    deps = [":native_libpython3_lib"],
)

cc_binary(
    name = "native_python",
    srcs = ["Programs/python.c"],
    copts = NATIVE_COPTS,
    dynamic_deps = [":native_libpython"],
    linkopts = select({
        NATIVE_WINDOWS: [
            "/STACK:2000000",
            "/NODEFAULTLIB:python{}.lib".format(PYTHON_MAJOR_MINOR_FLAT),
        ],
        NATIVE_MACOS: [
            "-Wl,-rpath,@loader_path/../lib",
            "-Wl,-stack_size,1000000",
            "-framework",
            "CoreFoundation",
        ],
        "//conditions:default": [
            "-Wl,--export-dynamic",
            "-Wl,-rpath,$$ORIGIN/../lib",
        ],
    }),
    local_defines = select({
        NATIVE_WINDOWS: [
            "NDEBUG",
            "WIN32",
            "_WIN64",
            "PY3_DLLNAME=L\\\"python3\\\"",
            "_MBCS",
        ],
        "//conditions:default": [
            "NDEBUG",
            "Py_BUILD_CORE",
        ],
    }),
    deps = [":native_headers"],
)

NATIVE_EXT_SUFFIXES = {
    condition: ".cpython-{}-{}.so".format(
        PYTHON_MAJOR_MINOR_FLAT,
        platform["multiarch"],
    )
    for condition, platform in NATIVE_PLATFORMS.items()
}

cc_library(
    name = "native_libmpdec",
    srcs = LIBMPDEC_SRCS,
    copts = NATIVE_COPTS,
