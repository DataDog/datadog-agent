    deps = [":native_internal_headers"],
)

cc_library(
    name = "native_expat",
    srcs = LIBEXPAT_SRCS,
    copts = NATIVE_COPTS,
    local_defines = ["NDEBUG"],
    deps = [":native_expat_headers"],
)

cc_library(
    name = "native_hacl_headers",
    defines = [
        "_BSD_SOURCE",
        "_DEFAULT_SOURCE",
    ],
    includes = [
        "Modules/_hacl/include",
