NATIVE_UNIX_SHARED_MODULES = SHARED_MODULES | MACOS_SHARED_MODULES

[
    cc_library(
        name = "native_module_{}_lib".format(name),
        srcs = ["Modules/" + src for src in module["srcs"]] + select({
            NATIVE_MACOS: ["Modules/" + src for src in MACOS_SHARED_MODULE_EXTRAS.get(name, {}).get("srcs", [])],
            "//conditions:default": [],
        }),
        copts = NATIVE_COPTS,
        linkopts = module.get("linkopts", []) + select({
            NATIVE_MACOS: [],
            "//conditions:default": module.get("linux_linkopts", []),
        }),
        local_defines = ["NDEBUG"] + module.get("defines", []) + select({
            NATIVE_MACOS: MACOS_SHARED_MODULE_EXTRAS.get(name, {}).get("defines", []),
            "//conditions:default": [],
        }),
        target_compatible_with = [NATIVE_MACOS] if name in MACOS_SHARED_MODULES else NATIVE_UNIX,
