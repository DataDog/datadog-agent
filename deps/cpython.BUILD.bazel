    cmd = " ".join([
        "$(execpath {})".format(DEFAULT_PYTHON),
        "$(execpath @@//deps/cpython:gen_sysconfigdata.py)",
        "--pyconfig $(execpath :native_pyconfig_h)",
        "--vars $(execpath :native_sysconfig_vars)",
        "--prefix $(INSTALL_DIR)/embedded",
        "--out $@",
    ]),
    toolchains = ["@@//:install_dir"],
    tools = [
        DEFAULT_PYTHON,
        "@@//deps/cpython:gen_sysconfigdata.py",
    ],
)

copy_to_directory(
    name = "native_install",
    srcs = [
        ":native_libpython",
        ":native_python",
        ":native_shared_modules",
        ":native_sysconfigdata",
    ] + glob(
        ["Lib/**"],
        exclude = [
            "Lib/**/__pycache__/**",
            "Lib/idlelib/idle_test/**",
            "Lib/test/**",
        ],
    ),
    replace_prefixes = select({
        condition: {
            "Lib/": "lib/python{}/".format(PYTHON_MAJOR_MINOR),
            "native_python": "bin/python{}".format(PYTHON_MAJOR_MINOR),
            "native_sysconfigdata.py": "lib/python{}/_sysconfigdata__linux_{}.py".format(
                PYTHON_MAJOR_MINOR,
                platform["multiarch"],
            ),
            LINUX_SO: "lib/" + LINUX_SO,
        } | {
            name + NATIVE_EXT_SUFFIXES[condition]: "lib/python{}/lib-dynload/{}{}".format(
                PYTHON_MAJOR_MINOR,
                name,
                NATIVE_EXT_SUFFIXES[condition],
            )
            for name in SHARED_MODULES
        }
        for condition, platform in NATIVE_PLATFORMS.items()
    }),
)

