load("@@//bazel/rules/dd_packaging:dd_cc_packaged.bzl", "dd_cc_packaged")
load("@bazel_skylib//rules:expand_template.bzl", "expand_template")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_pkg//pkg:install.bzl", "pkg_install")
load("@rules_pkg//pkg:mappings.bzl", "pkg_filegroup", "pkg_files")

package(default_visibility = ["//packages:__subpackages__"])

_VERSION = "2.39.2"

expand_template(
    name = "blkid_h",
    out = "blkid.h",
    substitutions = {
        "@LIBBLKID_DATE@": "REDACTED",
        "@LIBBLKID_VERSION@": _VERSION,
    },
    template = "libblkid/src/blkid.h.in",
)

cc_library(
    name = "libcommon",
    srcs = [
        "lib/blkdev.c",
        "lib/buffer.c",
        "lib/c_strtod.c",
        "lib/canonicalize.c",
        "lib/caputils.c",
        "lib/color-names.c",
        "lib/cpuset.c",
        "lib/crc32.c",
        "lib/crc32c.c",
        "lib/crc64.c",
        "lib/encode.c",
        "lib/env.c",
        "lib/fileutils.c",
        "lib/idcache.c",
        "lib/jsonwrt.c",
        "lib/linux_version.c",
        "lib/loopdev.c",
        "lib/mangle.c",
        "lib/match.c",
        "lib/mbsalign.c",
        "lib/mbsedit.c",
        "lib/md5.c",
        "lib/path.c",
        "lib/procfs.c",
        "lib/pwdutils.c",
        "lib/randutils.c",
        "lib/sha1.c",
        "lib/sha256.c",
        "lib/signames.c",
        "lib/strutils.c",
        "lib/strv.c",
        "lib/sysfs.c",
        "lib/timeutils.c",
        "lib/ttyutils.c",
        "lib/xxhash.c",
    ] + ["generated/config.h"],
    hdrs = glob(["include/*.h"]) + [
        ":blkid_h",
    ],
    copts = [
        "-include generated/config.h",
    ],
    include_prefix = "blkid",
    includes = [
        "include",
    ],
    local_defines = [
        "_GNU_SOURCE",
    ],
    visibility = ["//visibility:private"],
)

cc_library(
    name = "libblkid",
    srcs = glob([
        "libblkid/src/**/*.c",
        "libblkid/src/**/*.h",
    ]) + ["generated/config.h"],
    hdrs = [":blkid_h"],
    copts = [
        "-include generated/config.h",
    ],
    includes = [
        "generated",
        "include",
        "libblkid/src",
    ],
    local_defines = [
        "_GNU_SOURCE",
    ],
    visibility = ["//visibility:public"],
    deps = [":libcommon"],
)

cc_shared_library(
    name = "blkid",
    visibility = ["//visibility:public"],
    deps = [":libblkid"],
)

pkg_files(
    name = "blkid_hdr_files",
    srcs = [":blkid_h"],
    prefix = "embedded/include/blkid",
)

dd_cc_packaged(
    name = "blkid_pkg",
    dest_dir = "embedded/lib",
    input = ":blkid",
    installed_files = [":blkid_hdr_files"],
    version = "1.1.0",
    visibility = ["//visibility:public"],
)

pkg_filegroup(
    name = "all_files",
    srcs = [
        ":blkid_hdr_files",
    ],
    visibility = [
        "@@//deps/openscap:__pkg__",
        "@@//packages:__subpackages__",
    ],
)

pkg_install(
    name = "blkid_install",
    srcs = [
        ":all_files",
    ],
)
