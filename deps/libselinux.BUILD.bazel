load("@@//bazel/rules/dd_packaging:dd_cc_packaged.bzl", "dd_cc_packaged")
load("@@//compliance/rules:purl.bzl", "purl_for_generic")
load("@package_metadata//rules:package_metadata.bzl", "package_metadata")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_filegroup", "pkg_files")

package(
    default_package_metadata = [":package_metadata"],
    default_visibility = [
        "@@//deps:__pkg__",
        "@@//packages:__subpackages__",
    ],
)

VERSION = "3.5"

package_metadata(
    name = "package_metadata",
    attributes = [
        ":license",
    ],
    purl = purl_for_generic(
        download_url = "https://github.com/SELinuxProject/selinux/releases/download/{version}/libselinux-{version}.tar.gz",
        package = "libselinux",
        version = VERSION,
    ),
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/generic:unencumbered"],
    license_text = "LICENSE",
    visibility = ["//visibility:public"],
)

cc_library(
    name = "libselinux",
    srcs = glob(
        [
            "src/*.c",
            "src/*.h",
        ],
        exclude = [
            "src/audit2why.c",
            "src/label_backends_android.c",
        ],
    ),
    hdrs = glob(["include/selinux/*.h"]),
    includes = [
        "include",
    ],
    local_defines = [
        "_LARGEFILE_SOURCE",
        "FILE_OFFSET_BITS=64",
        "_GNU_SOURCE",
        "NO_ANDROID_BACKEND",
        "USE_PCRE2",
        "PCRE2_CODE_UNIT_WIDTH=8",
        # if glibc >= 2.38
        # "HAVE_STRLCPY",
        # glibc >= 2.28
        # "HAVE_REALLOCARRAY",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "@libsepol",
        "@pcre2//:libpcre2",
    ],
)

cc_shared_library(
    name = "selinux",
    additional_linker_inputs = [
        "src/libselinux.map",
    ],
    dynamic_deps = [
        "@libsepol//:sepol_pkg",
        "@pcre2//:pcre2-8_pkg",
    ],
    user_link_flags = [
        "-Wl,-soname=libselinux.so",
        "-Wl,--version-script=$(location src/libselinux.map)",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":libselinux",
    ],
)

pkg_files(
    name = "hdr_files",
    srcs = glob(["include/selinux/*.h"]),
    prefix = "include/selinux",
)

dd_cc_packaged(
    name = "selinux_pkg",
    input = ":selinux",
    installed_files = [":hdr_files"],
    visibility = ["//visibility:public"],
)

pkg_filegroup(
    name = "all_files",
    srcs = [
        ":hdr_files",
    ],
    prefix = "embedded",
    visibility = [
        "@@//deps/openscap:__pkg__",
        "@@//packages:__subpackages__",
    ],
)
