def sysconfig_vars(platform):
    """Returns the sysconfig build_time_vars for a target platform.

    Args:
        platform: a NATIVE_PLATFORMS entry.

    Returns:
        A dict of sysconfig variable names to values, with @PREFIX@ standing
        for the install prefix.
    """
    multiarch = platform["multiarch"]
    gnu_type = platform["gnu_type"]
    base = {
        "ABIFLAGS": "",
        "AR": "ar",
        "ARFLAGS": "rcsD",
        "BASECFLAGS": "-fno-strict-overflow -Wsign-compare",
        "BINDIR": "@PREFIX@/bin",
        "BINLIBDEST": "@PREFIX@/lib/python3.13",
        "BLDLIBRARY": "-L. -lpython3.13",
        "BLDSHARED": "gcc -shared",
        "BUILD_GNU_TYPE": gnu_type,
        "CC": "gcc",
        "CCSHARED": "-fPIC",
        "CFLAGS": "",
        "CFLAGSFORSHARED": "-fPIC",
        "CONFINCLUDEDIR": "@PREFIX@/include",
        "CONFINCLUDEPY": "@PREFIX@/include/python3.13",
        "CPPFLAGS": "",
        "CXX": "gcc",
        "DESTDIRS": "@PREFIX@ @PREFIX@/lib @PREFIX@/lib/python3.13 @PREFIX@/lib/python3.13/lib-dynload",
        "DESTLIB": "@PREFIX@/lib/python3.13",
        "DESTSHARED": "@PREFIX@/lib/python3.13/lib-dynload",
        "DLLLIBRARY": "",
        "EXE": "",
        "EXT_SUFFIX": ".cpython-313-{}.so".format(multiarch),
        "HOST_GNU_TYPE": gnu_type,
        "INCLUDEDIR": "@PREFIX@/include",
        "INCLUDEPY": "@PREFIX@/include/python3.13",
        "INSTSONAME": "libpython3.13.so.1.0",
        "LDCXXSHARED": "gcc -shared",
        "LDFLAGS": "",
        "LDLIBRARY": "libpython3.13.so",
        "LDSHARED": "gcc -shared",
        "LDVERSION": "3.13",
        "LIBC": "",
        "LIBDEST": "@PREFIX@/lib/python3.13",
        "LIBDIR": "@PREFIX@/lib",
        "LIBM": "-lm",
        "LIBOBJS": "",
        "LIBPC": "@PREFIX@/lib/pkgconfig",
        "LIBPL": "@PREFIX@/lib/python3.13/config-3.13-{}".format(multiarch),
        "LIBPYTHON": "",
        "LIBRARY": "libpython3.13.a",
        "LIBS": "-ldl  -lutil",
        "LINKCC": "gcc",
        "LINKFORSHARED": "-Xlinker -export-dynamic",
        "MACHDEP": platform["machdep"],
        "MULTIARCH": multiarch,
        "OPT": "-DNDEBUG -fwrapv",
        "PLATLIBDIR": "lib",
        "PY3LIBRARY": "libpython3.so",
        "PYTHON": "python",
        "PYTHONFRAMEWORK": "",
        "PY_ENABLE_SHARED": 1,
        "PY_LDFLAGS_NODIST": "",
        "Py_DEBUG": 0,
        "Py_ENABLE_SHARED": 1,
        "Py_GIL_DISABLED": 0,
        "Py_TRACE_REFS": 0,
        "SCRIPTDIR": "@PREFIX@/lib",
        "SHLIB_SUFFIX": ".so",
        "SOABI": "cpython-313-{}".format(multiarch),
        "SYSLIBS": "-lm",
        "TZPATH": "/usr/share/zoneinfo:/usr/lib/zoneinfo:/usr/share/lib/zoneinfo:/etc/zoneinfo",
        "VERSION": "3.13",
        "WITH_NEXT_FRAMEWORK": 0,
        "datarootdir": "@PREFIX@/share",
        "exec_prefix": "@PREFIX@",
        "prefix": "@PREFIX@",
    }
    if platform["machdep"] == "darwin":
        base.update(_SYSCONFIG_DARWIN_OVERRIDES)
    return base

