load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

# Headers generated by jemalloc's configure, see regen_headers.sh.
[
    cc_library(
        name = "config_linux_" + arch,
        hdrs = glob(["linux_{}/include/**/*.h".format(arch)]),
        includes = ["linux_{}/include".format(arch)],
        target_compatible_with = ["@platforms//os:linux"],
        visibility = ["@jemalloc//:__pkg__"],
    )
    for arch in [
        "arm64",
        "x86_64",
    ]
]

alias(
    name = "config",
    actual = select(
        {
            "@platforms//cpu:arm64": ":config_linux_arm64",
            "@platforms//cpu:x86_64": ":config_linux_x86_64",
            "//conditions:default": "@platforms//:incompatible",
        },
    ),
    visibility = ["@jemalloc//:__pkg__"],
)

cc_test(
    name = "smoke_test",
    srcs = ["smoke_test.c"],
    dynamic_deps = ["@jemalloc//:jemalloc_native_shared"],
    deps = ["@jemalloc"],
)

# Uses the host binutils (readelf, nm, objdump, objcopy).
sh_test(
    name = "parity_test",
    srcs = ["parity_test.sh"],
    args = [
        "$(rootpath @jemalloc//:jemalloc_shared)",
        "$(rootpath @jemalloc//:jemalloc_native_shared)",
    ],
    data = [
        "@jemalloc//:jemalloc_native_shared",
        "@jemalloc//:jemalloc_shared",
    ],
    target_compatible_with = ["@platforms//os:linux"],
)
