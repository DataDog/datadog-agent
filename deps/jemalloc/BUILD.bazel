load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

# Headers generated by jemalloc configure, checked in per arch.
[
    cc_library(
        name = "config_linux_" + arch,
        hdrs = glob(["linux_{}/include/**/*.h".format(arch)]),
        includes = ["linux_{}/include".format(arch)],
        target_compatible_with = ["@platforms//os:linux"],
        visibility = ["@jemalloc//:__pkg__"],
    )
    for arch in [
        "arm64",
        "x86_64",
    ]
]

alias(
    name = "config",
    actual = select(
        {
            "@platforms//cpu:arm64": ":config_linux_arm64",
            "@platforms//cpu:x86_64": ":config_linux_x86_64",
            "//conditions:default": "@platforms//:incompatible",
        },
    ),
    visibility = ["@jemalloc//:__pkg__"],
)

cc_test(
    name = "smoke_test",
    srcs = ["smoke_test.c"],
    dynamic_deps = ["@jemalloc//:jemalloc_native_shared"],
    deps = ["@jemalloc"],
)
