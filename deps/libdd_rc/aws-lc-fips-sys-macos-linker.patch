@@ -36,0 +37,25 @@ fn strip_lto_flags(cflags: &str) -> String {
+/// Remove Bazel LLVM's builtin-header selection when an Apple system compiler
+/// is used. Mixing LLVM 19 resource headers with AppleClang 16 builtins causes
+/// ARM NEON intrinsic compilation failures.
+fn strip_compiler_resource_flags(flags: &str) -> String {
+    let mut filtered = Vec::new();
+    let mut skip_value = false;
+
+    for flag in flags.split_whitespace() {
+        if skip_value {
+            skip_value = false;
+            continue;
+        }
+        if flag == "-resource-dir" || flag == "-idirafter" {
+            skip_value = true;
+            continue;
+        }
+        if flag.starts_with("-resource-dir=") || flag.starts_with("-idirafter=") {
+            continue;
+        }
+        filtered.push(flag);
+    }
+
+    filtered.join(" ")
+}
