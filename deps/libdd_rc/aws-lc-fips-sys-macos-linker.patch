+        let mut config = cmake::Config::new(&self.manifest_dir);
+        if is_fips_build() && target_vendor() == "apple" {
+            // Bazel's hermetic LLVM driver brings its bundled libc++ into the
+            // Apple linker process. Xcode's linker expects the host libc++ and
+            // aborts before CMake's compiler check with a missing
+            // `___cxa_demangle` symbol. Keep the Bazel-provided target, SDK,
+            // resource-dir, and hardening flags, but use Apple's compiler
