+            // matching host runtime.
+            let mut c_config = cc::Build::new();
+            c_config.compiler("/usr/bin/clang");
+            config.init_c_cfg(c_config);
+            let mut cxx_config = cc::Build::new();
+            cxx_config.cpp(true).compiler("/usr/bin/clang++");
+            config.init_cxx_cfg(cxx_config);
+        }
