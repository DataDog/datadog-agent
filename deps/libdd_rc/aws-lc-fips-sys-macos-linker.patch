     #[allow(clippy::too_many_lines)]
     fn prepare_cmake_build(&self) -> cmake::Config {
+        // Bazel's macOS C++ toolchain selects ld64.lld through LDFLAGS. That
+        // linker rejects an __eh_frame relocation emitted by the validated
+        // AWS-LC FIPS assembly when producing the required shared library.
+        // Use Apple's system linker for this dylib while retaining the rest of
+        // the Bazel-provided link flags and SDK configuration.
+        if is_fips_build() && target_vendor() == "apple" {
+            // Bazel also places its hermetic LLVM libc++ on DYLD_LIBRARY_PATH.
+            // Apple's linker is built against the system libc++; allowing the
+            // hermetic library to interpose makes ld fail to start due to ABI
+            // mismatches (for example, a missing ___cxa_demangle symbol).
+            unsafe {
+                env::remove_var("DYLD_LIBRARY_PATH");
+            }
+
+            if let Ok(ldflags) = env::var("LDFLAGS") {
+                let ldflags = ldflags
+                    .split_whitespace()
+                    .filter(|flag| {
+                        *flag != "-fuse-ld=lld" && *flag != "--ld-path=ld64.lld"
+                    })
+                    .collect::<Vec<_>>()
+                    .join(" ");
+                set_env("LDFLAGS", ldflags);
+            }
+        }
+
