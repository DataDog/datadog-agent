load("@//bazel/rules:foreign_cc_shared_wrapper.bzl", "foreign_cc_shared_wrapper")
load("@//bazel/rules/dd_packaging:dd_cc_packaged.bzl", "dd_cc_packaged")
load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("@rules_cc//cc:cc_import.bzl", "cc_import")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_go//go:def.bzl", "go_library")
load("@rules_go//proto:def.bzl", "go_proto_library")
load("@rules_rust//rust:defs.bzl", "rust_static_library")

proto_library(
    name = "signature_proto",
    srcs = ["lib/rc-x509-proto/protos/signature.proto"],
    strip_import_prefix = "/lib/rc-x509-proto/protos",
)

proto_library(
    name = "magic_tunnel_proto",
    srcs = ["lib/rc-x509-proto/protos/magic_tunnel/protocol.proto"],
    strip_import_prefix = "/lib/rc-x509-proto/protos",
)

proto_library(
    name = "remote_config_proto",
    srcs = ["lib/rc-x509-proto/protos/magic_tunnel/remote_config/remote_config.proto"],
    strip_import_prefix = "/lib/rc-x509-proto/protos",
    deps = ["@protobuf//:timestamp_proto"],
)

proto_library(
    name = "protocol_proto",
    srcs = glob(["lib/rc-x509-proto/protos/protocol/*.proto"]),
    strip_import_prefix = "/lib/rc-x509-proto/protos",
    deps = [
        ":magic_tunnel_proto",
        ":signature_proto",
    ],
)

go_proto_library(
    name = "signature_go_proto",
    importpath = "github.com/DataDog/libdd-rc/ffi-hosts/go/rcproto/signature",
    proto = ":signature_proto",
)

go_proto_library(
    name = "magic_tunnel_go_proto",
    importpath = "github.com/DataDog/libdd-rc/ffi-hosts/go/rcproto/magic_tunnel",
    proto = ":magic_tunnel_proto",
)

go_proto_library(
    name = "remote_config_go_proto",
    importpath = "github.com/DataDog/libdd-rc/ffi-hosts/go/rcproto/magic_tunnel/remote_config",
    proto = ":remote_config_proto",
    visibility = ["//visibility:public"],
)

go_proto_library(
    name = "protocol_go_proto",
    importpath = "github.com/DataDog/libdd-rc/ffi-hosts/go/rcproto/protocol",
    proto = ":protocol_proto",
    deps = [
        ":magic_tunnel_go_proto",
        ":signature_go_proto",
    ],
)

rust_static_library(
    name = "rc_x509_ffi",
    srcs = [
        "lib/rc-x509-ffi/src/connection.rs",
        "lib/rc-x509-ffi/src/ctx.rs",
        "lib/rc-x509-ffi/src/io_handle.rs",
        "lib/rc-x509-ffi/src/lib.rs",
        "lib/rc-x509-ffi/src/log_sink.rs",
    ],
    compile_data = ["lib/rc-x509-ffi/README.md"],
    crate_name = "rc_x509_ffi",
    crate_root = "lib/rc-x509-ffi/src/lib.rs",
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = [
        "@libdd_rc_crates//:futures",
        "@libdd_rc_crates//:rc-x509-client",
        "@libdd_rc_crates//:rc-x509-proto",
        "@libdd_rc_crates//:tokio",
        "@libdd_rc_crates//:tokio-stream",
        "@libdd_rc_crates//:tokio-util",
        "@libdd_rc_crates//:tracing",
        "@libdd_rc_crates//:tracing-subscriber",
    ],
)

# FIPS AWS-LC is necessarily dynamic on macOS. Cargo build scripts expose their
# output directory as a Bazel tree artifact, so materialize the dylib as a
# regular declared output that cc_import can propagate through cgo and place in
# test runfiles.
genrule(
    name = "aws_lc_fips_crypto_dylib_file",
    srcs = ["@@rules_rs++crate+libdd_rc_crates__aws-lc-fips-sys-0.14.2//:aws_lc_fips_build_output"],
    outs = ["libaws_lc_fips_0_14_2_crypto.dylib"],
    cmd = "cp $(location @@rules_rs++crate+libdd_rc_crates__aws-lc-fips-sys-0.14.2//:aws_lc_fips_build_output)/build/artifacts/libaws_lc_fips_0_14_2_crypto.dylib $@",
    target_compatible_with = ["@platforms//os:macos"],
)

cc_import(
    name = "aws_lc_fips_crypto_dylib",
    shared_library = ":aws_lc_fips_crypto_dylib_file",
    target_compatible_with = ["@platforms//os:macos"],
)

foreign_cc_shared_wrapper(
    name = "_aws_lc_fips_crypto_dylib_shared",
    input = ":aws_lc_fips_crypto_dylib",
    lib_filter = "libaws_lc_fips_0_14_2_crypto",
    target_compatible_with = ["@platforms//os:macos"],
)

# Make the dylib visible to the Agent's transitive package collector. The
# packaged copy is rpath/install-name rewritten for embedded/lib. It is added
# to rc_x509_ffi_cc's data below, while the original cc_import retains normal
# C++/cgo linking and runfiles behavior.
dd_cc_packaged(
    name = "_aws_lc_fips_crypto_dylib_packaged",
    input = ":_aws_lc_fips_crypto_dylib_shared",
)

cc_library(
    name = "rc_x509_ffi_cc",
    hdrs = ["include/libdd_rc.h"],
    data = select({
        "@rules_go//go/platform:darwin": [":_aws_lc_fips_crypto_dylib_packaged"],
        "//conditions:default": [],
    }),
    includes = ["include"],
    linkopts = select({
        "@rules_go//go/platform:linux": [
            "-lpthread",
            "-ldl",
            "-lm",
        ],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
    deps = [":rc_x509_ffi"] + select({
        "@rules_go//go/platform:darwin": [":aws_lc_fips_crypto_dylib"],
        "//conditions:default": [],
    }),
)

# bridge.go is intentionally omitted: it contains Cargo-relative #cgo paths.
# Bazel supplies the header, Rust archive, and any platform-specific native
# runtime libraries through rc_x509_ffi_cc.
go_library(
    name = "libddrcffi",
    srcs = [
        "ffi-hosts/go/internal/libddrcffi/callbacks.go",
        "ffi-hosts/go/internal/libddrcffi/connection.go",
        "ffi-hosts/go/internal/libddrcffi/context.go",
        "ffi-hosts/go/internal/libddrcffi/dispatcher.go",
        "ffi-hosts/go/internal/libddrcffi/doc.go",
        "ffi-hosts/go/internal/libddrcffi/log_sink.go",
    ],
    cdeps = [":rc_x509_ffi_cc"],
    cgo = True,
    importpath = "github.com/DataDog/libdd-rc/ffi-hosts/go/internal/libddrcffi",
    visibility = ["//visibility:public"],
    deps = [
        ":magic_tunnel_go_proto",
        ":protocol_go_proto",
        "@org_golang_google_protobuf//proto",
    ],
)

go_library(
    name = "rcx509",
    srcs = [
        "ffi-hosts/go/rcx509/client.go",
        "ffi-hosts/go/rcx509/log_sink.go",
        "ffi-hosts/go/rcx509/session.go",
    ],
    importpath = "github.com/DataDog/libdd-rc/ffi-hosts/go/rcx509",
    visibility = ["//visibility:public"],
    deps = [
        ":libddrcffi",
        "@com_github_coder_websocket//:websocket",
    ],
)
