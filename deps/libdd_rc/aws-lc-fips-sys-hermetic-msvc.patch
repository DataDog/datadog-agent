+/// CMake and Ninja execute from a nested build directory, while Bazel's MSVC
+/// flags contain paths relative to the execroot. Make those declared external
+/// inputs independent of the subprocess working directory.
+fn absolutize_bazel_execroot_paths(flags: &str) -> String {
+    let execroot = env::current_dir().expect("failed to determine Bazel execroot");
+    flags
+        .split_whitespace()
+        .map(|flag| {
+            let (prefix, path) = flag
+                .strip_prefix("/external:I")
+                .map_or(("", flag), |path| ("/external:I", path));
+            if path.starts_with("external/") || path.starts_with("external\\") {
+                format!("{prefix}{}", execroot.join(path).display())
+            } else {
+                flag.to_owned()
+            }
+        })
+        .collect::<Vec<_>>()
+        .join(" ")
+}
