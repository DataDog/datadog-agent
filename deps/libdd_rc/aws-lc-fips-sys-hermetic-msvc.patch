+/// CMake and Ninja execute from a nested build directory, while Bazel's MSVC
+/// flags contain paths relative to the execroot. Make those declared external
+/// inputs independent of the subprocess working directory.
+fn bazel_execroot() -> PathBuf {
+    for env_var in ["CC", "CXX", "AR", "LD", "GO_EXECUTABLE"] {
+        let Ok(tool) = env::var(env_var) else {
+            continue;
+        };
+        let normalized = tool.replace('\\', "/");
+        if let Some(external) = normalized.find("/external/") {
+            return PathBuf::from(&tool[..external]);
+        }
+    }
+    panic!("failed to determine Bazel execroot from declared tool paths");
+}
+
+fn prepare_bazel_flags_for_cmake(flags: &str) -> String {
+    let execroot = bazel_execroot();
+    let mut prepared = flags
+        .split_whitespace()
+        .map(|flag| {
+            // Bazel invokes link.exe directly, where the linker expands its
+            // private %_PDB% placeholder. CMake's Ninja generator adds a
+            // cmd.exe layer that expands it first; an unset value leaves an
+            // empty filename that link.exe interprets as `.obj`.
+            if flag.eq_ignore_ascii_case("/PDBALTPATH:%_PDB%") {
+                return "/PDBALTPATH:aws-lc.pdb".to_owned();
+            }
+            let (prefix, path) = flag
+                .strip_prefix("/external:I")
+                .map_or(("", flag), |path| ("/external:I", path));
+            if path.starts_with("external/") || path.starts_with("external\\") {
+                format!("{prefix}{}", execroot.join(path).display())
+            } else {
+                flag.to_owned()
+            }
+        })
+        .collect::<Vec<_>>();
+
+    // Bazel names the CRT libraries explicitly, while CMake additionally
+    // links standard Windows libraries such as kernel32.lib by name. The
+    // hermetic toolchain intentionally has no ambient LIB setting, so expose
+    // only the declared SDK/MSVC library directories to those subprocesses.
+    let mut library_paths = Vec::new();
+    for flag in &prepared {
+        let normalized = flag.replace('\\', "/");
+        let lowercase = normalized.to_ascii_lowercase();
+        if let Some(prefix) = lowercase.strip_suffix("/ucrt/x64/ucrt.lib") {
+            let root = &normalized[..prefix.len()];
+            library_paths.push(format!("{root}/ucrt/x64"));
+            library_paths.push(format!("{root}/um/x64"));
+        } else if lowercase.ends_with("/msvcrt.lib") {
+            if let Some((parent, _)) = normalized.rsplit_once('/') {
+                library_paths.push(parent.to_owned());
+            }
+        }
+    }
+    for library_path in library_paths {
+        let library_path = library_path.replace('/', "\\");
+        let flag = format!("/LIBPATH:{library_path}");
+        if !prepared
+            .iter()
+            .any(|existing| existing.eq_ignore_ascii_case(&flag))
+        {
+            prepared.push(flag);
+        }
+    }
+
+    prepared.join(" ")
+}
