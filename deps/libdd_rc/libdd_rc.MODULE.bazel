http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

crate = use_extension("@rules_rs//rs:extensions.bzl", "crate")
crate.from_cargo(
    name = "libdd_rc_crates",
    cargo_lock = "//deps/libdd_rc:Cargo.lock",
    cargo_toml = "//deps/libdd_rc:Cargo.toml",
    platform_triples = [
        "aarch64-apple-darwin",
        "aarch64-unknown-linux-gnu",
        "x86_64-apple-darwin",
        "x86_64-unknown-linux-gnu",
    ],
    validate_lockfile = True,
)
crate.annotation(
    build_script_env = {
        "PROTOC": "$(execpath @@//bazel/toolchains/protoc:protoc)",
    },
    build_script_tools = ["@@//bazel/toolchains/protoc:protoc"],
    crate = "rc-x509-proto",
)

# libdd-rc enables this cfg for its workspace in .cargo/config.toml. The
# valuable integration is gated on both the Cargo feature and this cfg in
# tracing/tracing-core, so reproduce it narrowly in the isolated crate graph.
crate.annotation(
    crate = "tracing",
    rustc_flags = ["--cfg=tracing_unstable"],
)
crate.annotation(
    crate = "tracing-core",
    rustc_flags = ["--cfg=tracing_unstable"],
    # Cargo declares this edge under cfg(tracing_unstable), which
    # crate_universe cannot infer from a custom rustc cfg.
    deps = ["@libdd_rc_crates//:valuable-0.1.1"],
)

# TODO: update as needed
crate.annotation(
    build_script_env_select = {
        "aarch64-apple-darwin": "{\"CMAKE\":\"/opt/homebrew/bin/cmake\",\"PATH\":\"/opt/homebrew/bin:/bin:/usr/bin:/usr/local/bin\"}",
        "x86_64-unknown-linux-gnu": "{\"CMAKE\":\"/usr/bin/cmake\",\"GO111MODULE\":\"on\",\"GOTOOLCHAIN\":\"local\",\"GOWORK\":\"off\",\"PATH\":\"/usr/local/go/bin:/bin:/usr/bin:/usr/local/bin\"}",
    },
    crate = "aws-lc-fips-sys",
)
use_repo(crate, "libdd_rc_crates")

http_archive(
    name = "libdd_rc_source",
    build_file = "//deps/libdd_rc:libdd_rc.BUILD.bazel",
    sha256 = "a1b0d09f95a06b7088f165f126cb9cc6de20d127209e33dba040da3ac560d8a1",
    strip_prefix = "libdd-rc-305c363d46afc04e497ea77f415753121aab9d3e",
    urls = ["https://github.com/DataDog/libdd-rc/archive/305c363d46afc04e497ea77f415753121aab9d3e.tar.gz"],
)
