load("@@//bazel/rules/dd_packaging:dd_cc_packaged.bzl", "dd_cc_packaged")
load("@@//compliance/rules:purl.bzl", "purl_for_generic")
load("@package_metadata//rules:package_metadata.bzl", "package_metadata")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_filegroup", "pkg_files")

package(default_package_metadata = [":package_metadata"])

VERSION = "1.19"

package_metadata(
    name = "package_metadata",
    attributes = [
        ":license",
    ],
    purl = purl_for_generic(
        download_url = "https://ftp.osuosl.org/pub/rpm/popt/releases/popt-1.x/popt-{version}.tar.gz",
        package = "popt",
        version = VERSION,
    ),
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:MIT"],
    license_text = "COPYING",
    visibility = ["//visibility:public"],
)

cc_library(
    name = "libpopt",
    srcs = [
        "src/popt.c",
        "src/poptconfig.c",
        "src/popthelp.c",
        "src/poptint.c",
        "src/poptint.h",
        "src/poptparse.c",
        "src/system.h",
    ],
    hdrs = [
        "src/popt.h",
    ],
    copts = [
        "-std=gnu99",
        "-O2",
    ],
    local_defines = [
        "_GNU_SOURCE",
        "HAVE_STPCPY",
        "HAVE_STRERROR",
        "HAVE_GETUID",
        "HAVE_GETEUID",
        "HAVE_MTRACE",
        "HAVE_SECURE_GETENV",
        "HAVE_SETUID",
        "HAVE_VASPRINTF",
        "HAVE_SRANDOM",
        "HAVE_GLOB_PATTERN_P",
        "HAVE_MBSRTOWCS",
        "HAVE_FNMATCH_H",
        "HAVE_GLOB_H",
        "HAVE_LANGINFO_H",
        "HAVE_MCHECK_H",
        "HAVE_STDALIGN_H",
        'PACKAGE=\\"popt\\"',
        'POPT_SYSCONFDIR=\\"/etc/\\"',
    ],
    strip_include_prefix = "src",
    target_compatible_with = ["@platforms//os:linux"],
    textual_hdrs = [
        "src/lookup3.c",
    ],
    visibility = ["//visibility:public"],
)

cc_shared_library(
    name = "popt",
    additional_linker_inputs = [
        "src/libpopt.vers",
    ],
    user_link_flags = [
        "-Wl,--no-undefined",
        "-Wl,--version-script=$(location src/libpopt.vers)",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":libpopt",
    ],
)

pkg_files(
    name = "hdr_files",
    srcs = glob(["src/popt.h"]),
    prefix = "embedded/include",
)

dd_cc_packaged(
    name = "popt_pkg",
    dest_dir = "embedded/lib",
    input = ":popt",
    installed_files = [":hdr_files"],
    version = "0.0.2",
    visibility = ["//visibility:public"],
)

pkg_filegroup(
    name = "all_files",
    srcs = [
        ":hdr_files",
    ],
    visibility = [
        "@@//deps/openscap:__pkg__",
        "@@//packages:__subpackages__",
    ],
)
