        "kdb/keytab.c",
        ":adb_err",
    ],
    dynamic_deps = [
        ":gssrpc_pkg",
        "//src/lib/crypto:k5crypto_pkg",
        "//src/lib/krb5:krb5_pkg",
        "//src/util:com_err_pkg",
        "//src/util:krb5support_pkg",
    ],
    implementation_deps = [":kdb_private_h"],
    linkopts = ["-ldl"],
    local_defines = ["KDB5_USE_LIB_KDB_DB2"],
    version = "10.0",
    exports = "kdb/libkdb5.exports",
    deps = [
        ":gssrpc_lib",
        "//:gssrpc_h",
        "//:include",
        "//src/lib/crypto:k5crypto_lib",
        "//src/lib/krb5:krb5_lib",
        "//src/util:com_err_lib",
        "//src/util:krb5support_lib",
    ],
)

