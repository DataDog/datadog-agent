package(
    default_package_metadata = ["//:package_metadata"],
    default_visibility = [
        "//:__subpackages__",
        "@@//deps/krb5:__pkg__",
    ],
)

# libgssrpc (lib/rpc): ONC RPC over GSS-API, used by kadmin.
krb5_shared_library(
    name = "gssrpc",
    srcs = [
        "rpc/auth_gss.c",
        "rpc/auth_gssapi.c",
        "rpc/auth_gssapi_misc.c",
        "rpc/auth_none.c",
        "rpc/auth_unix.c",
        "rpc/authgss_prot.c",
        "rpc/authunix_prot.c",
        "rpc/bindresvport.c",
        "rpc/clnt_generic.c",
        "rpc/clnt_perror.c",
        "rpc/clnt_raw.c",
        "rpc/clnt_simple.c",
        "rpc/clnt_tcp.c",
        "rpc/clnt_udp.c",
        "rpc/dyn.c",
        "rpc/dyn.h",
        "rpc/dynP.h",
        "rpc/get_myaddress.c",
        "rpc/getrpcport.c",
        "rpc/gssrpcint.h",
        "rpc/pmap_clnt.c",
        "rpc/pmap_getmaps.c",
        "rpc/pmap_getport.c",
        "rpc/pmap_prot.c",
        "rpc/pmap_prot2.c",
        "rpc/pmap_rmt.c",
        "rpc/rpc_callmsg.c",
        "rpc/rpc_commondata.c",
        "rpc/rpc_dtablesize.c",
        "rpc/rpc_prot.c",
        "rpc/svc.c",
        "rpc/svc_auth.c",
        "rpc/svc_auth_gss.c",
        "rpc/svc_auth_gssapi.c",
        "rpc/svc_auth_none.c",
        "rpc/svc_auth_unix.c",
        "rpc/svc_raw.c",
        "rpc/svc_run.c",
        "rpc/svc_simple.c",
        "rpc/svc_tcp.c",
        "rpc/svc_udp.c",
        "rpc/xdr.c",
        "rpc/xdr_alloc.c",
        "rpc/xdr_array.c",
        "rpc/xdr_float.c",
        "rpc/xdr_mem.c",
        "rpc/xdr_rec.c",
        "rpc/xdr_reference.c",
        "rpc/xdr_sizeof.c",
        "rpc/xdr_stdio.c",
    ],
    dynamic_deps = [
        "//src/lib/crypto:k5crypto_pkg",
        "//src/lib/gssapi:gssapi_krb5_pkg",
        "//src/lib/krb5:krb5_pkg",
        "//src/util:com_err_pkg",
        "//src/util:krb5support_pkg",
    ],
    local_defines = [
        "DEBUG_GSSAPI=0",
        "GSSAPI_KRB5",
        "GSSRPC__IMPL",
    ],
    version = "4.2",
    exports = "rpc/libgssrpc.exports",
    deps = [
        "//:gssrpc_h",
        "//:include",
        "//src/lib/crypto:k5crypto_lib",
        "//src/lib/gssapi:gssapi_krb5_h",
        "//src/lib/gssapi:gssapi_krb5_lib",
        "//src/lib/krb5:krb5_lib",
        "//src/util:com_err_lib",
    ],
)

krb5_compile_et(
    name = "adb_err",
    src = "kdb/adb_err.et",
    out_c = "kdb/adb_err.c",
    out_h = "kdb/adb_err.h",
)

cc_library(
    name = "kdb_private_h",
    hdrs = glob(["kdb/*.h"]) + ["kdb/adb_err.h"],
    includes = ["kdb"],
)

# libkdb5 (lib/kdb): KDC database interface.
krb5_shared_library(
    name = "kdb5",
    srcs = [
        "kdb/decrypt_key.c",
        "kdb/encrypt_key.c",
        "kdb/iprop_xdr.c",
        "kdb/kdb5.c",
        "kdb/kdb_convert.c",
        "kdb/kdb_cpw.c",
