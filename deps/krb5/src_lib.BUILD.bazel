        "kadm5/kadm_rpc.h",
        "kadm5/server_internal.h",
    ],
    includes = [
        "kadm5",
        "kadm5/clnt",
    ],
)

# Objects of lib/kadm5 that upstream links into both kadm5 libraries.
cc_library(
    name = "kadm5_common",
    srcs = [
        "kadm5/alt_prof.c",
        "kadm5/chpass_util.c",
        "kadm5/kadm_rpc_xdr.c",
        "kadm5/logger.c",
        "kadm5/misc_free.c",
        "kadm5/str_conv.c",
        ":chpass_util_strings",
        ":kadm_err",
    ],
    copts = KRB5_COPTS,
    implementation_deps = [":kadm5_private_h"],
    local_defines = KRB5_LOCAL_DEFINES,
    tags = ["LINKABLE_MORE_THAN_ONCE"],
    deps = [
        ":gssrpc_lib",
        ":kadm5_h",
        "//:gssrpc_h",
        "//:include",
        "//src/lib/krb5:krb5_lib",
        "//src/util:com_err_lib",
        "//src/util:krb5support_lib",
    ],
    alwayslink = True,
)

