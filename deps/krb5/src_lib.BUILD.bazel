    out_h = "kadm5/chpass_util_strings.h",
)

cc_library(
    name = "kadm5_h",
    hdrs = [
        "kadm5/admin.h",
        "kadm5/admin_internal.h",
        "kadm5/admin_xdr.h",
        "kadm5/chpass_util_strings.h",
        "kadm5/kadm_err.h",
