load("@@//deps/krb5:krb5_codegen.bzl", "krb5_compile_et")
load("@@//deps/krb5:krb5_defs.bzl", "KRB5_COPTS", "KRB5_LOCAL_DEFINES")
load("@@//deps/krb5:krb5_library.bzl", "krb5_shared_library")
load("@@//deps/krb5:krb5_tests.bzl", "krb5_c_tests")
