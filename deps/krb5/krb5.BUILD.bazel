load("@@//compliance/rules:purl.bzl", "purl_for_generic")
load("@@//deps/krb5:krb5_codegen.bzl", "krb5_concat")
load("@bazel_skylib//rules:copy_file.bzl", "copy_file")
load("@bazel_skylib//rules:expand_template.bzl", "expand_template")
load("@package_metadata//rules:package_metadata.bzl", "package_metadata")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_filegroup", "pkg_files", "strip_prefix")

package(
    default_package_metadata = [":package_metadata"],
    default_visibility = [
        "//:__subpackages__",
        "@@//deps/krb5:__pkg__",
    ],
)

VERSION = "1.22.2"

package_metadata(
    name = "package_metadata",
    attributes = [
        ":license",
    ],
    purl = purl_for_generic(
        download_url = "https://kerberos.org/dist/krb5/1.22/krb5-{version}.tar.gz",
        package = "krb5",
        version = VERSION,
    ),
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-2-Clause"],
    license_text = "NOTICE",
    visibility = ["//visibility:public"],
)

exports_files(["src/config-files/krb5.conf"])

# include/autoconf.h, captured from upstream's configure for each architecture.
copy_file(
    name = "autoconf_h",
    src = select({
        "@@//:linux_arm64": "autoconf-linux-arm64.h",
        "@@//:linux_x86_64": "autoconf-linux-x86_64.h",
    }),
    out = "src/include/autoconf.h",
    target_compatible_with = ["@platforms//os:linux"],
)

# These paths are compiled into the libraries, so they must not depend on the install location.
# Defaults the agent does not use point to /nonexistent, so a krb5 installed on the host is
# never picked up. Plugins are found through %{LIBDIR}, which resolves at runtime next to the
# loaded libkrb5 (see 0005-Resolve-LIBDIR-token-from-the-loaded-library-on-Unix.patch).
expand_template(
    name = "osconf_h",
    out = "src/include/osconf.h",
    substitutions = {
        "@BINDIR": "/nonexistent/krb5/bin",
        "@DYNOBJEXT": ".so",
        "@GSSMODULEDIR": "/nonexistent/krb5/lib/gss",
        "@KRB5RCTMPDIR": "/var/tmp",
        "@LIBDIR": "%{LIBDIR}",
        "@LOCALSTATEDIR": "/nonexistent/krb5/var",
        "@MODULEDIR": "/nonexistent/krb5/lib/krb5/plugins",
        "@RUNSTATEDIR": "/nonexistent/krb5/var/run",
        "@SBINDIR": "/nonexistent/krb5/sbin",
        "@SYSCONFCONF": "",
        "@SYSCONFDIR": "/nonexistent/krb5/etc",
    },
    template = "src/include/osconf.hin",
)

# Public krb5/krb5.h: krb5.hin followed by the error tables, as in include/Makefile.in.
krb5_concat(
    name = "krb5_h",
    out = "src/include/krb5/krb5.h",
    epilogue = "#endif /* KRB5_KRB5_H_INCLUDED */",
    inputs = [
        "src/include/krb5/krb5.hin",
        "//src/lib/krb5:error_tables/krb5_err.h",
        "//src/lib/krb5:error_tables/k5e1_err.h",
        "//src/lib/krb5:error_tables/kdb5_err.h",
        "//src/lib/krb5:error_tables/kv5m_err.h",
        "//src/lib/krb5:error_tables/krb524_err.h",
        "//src/lib/krb5:error_tables/asn1_err.h",
    ],
    prologue = "/* This file is generated, please don't edit it directly.  */\\n#ifndef KRB5_KRB5_H_INCLUDED\\n#define KRB5_KRB5_H_INCLUDED",
)

# Public profile.h, as in util/profile/Makefile.in.
krb5_concat(
    name = "profile_h",
    out = "src/include/profile.h",
    inputs = [
        "//src/util:profile/profile.hin",
        "//src/util:profile/prof_err.h",
    ],
)

# Upstream's include/ directory (source and generated headers), used by every library.
cc_library(
    name = "include",
    hdrs = glob([
        "src/include/*.h",
        "src/include/krb5/*.h",
    ]) + [
        ":autoconf_h",
        ":krb5_h",
        ":osconf_h",
        ":profile_h",
    ],
    includes = ["src/include"],
    deps = [
        "//src/util:com_err_h",
        "//src/util:verto_h",
    ],
)

cc_library(
    name = "patchlevel_h",
    hdrs = ["src/patchlevel.h"],
    includes = ["src"],
)

expand_template(
    name = "gssrpc_types_h",
    out = "src/include/gssrpc/types.h",
    substitutions = {
        "@GSSRPC__BSD_TYPEALIASES@": "/* #undef GSSRPC__BSD_TYPEALIASES */",
        "@GSSRPC__NETDB_H@": "/* #include <netdb.h> */",
        "@GSSRPC__SYS_PARAM_H@": "#include <sys/param.h>",
        "@GSSRPC__SYS_SELECT_H@": "#include <sys/select.h>",
        "@GSSRPC__SYS_TIME_H@": "#include <sys/time.h>",
        "@GSSRPC__UNISTD_H@": "#include <unistd.h>",
        "@rpcent_define@": "#define STRUCT_RPCENT_IN_RPC_NETDB_H",
    },
    template = "src/include/gssrpc/types.hin",
)

# Public gssrpc/ headers, including the configured gssrpc/types.h.
cc_library(
    name = "gssrpc_h",
    hdrs = glob(["src/include/gssrpc/*.h"]) + [":gssrpc_types_h"],
    includes = ["src/include"],
    deps = ["//src/lib/gssapi:gssapi_generic_h"],
)

pkg_files(
    name = "include_hdr_files",
    srcs = [
        "src/include/gssapi.h",
        "src/include/kdb.h",
        "src/include/krad.h",
        "src/include/krb5.h",
        "src/include/krb5/ccselect_plugin.h",
        "src/include/krb5/certauth_plugin.h",
        "src/include/krb5/clpreauth_plugin.h",
        "src/include/krb5/hostrealm_plugin.h",
        "src/include/krb5/kadm5_auth_plugin.h",
        "src/include/krb5/kadm5_hook_plugin.h",
        "src/include/krb5/kdcpolicy_plugin.h",
        "src/include/krb5/kdcpreauth_plugin.h",
        "src/include/krb5/localauth_plugin.h",
        "src/include/krb5/locate_plugin.h",
        "src/include/krb5/plugin.h",
        "src/include/krb5/preauth_plugin.h",
        "src/include/krb5/pwqual_plugin.h",
        ":gssrpc_types_h",
        ":krb5_h",
        ":profile_h",
    ] + glob(["src/include/gssrpc/*.h"]),
    prefix = "embedded/include",
    strip_prefix = strip_prefix.from_pkg("src/include"),
)

# All headers upstream's make install puts in include/, shipped with libkrb5.
pkg_filegroup(
    name = "hdr_files",
    srcs = [
        ":include_hdr_files",
        "//src/lib:kadm5_hdr_files",
        "//src/lib/gssapi:hdr_files",
        "//src/util:com_err_hdr_files",
        "//src/util:verto_hdr_files",
    ],
)

# Entry point for packaging krb5, so consumers don't depend on the overlay layout.
alias(
    name = "kinit_pkg",
    actual = "//src/clients/kinit:kinit_pkg",
    visibility = ["@@//packages:__subpackages__"],
)

# Upstream's self-contained C unit tests. Manual: run with `bazel test @krb5//:tests`.
test_suite(
    name = "tests",
    tags = ["manual"],
    tests = [
        "//src/lib:krad_tests",
        "//src/lib/crypto:crypto_tests",
        "//src/lib/gssapi:gssapi_tests",
        "//src/lib/krb5:krb5_tests",
        "//src/util:com_err_tests",
        "//src/util:support_tests",
    ],
)
