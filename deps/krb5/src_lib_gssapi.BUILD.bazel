load("@@//deps/krb5:krb5_codegen.bzl", "krb5_compile_et", "krb5_concat", "krb5_perl_gen")
load("@@//deps/krb5:krb5_defs.bzl", "KRB5_COPTS", "KRB5_LOCAL_DEFINES")
load("@@//deps/krb5:krb5_library.bzl", "krb5_shared_library")
load("@@//deps/krb5:krb5_tests.bzl", "krb5_c_tests")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_pkg//pkg:mappings.bzl", "pkg_files")

package(
    default_package_metadata = ["//:package_metadata"],
    default_visibility = [
        "//:__subpackages__",
        "@@//deps/krb5:__pkg__",
    ],
)

krb5_compile_et(
    name = "gssapi_err_generic",
    src = "generic/gssapi_err_generic.et",
    out_c = "generic/gssapi_err_generic.c",
    out_h = "generic/gssapi_err_generic.h",
)

krb5_compile_et(
    name = "gssapi_err_krb5",
    src = "krb5/gssapi_err_krb5.et",
    out_c = "krb5/gssapi_err_krb5.c",
    out_h = "krb5/gssapi_err_krb5.h",
)

krb5_concat(
    name = "gssapi_h",
    out = "generic/gssapi.h",
    inputs = ["generic/gssapi.hin"],
    prologue = "/* This is the gssapi.h prologue. */\\n/* no xom.h */\\n/* End of gssapi.h prologue. */",
)

# Generated maps used by the mechglue and krb5 mechanism, as in their Makefile.in.
krb5_perl_gen(
    name = "errmap_h",
    out = "generic/errmap.h",
    modules = ["//src/util:perl_modules"],
    perl_args = ["-w"],
    script = "//src/util:gen.pl",
    script_args = [
        "bimap",
        "{out}",
        "NAME=mecherrmap",
        "LEFT=OM_uint32",
        "RIGHT=struct mecherror",
        "LEFTPRINT=print_OM_uint32",
        "RIGHTPRINT=mecherror_print",
        "LEFTCMP=cmp_OM_uint32",
        "RIGHTCMP=mecherror_cmp",
    ],
)

krb5_perl_gen(
    name = "error_map_h",
    out = "krb5/error_map.h",
    modules = ["//src/util:perl_modules"],
    script = "//src/util:gen-map.pl",
    script_args = [
        "-o{out}",
        "NAME=gsserrmap",
        "KEY=OM_uint32",
        "VALUE=char *",
        "COMPARE=compare_OM_uint32",
        "FREEVALUE=free_string",
    ],
)

cc_library(
    name = "gssapi_generic_h",
    hdrs = [
        "generic/gssapi_alloc.h",
        "generic/gssapi_ext.h",
        "generic/gssapi_generic.h",
        ":gssapi_h",
    ],
    include_prefix = "gssapi",
    strip_include_prefix = "generic",
)

cc_library(
    name = "gssapi_krb5_h",
    hdrs = ["krb5/gssapi_krb5.h"],
    include_prefix = "gssapi",
    strip_include_prefix = "krb5",
    deps = [":gssapi_generic_h"],
)

cc_library(
    name = "gssapi_mechglue_h",
    hdrs = ["mechglue/mechglue.h"],
    include_prefix = "gssapi",
    strip_include_prefix = "mechglue",
    deps = [":gssapi_generic_h"],
)

cc_library(
    name = "gssapi_private_h",
    hdrs = glob([
        "generic/*.h",
        "krb5/*.h",
        "mechglue/*.h",
        "spnego/*.h",
    ]) + [
        "generic/gssapi_err_generic.h",
        "krb5/gssapi_err_krb5.h",
        ":errmap_h",
        ":error_map_h",
        ":gssapi_h",
    ],
    includes = [
        ".",
        "generic",
        "krb5",
        "mechglue",
        "spnego",
    ],
)

# libgssapi_krb5 (lib/gssapi): GSS-API with the krb5 and SPNEGO mechanisms.
