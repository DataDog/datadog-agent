pkg_files(
    name = "hdr_files",
    srcs = [
        "generic/gssapi_alloc.h",
        "generic/gssapi_ext.h",
        "generic/gssapi_generic.h",
        "krb5/gssapi_krb5.h",
        "mechglue/mechglue.h",
        ":gssapi_h",
    ],
    prefix = "embedded/include/gssapi",
)

krb5_c_tests(
    name = "gssapi_tests",
    srcs = ["generic/t_seqstate.c"],
    copts = KRB5_COPTS,
    local_defines = KRB5_LOCAL_DEFINES + ["_GSS_STATIC_LINK=1"],
    deps = [
        ":gssapi_krb5_lib",
        ":gssapi_private_h",
    ],
)
