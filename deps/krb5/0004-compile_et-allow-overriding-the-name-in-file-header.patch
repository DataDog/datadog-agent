The generated files record their own path in a header comment. Allow
passing a separate display name, so build systems that write outputs
outside the current directory don't leak build paths into the
generated (and installed) headers.

diff --git a/src/util/et/et_c.awk b/src/util/et/et_c.awk
--- a/src/util/et/et_c.awk
+++ b/src/util/et/et_c.awk
@@ -103,7 +103,9 @@
 			tab_base_high--
 		}
 	}
+	if (displayname == "")
+		displayname = outfile
 	print "/*" > outfile
-	print " * " outfile ":" > outfile
+	print " * " displayname ":" > outfile
 	print " * This file is automatically generated; please do not edit it." > outfile
 	print " */" > outfile
diff --git a/src/util/et/et_h.awk b/src/util/et/et_h.awk
--- a/src/util/et/et_h.awk
+++ b/src/util/et/et_h.awk
@@ -105,8 +105,10 @@
 	curr_low = tab_base_low
 	curr_high = tab_base_high
 	curr_sign = tab_base_sign
+	if (displayname == "")
+		displayname = outfile
 	print "/*" > outfile
-	print " * " outfile ":" > outfile
+	print " * " displayname ":" > outfile
 	print " * This file is automatically generated; please do not edit it." > outfile
 	print " */" > outfile
 	print "" > outfile
