cc_library(
    name = "krb5_private_h",
    hdrs = glob([
        "*.h",
        "asn.1/*.h",
        "ccache/*.h",
        "ccache/ccapi/*.h",
        "keytab/*.h",
        "krb/*.h",
        "os/*.h",
        "rcache/*.h",
        "unicode/ucdata/*.h",
