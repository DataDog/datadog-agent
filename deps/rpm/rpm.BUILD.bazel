load("@@//bazel/rules:dd_agent_expand_template.bzl", "dd_agent_expand_template")
load("@@//bazel/rules/dd_packaging:dd_cc_packaged.bzl", "dd_cc_packaged")
load("@@//compliance/rules:purl.bzl", "purl_for_generic")
load("@bazel_skylib//rules:copy_file.bzl", "copy_file")
load("@package_metadata//rules:package_metadata.bzl", "package_metadata")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_filegroup", "pkg_files")

package(default_package_metadata = [":package_metadata"])

VERSION = "4.20.1"

package_metadata(
    name = "package_metadata",
    attributes = [
        ":license",
    ],
    purl = purl_for_generic(
        download_url = "https://github.com/rpm-software-management/rpm/releases/download/rpm-{version}-release/rpm-{version}.tar.bz2",
        package = "rpm",
        version = VERSION,
    ),
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:LGPL-2.0"],
    license_text = "COPYING",
    visibility = ["//visibility:public"],
)

copy_file(
    name = "copy_config_h",
    src = select({
        "@//:linux_x86_64": "config-linux-x86_64.h",
        "@//:linux_arm64": "config-linux-arm64.h",
    }),
    out = "config.h",
    target_compatible_with = ["@platforms//os:linux"],
)

cc_library(
    name = "config_h",
    hdrs = [
        ":copy_config_h",
    ],
    includes = ["."],
)

FAKE_PREFIX = "/opt/datadog-agent/embedded"

COMMON_DEFINES = [
    "HAVE_CONFIG_H",
    "_FILE_OFFSET_BITS=64",
    "_GNU_SOURCE",
]

cc_library(
    name = "headers",
    hdrs = glob(["include/rpm/*.h"]),
    includes = ["include"],
)

genrule(
    name = "tagtbl_inc",
    srcs = [
        "include/rpm/rpmtag.h",
    ],
    outs = ["lib/tagtbl.inc"],
    cmd = "AWK=$(execpath @gawk) $(execpath lib/gentagtbl.sh) $(execpath include/rpm/rpmtag.h) > $@",
    tools = [
        "lib/gentagtbl.sh",
        "@gawk",
    ],
)

# The headers CMake puts on the private include path of the libraries.
cc_library(
    name = "private_headers",
    hdrs = glob([
        "lib/*.h",
        "lib/backend/*.h",
        "misc/*.h",
        "rpmio/*.h",
    ]) + [":tagtbl_inc"],
    includes = [
        "lib",
        "misc",
        "rpmio",
    ],
    textual_hdrs = [
        "misc/rpmhash.C",
        "misc/rpmhash.H",
        "rpmio/modemuncher.c",
    ],
)

cc_library(
    name = "rpmpgp_legacy",
    srcs = ["@libpgpr//:rpm_intree_srcs"],
    implementation_deps = [
        ":config_h",
        ":headers",
        ":private_headers",
        "@openssl",
    ],
    local_defines = COMMON_DEFINES + ["PGPR_RPM_INTREE"],
    alwayslink = True,
)

cc_library(
    name = "librpmio",
    srcs = [
        "rpmio/argv.c",
        "rpmio/base64.c",
        "rpmio/digest.c",
        "rpmio/digest_openssl.c",
        "rpmio/expression.c",
        "rpmio/lposix.c",
        "rpmio/macro.c",
        "rpmio/rgetopt.c",
        "rpmio/rpmfileutil.c",
        "rpmio/rpmglob.c",
        "rpmio/rpmhook.c",
        "rpmio/rpmio.c",
        "rpmio/rpmkeyring.c",
        "rpmio/rpmlog.c",
        "rpmio/rpmlua.c",
        "rpmio/rpmmalloc.c",
        "rpmio/rpmpgp.c",
        "rpmio/rpmsq.c",
        "rpmio/rpmstring.c",
        "rpmio/rpmstrpool.c",
        "rpmio/rpmsw.c",
        "rpmio/rpmver.c",
        "rpmio/rpmvercmp.c",
        "rpmio/url.c",
    ],
    implementation_deps = [
        ":config_h",
        ":private_headers",
    ],
    local_defines = COMMON_DEFINES + [
        'RPM_CONFIGDIR=\\"{}/lib/rpm\\"'.format(FAKE_PREFIX),
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":headers",
        ":rpmpgp_legacy",
        "@bzip2//:libbz2",
        "@lua//:liblua",
        "@openssl",
        "@popt//:libpopt",
        "@xz//:liblzma",
        "@zlib",
        "@zstd//:libzstd",
    ],
)

cc_shared_library(
    name = "rpmio",
    dynamic_deps = [
        "@popt//:popt_pkg",
        "@zlib//:z_pkg",
        "@xz//:lzma_pkg",
        "@bzip2//:bz2_pkg",
    ],
    user_link_flags = select({
        "@platforms//os:linux": [
            "-Wl,-rpath=/opt/datadog-agent/embedded/lib",
        ],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
    deps = [":librpmio"],
)

cc_library(
    name = "librpm",
    srcs = [
        "lib/backend/bdb_ro.c",
        "lib/backend/dbi.c",
        "lib/backend/dbiset.c",
        "lib/backend/dummydb.c",
        "lib/backend/sqlite.c",
        "lib/cpio.c",
        "lib/depends.c",
        "lib/formats.c",
        "lib/fprint.c",
        "lib/fsm.c",
        "lib/header.c",
        "lib/headerfmt.c",
        "lib/headerutil.c",
        "lib/manifest.c",
        "lib/order.c",
        "lib/package.c",
        "lib/poptALL.c",
        "lib/poptI.c",
        "lib/poptQV.c",
        "lib/psm.c",
        "lib/query.c",
        "lib/relocation.c",
        "lib/rpmal.c",
        "lib/rpmchecksig.c",
        "lib/rpmchroot.c",
        "lib/rpmdb.c",
        "lib/rpmds.c",
        "lib/rpmfi.c",
        "lib/rpmfs.c",
        "lib/rpmgi.c",
        "lib/rpminstall.c",
        "lib/rpmlead.c",
        "lib/rpmlock.c",
        "lib/rpmplugins.c",
        "lib/rpmprob.c",
        "lib/rpmps.c",
        "lib/rpmrc.c",
        "lib/rpmscript.c",
        "lib/rpmtd.c",
        "lib/rpmte.c",
        "lib/rpmtriggers.c",
        "lib/rpmts.c",
        "lib/rpmug.c",
        "lib/rpmvs.c",
        "lib/signature.c",
        "lib/tagexts.c",
        "lib/tagname.c",
        "lib/transaction.c",
        "lib/verify.c",
    ],
    implementation_deps = [
        ":config_h",
        ":private_headers",
    ],
    local_defines = COMMON_DEFINES + [
        'LIBRPMALIAS_FILENAME=\\"rpmpopt-{}\\"'.format(VERSION),
        'LIBRPMALIAS_EXECPATH=\\"{}\\"'.format(FAKE_PREFIX),
        'LOCALSTATEDIR=\\"/var\\"',
        'SYSCONFDIR=\\"{}/etc\\"'.format(FAKE_PREFIX),
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":librpmio",
        "@popt//:libpopt",
        "@sqlite3//:libsqlite3",
    ],
)

cc_shared_library(
    name = "rpm",
    dynamic_deps = [
        ":rpmio_pkg",
        "@sqlite3//:sqlite3_pkg",
        "@popt//:popt_pkg",
    ],
    visibility = ["//visibility:public"],
    deps = [":librpm"],
)

dd_agent_expand_template(
    name = "gen_rpmrc",
    out = "rpmrc",
    substitutions = {
        "@RPM_CONFIGDIR@": "{install_dir}/embedded/lib/rpm",
    },
    template = "rpmrc.in",
)

dd_agent_expand_template(
    name = "gen_rpmpopt",
    out = "rpmpopt-{}".format(VERSION),
    substitutions = {
        "@RPM_CONFIGDIR@": "{install_dir}/embedded/lib/rpm",
        "@PROJECT_VERSION@": VERSION,
    },
    template = "rpmpopt.in",
)

pkg_files(
    name = "hdr_files",
    srcs = glob(["include/rpm/*.h"]),
    prefix = "embedded/include/rpm",
)

pkg_files(
    name = "misc_files",
    srcs = [
        ":gen_rpmpopt",
        ":gen_rpmrc",
    ],
    prefix = "embedded/lib/rpm",
)

dd_cc_packaged(
    name = "rpmio_pkg",
    dest_dir = "embedded/lib",
    input = ":rpmio",
    version = "10.2.1",
    visibility = ["//visibility:public"],
)

dd_cc_packaged(
    name = "rpm_pkg",
    data = [
        ":hdr_files",
        ":misc_files",
    ],
    dest_dir = "embedded/lib",
    input = ":rpm",
    version = "10.2.1",
    visibility = ["//visibility:public"],
)

pkg_filegroup(
    name = "all_files",
    srcs = [
        ":hdr_files",
        ":misc_files",
    ],
    visibility = [
        "@@//deps/openscap:__pkg__",
        "@@//packages:__subpackages__",
    ],
)
