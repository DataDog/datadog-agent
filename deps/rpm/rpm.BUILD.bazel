load("@@//bazel/rules:dd_agent_expand_template.bzl", "dd_agent_expand_template")
load("@@//bazel/rules/dd_packaging:dd_cc_packaged.bzl", "dd_cc_packaged")
load("@@//compliance/rules:purl.bzl", "purl_for_generic")
load("@bazel_skylib//rules:copy_file.bzl", "copy_file")
load("@package_metadata//rules:package_metadata.bzl", "package_metadata")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_filegroup", "pkg_files")

package(default_package_metadata = [":package_metadata"])

VERSION = "4.18.1"

package_metadata(
    name = "package_metadata",
    attributes = [
        ":license",
    ],
    purl = purl_for_generic(
        download_url = "https://github.com/rpm-software-management/rpm/archive/refs/tags/rpm-{version}-release.tar.gz",
        package = "rpm",
        version = VERSION,
    ),
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:LGPL-2.0"],
    license_text = "COPYING",
    visibility = ["//visibility:public"],
)

copy_file(
    name = "copy_config_h",
    src = select({
        "@//:linux_x86_64": "config-linux-x86_64.h",
        "@//:linux_arm64": "config-linux-arm64.h",
    }),
    out = "config.h",
    target_compatible_with = ["@platforms//os:linux"],
)

cc_library(
    name = "config_h",
    hdrs = [
        ":copy_config_h",
    ],
)

FAKE_PREFIX = "/opt/datadog-agent/embedded"

COMMON_DEFINES = [
    "HAVE_CONFIG_H",
    'LOCALSTATEDIR=\\"/var\\"',
]

PUBLIC_HEADERS = glob(["include/rpm/*.h"])

COMMON_HEADERS = [
    "system.h",
    "debug.h",
] + PUBLIC_HEADERS

cc_library(
    name = "misc",
    srcs = [
        "misc/fnmatch.c",
        "misc/fnmatch.h",
        "misc/fts.c",
        "misc/rpmfts.h",
    ] + COMMON_HEADERS,
    implementation_deps = [
        ":config_h",
    ],
    includes = ["include"],
    local_defines = COMMON_DEFINES,
)

cc_library(
    name = "librpmio",
    srcs = [
        "rpmio/argv.c",
        "rpmio/base64.c",
        "rpmio/digest.c",
        "rpmio/digest_openssl.c",
        "rpmio/expression.c",
        "rpmio/lposix.c",
        "rpmio/lposix.h",
        "rpmio/macro.c",
        "rpmio/rgetopt.c",
        "rpmio/rpmfileutil.c",
        "rpmio/rpmglob.c",
        "rpmio/rpmhook.c",
        "rpmio/rpmhook.h",
        "rpmio/rpmio.c",
        "rpmio/rpmio_internal.h",
        "rpmio/rpmkeyring.c",
        "rpmio/rpmlog.c",
        "rpmio/rpmlua.c",
        "rpmio/rpmlua.h",
        "rpmio/rpmmacro_internal.h",
        "rpmio/rpmmalloc.c",
        "rpmio/rpmpgp.c",
        "rpmio/rpmpgp_internal.c",
        "rpmio/rpmpgp_internal.h",
        "rpmio/rpmpgpval.h",
        "rpmio/rpmsq.c",
        "rpmio/rpmstring.c",
        "rpmio/rpmstrpool.c",
        "rpmio/rpmsw.c",
        "rpmio/rpmver.c",
        "rpmio/rpmvercmp.c",
        "rpmio/url.c",
    ] + COMMON_HEADERS,
    implementation_deps = [
        ":config_h",
    ],
    includes = [
        ".",
        "include",
    ],
    local_defines = COMMON_DEFINES + [
        'RPMCONFIGDIR=\\"{}/lib/rpm\\"'.format(FAKE_PREFIX),
    ],
    textual_hdrs = [
        "rpmio/modemuncher.c",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":misc",
        "@bzip2//:libbz2",
        "@lua//:liblua",
        "@openssl",
        "@popt//:libpopt",
        "@xz//:liblzma",
        "@zlib",
        "@zstd//:libzstd",
    ],
)

cc_shared_library(
    name = "rpmio",
    dynamic_deps = [
        "@popt//:popt_pkg",
        "@zlib//:z_pkg",
        "@xz//:lzma_pkg",
        "@bzip2//:bz2_pkg",
        "@openssl//:openssl_shared",
    ],
    user_link_flags = select({
        "@platforms//os:linux": [
            "-Wl,-rpath=/opt/datadog-agent/embedded/lib",
        ],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
    deps = [":librpmio"],
)

genrule(
    name = "tagtbl_c",
    srcs = [
        "include/rpm/rpmtag.h",
    ],
    outs = ["lib/tagtbl.C"],
    cmd = "AWK=$(location @gawk) $(location lib/gentagtbl.sh) $(location include/rpm/rpmtag.h) > $@",
    tools = [
        "lib/gentagtbl.sh",
        "@gawk",
    ],
)

cc_library(
    name = "librpm",
    srcs = [
        "lib/backend/bdb_ro.c",
        "lib/backend/dbi.c",
        "lib/backend/dbi.h",
        "lib/backend/dbiset.c",
        "lib/backend/dbiset.h",
        "lib/backend/dummydb.c",
        "lib/backend/sqlite.c",
        "lib/cpio.c",
        "lib/cpio.h",
        "lib/depends.c",
        "lib/formats.c",
        "lib/fprint.c",
        "lib/fprint.h",
        "lib/fsm.c",
        "lib/fsm.h",
        "lib/header.c",
        "lib/header_internal.h",
        "lib/headerfmt.c",
        "lib/headerutil.c",
        "lib/manifest.c",
        "lib/manifest.h",
        "lib/misc.h",
        "lib/order.c",
        "lib/package.c",
        "lib/poptALL.c",
        "lib/poptI.c",
        "lib/poptQV.c",
        "lib/psm.c",
        "lib/query.c",
        "lib/relocation.c",
        "lib/rpmal.c",
        "lib/rpmal.h",
        "lib/rpmchecksig.c",
        "lib/rpmchroot.c",
        "lib/rpmchroot.h",
        "lib/rpmdb.c",
        "lib/rpmdb_internal.h",
        "lib/rpmds.c",
        "lib/rpmds_internal.h",
        "lib/rpmfi.c",
        "lib/rpmfi_internal.h",
        "lib/rpmfs.c",
        "lib/rpmfs.h",
        "lib/rpmgi.c",
        "lib/rpmgi.h",
        "lib/rpminstall.c",
        "lib/rpmlead.c",
        "lib/rpmlead.h",
        "lib/rpmlock.c",
        "lib/rpmlock.h",
        "lib/rpmplugin.h",
        "lib/rpmplugins.c",
        "lib/rpmplugins.h",
        "lib/rpmprob.c",
        "lib/rpmps.c",
        "lib/rpmrc.c",
        "lib/rpmscript.c",
        "lib/rpmscript.h",
        "lib/rpmtd.c",
        "lib/rpmte.c",
        "lib/rpmte_internal.h",
        "lib/rpmtriggers.c",
        "lib/rpmtriggers.h",
        "lib/rpmts.c",
        "lib/rpmts_internal.h",
        "lib/rpmug.c",
        "lib/rpmug.h",
        "lib/rpmvs.c",
        "lib/rpmvs.h",
        "lib/signature.c",
        "lib/signature.h",
        "lib/tagexts.c",
        "lib/tagname.c",
        "lib/transaction.c",
        "lib/verify.c",
    ] + COMMON_HEADERS,
    hdrs = PUBLIC_HEADERS,
    implementation_deps = [
        ":config_h",
    ],
    includes = ["."],
    local_defines = COMMON_DEFINES + [
        'LIBRPMALIAS_FILENAME=\\"rpmopt-{}\\"'.format(VERSION),
        'LIBRPMALIAS_EXECPATH=\\"{}\\"'.format(FAKE_PREFIX),
        'SYSCONFDIR=\\"{}/etc\\"'.format(FAKE_PREFIX),
    ],
    textual_hdrs = [
        "lib/rpmhash.H",
        "lib/rpmhash.C",
        ":tagtbl_c",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":librpmio",
        "@popt//:libpopt",
        "@sqlite3//:libsqlite3",
    ],
)

cc_shared_library(
    name = "rpm",
    dynamic_deps = [
        ":rpmio_pkg",
        "@sqlite3//:sqlite3_pkg",
        "@popt//:popt_pkg",
    ],
    visibility = ["//visibility:public"],
    deps = [":librpm"],
)

dd_agent_expand_template(
    name = "gen_rpmrc",
    out = "rpmrc",
    substitutions = {
        "@RPMCONFIGDIR@": "{install_dir}/lib/rpm/rpmrc",
    },
    template = "rpmrc.in",
)

dd_agent_expand_template(
    name = "gen_rpmpopt",
    out = "rpmpopt-{}".format(VERSION),
    substitutions = {
        "@RPMCONFIGDIR@": "{install_dir}/lib/rpm/rpmrc",
        "@VERSION@": VERSION,
    },
    template = "rpmpopt.in",
)

pkg_files(
    name = "hdr_files",
    srcs = PUBLIC_HEADERS,
    prefix = "embedded/include/rpm",
)

pkg_files(
    name = "misc_files",
    srcs = [
        ":gen_rpmpopt",
        ":gen_rpmrc",
    ],
    prefix = "embedded/lib/rpm",
)

dd_cc_packaged(
    name = "rpmio_pkg",
    dest_dir = "embedded/lib",
    input = ":rpmio",
    version = "9.4.0",
    visibility = ["//visibility:public"],
)

dd_cc_packaged(
    name = "rpm_pkg",
    dest_dir = "embedded/lib",
    input = ":rpm",
    installed_files = [
        ":hdr_files",
        ":misc_files",
    ],
    version = "9.4.0",
    visibility = ["//visibility:public"],
)

pkg_filegroup(
    name = "all_files",
    srcs = [
        ":hdr_files",
        ":misc_files",
    ],
    visibility = [
        "@@//deps/openscap:__pkg__",
        "@@//packages:__subpackages__",
    ],
)
