 #endif
 
 #if !HAVE_STRLCAT && !defined(strlcat)
+#define strlcat yr_strlcat
+#define YR_STRLCAT_FALLBACK 1
 size_t strlcat(char* dst, const char* src, size_t size);
 #endif
 
