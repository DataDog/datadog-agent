load("@@//bazel/rules/dd_packaging:dd_cc_packaged.bzl", "dd_cc_packaged")
load("@@//compliance/rules:purl.bzl", "purl_for_generic")
load("@@//compliance/rules:ship_source_offer.bzl", "ship_source_offer")
load("@bazel_skylib//rules:copy_file.bzl", "copy_file")
load("@package_metadata//rules:package_metadata.bzl", "package_metadata")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_pkg//pkg:mappings.bzl", "pkg_filegroup", "pkg_files")

package(default_package_metadata = [
    ":package_metadata",
    ":ship_source_offer",
])

_VERSION = "2.5.1"

package_metadata(
    name = "package_metadata",
    attributes = [
        ":license",
        ":ship_source_offer",
    ],
    purl = purl_for_generic(
        download_url = "https://download.savannah.nongnu.org/releases/attr/attr-{version}.tar.xz",
        package = "attr",
        version = _VERSION,
    ),
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:LGPL-2.1"],
    license_text = "doc/COPYING.LGPL",
    visibility = ["//visibility:public"],
)

ship_source_offer(name = "ship_source_offer")

copy_file(
    name = "copy_config_h",
    src = select({
        "@@//:linux_x86_64": "config-linux-x86_64.h",
        "@@//:linux_arm64": "config-linux-arm64.h",
    }),
    out = "config.h",
    target_compatible_with = ["@platforms//os:linux"],
)

cc_library(
    name = "config_h",
    hdrs = [
        ":copy_config_h",
    ],
)

_PUBLIC_HEADERS = [
    "include/libattr.h",
    "include/attributes.h",
    "include/error_context.h",
]

cc_library(
    name = "libattr",
    srcs = [
        "include/nls.h",
        "libattr/attr_copy_action.c",
        "libattr/attr_copy_check.c",
        "libattr/attr_copy_fd.c",
        "libattr/attr_copy_file.c",
        "libattr/libattr.c",
        "libattr/libattr.h",
        "libattr/syscalls.c",
    ],
    hdrs = _PUBLIC_HEADERS,
    copts = [
        "-include $(execpath libattr/libattr.h)",
        "-O2",
    ],
    implementation_deps = [
        ":config_h",
    ],
    include_prefix = "attr",
    includes = [
        "include",
    ],
    local_defines = [
        "HAVE_CONFIG_H",
        'SYSCONFDIR=\\"/opt/datadog-agent/embedded/etc\\"',
    ],
    strip_include_prefix = "include",
    visibility = ["//visibility:public"],
)

cc_shared_library(
    name = "attr",
    additional_linker_inputs = [
        "exports",
    ],
    user_link_flags = [
        "-Wl,--version-script=$(execpath exports)",
    ],
    visibility = ["//visibility:public"],
    deps = [":libattr"],
)

pkg_files(
    name = "hdr_files",
    srcs = _PUBLIC_HEADERS,
    prefix = "embedded/include/attr/",
)

dd_cc_packaged(
    name = "attr_pkg",
    dest_dir = "embedded/lib",
    input = ":attr",
    installed_files = [":hdr_files"],
    version = "1.1.2501",
    visibility = ["//visibility:public"],
)

pkg_filegroup(
    name = "all_files",
    srcs = [
        ":hdr_files",
    ],
    visibility = [
        "@@//deps/openscap:__pkg__",
        "@@//packages:__subpackages__",
    ],
)
