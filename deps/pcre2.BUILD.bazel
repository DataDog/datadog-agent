load("@@//bazel/rules/dd_packaging:dd_cc_packaged.bzl", "dd_cc_packaged")
load("@@//compliance/rules:purl.bzl", "purl_for_generic")
load("@bazel_skylib//rules:copy_file.bzl", "copy_file")
load("@bazel_skylib//rules:native_binary.bzl", "native_test")
load("@package_metadata//licenses/rules:license.bzl", "license")
load("@package_metadata//rules:package_metadata.bzl", "package_metadata")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library")
load("@rules_pkg//pkg:mappings.bzl", "pkg_filegroup", "pkg_files")

package(
    default_package_metadata = [":package_metadata"],
    default_visibility = [
        "@@//deps:__pkg__",
        "@@//packages:__subpackages__",
    ],
)

VERSION = "10.49"

package_metadata(
    name = "package_metadata",
    attributes = [
        ":license",
    ],
    purl = purl_for_generic(
        download_url = "https://github.com/PCRE2Project/pcre2/releases/download/pcre2-{version}/pcre2-{version}.tar.bz2",
        package = "pcre2",
        version = VERSION,
    ),
)

license(
    name = "license",
    kind = "@rules_license//licenses/spdx:BSD-3-Clause",
    text = "LICENCE.md",
    visibility = ["//visibility:public"],
)

copy_file(
    name = "config_h_generic",
    src = "src/config.h.generic",
    out = "src/config.h",
)

copy_file(
    name = "pcre2_h_generic",
    src = "src/pcre2.h.generic",
    out = "src/pcre2.h",
)

copy_file(
    name = "pcre2_chartables_c",
    src = "src/pcre2_chartables.c.dist",
    out = "src/pcre2_chartables.c",
)

# Removed src/pcre2_ucptables.c below because it is #included in
# src/pcre2_tables.c. Also fixed typo: ckdint should be chkdint.
# PH, 22-March-2023.
cc_library(
    name = "libpcre2",
    srcs = [
        "src/pcre2_auto_possess.c",
        "src/pcre2_chkdint.c",
        "src/pcre2_compile.c",
        "src/pcre2_compile.h",
        "src/pcre2_compile_cgroup.c",
        "src/pcre2_compile_class.c",
        "src/pcre2_config.c",
        "src/pcre2_context.c",
        "src/pcre2_convert.c",
        "src/pcre2_dfa_match.c",
        "src/pcre2_error.c",
        "src/pcre2_extuni.c",
        "src/pcre2_find_bracket.c",
        "src/pcre2_internal.h",
        "src/pcre2_intmodedep.h",
        "src/pcre2_jit_compile.c",
        "src/pcre2_maketables.c",
        "src/pcre2_match.c",
        "src/pcre2_match_data.c",
        "src/pcre2_match_next.c",
        "src/pcre2_newline.c",
        "src/pcre2_ord2utf.c",
        "src/pcre2_pattern_info.c",
        "src/pcre2_script_run.c",
        "src/pcre2_serialize.c",
        "src/pcre2_string_utils.c",
        "src/pcre2_study.c",
        "src/pcre2_substitute.c",
        "src/pcre2_substring.c",
        "src/pcre2_tables.c",
        "src/pcre2_ucd.c",
        "src/pcre2_ucp.h",
        "src/pcre2_util.h",
        "src/pcre2_valid_utf.c",
        "src/pcre2_xclass.c",
        ":config_h_generic",
        ":pcre2_chartables_c",
    ],
    hdrs = [
        ":pcre2_h_generic",
    ],
    includes = ["src"],
    local_defines = [
        "HAVE_CONFIG_H",
        "PCRE2_CODE_UNIT_WIDTH=8",
        "PCRE2_STATIC",
        "SUPPORT_UNICODE",
    ],
    strip_include_prefix = "src",
    textual_hdrs = [
        "src/pcre2_jit_char_inc.h",
        "src/pcre2_jit_match_inc.h",
        "src/pcre2_jit_misc_inc.h",
        "src/pcre2_jit_simd_inc.h",
        "src/pcre2_printint_inc.h",
        "src/pcre2_ucptables_inc.h",
    ],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "libpcre2-posix",
    srcs = [
        "src/pcre2_internal.h",
        "src/pcre2_intmodedep.h",
        "src/pcre2_ucp.h",
        "src/pcre2_util.h",
        "src/pcre2posix.c",
        ":config_h_generic",
    ],
    hdrs = [
        "src/pcre2posix.h",
    ],
    includes = ["src"],
    local_defines = [
        "HAVE_CONFIG_H",
        "PCRE2_CODE_UNIT_WIDTH=8",
        "PCRE2_STATIC",
        "SUPPORT_UNICODE",
    ],
    strip_include_prefix = "src",
    textual_hdrs = [
        "src/pcre2_tables.c",
        "src/pcre2_ucptables_inc.h",
    ],
    visibility = ["//visibility:public"],
    deps = [":libpcre2"],
)

# Totally weird issue in Bazel. It won't let you #include any files unless they
# are declared to the build system. OK, fair enough. But - for a cc_binary it
# uses the file extension to determine whether it's a header or a compilation
# unit. But... we have several .c files which are #included, rather than treated
# as a compilation unit.
#
# For cc_library() above, we can overcome this with textual_hdrs. But that
# doesn't work for cc_binary(). Here's our workaround.
#
# https://github.com/bazelbuild/bazel/issues/680
cc_library(
    name = "pcre2test_dotc_headers",
    hdrs = [
        "src/pcre2_chkdint.c",
        "src/pcre2_tables.c",
        "src/pcre2_ucd.c",
        "src/pcre2_valid_utf.c",
    ],
    strip_include_prefix = "src",
    visibility = ["//visibility:private"],
)

cc_binary(
    name = "pcre2test",
    srcs = [
        "src/pcre2_printint_inc.h",
        "src/pcre2test.c",
        "src/pcre2test_inc.h",
        ":config_h_generic",
    ],
    dynamic_deps = [
        ":pcre2-8_pkg",
        ":pcre2-posix_pkg",
    ],
    linkopts = select({
        "@platforms//os:windows": ["-STACK:2500000"],
        "//conditions:default": [],
    }),
    local_defines = [
        "HAVE_CONFIG_H",
        "PCRE2_STATIC",
        "SUPPORT_UNICODE",
        "SUPPORT_PCRE2_8",
    ] + select({
        "@platforms//os:linux": [
            "HAVE_SETRLIMIT",
            "HAVE_UNISTD_H",
        ],
        "@platforms//os:windows": [],
        "//conditions:default": ["HAVE_UNISTD_H"],
    }),
    visibility = ["//visibility:public"],
    deps = [
        ":libpcre2",
        ":libpcre2-posix",
        ":pcre2test_dotc_headers",
    ],
)

filegroup(
    name = "testdata",
    srcs = glob(["testdata/*"]),
)

native_test(
    name = "pcre2_test",
    size = "small",
    src = select({
        "@platforms//os:windows": "RunTest.bat",
        "//conditions:default": "RunTest",
    }),
    out = select({
        "@platforms//os:windows": "RunTest.bat",
        "//conditions:default": "RunTest",
    }),
    data = [
        ":pcre2test",
        ":testdata",
    ],
)

cc_shared_library(
    name = "pcre2-8",
    visibility = ["//visibility:public"],
    deps = [":libpcre2"],
)

cc_shared_library(
    name = "pcre2-posix",
    dynamic_deps = [":pcre2-8_pkg"],
    visibility = ["//visibility:public"],
    deps = [":libpcre2-posix"],
)

pkg_files(
    name = "headers",
    srcs = [
        ":pcre2_h_generic",
        ":src/pcre2posix.h",
    ],
    prefix = "embedded/include",
)

dd_cc_packaged(
    name = "pcre2-8_pkg",
    dest_dir = "embedded/lib",
    input = ":pcre2-8",
    installed_files = [":headers"],
    version = "0.16.1",
    visibility = ["//visibility:public"],
)

dd_cc_packaged(
    name = "pcre2-posix_pkg",
    dest_dir = "embedded/lib",
    input = ":pcre2-posix",
    version = "3.0.9",
    visibility = ["//visibility:public"],
)

pkg_filegroup(
    name = "all_files",
    srcs = [
        ":headers",
    ],
    visibility = [
        "@@//deps/openscap:__pkg__",
        "@@//packages:__subpackages__",
    ],
)
