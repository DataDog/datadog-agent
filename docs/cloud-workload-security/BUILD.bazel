load("@bazel_lib//lib:run_binary.bzl", "run_binary")
load("@bazel_lib//lib:write_source_files.bzl", "write_source_file", "write_source_files")

package(default_visibility = ["//visibility:private"])

# These JSON files are co-generated by //pkg/security/generators/accessors when
# producing accessors_<platform>.go (see //pkg/security/secl/model:BUILD.bazel
# `accessors(...)` calls). The diff_test produced by write_source_file checks
# that the checked-in JSON matches what the Bazel action produces.
[
    write_source_file(
        name = "secl_{}".format(variant),
        in_file = "//pkg/security/secl/model:accessors_{}/secl_{}.json".format(
            "unix" if variant == "linux" else "windows",
            variant,
        ),
        out_file = "secl_{}.json".format(variant),
    )
    for variant in [
        "linux",
        "windows",
    ]
]

# Generates workload_protection_agent_config.schema.json from pkg/security/config/config.go.
run_binary(
    name = "workload_protection_agent_config_schema_gen",
    srcs = ["//pkg/security/config:config_doc_input"],
    outs = ["workload_protection_agent_config_schema_gen/workload_protection_agent_config.schema.json"],
    args = [
        "-input=pkg/security/config/config.go",
        "-output=$(execpath workload_protection_agent_config_schema_gen/workload_protection_agent_config.schema.json)",
    ],
    tool = "//pkg/security/generators/config_doc",
)

write_source_file(
    name = "workload_protection_agent_config_schema",
    in_file = ":workload_protection_agent_config_schema_gen",
    out_file = "workload_protection_agent_config.schema.json",
)

# backend_<os>.schema.json is produced by reflecting over the serializer types
# compiled into the generator, so each variant needs a generator built for that
# platform and therefore only builds on its own OS.
run_binary(
    name = "backend_linux_schema_gen",
    srcs = ["//pkg/security/serializers:serializers_sources"],
    outs = ["backend_linux_schema_gen/backend_linux.schema.json"],
    args = [
        "-serializers-dir=pkg/security/serializers",
        "-output=$(execpath backend_linux_schema_gen/backend_linux.schema.json)",
    ],
    target_compatible_with = ["@platforms//os:linux"],
    tool = "//pkg/security/generators/backend_doc",
)

# The Windows variant is the same generator, but it additionally honours
# --//:wine=true: instead of requiring a Windows host, it runs a generator
# cross-compiled for Windows under Wine, which lets the schema be refreshed from
# a Linux or macOS machine. Off by default because it needs `wine` on the host
# and the resulting action is not hermetic.
run_binary(
    name = "backend_windows_schema_gen",
    srcs = ["//pkg/security/serializers:serializers_sources"] + select({
        "//:is_wine": ["//pkg/security/generators/backend_doc:backend_doc_windows"],
        "//conditions:default": [],
    }),
    outs = ["backend_windows_schema_gen/backend_windows.schema.json"],
    # Under Wine the generator is passed to the wrapper as its first argument;
    # natively it *is* the tool, so it takes only the generator's own flags.
    args = select({
        "//:is_wine": ["$(execpath //pkg/security/generators/backend_doc:backend_doc_windows)"],
        "//conditions:default": [],
    }) + [
        "-serializers-dir=pkg/security/serializers",
        "-output=$(execpath backend_windows_schema_gen/backend_windows.schema.json)",
    ],
    target_compatible_with = select({
        "//:is_wine": [],
        "//conditions:default": ["@platforms//os:windows"],
    }),
    tool = select({
        "//:is_wine": "//bazel/tools/wine:wine_run",
        "//conditions:default": "//pkg/security/generators/backend_doc",
    }),
)

[
    write_source_file(
        name = "backend_{}_schema".format(os),
        in_file = ":backend_{}_schema_gen".format(os),
        out_file = "backend_{}.schema.json".format(os),
    )
    for os in [
        "linux",
        "windows",
    ]
]

# Markdown doc generation: renders Jinja2 templates using the committed JSON
# schemas as inputs. Platform-neutral — reads committed source files so it runs
# on any OS without needing the Linux-only Go generator.
run_binary(
    name = "backend_linux_doc_gen",
    srcs = ["backend_linux.schema.json"],
    outs = ["backend_linux_doc_gen/backend_linux.md"],
    args = [
        "$(execpath backend_linux.schema.json)",
        "$(execpath backend_linux_doc_gen/backend_linux.md)",
        "backend_linux.md",
    ],
    target_compatible_with = select({
        "@platforms//os:windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    tool = "//tasks/libs/cws:backend_doc_gen",
)

run_binary(
    name = "backend_windows_doc_gen",
    srcs = ["backend_windows.schema.json"],
    outs = ["backend_windows_doc_gen/backend_windows.md"],
    args = [
        "$(execpath backend_windows.schema.json)",
        "$(execpath backend_windows_doc_gen/backend_windows.md)",
        "backend_windows.md",
    ],
    tool = "//tasks/libs/cws:backend_doc_gen",
)

run_binary(
    name = "secl_linux_doc_gen",
    srcs = ["secl_linux.json"],
    outs = ["secl_linux_doc_gen/linux_expressions.md"],
    args = [
        "$(execpath secl_linux.json)",
        "$(execpath secl_linux_doc_gen/linux_expressions.md)",
        "linux_expressions.md",
    ],
    target_compatible_with = select({
        "@platforms//os:windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    tool = "//tasks/libs/cws:secl_doc_gen",
)

run_binary(
    name = "secl_windows_doc_gen",
    srcs = ["secl_windows.json"],
    outs = ["secl_windows_doc_gen/windows_expressions.md"],
    args = [
        "$(execpath secl_windows.json)",
        "$(execpath secl_windows_doc_gen/windows_expressions.md)",
        "windows_expressions.md",
    ],
    tool = "//tasks/libs/cws:secl_doc_gen",
)

run_binary(
    name = "workload_protection_agent_config_doc_gen",
    srcs = ["workload_protection_agent_config.schema.json"],
    outs = ["workload_protection_agent_config_doc_gen/workload_protection_agent_config.md"],
    args = [
        "$(execpath workload_protection_agent_config.schema.json)",
        "$(execpath workload_protection_agent_config_doc_gen/workload_protection_agent_config.md)",
        "workload_protection_agent_config.md",
    ],
    tool = "//tasks/libs/cws:config_doc_gen",
)

# Umbrella target: updates all five CWS markdown docs in one shot using the
# committed JSON schemas as inputs. Platform-neutral — can run on any OS.
# The JSON schemas themselves are updated by backend_linux_schema (Linux-only),
# backend_windows_schema (Windows, or any host with --//:wine=true) and
# workload_protection_agent_config_schema, called from cws_go_generate.
write_source_files(
    name = "cws_docs",
    files = {
        "backend_linux.md": ":backend_linux_doc_gen/backend_linux.md",
        "backend_windows.md": ":backend_windows_doc_gen/backend_windows.md",
        "linux_expressions.md": ":secl_linux_doc_gen/linux_expressions.md",
        "windows_expressions.md": ":secl_windows_doc_gen/windows_expressions.md",
        "workload_protection_agent_config.md": ":workload_protection_agent_config_doc_gen/workload_protection_agent_config.md",
    },
    visibility = ["//visibility:public"],
)
