load("@bazel_lib//lib:diff_test.bzl", "diff_test")
load("@bazel_lib//lib:run_binary.bzl", "run_binary")
load("@bazel_lib//lib:write_source_files.bzl", "write_source_file", "write_source_files")

package(default_visibility = ["//visibility:private"])

# These JSON files are co-generated by //pkg/security/generators/accessors when
# producing accessors_<platform>.go (see //pkg/security/secl/model:BUILD.bazel
# `accessors(...)` calls). The diff_test produced by write_source_file checks
# that the checked-in JSON matches what the Bazel action produces.
[
    write_source_file(
        name = "secl_{}".format(variant),
        in_file = "//pkg/security/secl/model:accessors_{}/secl_{}.json".format(
            "unix" if variant == "linux" else "windows",
            variant,
        ),
        out_file = "secl_{}.json".format(variant),
        visibility = ["//pkg/security:__pkg__"],
    )
    for variant in [
        "linux",
        "windows",
    ]
]

# Generates workload_protection_agent_config.schema.json from pkg/security/config/config.go.
run_binary(
    name = "workload_protection_agent_config_schema_gen",
    srcs = ["//pkg/security/config:config_doc_input"],
    outs = ["workload_protection_agent_config_schema_gen/workload_protection_agent_config.schema.json"],
    args = [
        "-input=pkg/security/config/config.go",
        "-output=$(execpath workload_protection_agent_config_schema_gen/workload_protection_agent_config.schema.json)",
    ],
    tool = "//pkg/security/generators/config_doc",
)

write_source_file(
    name = "workload_protection_agent_config_schema",
    in_file = ":workload_protection_agent_config_schema_gen",
    out_file = "workload_protection_agent_config.schema.json",
    visibility = ["//pkg/security:__pkg__"],
)

# backend_linux.schema.json reflects serializer types compiled into a Linux
# generator, so it only builds on Linux.
run_binary(
    name = "backend_linux_schema_gen",
    srcs = ["//pkg/security/serializers:serializers_go_files"],
    outs = ["backend_linux_schema_gen/backend_linux.schema.json"],
    args = [
        "-serializers-dir=pkg/security/serializers",
        "-output=$(execpath backend_linux_schema_gen/backend_linux.schema.json)",
    ],
    target_compatible_with = ["@platforms//os:linux"],
    tool = "//pkg/security/generators/backend_doc",
)

# Native Windows. The generator is the tool and takes only its own flags.
run_binary(
    name = "backend_windows_schema_gen_native",
    srcs = ["//pkg/security/serializers:serializers_go_files"],
    outs = ["backend_windows_schema_gen_native/backend_windows.schema.json"],
    args = [
        "-serializers-dir=pkg/security/serializers",
        "-output=$(execpath backend_windows_schema_gen_native/backend_windows.schema.json)",
    ],
    target_compatible_with = ["@platforms//os:windows"],
    tool = "//pkg/security/generators/backend_doc",
)

# Linux hosts run the Windows cross-build under Wine. wine_run passes the
# generator as its first argument, and is incompatible off Linux x86_64/aarch64.
# Manual: Wine is for local regeneration only (flaky under box64 on CI);
# backend_windows_schema_test covers CI on Windows.
run_binary(
    name = "backend_windows_schema_gen_wine",
    srcs = [
        "//pkg/security/generators/backend_doc:backend_doc_windows",
        "//pkg/security/serializers:serializers_go_files",
    ],
    outs = ["backend_windows_schema_gen_wine/backend_windows.schema.json"],
    args = [
        "$(execpath //pkg/security/generators/backend_doc:backend_doc_windows)",
        "-serializers-dir=pkg/security/serializers",
        "-output=$(execpath backend_windows_schema_gen_wine/backend_windows.schema.json)",
    ],
    tags = ["manual"],
    tool = "//bazel/tools/wine:wine_run",
)

alias(
    name = "backend_windows_schema_gen",
    actual = select({
        "@platforms//os:windows": ":backend_windows_schema_gen_native",
        "//conditions:default": ":backend_windows_schema_gen_wine",
    }),
    tags = ["manual"],
)

write_source_file(
    name = "backend_linux_schema",
    in_file = ":backend_linux_schema_gen",
    out_file = "backend_linux.schema.json",
    visibility = ["//pkg/security:__pkg__"],
)

write_source_file(
    name = "backend_windows_schema",
    diff_test = False,
    in_file = ":backend_windows_schema_gen",
    out_file = "backend_windows.schema.json",
    tags = ["manual"],
    visibility = ["//pkg/security:__pkg__"],
)

diff_test(
    name = "backend_windows_schema_test",
    failure_message = "Run: bazel run //docs/cloud-workload-security:backend_windows_schema",
    file1 = ":backend_windows_schema_gen_native",
    file2 = "backend_windows.schema.json",
)

# The markdown docs render from the fresh schema where the generator can
# run, and fall back to the committed one elsewhere so they still build.
[
    alias(
        name = "backend_{}_schema_input".format(os),
        actual = select({
            "@platforms//os:" + os: ":backend_{}_schema_gen".format(os),
            "//conditions:default": "backend_{}.schema.json".format(os),
        }),
    )
    for os in [
        "linux",
        "windows",
    ]
]

# Markdown doc generation: renders Jinja2 templates from the generator outputs
# rather than the committed JSON, so a single //pkg/security:cws_codegen run
# refreshes the schemas and their docs together.
run_binary(
    name = "backend_linux_doc_gen",
    srcs = [":backend_linux_schema_input"],
    outs = ["backend_linux_doc_gen/backend_linux.md"],
    args = [
        "$(execpath :backend_linux_schema_input)",
        "$(execpath backend_linux_doc_gen/backend_linux.md)",
        "backend_linux.md",
    ],
    target_compatible_with = select({
        "@platforms//os:windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    tool = "//tasks/libs/cws:backend_doc_gen",
)

run_binary(
    name = "backend_windows_doc_gen",
    srcs = [":backend_windows_schema_input"],
    outs = ["backend_windows_doc_gen/backend_windows.md"],
    args = [
        "$(execpath :backend_windows_schema_input)",
        "$(execpath backend_windows_doc_gen/backend_windows.md)",
        "backend_windows.md",
    ],
    tool = "//tasks/libs/cws:backend_doc_gen",
)

run_binary(
    name = "secl_linux_doc_gen",
    srcs = ["//pkg/security/secl/model:accessors_unix/secl_linux.json"],
    outs = ["secl_linux_doc_gen/linux_expressions.md"],
    args = [
        "$(execpath //pkg/security/secl/model:accessors_unix/secl_linux.json)",
        "$(execpath secl_linux_doc_gen/linux_expressions.md)",
        "linux_expressions.md",
    ],
    target_compatible_with = select({
        "@platforms//os:windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    tool = "//tasks/libs/cws:secl_doc_gen",
)

run_binary(
    name = "secl_windows_doc_gen",
    srcs = ["//pkg/security/secl/model:accessors_windows/secl_windows.json"],
    outs = ["secl_windows_doc_gen/windows_expressions.md"],
    args = [
        "$(execpath //pkg/security/secl/model:accessors_windows/secl_windows.json)",
        "$(execpath secl_windows_doc_gen/windows_expressions.md)",
        "windows_expressions.md",
    ],
    tool = "//tasks/libs/cws:secl_doc_gen",
)

run_binary(
    name = "workload_protection_agent_config_doc_gen",
    srcs = [":workload_protection_agent_config_schema_gen"],
    outs = ["workload_protection_agent_config_doc_gen/workload_protection_agent_config.md"],
    args = [
        "$(execpath :workload_protection_agent_config_schema_gen)",
        "$(execpath workload_protection_agent_config_doc_gen/workload_protection_agent_config.md)",
        "workload_protection_agent_config.md",
    ],
    tool = "//tasks/libs/cws:config_doc_gen",
)

# Umbrella target for the five CWS markdown docs. Part of
# //pkg/security:cws_codegen, which also refreshes the JSON schemas.
write_source_files(
    name = "cws_docs",
    files = {
        "backend_linux.md": ":backend_linux_doc_gen/backend_linux.md",
        "backend_windows.md": ":backend_windows_doc_gen/backend_windows.md",
        "linux_expressions.md": ":secl_linux_doc_gen/linux_expressions.md",
        "windows_expressions.md": ":secl_windows_doc_gen/windows_expressions.md",
        "workload_protection_agent_config.md": ":workload_protection_agent_config_doc_gen/workload_protection_agent_config.md",
    },
    visibility = ["//visibility:public"],
)
