load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "instrumentation",
    srcs = ["bundle.go"],
    importpath = "github.com/DataDog/datadog-agent/comp/instrumentation",
    visibility = ["//visibility:public"],
    deps = [
        "//comp/core/autodiscovery/common/types",
        "//comp/instrumentation/apm/def",
        "//comp/instrumentation/apm/fx",
        "//comp/instrumentation/checks/def",
        "//comp/instrumentation/checks/fx",
        "//comp/instrumentation/common",
        "//comp/instrumentation/controller/fx",
        "//comp/instrumentation/logs/def",
        "//comp/instrumentation/logs/fx",
        "//pkg/clusteragent/instrumentation",
        "//pkg/util/fxutil",
        "@org_uber_go_fx//:fx",
    ],
)

dd_agent_go_test(
    name = "instrumentation_test",
    srcs = ["bundle_test.go"],
    embed = [":instrumentation"],
    gotags_sets = [[
        "cel",
        "clusterchecks",
        "kubeapiserver",
        "kubelet",
    ]],
    include_default = False,
    deps = [
        "//comp/core/autodiscovery/common/types",
        "//comp/core/telemetry/mock",
        "//comp/instrumentation/apm/def",
        "//comp/instrumentation/checks/def",
        "//comp/instrumentation/common",
        "//comp/instrumentation/controller/def",
        "//comp/instrumentation/logs/def",
        "//pkg/clusteragent/instrumentation",
        "//pkg/ssi",
        "//pkg/util/fxutil",
        "@com_github_datadog_datadog_operator_api//datadoghq/v1alpha1",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
        "@io_k8s_api//autoscaling/v2:autoscaling",
        "@io_k8s_apimachinery//pkg/apis/meta/v1:meta",
        "@io_k8s_apimachinery//pkg/apis/meta/v1/unstructured",
        "@io_k8s_apimachinery//pkg/runtime",
        "@io_k8s_apimachinery//pkg/runtime/schema",
        "@io_k8s_client_go//dynamic/dynamicinformer",
        "@io_k8s_client_go//dynamic/fake",
        "@org_uber_go_fx//:fx",
    ],
)
