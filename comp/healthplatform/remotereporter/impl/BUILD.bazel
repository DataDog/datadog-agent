load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "impl",
    srcs = ["remotereporter.go"],
    importpath = "github.com/DataDog/datadog-agent/comp/healthplatform/remotereporter/impl",
    visibility = ["//visibility:public"],
    deps = [
        "//comp/core/config",
        "//comp/core/ipc/def",
        "//comp/core/log/def",
        "//comp/core/remoteagent/helper",
        "//comp/def",
        "//comp/healthplatform/remotereporter/def",
        "//pkg/proto/pbgo/core",
        "@com_github_datadog_agent_payload_v5//healthplatform",
        "@org_golang_google_protobuf//proto",
    ],
)

dd_agent_go_test(
    name = "impl_test",
    srcs = [
        "component_test.go",
        "remotereporter_test.go",
    ],
    embed = [":impl"],
    deps = [
        "//comp/core/config",
        "//comp/core/ipc/mock",
        "//comp/core/log/mock",
        "//comp/def",
        "//pkg/proto/pbgo/core",
        "//pkg/proto/pbgo/mocks/core",
        "//pkg/util/grpc",
        "@com_github_datadog_agent_payload_v5//healthplatform",
        "@com_github_grpc_ecosystem_go_grpc_middleware_v2//interceptors/auth",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//credentials",
        "@org_golang_google_protobuf//types/known/emptypb",
        "@org_uber_go_mock//gomock",
    ],
)
