load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "impl",
    srcs = ["remote.go"],
    importpath = "github.com/DataDog/datadog-agent/comp/healthplatform/store/remote/impl",
    visibility = ["//visibility:public"],
    deps = [
        "//comp/core/config",
        "//comp/core/log/def",
        "//comp/core/workloadmeta/def",
        "//comp/healthplatform/issueregistry/utils/selfident",
        "//comp/healthplatform/store/remote/def",
        "//pkg/config/helper",
        "//pkg/config/utils",
        "//pkg/util/flavor",
        "//pkg/util/http",
        "//pkg/version",
    ],
)

dd_agent_go_test(
    name = "impl_test",
    srcs = ["remote_test.go"],
    embed = [":impl"],
    deps = [
        "//comp/core/config",
        "//comp/core/log/mock",
        "//pkg/util/flavor",
        "//pkg/version",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
