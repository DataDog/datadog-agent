load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "secretresolution",
    srcs = [
        "issue.go",
        "reporter.go",
    ],
    importpath = "github.com/DataDog/datadog-agent/comp/healthplatform/issues/secretresolution",
    visibility = ["//visibility:public"],
    deps = [
        "//comp/core/config",
        "//comp/core/hostname/hostnameinterface/def",
        "//comp/core/log/def",
        "//comp/core/secrets/def",
        "//comp/healthplatform/store/def",
        "//pkg/util/scrubber",
        "@com_github_datadog_agent_payload_v5//healthplatform",
        "@com_github_qri_io_jsonpointer//:jsonpointer",
        "@org_golang_google_protobuf//types/known/structpb",
        "@org_uber_go_fx//:fx",
    ],
)

dd_agent_go_test(
    name = "secretresolution_test",
    srcs = ["issue_test.go"],
    embed = [":secretresolution"],
    deps = [
        "//comp/core/secrets/def",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
