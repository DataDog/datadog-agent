dd_agent_go_test(
    name = "impl_test",
    srcs = [
        "client_http_test.go",
        "intakerouting_test.go",
        "path_test.go",
        "validate_test.go",
    ],
    embed = [":impl"],
    deps = [
        "//comp/core/config",
        "//comp/core/log/mock",
        "//comp/core/telemetry/def",
        "//comp/core/telemetry/mock",
        "//comp/def",
        "//comp/intakerouting/def",
        "//pkg/util/http",
        "@com_github_benbjohnson_clock//:clock",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
