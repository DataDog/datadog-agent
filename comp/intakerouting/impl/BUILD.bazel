load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "impl",
    srcs = [
        "client.go",
        "client_http.go",
        "intakerouting.go",
        "path.go",
        "scheduler.go",
        "telemetry.go",
        "validate.go",
    ],
    importpath = "github.com/DataDog/datadog-agent/comp/intakerouting/impl",
    visibility = ["//visibility:public"],
    deps = [
        "//comp/core/config",
        "//comp/core/log/def",
        "//comp/core/telemetry/def",
        "//comp/def",
        "//comp/intakerouting/def",
        "//pkg/config/utils",
        "//pkg/util/http",
        "//pkg/version",
        "@com_github_benbjohnson_clock//:clock",
        "@com_github_cenkalti_backoff_v7//:backoff",
    ],
