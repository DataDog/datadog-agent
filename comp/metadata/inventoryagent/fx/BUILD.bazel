load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "fx",
    srcs = ["fx.go"],
    importpath = "github.com/DataDog/datadog-agent/comp/metadata/inventoryagent/fx",
    visibility = ["//visibility:public"],
    deps = [
        "//comp/metadata/inventoryagent/impl",
        "//pkg/util/fxutil",
    ],
)

dd_agent_go_test(
    name = "fx_test",
    srcs = ["fx_test.go"],
    embed = [":fx"],
    deps = [
        "//comp/core/config",
        "//comp/core/hostname/hostnameimpl",
        "//comp/core/ipc/def",
        "//comp/core/ipc/mock",
        "//comp/core/log/def",
        "//comp/core/log/mock",
        "//comp/core/sysprobeconfig/def",
        "//comp/core/sysprobeconfig/mock",
        "//pkg/remoteflags",
        "//pkg/serializer",
        "//pkg/serializer/mocks",
        "//pkg/util/fxutil",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
        "@org_uber_go_fx//:fx",
    ],
)
