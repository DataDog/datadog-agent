load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "impl",
    srcs = [
        "endpoint.go",
        "replace_file_unix.go",
        "replace_file_windows.go",
    ],
    importpath = "github.com/DataDog/datadog-agent/comp/aggregator/demultiplexerendpoint/impl",
    visibility = ["//visibility:public"],
    deps = [
        "//comp/aggregator/demultiplexer/def",
        "//comp/api/api/def",
        "//comp/core/config",
        "//comp/core/log/def",
        "//comp/dogstatsd/config",
        "//pkg/util/http",
        "@com_github_datadog_zstd//:zstd",
        "@org_golang_x_sync//singleflight",
    ] + select({
        "@rules_go//go/platform:windows": [
            "@org_golang_x_sys//windows",
        ],
        "//conditions:default": [],
    }),
)

dd_agent_go_test(
    name = "impl_test",
    srcs = [
        "dump_endpoint_test.go",
        "endpoint_test.go",
        "replace_file_windows_test.go",
    ],
    embed = [":impl"],
    deps = [
        "@com_github_datadog_zstd//:zstd",
        "@com_github_stretchr_testify//require",
    ] + select({
        "@rules_go//go/platform:windows": [
            "//pkg/util/filesystem",
        ],
        "//conditions:default": [],
    }),
)
