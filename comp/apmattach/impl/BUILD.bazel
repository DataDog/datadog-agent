load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "impl",
    srcs = [
        "apmattach.go",
        "apmattach_linux.go",
        "apmattach_nolinux.go",
        "helper_linux.go",
        "policy_linux.go",
        "scan_linux.go",
        "status_linux.go",
    ],
    embedsrcs = select({
        "@rules_go//go/platform:android": [
            "status_templates/apmattach.tmpl",
            "status_templates/apmattachHTML.tmpl",
        ],
        "@rules_go//go/platform:linux": [
            "status_templates/apmattach.tmpl",
            "status_templates/apmattachHTML.tmpl",
        ],
        "//conditions:default": [],
    }),
    importpath = "github.com/DataDog/datadog-agent/comp/apmattach/impl",
    visibility = ["//visibility:public"],
    deps = [
        "//comp/apmattach/def",
        "//comp/core/config",
        "//comp/core/log/def",
        "//comp/core/status",
        "//comp/def",
    ] + select({
        "@rules_go//go/platform:android": [
            "//pkg/util/kernel",
        ],
        "@rules_go//go/platform:linux": [
            "//pkg/util/kernel",
        ],
        "//conditions:default": [],
    }),
)

dd_agent_go_test(
    name = "impl_test",
    srcs = [
        "apmattach_linux_test.go",
        "helper_linux_test.go",
        "scan_linux_test.go",
    ],
    embed = [":impl"],
    deps = select({
        "@rules_go//go/platform:android": [
            "//comp/core/config",
            "//comp/core/log/mock",
            "//comp/def",
            "@com_github_stretchr_testify//assert",
            "@com_github_stretchr_testify//require",
        ],
        "@rules_go//go/platform:linux": [
            "//comp/core/config",
            "//comp/core/log/mock",
            "//comp/def",
            "@com_github_stretchr_testify//assert",
            "@com_github_stretchr_testify//require",
        ],
        "//conditions:default": [],
    }),
)
