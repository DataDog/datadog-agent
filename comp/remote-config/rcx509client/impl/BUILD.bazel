dd_agent_go_test(
    name = "impl_test",
    srcs = ["rcx509client_test.go"],
    embed = [":impl"],
    deps = [
        "//comp/core/config",
        "//comp/core/log/mock",
        "//comp/def",
        "//comp/remote-config/rcx509client/def",
        "//pkg/version",
        "@com_github_stretchr_testify//require",
        "@libdd_rc_source//:remote_config_go_proto",
