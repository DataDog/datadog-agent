load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "impl-systemprobe",
    srcs = [
        "flare_linux.go",
        "flare_other.go",
        "remoteagent.go",
    ],
    importpath = "github.com/DataDog/datadog-agent/comp/core/remoteagent/impl-systemprobe",
    visibility = ["//visibility:public"],
    deps = [
        "//comp/core/config",
        "//comp/core/ipc/def",
        "//comp/core/log/def",
        "//comp/core/remoteagent/def",
        "//comp/core/remoteagent/helper",
        "//comp/core/sysprobeconfig/def",
        "//comp/core/telemetry/def",
        "//comp/def",
        "//comp/logs-library/metrics",
        "//pkg/compliance/statusregistry",
        "//pkg/proto/pbgo/core",
        "//pkg/security/flareregistry",
        "//pkg/status/systemprobe",
        "//pkg/system-probe/api/module",
        "//pkg/util/flavor",
    ] + select({
        "@rules_go//go/platform:android": [
            "@com_github_datadog_ebpf_manager//tracefs",
        ],
        "@rules_go//go/platform:linux": [
            "@com_github_datadog_ebpf_manager//tracefs",
        ],
        "//conditions:default": [],
    }),
)

dd_agent_go_test(
    name = "impl-systemprobe_test",
    srcs = ["remoteagent_test.go"],
    embed = [":impl-systemprobe"],
    deps = [
        "//pkg/compliance/statusregistry",
        "//pkg/proto/pbgo/core",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
