load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "discovery",
    srcs = ["discovery.go"],
    importpath = "github.com/DataDog/datadog-agent/comp/core/autodiscovery/providers/ndm/discovery",
    visibility = ["//visibility:public"],
    deps = [
        "//comp/core/log/def",
        "//comp/ndmdiscovery/def",
    ],
)

dd_agent_go_test(
    name = "discovery_test",
    srcs = ["discovery_test.go"],
    embed = [":discovery"],
    deps = [
        "//comp/core/log/mock",
        "//comp/ndmdiscovery/def",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
