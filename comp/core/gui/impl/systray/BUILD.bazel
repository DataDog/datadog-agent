load("@rules_swift//swift:swift_binary.bzl", "swift_binary")

swift_binary(
    name = "gui",
    srcs = glob(["Sources/*.swift"]),
    copts = [
        "-swift-version",
        "5",
    ],
    features = [
        "swift.opt",
        "-swift.fastbuild",
    ],
    target_compatible_with = ["@platforms//os:macos"],
    visibility = ["//packages/macos/app:__pkg__"],
)

exports_files(
    ["agent.png"],
    visibility = ["//packages/macos/app:__pkg__"],
)
