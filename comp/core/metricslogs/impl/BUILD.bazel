load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "impl",
    srcs = [
        "impl.go",
        "logmetrics.go",
    ],
    importpath = "github.com/DataDog/datadog-agent/comp/core/metricslogs/impl",
    visibility = ["//visibility:public"],
    deps = [
        "//comp/core/log/def",
        "//comp/core/metricslogs/def",
    ],
)

dd_agent_go_test(
    name = "impl_test",
    srcs = ["impl_test.go"],
    embed = [":impl"],
    deps = [
        "//comp/core/metricslogs/def",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
