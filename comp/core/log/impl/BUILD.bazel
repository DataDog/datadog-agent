load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")
load("//bazel/rules/go_package_metadata:defs.bzl", "go_package_metadata")

package(default_package_metadata = [":go_package_metadata"])

go_package_metadata(
    name = "go_package_metadata",
    module = "github.com/DataDog/datadog-agent/comp/core/log/impl",
)

go_library(
    name = "impl",
    srcs = ["logger.go"],
    importpath = "github.com/DataDog/datadog-agent/comp/core/log/impl",
    visibility = ["//visibility:public"],
    deps = [
        "//comp/core/config",
        "//comp/core/log/def",
        "//comp/def",
        "//pkg/util/log",
        "//pkg/util/log/setup",
    ],
)

dd_agent_go_test(
    name = "impl_test",
    srcs = ["logger_test.go"],
    embed = [":impl"],
    deps = [
        "//comp/core/log/def",
        "//comp/def",
        "//pkg/config/mock",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
