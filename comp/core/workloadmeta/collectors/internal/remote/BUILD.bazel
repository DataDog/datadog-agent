dd_agent_go_test(
    name = "remote_test",
    srcs = ["generic_test.go"],
    embed = [":remote"],
    deps = [
        "//comp/core/ipc/mock",
        "//comp/core/workloadmeta/def",
        "//pkg/config/mock",
        "@com_github_stretchr_testify//assert",
