load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "remote",
    srcs = ["generic.go"],
    importpath = "github.com/DataDog/datadog-agent/comp/core/workloadmeta/collectors/internal/remote",
    visibility = ["//comp/core/workloadmeta/collectors:__subpackages__"],
    deps = [
        "//comp/core/ipc/def",
        "//comp/core/workloadmeta/def",
        "//comp/core/workloadmeta/telemetry",
        "//pkg/config/model",
        "//pkg/util/grpc",
        "//pkg/util/log",
        "//pkg/util/system/socket",
        "@com_github_cenkalti_backoff_v7//:backoff",
