load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")
load("//bazel/rules/go_package_metadata:defs.bzl", "go_package_metadata")

package(default_package_metadata = [":go_package_metadata"])

go_package_metadata(
    name = "go_package_metadata",
    module = "github.com/DataDog/datadog-agent/comp/core/secrets/utils",
)

go_library(
    name = "utils",
    srcs = ["utils.go"],
    importpath = "github.com/DataDog/datadog-agent/comp/core/secrets/utils",
    visibility = ["//visibility:public"],
)

dd_agent_go_test(
    name = "utils_test",
    srcs = [
        "utils_test.go",
        "walker_test.go",
    ],
    embed = [":utils"],
    deps = [
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
        "@in_yaml_go_yaml_v3//:yaml",
    ],
)
