    srcs = [
        "delegated_auth_test.go",
        "workload_authorization_test.go",
    ],
    embed = [":api"],
    deps = [
        "//comp/core/delegatedauth/common",
        "//pkg/config/mock",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
