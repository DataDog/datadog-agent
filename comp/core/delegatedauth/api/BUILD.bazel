load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "api",
    srcs = [
        "delegated_auth.go",
        "workload_authorization.go",
    ],
    importpath = "github.com/DataDog/datadog-agent/comp/core/delegatedauth/api",
    visibility = ["//visibility:public"],
