load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")
load("//bazel/rules/go_package_metadata:defs.bzl", "go_package_metadata")

package(default_package_metadata = [":go_package_metadata"])

go_package_metadata(
    name = "go_package_metadata",
    module = "github.com/DataDog/datadog-agent/comp/core/ipc/impl",
)

go_library(
    name = "impl",
    srcs = ["ipc.go"],
    importpath = "github.com/DataDog/datadog-agent/comp/core/ipc/impl",
    visibility = ["//visibility:public"],
    deps = [
        "//comp/core/config",
        "//comp/core/ipc/def",
        "//comp/core/ipc/httphelpers",
        "//comp/core/log/def",
        "//pkg/api/security",
        "//pkg/api/security/cert",
        "//pkg/api/util",
    ],
)

dd_agent_go_test(
    name = "impl_test",
    srcs = ["ipc_test.go"],
    embed = [":impl"],
    deps = [
        "//comp/core/log/mock",
        "//pkg/api/util",
        "//pkg/config/mock",
        "//pkg/config/model",
        "//pkg/util/flavor",
        "@com_github_gofrs_flock//:flock",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
