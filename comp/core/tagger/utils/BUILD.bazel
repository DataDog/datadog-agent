load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")
load("//bazel/rules/go_package_metadata:defs.bzl", "go_package_metadata")

package(default_package_metadata = [":go_package_metadata"])

go_package_metadata(
    name = "go_package_metadata",
    module = "github.com/DataDog/datadog-agent/comp/core/tagger/utils",
)

go_library(
    name = "utils",
    srcs = [
        "compute_tags_hash.go",
        "concat.go",
        "doc.go",
    ],
    importpath = "github.com/DataDog/datadog-agent/comp/core/tagger/utils",
    visibility = ["//visibility:public"],
)

dd_agent_go_test(
    name = "utils_test",
    srcs = [
        "compute_tags_hash_test.go",
        "concat_test.go",
    ],
    embed = [":utils"],
    deps = [
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
