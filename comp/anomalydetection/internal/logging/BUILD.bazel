load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "logging",
    srcs = ["logging.go"],
    importpath = "github.com/DataDog/datadog-agent/comp/anomalydetection/internal/logging",
    visibility = ["//comp/anomalydetection:__subpackages__"],
    deps = [
        "//pkg/util/log",
    ],
)

dd_agent_go_test(
    name = "logging_test",
    srcs = ["logging_test.go"],
    embed = [":logging"],
    deps = [
        "//pkg/util/log",
        "@com_github_stretchr_testify//require",
    ],
)
