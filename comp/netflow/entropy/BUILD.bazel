load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "entropy",
    srcs = [
        "entropy.go",
        "report.go",
    ],
    importpath = "github.com/DataDog/datadog-agent/comp/netflow/entropy",
    visibility = ["//visibility:public"],
    deps = [
        "//comp/core/log/def",
        "//comp/netflow/common",
        "//pkg/aggregator/sender",
        "//pkg/version",
    ],
)

dd_agent_go_test(
    name = "entropy_test",
    srcs = ["entropy_test.go"],
    embed = [":entropy"],
    deps = [
        "//comp/core/log/mock",
        "//comp/netflow/common",
        "//pkg/aggregator/mocksender",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
