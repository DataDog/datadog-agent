load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "datadogremoteconfigextension",
    srcs = [
        "config.go",
        "extension.go",
        "factory.go",
    ],
    importpath = "github.com/DataDog/datadog-agent/comp/otelcol/otlp/components/extension/datadogremoteconfigextension",
    visibility = ["//visibility:public"],
    deps = [
        "@io_opentelemetry_go_collector_component//:component",
        "@io_opentelemetry_go_collector_component_componentstatus//:componentstatus",
        "@io_opentelemetry_go_collector_config_configtls//:configtls",
        "@io_opentelemetry_go_collector_extension//:extension",
        "@io_opentelemetry_go_otel//attribute",
        "@io_opentelemetry_go_otel_metric//:metric",
    ],
)

dd_agent_go_test(
    name = "datadogremoteconfigextension_test",
    srcs = ["extension_test.go"],
    embed = [":datadogremoteconfigextension"],
    deps = [
        "@com_github_stretchr_testify//require",
        "@io_opentelemetry_go_collector_component//:component",
        "@io_opentelemetry_go_collector_component_componenttest//:componenttest",
        "@io_opentelemetry_go_collector_config_configtls//:configtls",
        "@io_opentelemetry_go_collector_extension//:extension",
    ],
)
