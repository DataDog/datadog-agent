load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")
load("//bazel/rules/go_package_metadata:defs.bzl", "go_package_metadata")

package(default_package_metadata = [":go_package_metadata"])

go_package_metadata(
    name = "go_package_metadata",
    module = "github.com/DataDog/datadog-agent/comp/otelcol/otlp/components/metricsclient",
)

go_library(
    name = "metricsclient",
    srcs = [
        "doc.go",
        "metrics_client.go",
        "metrics_client_wrapper.go",
    ],
    importpath = "github.com/DataDog/datadog-agent/comp/otelcol/otlp/components/metricsclient",
    visibility = ["//visibility:public"],
    deps = [
        "@com_github_datadog_datadog_go_v5//statsd",
        "@io_opentelemetry_go_otel//attribute",
        "@io_opentelemetry_go_otel_metric//:metric",
    ],
)

dd_agent_go_test(
    name = "metricsclient_test",
    srcs = ["metrics_client_test.go"],
    embed = [":metricsclient"],
    deps = [
        "//pkg/trace/timing",
        "@com_github_datadog_datadog_go_v5//statsd",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
        "@io_opentelemetry_go_otel//attribute",
        "@io_opentelemetry_go_otel_metric//:metric",
        "@io_opentelemetry_go_otel_metric//embedded",
        "@io_opentelemetry_go_otel_sdk_metric//:metric",
        "@io_opentelemetry_go_otel_sdk_metric//metricdata",
        "@io_opentelemetry_go_otel_sdk_metric//metricdata/metricdatatest",
    ],
)
