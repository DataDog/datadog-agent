load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")
load("//bazel/rules/go_package_metadata:defs.bzl", "go_package_metadata")

package(default_package_metadata = [":go_package_metadata"])

go_package_metadata(
    name = "go_package_metadata",
    module = "github.com/DataDog/datadog-agent/comp/otelcol/converter/impl",
)

go_library(
    name = "impl",
    srcs = [
        "autoconfigure.go",
        "converter.go",
        "coreconfig.go",
        "cumulativetodelta.go",
        "extensions.go",
        "infraattributes.go",
        "prometheus.go",
    ],
    importpath = "github.com/DataDog/datadog-agent/comp/otelcol/converter/impl",
    visibility = ["//visibility:public"],
    deps = [
        "//comp/core/config",
        "//comp/core/hostname/hostnameinterface/def",
        "//comp/core/log/def",
        "//comp/otelcol/converter/def",
        "//pkg/util/hostport",
        "//pkg/util/log/zap",
        "@io_opentelemetry_go_collector_confmap//:confmap",
        "@org_uber_go_zap//:zap",
    ],
)

dd_agent_go_test(
    name = "impl_test",
    srcs = ["converter_test.go"],
    data = glob(["testdata/**"]),
    embed = [":impl"],
    deps = [
        "//comp/core/config",
        "//comp/core/hostname/hostnameinterface/def",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
        "@io_opentelemetry_go_collector_confmap//:confmap",
        "@io_opentelemetry_go_collector_confmap_provider_envprovider//:envprovider",
        "@io_opentelemetry_go_collector_confmap_provider_fileprovider//:fileprovider",
        "@io_opentelemetry_go_collector_confmap_provider_httpprovider//:httpprovider",
        "@io_opentelemetry_go_collector_confmap_provider_httpsprovider//:httpsprovider",
        "@io_opentelemetry_go_collector_confmap_provider_yamlprovider//:yamlprovider",
        "@org_uber_go_zap//:zap",
        "@org_uber_go_zap//zapcore",
        "@org_uber_go_zap//zaptest/observer",
    ],
)
