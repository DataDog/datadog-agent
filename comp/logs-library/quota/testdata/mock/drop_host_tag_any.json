{
  "schema_version": 1,
  "quota_id": "host-scoped",
  "version": 1,
  "action": "drop",
  "match": {
    "all": [
      { "field": "host_tag", "op": "eq", "value": "hostteam:payments" },
      { "field": "status", "op": "in", "values": ["info", "debug"] }
    ],
    "any": [
      { "field": "source", "op": "eq", "value": "redis" },
      { "field": "service", "op": "eq", "value": "rcq-cache" }
    ]
  },
  "enforce_until": "2026-12-31T00:00:00Z",
  "max_ttl_seconds": 3600
}
