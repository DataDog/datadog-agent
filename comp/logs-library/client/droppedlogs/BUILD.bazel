load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "droppedlogs",
    srcs = ["droppedlogs.go"],
    importpath = "github.com/DataDog/datadog-agent/comp/logs-library/client/droppedlogs",
    visibility = ["//visibility:public"],
    deps = [
        "//comp/logs-library/metrics",
        "//pkg/logs/message",
    ],
)

dd_agent_go_test(
    name = "droppedlogs_test",
    srcs = ["droppedlogs_test.go"],
    embed = [":droppedlogs"],
    deps = [
        "//comp/logs-library/metrics",
        "//comp/logs/agent/config",
        "//pkg/logs/message",
        "//pkg/logs/sources",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
