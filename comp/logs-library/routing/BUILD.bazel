load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "routing",
    srcs = [
        "definitions.go",
        "progress.go",
        "registry.go",
    ],
    importpath = "github.com/DataDog/datadog-agent/comp/logs-library/routing",
    visibility = ["//visibility:public"],
    deps = [
        "//comp/logs-library/sender",
        "//comp/logs/agent/config",
        "//pkg/logs/message",
        "//pkg/logs/types",
    ],
)

dd_agent_go_test(
    name = "routing_test",
    srcs = [
        "definitions_test.go",
        "progress_test.go",
    ],
    embed = [":routing"],
    deps = [
        "//comp/logs/agent/config",
        "//pkg/logs/message",
        "//pkg/logs/sources",
    ],
)
