#!/bin/sh
# Pre-installation Script — runs on fresh installs and upgrades, before the
# new files are installed. On upgrades it runs after prerm, once the old
# files have been removed.

# The legacy Unix Agent cannot coexist with Agent 7
if /usr/bin/lslpp -Lq datadog-unix-agent >/dev/null 2>&1; then
    echo "The legacy Datadog Unix Agent (datadog-unix-agent) is installed, and Agent 7 cannot coexist with it." >&2
    echo "Removing the Unix Agent also deletes its configuration, including /etc/datadog-agent/datadog.yaml" >&2
    echo "and conf.d. The Unix Agent and Agent 7 use different configuration formats, so save a copy" >&2
    echo "elsewhere first if you want to reference its settings (API key, tags, ...) when configuring Agent 7:" >&2
    echo "" >&2
    echo "  cp -rp /etc/datadog-agent /etc/datadog-agent.unix-agent.bak" >&2
    echo "" >&2
    echo "Then remove the Unix Agent and retry the installation:" >&2
    echo "" >&2
    echo "  installp -u datadog-unix-agent" >&2
    exit 1
fi

stopsrc -g datadog-agent 2>/dev/null || true
