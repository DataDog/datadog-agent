#!/bin/sh
CONFIG_DIR=/etc/datadog-agent
CONFIG_FILE="$CONFIG_DIR/datadog.yaml"
EXAMPLE_FILE="$CONFIG_DIR/datadog.yaml.example"
PYTHON=/opt/datadog-agent/embedded/bin/python3.13

# installp has no mechanism to pass parameters/env vars at install time
# (unlike apt/yum, which the Linux install script relies on), so this is the
# only way to configure the agent unattended on AIX. Mirrors the env vars
# handled by https://github.com/DataDog/agent-linux-install-script.
# Only touches the config file on a fresh install: if datadog.yaml already
# exists, it is left untouched.
if [ ! -f "$CONFIG_FILE" ] && [ -n "$DD_API_KEY" ] && [ -f "$EXAMPLE_FILE" ] && [ -x "$PYTHON" ]; then
    # Rendered on a private staging file, chowned/chmoded and moved into
    # place only once everything below succeeds, so datadog.yaml (which will
    # contain the API key) never exists at its final path in a state
    # readable by anyone but root. umask 077 makes the initial copy
    # root-only from the start; Python then rewrites that same file in
    # place, which doesn't change its mode/owner.
    STAGING_FILE="$CONFIG_FILE.tmp.$$"

    if (umask 077 && cp "$EXAMPLE_FILE" "$STAGING_FILE"); then
        # Reads DD_* directly from the environment rather than taking them as
        # argv/heredoc-interpolated values: this heredoc is quoted ('PYEOF'),
        # so none of it is shell-expanded, which matters because interpolating
        # an env var into Python *source text* would let a value containing
        # e.g. a stray '"' turn into arbitrary code execution as root.
        "$PYTHON" - "$STAGING_FILE" <<'PYEOF'
import os
import sys

import yaml


def env(*names):
    for name in names:
        value = os.environ.get(name)
        if value:
            return value
    return None


path = sys.argv[1]
with open(path) as f:
    lines = f.readlines()

# api_key is the only field with a real, uncommented line in the template
# (it's required, so it ships as "api_key:" with no value); every other
# field below ships commented out. go.yaml.in/yaml/v2 (what the Agent
# parses config with) resolves duplicate top-level keys as *last wins*, so
# appending a second "api_key:" would be overridden by -- not override --
# the template's original line. Editing it in place avoids that; appending
# the rest further down is safe since there's nothing else active to lose to.
api_key = env("DD_API_KEY")
for i, line in enumerate(lines):
    if line.startswith("api_key:"):
        value_yaml = yaml.safe_dump(api_key, default_flow_style=True).splitlines()[0]
        lines[i] = "api_key: " + value_yaml + "\n"
        break

extra = {}
if env("DD_SITE"):
    extra["site"] = env("DD_SITE")
if env("DD_HOSTNAME"):
    extra["hostname"] = env("DD_HOSTNAME")
if env("DD_ENV"):
    extra["env"] = env("DD_ENV")
if env("DD_INFRASTRUCTURE_MODE"):
    extra["infrastructure_mode"] = env("DD_INFRASTRUCTURE_MODE")
if env("DD_TAGS"):
    extra["tags"] = [t for t in env("DD_TAGS").split(",") if t]

# DD_PROXY_* takes precedence over the generic HTTP_PROXY/HTTPS_PROXY/NO_PROXY
# vars, matching the Agent's own env var resolution (LoadProxyFromEnv).
proxy = {}
if env("DD_PROXY_HTTP", "HTTP_PROXY", "http_proxy"):
    proxy["http"] = env("DD_PROXY_HTTP", "HTTP_PROXY", "http_proxy")
if env("DD_PROXY_HTTPS", "HTTPS_PROXY", "https_proxy"):
    proxy["https"] = env("DD_PROXY_HTTPS", "HTTPS_PROXY", "https_proxy")
if env("DD_PROXY_NO_PROXY", "NO_PROXY", "no_proxy"):
    no_proxy = env("DD_PROXY_NO_PROXY", "NO_PROXY", "no_proxy")
    proxy["no_proxy"] = no_proxy.replace(",", " ").split()
if proxy:
    extra["proxy"] = proxy

with open(path, "w") as f:
    f.writelines(lines)
    if extra:
        f.write("\n" + yaml.safe_dump(extra, default_flow_style=False))
PYEOF

        if chown dd-agent:dd-agent "$STAGING_FILE" 2>/dev/null && chmod 640 "$STAGING_FILE" 2>/dev/null; then
            mv "$STAGING_FILE" "$CONFIG_FILE" 2>/dev/null
        fi
    fi
    rm -f "$STAGING_FILE" 2>/dev/null || true
fi

chown -R dd-agent:dd-agent /etc/datadog-agent \
                           /var/log/datadog \
                           /var/run/datadog \
                           /opt/datadog-agent 2>/dev/null || true

if [ -f "$CONFIG_FILE" ]; then
    if [ -z "$DD_INSTALL_ONLY" ]; then
        startsrc -s datadog-agent
        startsrc -s datadog-trace-agent
        startsrc -s datadog-agent-data-plane
    else
        echo ""
        echo "DD_INSTALL_ONLY is set: the Datadog Agent was not started."
        echo "Start it with:  startsrc -s datadog-agent && startsrc -s datadog-trace-agent && startsrc -s datadog-agent-data-plane"
        echo ""
    fi
else
    echo ""
    echo "Datadog Agent installed."
    echo "Create /etc/datadog-agent/datadog.yaml with your api_key to start."
    echo "Then run:  startsrc -s datadog-agent && startsrc -s datadog-trace-agent && startsrc -s datadog-agent-data-plane"
    echo ""
fi
