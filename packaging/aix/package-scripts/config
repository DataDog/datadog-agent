#!/bin/sh
CONFIG_DIR=/etc/datadog-agent
CONFIG_FILE="$CONFIG_DIR/datadog.yaml"
EXAMPLE_FILE="$CONFIG_DIR/datadog.yaml.example"
PYTHON=/opt/datadog-agent/embedded/bin/python3.13

# installp has no mechanism to pass parameters/env vars at install time
# (unlike apt/yum, which the Linux install script relies on), so this is the
# only way to configure the agent unattended on AIX. Mirrors the env vars
# handled by https://github.com/DataDog/agent-linux-install-script.
# Only touches the config file on a fresh install: if datadog.yaml already
# exists, it is left untouched.
if [ ! -f "$CONFIG_FILE" ] && [ -n "$DD_API_KEY" ] && [ -f "$EXAMPLE_FILE" ] && [ -x "$PYTHON" ]; then
    # All edits below happen on a private staging file, never on $CONFIG_FILE
    # directly: it is only chowned/chmoded and moved into place once, after
    # every field has been set, so datadog.yaml (which will contain the API
    # key) never exists at its final path in a state readable by anyone but
    # root. The staging file itself stays root-only (600) throughout: each
    # set_config_value call rewrites it via its own temp-file-then-rename
    # step (embedded Python has no in-place edit, and AIX sed has no -i
    # anyway), always recreating it with mode 600.
    STAGING_FILE="$CONFIG_FILE.tmp.$$"

    # set_config_value <anchor-regex> <indent-spaces> <key> [value ...]
    # Replaces the first line matching <anchor-regex> with "key: value" (or
    # "key: [v1, v2, ...]" for multiple values, or bare "key:" for none),
    # indented by <indent-spaces>. Values are YAML-quoted by PyYAML rather
    # than string-interpolated into a sed script, so there is no equivalent
    # of sed's '&'/delimiter escaping to get wrong.
    set_config_value() {
        anchor="$1"
        indent="$2"
        key="$3"
        shift 3
        "$PYTHON" - "$STAGING_FILE" "$anchor" "$indent" "$key" "$@" <<'PYEOF'
import os
import re
import sys

import yaml

path, anchor, indent, key = sys.argv[1:5]
values = sys.argv[5:]

if not values:
    rendered = key + ":"
else:
    # Dump just the value (not a wrapping {key: value} dict, which
    # default_flow_style would render as a flow-style *mapping* too, e.g.
    # "{api_key: foo}") and take only its first line, discarding the "...\n"
    # document-end marker PyYAML appends after a bare scalar.
    value = values[0] if len(values) == 1 else values
    value_yaml = yaml.safe_dump(value, default_flow_style=True).splitlines()[0]
    rendered = key + ": " + value_yaml
new_line = (" " * int(indent)) + rendered + "\n"

with open(path) as f:
    lines = f.readlines()

pattern = re.compile(anchor)
for i, line in enumerate(lines):
    if pattern.match(line):
        lines[i] = new_line
        break
else:
    sys.exit(1)

dirpath = os.path.dirname(path) or "."
tmp_path = os.path.join(dirpath, ".datadog-config.%d.tmp" % os.getpid())
fd = os.open(tmp_path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
with os.fdopen(fd, "w") as f:
    f.writelines(lines)
os.rename(tmp_path, path)
PYEOF
    }

    if (umask 077 && cp "$EXAMPLE_FILE" "$STAGING_FILE"); then
        set_config_value '^api_key:' 0 api_key "$DD_API_KEY" || true

        [ -n "$DD_SITE" ] && { set_config_value '^# site:' 0 site "$DD_SITE" || true; }
        [ -n "$DD_HOSTNAME" ] && { set_config_value '^# hostname:' 0 hostname "$DD_HOSTNAME" || true; }
        [ -n "$DD_ENV" ] && { set_config_value '^# env:' 0 env "$DD_ENV" || true; }
        [ -n "$DD_INFRASTRUCTURE_MODE" ] && { set_config_value '^# infrastructure_mode:' 0 infrastructure_mode "$DD_INFRASTRUCTURE_MODE" || true; }

        if [ -n "$DD_TAGS" ]; then
            (
                IFS=,
                # shellcheck disable=SC2086 # word-splitting is the point: turns "a,b" into separate argv values
                set -- $DD_TAGS
                set_config_value '^# tags:' 0 tags "$@"
            ) || true
        fi

        # Proxy settings: https://docs.datadoghq.com/agent/proxy/
        # DD_PROXY_* takes precedence over the generic HTTP_PROXY/HTTPS_PROXY/NO_PROXY
        # vars, matching the Agent's own env var resolution (LoadProxyFromEnv).
        proxy_http="${DD_PROXY_HTTP:-${HTTP_PROXY:-${http_proxy:-}}}"
        proxy_https="${DD_PROXY_HTTPS:-${HTTPS_PROXY:-${https_proxy:-}}}"
        proxy_no_proxy="${DD_PROXY_NO_PROXY:-${NO_PROXY:-${no_proxy:-}}}"

        if [ -n "$proxy_http" ] || [ -n "$proxy_https" ] || [ -n "$proxy_no_proxy" ]; then
            set_config_value '^# proxy:' 0 proxy || true
            [ -n "$proxy_http" ] && { set_config_value '^#   http:' 2 http "$proxy_http" || true; }
            [ -n "$proxy_https" ] && { set_config_value '^#   https:' 2 https "$proxy_https" || true; }
            if [ -n "$proxy_no_proxy" ]; then
                (
                    IFS=' '
                    # shellcheck disable=SC2046,SC2086 # word-splitting is the point: turns the space-separated list into separate argv values
                    set -- $(printf '%s' "$proxy_no_proxy" | tr ',' ' ')
                    set_config_value '^#   no_proxy:' 2 no_proxy "$@"
                ) || true
            fi
        fi

        if chown dd-agent:dd-agent "$STAGING_FILE" 2>/dev/null && chmod 640 "$STAGING_FILE" 2>/dev/null; then
            mv "$STAGING_FILE" "$CONFIG_FILE" 2>/dev/null
        fi
    fi
    rm -f "$STAGING_FILE" 2>/dev/null || true
fi

chown -R dd-agent:dd-agent /etc/datadog-agent \
                           /var/log/datadog \
                           /var/run/datadog \
                           /opt/datadog-agent 2>/dev/null || true

if [ -f "$CONFIG_FILE" ]; then
    if [ -z "$DD_INSTALL_ONLY" ]; then
        startsrc -s datadog-agent
        startsrc -s datadog-trace-agent
        startsrc -s datadog-agent-data-plane
    else
        echo ""
        echo "DD_INSTALL_ONLY is set: the Datadog Agent was not started."
        echo "Start it with:  startsrc -s datadog-agent && startsrc -s datadog-trace-agent && startsrc -s datadog-agent-data-plane"
        echo ""
    fi
else
    echo ""
    echo "Datadog Agent installed."
    echo "Create /etc/datadog-agent/datadog.yaml with your api_key to start."
    echo "Then run:  startsrc -s datadog-agent && startsrc -s datadog-trace-agent && startsrc -s datadog-agent-data-plane"
    echo ""
fi
