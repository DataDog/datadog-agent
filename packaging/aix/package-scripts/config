#!/bin/sh
CONFIG_DIR=/etc/datadog-agent
CONFIG_FILE="$CONFIG_DIR/datadog.yaml"
EXAMPLE_FILE="$CONFIG_DIR/datadog.yaml.example"

# installp has no mechanism to pass parameters/env vars at install time
# (unlike apt/yum, which the Linux install script relies on), so this is the
# only way to configure the agent unattended on AIX. Mirrors the env vars
# handled by https://github.com/DataDog/agent-linux-install-script.
# Only touches the config file on a fresh install: if datadog.yaml already
# exists, it is left untouched.
if [ ! -f "$CONFIG_FILE" ] && [ -n "$DD_API_KEY" ] && [ -f "$EXAMPLE_FILE" ]; then
    # Escapes characters special to a sed replacement built with '|' as the
    # delimiter: backslash, '&' (whole-match token), and the delimiter itself.
    # Without this, a value containing one of them (e.g. a proxy URL with a
    # '&' in it) would corrupt the substitution or break the sed script.
    escape_sed_repl() {
        printf '%s' "$1" | sed 's/[\&|]/\\&/g'
    }

    sed_script="s|^api_key:.*|api_key: $(escape_sed_repl "$DD_API_KEY")|"

    if [ -n "$DD_SITE" ]; then
        sed_script="$sed_script
s|^# site:.*|site: $(escape_sed_repl "$DD_SITE")|"
    fi
    if [ -n "$DD_HOSTNAME" ]; then
        sed_script="$sed_script
s|^# hostname:.*|hostname: $(escape_sed_repl "$DD_HOSTNAME")|"
    fi
    if [ -n "$DD_ENV" ]; then
        sed_script="$sed_script
s|^# env:.*|env: $(escape_sed_repl "$DD_ENV")|"
    fi
    if [ -n "$DD_INFRASTRUCTURE_MODE" ]; then
        sed_script="$sed_script
s|^# infrastructure_mode:.*|infrastructure_mode: $(escape_sed_repl "$DD_INFRASTRUCTURE_MODE")|"
    fi
    if [ -n "$DD_TAGS" ]; then
        formatted_tags=$(echo "$DD_TAGS" | sed "s/,/', '/g")
        sed_script="$sed_script
s|^# tags:.*|tags: ['$(escape_sed_repl "$formatted_tags")']|"
    fi

    # Proxy settings: https://docs.datadoghq.com/agent/proxy/
    # DD_PROXY_* takes precedence over the generic HTTP_PROXY/HTTPS_PROXY/NO_PROXY
    # vars, matching the Agent's own env var resolution (LoadProxyFromEnv).
    proxy_http="${DD_PROXY_HTTP:-${HTTP_PROXY:-${http_proxy:-}}}"
    proxy_https="${DD_PROXY_HTTPS:-${HTTPS_PROXY:-${https_proxy:-}}}"
    proxy_no_proxy="${DD_PROXY_NO_PROXY:-${NO_PROXY:-${no_proxy:-}}}"

    if [ -n "$proxy_http" ] || [ -n "$proxy_https" ] || [ -n "$proxy_no_proxy" ]; then
        sed_script="$sed_script
s|^# proxy:.*|proxy:|"
        if [ -n "$proxy_http" ]; then
            sed_script="$sed_script
s|^#   http:.*|  http: $(escape_sed_repl "$proxy_http")|"
        fi
        if [ -n "$proxy_https" ]; then
            sed_script="$sed_script
s|^#   https:.*|  https: $(escape_sed_repl "$proxy_https")|"
        fi
        if [ -n "$proxy_no_proxy" ]; then
            formatted_no_proxy=$(echo "$proxy_no_proxy" | sed "s/[, ][, ]*/', '/g")
            sed_script="$sed_script
s|^#   no_proxy:.*|  no_proxy: ['$(escape_sed_repl "$formatted_no_proxy")']|"
        fi
    fi

    # Render into a private temp file (umask 077: never group/world-readable,
    # even transiently), apply the final ownership/mode there, then rename it
    # into place atomically. datadog.yaml (which will contain the API key)
    # therefore never exists at its final path in a state readable by anyone
    # but root — unlike editing it in place across several sed+mv passes.
    TMP_CONFIG="$CONFIG_FILE.tmp.$$"
    if (umask 077 && sed "$sed_script" "$EXAMPLE_FILE" > "$TMP_CONFIG") \
        && chown dd-agent:dd-agent "$TMP_CONFIG" 2>/dev/null \
        && chmod 640 "$TMP_CONFIG" 2>/dev/null \
        && mv "$TMP_CONFIG" "$CONFIG_FILE" 2>/dev/null
    then
        :
    else
        rm -f "$TMP_CONFIG" 2>/dev/null || true
    fi
fi

chown -R dd-agent:dd-agent /etc/datadog-agent \
                           /var/log/datadog \
                           /var/run/datadog \
                           /opt/datadog-agent 2>/dev/null || true

if [ -f "$CONFIG_FILE" ]; then
    if [ -z "$DD_INSTALL_ONLY" ]; then
        startsrc -s datadog-agent
        startsrc -s datadog-trace-agent
        startsrc -s datadog-agent-data-plane
    else
        echo ""
        echo "DD_INSTALL_ONLY is set: the Datadog Agent was not started."
        echo "Start it with:  startsrc -s datadog-agent && startsrc -s datadog-trace-agent && startsrc -s datadog-agent-data-plane"
        echo ""
    fi
else
    echo ""
    echo "Datadog Agent installed."
    echo "Create /etc/datadog-agent/datadog.yaml with your api_key to start."
    echo "Then run:  startsrc -s datadog-agent && startsrc -s datadog-trace-agent && startsrc -s datadog-agent-data-plane"
    echo ""
fi
