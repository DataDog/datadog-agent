load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "windows",
    srcs = ["wts_windows.go"],
    importpath = "github.com/DataDog/datadog-agent/pkg/vdi/session/windows",
    visibility = ["//visibility:public"],
    deps = select({
        "@rules_go//go/platform:windows": [
            "//pkg/vdi/model",
            "@org_golang_x_sys//windows",
        ],
        "//conditions:default": [],
    }),
)

dd_agent_go_test(
    name = "windows_test",
    srcs = ["wts_windows_test.go"],
    embed = [":windows"],
    deps = select({
        "@rules_go//go/platform:windows": [
            "@com_github_stretchr_testify//require",
        ],
        "//conditions:default": [],
    }),
)
