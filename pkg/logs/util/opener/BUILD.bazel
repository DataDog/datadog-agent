load("@rules_go//go:def.bzl", "go_library")

go_library(
    name = "opener",
    srcs = [
        "direct_io.go",
        "direct_io_linux.go",
        "direct_io_other.go",
        "file_mock.go",
        "open.go",
        "open_mock.go",
    ],
    importpath = "github.com/DataDog/datadog-agent/pkg/logs/util/opener",
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/logs/internal/util/opener",
        "//pkg/util/filesystem",
        "@com_github_spf13_afero//:afero",
    ] + select({
        "@rules_go//go/platform:android": [
            "@org_golang_x_sys//unix",
        ],
        "@rules_go//go/platform:linux": [
            "@org_golang_x_sys//unix",
        ],
        "//conditions:default": [],
    }),
)

