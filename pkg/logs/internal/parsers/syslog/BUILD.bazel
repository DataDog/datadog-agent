load("@bazel_lib//lib:run_binary.bzl", "run_binary")
load("@bazel_lib//lib:write_source_files.bzl", "write_source_file")
load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "syslog",
    srcs = [
        "cef_leef.go",
        "parser.go",
        "structured_content.go",
        "syslog.go",
    ],
    importpath = "github.com/DataDog/datadog-agent/pkg/logs/internal/parsers/syslog",
    visibility = [
        "//pkg/logs:__subpackages__",
        "@com_github_datadog_datadog_agent_pkg_logs_client//:__subpackages__",
        "@com_github_datadog_datadog_agent_pkg_logs_diagnostic//:__subpackages__",
        "@com_github_datadog_datadog_agent_pkg_logs_message//:__subpackages__",
        "@com_github_datadog_datadog_agent_pkg_logs_sources//:__subpackages__",
        "@com_github_datadog_datadog_agent_pkg_logs_status_statusinterface//:__subpackages__",
        "@com_github_datadog_datadog_agent_pkg_logs_status_utils//:__subpackages__",
        "@com_github_datadog_datadog_agent_pkg_logs_types//:__subpackages__",
        "@com_github_datadog_datadog_agent_pkg_logs_util_testutils//:__subpackages__",
    ],
    deps = [
        "//pkg/logs/internal/parsers",
        "//pkg/logs/message",
        "@com_github_json_iterator_go//:go",
    ],
)

dd_agent_go_test(
    name = "syslog_test",
    srcs = [
        "cef_leef_test.go",
        "corpus_coverage_test.go",
        "parser_test.go",
        "structured_content_test.go",
        "syslog_fuzz_test.go",
        "syslog_test.go",
        "timestamp_variants_test.go",
    ],
    data = glob(["testdata/**"]),
    embed = [":syslog"],
    deps = [
        "//comp/logs/agent/config",
        "//pkg/logs/message",
        "//pkg/logs/sources",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)

# Regenerate testdata/corpus.json's "want" fields from the current parser
# output (see generators/corpus).
run_binary(
    name = "corpus_golden_gen",
    srcs = ["testdata/corpus.json"],
    outs = ["corpus_golden_gen/corpus.json"],
    args = [
        "-in=$(execpath :testdata/corpus.json)",
        "-out=$@",
    ],
    tool = "//pkg/logs/internal/parsers/syslog/generators/corpus",
)

exports_files(["testdata/corpus.json"])

write_source_file(
    name = "corpus_golden",
    in_file = ":corpus_golden_gen",
    out_file = "testdata/corpus.json",
)
