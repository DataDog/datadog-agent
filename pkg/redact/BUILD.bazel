load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "redact",
    srcs = [
        "admission.go",
        "apps.go",
        "authentication.go",
        "autoscaling.go",
        "batch.go",
        "core.go",
        "cr.go",
        "data_scrubber.go",
        "discovery.go",
        "metadata.go",
        "networking.go",
        "object_meta.go",
        "pod.go",
        "rbac.go",
    ],
    importpath = "github.com/DataDog/datadog-agent/pkg/redact",
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/util/log",
        "@io_k8s_api//admissionregistration/v1:admissionregistration",
        "@io_k8s_api//apps/v1:apps",
        "@io_k8s_api//authentication/v1:authentication",
        "@io_k8s_api//autoscaling/v2:autoscaling",
        "@io_k8s_api//batch/v1:batch",
        "@io_k8s_api//core/v1:core",
        "@io_k8s_api//discovery/v1:discovery",
        "@io_k8s_api//networking/v1:networking",
