load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "irprinter",
    srcs = [
        "doc.go",
        "json.go",
        "yaml.go",
    ],
    importpath = "github.com/DataDog/datadog-agent/pkg/dyninst/irprinter",
    tags = ["manual"],
    visibility = ["//visibility:public"],
    deps = select({
        "@rules_go//go/platform:android": [
            "//pkg/dyninst/ir",
            "@com_github_go_json_experiment_json//:json",
            "@com_github_go_json_experiment_json//jsontext",
            "@in_yaml_go_yaml_v3//:yaml",
        ],
        "@rules_go//go/platform:linux": [
            "//pkg/dyninst/ir",
            "@com_github_go_json_experiment_json//:json",
            "@com_github_go_json_experiment_json//jsontext",
            "@in_yaml_go_yaml_v3//:yaml",
        ],
        "//conditions:default": [],
    }),
)

dd_agent_go_test(
    name = "irprinter_test",
    srcs = ["example_test.go"],
    embed = [":irprinter"],
    gotags_sets = [["bpf"]],
    include_default = False,
    tags = ["requires_ebpf"],
    deps = select({
        "@rules_go//go/platform:android": [
            "//pkg/dyninst/ir",
        ],
        "@rules_go//go/platform:linux": [
            "//pkg/dyninst/ir",
        ],
        "//conditions:default": [],
    }),
)
