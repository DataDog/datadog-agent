load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "testprogs",
    srcs = [
        "probes.go",
        "test_progs.go",
    ],
    importpath = "github.com/DataDog/datadog-agent/pkg/dyninst/testprogs",
    tags = ["manual"],
    visibility = ["//visibility:public"],
    deps = select({
        "@rules_go//go/platform:android": [
            "//pkg/dyninst/ir",
            "//pkg/dyninst/rcjson",
            "@com_github_stretchr_testify//require",
            "@in_yaml_go_yaml_v3//:yaml",
        ],
        "@rules_go//go/platform:linux": [
            "//pkg/dyninst/ir",
            "//pkg/dyninst/rcjson",
            "@com_github_stretchr_testify//require",
            "@in_yaml_go_yaml_v3//:yaml",
        ],
        "//conditions:default": [],
    }),
)

dd_agent_go_test(
    name = "testprogs_test",
    srcs = ["test_progs_test.go"],
    data = glob(["testdata/**"]),
    embed = [":testprogs"],
    gotags_sets = [["bpf"]],
    include_default = False,
    tags = ["requires_ebpf"],
    deps = select({
        "@rules_go//go/platform:android": [
            "//pkg/dyninst/ir",
            "@com_github_stretchr_testify//require",
        ],
        "@rules_go//go/platform:linux": [
            "//pkg/dyninst/ir",
            "@com_github_stretchr_testify//require",
        ],
        "//conditions:default": [],
    }),
)
