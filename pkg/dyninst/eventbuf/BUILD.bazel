load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "eventbuf",
    srcs = [
        "buffer.go",
        "doc.go",
        "message.go",
        "sharedmessage.go",
    ],
    importpath = "github.com/DataDog/datadog-agent/pkg/dyninst/eventbuf",
    tags = ["manual"],
    visibility = ["//visibility:public"],
    deps = select({
        "@rules_go//go/platform:android": [
            "//pkg/dyninst/output",
            "//pkg/util/log",
            "@com_github_google_btree//:btree",
        ],
        "@rules_go//go/platform:linux": [
            "//pkg/dyninst/output",
            "//pkg/util/log",
            "@com_github_google_btree//:btree",
        ],
        "//conditions:default": [],
    }),
)

dd_agent_go_test(
    name = "eventbuf_test",
    srcs = [
        "budget_test.go",
        "buffer_bench_test.go",
        "buffer_test.go",
        "message_test.go",
        "property_test.go",
        "snapshot_test.go",
    ],
    data = glob(["testdata/**"]),
    embed = [":eventbuf"],
    gotags_sets = [["bpf"]],
    include_default = False,
    tags = ["requires_ebpf"],
    deps = select({
        "@rules_go//go/platform:android": [
            "//pkg/dyninst/output",
            "@com_github_stretchr_testify//assert",
            "@com_github_stretchr_testify//require",
            "@in_yaml_go_yaml_v3//:yaml",
        ],
        "@rules_go//go/platform:linux": [
            "//pkg/dyninst/output",
            "@com_github_stretchr_testify//assert",
            "@com_github_stretchr_testify//require",
            "@in_yaml_go_yaml_v3//:yaml",
        ],
        "//conditions:default": [],
    }),
)
