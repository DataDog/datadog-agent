load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "uploader",
    srcs = [
        "batcher.go",
        "batcher_state.go",
        "config.go",
        "diagnostics.go",
        "doc.go",
        "logs.go",
        "metrics.go",
    ],
    importpath = "github.com/DataDog/datadog-agent/pkg/dyninst/uploader",
    tags = ["manual"],
    visibility = ["//visibility:public"],
    deps = select({
        "@rules_go//go/platform:android": [
            "//pkg/util/log",
            "@org_golang_x_time//rate",
        ],
        "@rules_go//go/platform:linux": [
            "//pkg/util/log",
            "@org_golang_x_time//rate",
        ],
        "//conditions:default": [],
    }),
)

dd_agent_go_test(
    name = "uploader_test",
    srcs = [
        "batcher_snapshot_test.go",
        "config_test.go",
        "main_test.go",
        "uploader_test.go",
    ],
    data = glob(["testdata/**"]),
    embed = [":uploader"],
    gotags_sets = [["bpf"]],
    include_default = False,
    tags = ["requires_ebpf"],
    deps = select({
        "@rules_go//go/platform:android": [
            "//pkg/dyninst/dyninsttest",
            "@com_github_stretchr_testify//assert",
            "@com_github_stretchr_testify//require",
            "@in_yaml_go_yaml_v3//:yaml",
            "@org_uber_go_goleak//:goleak",
        ],
        "@rules_go//go/platform:linux": [
            "//pkg/dyninst/dyninsttest",
            "@com_github_stretchr_testify//assert",
            "@com_github_stretchr_testify//require",
            "@in_yaml_go_yaml_v3//:yaml",
            "@org_uber_go_goleak//:goleak",
        ],
        "//conditions:default": [],
    }),
)
