load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "gotype",
    srcs = [
        "abi.go",
        "doc.go",
        "map_detect.go",
        "name.go",
        "table.go",
        "type.go",
        "uncommon.go",
    ],
    importpath = "github.com/DataDog/datadog-agent/pkg/dyninst/gotype",
    tags = ["manual"],
    visibility = ["//visibility:public"],
    deps = select({
        "@rules_go//go/platform:android": [
            "//pkg/dyninst/object",
            "//pkg/util/safeelf",
        ],
        "@rules_go//go/platform:linux": [
            "//pkg/dyninst/object",
            "//pkg/util/safeelf",
        ],
        "//conditions:default": [],
    }),
)

dd_agent_go_test(
    name = "gotype_test",
    srcs = [
        "fuzz_test.go",
        "snapshot_test.go",
    ],
    data = glob(["testdata/**"]),
    embed = [":gotype"],
    gotags_sets = [["bpf"]],
    include_default = False,
    tags = ["requires_ebpf"],
    deps = select({
        "@rules_go//go/platform:android": [
            "//pkg/dyninst/gotype/gotypeprinter",
            "//pkg/dyninst/object",
            "//pkg/dyninst/testprogs",
            "@com_github_stretchr_testify//require",
        ],
        "@rules_go//go/platform:linux": [
            "//pkg/dyninst/gotype/gotypeprinter",
            "//pkg/dyninst/object",
            "//pkg/dyninst/testprogs",
            "@com_github_stretchr_testify//require",
        ],
        "//conditions:default": [],
    }),
)
