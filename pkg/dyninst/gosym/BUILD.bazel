load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "gosym",
    srcs = ["symtab.go"],
    importpath = "github.com/DataDog/datadog-agent/pkg/dyninst/gosym",
    tags = ["manual"],
    visibility = ["//visibility:public"],
)

dd_agent_go_test(
    name = "gosym_test",
    srcs = [
        "symtab_benchmark_test.go",
        "symtab_test.go",
    ],
    data = glob(["testdata/**"]),
    gotags_sets = [["bpf"]],
    include_default = False,
    tags = ["requires_ebpf"],
    deps = select({
        "@rules_go//go/platform:android": [
            ":gosym",
            "//pkg/dyninst/ir",
            "//pkg/dyninst/irgen",
            "//pkg/dyninst/object",
            "//pkg/dyninst/testprogs",
            "@com_github_stretchr_testify//require",
        ],
        "@rules_go//go/platform:linux": [
            ":gosym",
            "//pkg/dyninst/ir",
            "//pkg/dyninst/irgen",
            "//pkg/dyninst/object",
            "//pkg/dyninst/testprogs",
            "@com_github_stretchr_testify//require",
        ],
        "//conditions:default": [],
    }),
)
