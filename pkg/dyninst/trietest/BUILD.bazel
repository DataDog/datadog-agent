load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "trietest",
    srcs = ["trie.go"],
    cdeps = ["//pkg/dyninst/ebpf:dyninst_ebpf_headers"],
    cgo = True,
    importpath = "github.com/DataDog/datadog-agent/pkg/dyninst/trietest",
    tags = ["manual"],
    visibility = ["//visibility:public"],
)

dd_agent_go_test(
    name = "trietest_test",
    srcs = [
        "hash_set_test.go",
        "trie_test.go",
    ],
    embed = [":trietest"],
    gotags_sets = [["linux_bpf"]],
    include_default = False,
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        "@com_github_stretchr_testify//require",
        "@net_pgregory_rapid//:rapid",
    ],
)
