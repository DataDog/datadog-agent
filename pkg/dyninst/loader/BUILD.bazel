load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/ebpf:cgo_godefs.bzl", "cgo_godefs")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

# gazelle:go_test file

exports_files([
    "types_linux.go",
    "types_linux_test.go",
])

# Source files all carry //go:build bpf, so callers must propagate the
# bpf tag (e.g. via gotags on a go_library/go_test) to compile in this
# package.
go_library(
    name = "loader",
    srcs = [
        "loader.go",
        "serialize.go",
        "types_linux.go",
    ],
    cgo = True,
    importpath = "github.com/DataDog/datadog-agent/pkg/dyninst/loader",
    tags = ["manual"],
    visibility = ["//visibility:public"],
    deps = select({
        "@rules_go//go/platform:android": [
            "//pkg/dyninst/compiler",
            "//pkg/dyninst/ir",
            "//pkg/ebpf",
            "//pkg/ebpf/bytecode",
            "//pkg/util/kernel",
            "//pkg/util/log",
            "@com_github_cilium_ebpf//:ebpf",
            "@com_github_cilium_ebpf//asm",
            "@com_github_cilium_ebpf//btf",
            "@com_github_cilium_ebpf//features",
            "@com_github_cilium_ebpf//ringbuf",
        ],
        "@rules_go//go/platform:linux": [
            "//pkg/dyninst/compiler",
            "//pkg/dyninst/ir",
            "//pkg/ebpf",
            "//pkg/ebpf/bytecode",
            "//pkg/util/kernel",
            "//pkg/util/log",
            "@com_github_cilium_ebpf//:ebpf",
            "@com_github_cilium_ebpf//asm",
            "@com_github_cilium_ebpf//btf",
            "@com_github_cilium_ebpf//features",
            "@com_github_cilium_ebpf//ringbuf",
        ],
        "//conditions:default": [],
    }),
)

cgo_godefs(
    name = "types_godefs",
    src = "types.go",
    hdrs = ["//pkg/dyninst/ebpf:dyninst_ebpf_headers"],
    visibility = ["//visibility:public"],
)

dd_agent_go_test(
    name = "relocations_test",
    srcs = ["relocations_test.go"],
    embed = [":loader"],
    gotags_sets = [["bpf"]],
    include_default = False,
    tags = ["requires_ebpf"],
    deps = select({
        "@rules_go//go/platform:android": [
            "//pkg/ebpf",
            "@com_github_cilium_ebpf//:ebpf",
            "@com_github_cilium_ebpf//btf",
            "@com_github_stretchr_testify//require",
        ],
        "@rules_go//go/platform:linux": [
            "//pkg/ebpf",
            "@com_github_cilium_ebpf//:ebpf",
            "@com_github_cilium_ebpf//btf",
            "@com_github_stretchr_testify//require",
        ],
        "//conditions:default": [],
    }),
)

dd_agent_go_test(
    name = "stats_test",
    srcs = ["stats_test.go"],
    embed = [":loader"],
    gotags_sets = [["bpf"]],
    include_default = False,
    deps = select({
        "@rules_go//go/platform:android": [
            "@com_github_stretchr_testify//require",
        ],
        "@rules_go//go/platform:linux": [
            "@com_github_stretchr_testify//require",
        ],
        "//conditions:default": [],
    }),
)

dd_agent_go_test(
    name = "types_linux_test",
    srcs = ["types_linux_test.go"],
    embed = [":loader"],
    gotags_sets = [["bpf"]],
    deps = select({
        "@rules_go//go/platform:android": [
            "//pkg/ebpf/ebpftest",
        ],
        "@rules_go//go/platform:linux": [
            "//pkg/ebpf/ebpftest",
        ],
        "//conditions:default": [],
    }),
)
