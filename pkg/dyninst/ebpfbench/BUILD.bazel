load("@rules_go//go:def.bzl", "go_binary", "go_library")

go_library(
    name = "ebpfbench_lib",
    srcs = ["main.go"],
    importpath = "github.com/DataDog/datadog-agent/pkg/dyninst/ebpfbench",
    tags = ["manual"],
    visibility = ["//visibility:private"],
    deps = select({
        "@rules_go//go/platform:android": [
            "//pkg/dyninst/compiler",
            "//pkg/dyninst/ir",
            "//pkg/dyninst/irgen",
            "//pkg/dyninst/loader",
            "//pkg/dyninst/object",
            "//pkg/dyninst/output",
            "//pkg/dyninst/process",
            "//pkg/dyninst/testprogs",
            "//pkg/dyninst/uprobe",
            "@com_github_cilium_ebpf//ringbuf",
        ],
        "@rules_go//go/platform:linux": [
            "//pkg/dyninst/compiler",
            "//pkg/dyninst/ir",
            "//pkg/dyninst/irgen",
            "//pkg/dyninst/loader",
            "//pkg/dyninst/object",
            "//pkg/dyninst/output",
            "//pkg/dyninst/process",
            "//pkg/dyninst/testprogs",
            "//pkg/dyninst/uprobe",
            "@com_github_cilium_ebpf//ringbuf",
        ],
        "//conditions:default": [],
    }),
)

go_binary(
    name = "ebpfbench",
    embed = [":ebpfbench_lib"],
    gotags = ["bpf"],
    target_compatible_with = ["@platforms//os:linux"],  # keep
    visibility = ["//visibility:public"],
)
