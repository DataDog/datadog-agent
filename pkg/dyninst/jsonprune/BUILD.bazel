load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "jsonprune",
    srcs = [
        "doc.go",
        "prune.go",
    ],
    importpath = "github.com/DataDog/datadog-agent/pkg/dyninst/jsonprune",
    tags = ["manual"],
    visibility = ["//visibility:public"],
    deps = ["@com_github_go_json_experiment_json//jsontext"],
)

dd_agent_go_test(
    name = "jsonprune_test",
    srcs = [
        "prune_bench_test.go",
        "prune_property_test.go",
        "prune_test.go",
    ],
    embed = [":jsonprune"],
    gotags_sets = [["linux_bpf"]],
    include_default = False,
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
