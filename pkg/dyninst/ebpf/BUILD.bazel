load("@bazel_lib//lib:transitions.bzl", "platform_transition_filegroup")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel/rules/ebpf:ebpf.bzl", "ebpf_prog")

cc_library(
    name = "dyninst_ebpf_headers",
    hdrs = glob(["*.h"]),
    includes = ["."],
    visibility = ["//visibility:public"],
)

ebpf_prog(
    name = "dyninst_event",
    src = "event.c",
    core = True,
    extra_flags = ["-Ipkg/dyninst/ebpf"],
    visibility = ["//visibility:public"],
    deps = [
        ":dyninst_ebpf_headers",
        "//pkg/ebpf/c:ebpf_c_headers",
    ],
)

ebpf_prog(
    name = "dyninst_event-debug",
    src = "event.c",
    core = True,
    debug = True,
    extra_flags = [
        "-Ipkg/dyninst/ebpf",
        "-DDYNINST_DEBUG=1",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":dyninst_ebpf_headers",
        "//pkg/ebpf/c:ebpf_c_headers",
    ],
)

# Both architectures, built explicitly, for //pkg/dyninst/ebpf/stackbudget.
# The verifier's combined-stack limit is architecture-sensitive: a call chain
# can fit on x86_64 and overflow on aarch64. Frame sizes are compiler output,
# so building both here lets the budget be checked from any host instead of
# waiting for an arm64 KMT job to fail to load the program.
platform_transition_filegroup(
    name = "dyninst_event.x86_64",
    srcs = [":dyninst_event"],
    target_platform = "//bazel/platforms:linux_x86_64",
    visibility = ["//visibility:public"],
)

platform_transition_filegroup(
    name = "dyninst_event.aarch64",
    srcs = [":dyninst_event"],
    target_platform = "//bazel/platforms:linux_arm64",
    visibility = ["//visibility:public"],
)

platform_transition_filegroup(
    name = "dyninst_event-debug.x86_64",
    srcs = [":dyninst_event-debug"],
    target_platform = "//bazel/platforms:linux_x86_64",
    visibility = ["//visibility:public"],
)

platform_transition_filegroup(
    name = "dyninst_event-debug.aarch64",
    srcs = [":dyninst_event-debug"],
    target_platform = "//bazel/platforms:linux_arm64",
    visibility = ["//visibility:public"],
)
