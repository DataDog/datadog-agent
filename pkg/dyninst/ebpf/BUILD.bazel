load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel/rules/ebpf:ebpf.bzl", "ebpf_prog")

cc_library(
    name = "dyninst_ebpf_headers",
    hdrs = glob(["*.h"]),
    includes = ["."],
    visibility = ["//visibility:public"],
)

ebpf_prog(
    name = "dyninst_event",
    src = "event.c",
    core = True,
    extra_flags = ["-Ipkg/dyninst/ebpf"],
    visibility = ["//visibility:public"],
    deps = [
        ":dyninst_ebpf_headers",
        "//pkg/ebpf/c:ebpf_c_headers",
    ],
)

ebpf_prog(
    name = "dyninst_event-debug",
    src = "event.c",
    core = True,
    debug = True,
    extra_flags = [
        "-Ipkg/dyninst/ebpf",
        "-DDYNINST_DEBUG=1",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":dyninst_ebpf_headers",
        "//pkg/ebpf/c:ebpf_c_headers",
    ],
)

# Both architectures, built explicitly, for //pkg/dyninst/ebpf/stackbudget.
# The verifier's combined-stack limit is architecture-sensitive: a call chain
# can fit on x86_64 and overflow on aarch64. Frame sizes are compiler output,
# so building both here lets the budget be checked from any host instead of
# waiting for an arm64 KMT job to fail to load the program.
[
    ebpf_prog(
        name = "dyninst_event%s.%s" % (suffix, arch),
        src = "event.c",
        core = True,
        debug = debug,
        extra_flags = ["-Ipkg/dyninst/ebpf"] + extra,
        target_arch = arch,
        visibility = ["//visibility:public"],
        deps = [
            ":dyninst_ebpf_headers",
            "//pkg/ebpf/c:ebpf_c_headers",
        ],
    )
    for arch in [
        "x86_64",
        "aarch64",
    ]
    for suffix, debug, extra in [
        ("", False, []),
        (
            "-debug",
            True,
            ["-DDYNINST_DEBUG=1"],
        ),
    ]
]
