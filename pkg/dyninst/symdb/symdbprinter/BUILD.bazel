load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "symdbprinter",
    srcs = ["symdbprinter.go"],
    importpath = "github.com/DataDog/datadog-agent/pkg/dyninst/symdb/symdbprinter",
    tags = ["manual"],
    visibility = ["//visibility:public"],
    deps = select({
        "@rules_go//go/platform:android": [
            "//pkg/dyninst/symdb/uploader",
        ],
        "@rules_go//go/platform:linux": [
            "//pkg/dyninst/symdb/uploader",
        ],
        "//conditions:default": [],
    }),
)

dd_agent_go_test(
    name = "symdbprinter_test",
    srcs = ["symdbprinter_test.go"],
    embed = [":symdbprinter"],
    gotags_sets = [["bpf"]],
    include_default = False,
    tags = ["requires_ebpf"],
    deps = select({
        "@rules_go//go/platform:android": [
            "//pkg/dyninst/symdb",
            "//pkg/dyninst/symdb/uploader",
            "@com_github_stretchr_testify//require",
        ],
        "@rules_go//go/platform:linux": [
            "//pkg/dyninst/symdb",
            "//pkg/dyninst/symdb/uploader",
            "@com_github_stretchr_testify//require",
        ],
        "//conditions:default": [],
    }),
)
