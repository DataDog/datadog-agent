load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "cli_lib",
    srcs = ["main.go"],
    importpath = "github.com/DataDog/datadog-agent/pkg/dyninst/symdb/cli",
    tags = ["manual"],
    visibility = ["//visibility:private"],
    deps = [
        "//pkg/dyninst/object",
        "//pkg/dyninst/symdb",
        "//pkg/dyninst/symdb/symdbprinter",
        "//pkg/dyninst/symdb/uploader",
        "//pkg/util/log",
        "//pkg/version",
        "@com_github_google_go_containerregistry//pkg/crane",
        "@com_github_google_go_containerregistry//pkg/name",
        "@com_github_google_go_containerregistry//pkg/v1:pkg",
        "@com_github_google_uuid//:uuid",
    ],
)

go_binary(
    name = "cli",
    embed = [":cli_lib"],
    gotags = [
        "test",
        "linux_bpf",
    ],  # keep
    target_compatible_with = ["@platforms//os:linux"],  # keep
    visibility = ["//visibility:public"],
)

dd_agent_go_test(
    name = "cli_test",
    srcs = ["main_test.go"],
    embed = [":cli_lib"],
    gotags_sets = [["linux_bpf"]],
    include_default = False,
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        "//pkg/dyninst/object",
        "//pkg/dyninst/symdb",
        "//pkg/dyninst/symdb/uploader",
        "@com_github_google_uuid//:uuid",
    ],
)
