load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "cli_lib",
    srcs = ["main.go"],
    importpath = "github.com/DataDog/datadog-agent/pkg/dyninst/symdb/cli",
    tags = ["manual"],
    visibility = ["//visibility:private"],
    deps = select({
        "@rules_go//go/platform:android": [
            "//pkg/dyninst/object",
            "//pkg/dyninst/symdb",
            "//pkg/dyninst/symdb/symdbprinter",
            "//pkg/dyninst/symdb/uploader",
            "//pkg/util/log",
            "//pkg/version",
            "@com_github_google_go_containerregistry//pkg/crane",
            "@com_github_google_go_containerregistry//pkg/name",
            "@com_github_google_go_containerregistry//pkg/v1:pkg",
            "@com_github_google_uuid//:uuid",
        ],
        "@rules_go//go/platform:linux": [
            "//pkg/dyninst/object",
            "//pkg/dyninst/symdb",
            "//pkg/dyninst/symdb/symdbprinter",
            "//pkg/dyninst/symdb/uploader",
            "//pkg/util/log",
            "//pkg/version",
            "@com_github_google_go_containerregistry//pkg/crane",
            "@com_github_google_go_containerregistry//pkg/name",
            "@com_github_google_go_containerregistry//pkg/v1:pkg",
            "@com_github_google_uuid//:uuid",
        ],
        "//conditions:default": [],
    }),
)

go_binary(
    name = "cli",
    embed = [":cli_lib"],
    gotags = [
        "test",
        "bpf",
    ],  # keep
    target_compatible_with = ["@platforms//os:linux"],  # keep
    visibility = ["//visibility:public"],
)

dd_agent_go_test(
    name = "cli_test",
    srcs = ["main_test.go"],
    embed = [":cli_lib"],
    gotags_sets = [["bpf"]],
    include_default = False,
    tags = ["requires_ebpf"],
    deps = select({
        "@rules_go//go/platform:android": [
            "//pkg/dyninst/object",
            "//pkg/dyninst/symdb",
            "//pkg/dyninst/symdb/uploader",
            "@com_github_google_uuid//:uuid",
        ],
        "@rules_go//go/platform:linux": [
            "//pkg/dyninst/object",
            "//pkg/dyninst/symdb",
            "//pkg/dyninst/symdb/uploader",
            "@com_github_google_uuid//:uuid",
        ],
        "//conditions:default": [],
    }),
)
