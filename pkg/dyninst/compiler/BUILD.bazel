load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")
load("//bazel/rules/go_stringer:defs.bzl", "go_stringer")

go_library(
    name = "compiler",
    srcs = [
        "code.go",
        "doc.go",
        "functions.go",
        "generate.go",
        "instructions.go",
        "opcode.go",
        "opcode_string.go",
        "ops.go",
    ],
    importpath = "github.com/DataDog/datadog-agent/pkg/dyninst/compiler",
    tags = ["manual"],
    visibility = ["//visibility:public"],
    deps = select({
        "@rules_go//go/platform:android": [
            "//pkg/dyninst/ir",
            "//pkg/util/log",
            "@org_golang_x_time//rate",
        ],
        "@rules_go//go/platform:linux": [
            "//pkg/dyninst/ir",
            "//pkg/util/log",
            "@org_golang_x_time//rate",
        ],
        "//conditions:default": [],
    }),
)

go_stringer(
    name = "opcode_string",
    src = "opcode.go",
    output = "opcode_string.go",
    trimprefix = "Opcode",
    types = ["Opcode"],
)

dd_agent_go_test(
    name = "compiler_test",
    srcs = [
        "generate_test.go",
        "instructions_test.go",
        "snapshot_test.go",
    ],
    data = glob(["testdata/**"]),
    embed = [":compiler"],
    gotags_sets = [["bpf"]],
    include_default = False,
    tags = ["requires_ebpf"],
    deps = select({
        "@rules_go//go/platform:android": [
            "//pkg/dyninst/ir",
            "//pkg/dyninst/irgen",
            "//pkg/dyninst/object",
            "//pkg/dyninst/testprogs",
            "//pkg/util/log",
            "@com_github_stretchr_testify//assert",
            "@com_github_stretchr_testify//require",
        ],
        "@rules_go//go/platform:linux": [
            "//pkg/dyninst/ir",
            "//pkg/dyninst/irgen",
            "//pkg/dyninst/object",
            "//pkg/dyninst/testprogs",
            "//pkg/util/log",
            "@com_github_stretchr_testify//assert",
            "@com_github_stretchr_testify//require",
        ],
        "//conditions:default": [],
    }),
)
