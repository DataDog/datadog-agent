            "//pkg/util/backoff",
            "//pkg/util/kernel",
            "//pkg/util/log",
            "@com_github_cilium_ebpf//ringbuf",
            "@com_github_datadog_ebpf_manager//tracefs",
            "@com_github_go_json_experiment_json//:json",
