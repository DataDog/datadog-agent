load("@rules_go//go:def.bzl", "go_binary", "go_library")

go_library(
    name = "cli_lib",
    srcs = ["analyze.go"],
    importpath = "github.com/DataDog/datadog-agent/pkg/dyninst/irgen/cli",
    tags = ["manual"],
    visibility = ["//visibility:private"],
    deps = select({
        "@rules_go//go/platform:android": [
            "//pkg/dyninst/dyninsttest",
            "//pkg/dyninst/ir",
            "//pkg/dyninst/irgen",
            "//pkg/dyninst/irprinter",
            "//pkg/dyninst/object",
            "//pkg/dyninst/rcjson",
            "//pkg/util/safeelf",
        ],
        "@rules_go//go/platform:linux": [
            "//pkg/dyninst/dyninsttest",
            "//pkg/dyninst/ir",
            "//pkg/dyninst/irgen",
            "//pkg/dyninst/irprinter",
            "//pkg/dyninst/object",
            "//pkg/dyninst/rcjson",
            "//pkg/util/safeelf",
        ],
        "//conditions:default": [],
    }),
)

go_binary(
    name = "cli",
    embed = [":cli_lib"],
    gotags = [
        "test",
        "bpf",
