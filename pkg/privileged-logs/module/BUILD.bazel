load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "module",
    srcs = [
        "handler.go",
        "module.go",
        "open_rust_linux.go",
        "open_rust_stub_linux.go",
    ],
    cdeps = select({
        "@rules_go//go/platform:linux": [
            "//pkg/discovery/module/rust:dd_discovery_cc",
        ],
        "//conditions:default": [],
    }),
    cgo = True,
    clinkopts = [],  # keep
    copts = [],  # keep
    importpath = "github.com/DataDog/datadog-agent/pkg/privileged-logs/module",
    visibility = ["//visibility:public"],
    deps = select({
        "@rules_go//go/platform:android": [
            "//pkg/privileged-logs/common",
            "//pkg/system-probe/api/module",
            "//pkg/util/log",
            "@com_github_hashicorp_golang_lru_v2//simplelru",
        ],
        "@rules_go//go/platform:linux": [
            "//pkg/privileged-logs/common",
            "//pkg/system-probe/api/module",
            "//pkg/util/log",
            "@com_github_hashicorp_golang_lru_v2//simplelru",
        ],
        "//conditions:default": [],
    }),
)

dd_agent_go_test(
    name = "module_test",
    srcs = ["handler_test.go"],
    embed = [":module"],
    gotags_sets = [["bpf"]],
    deps = select({
        "@rules_go//go/platform:android": [
            "//pkg/util/log",
            "@com_github_stretchr_testify//assert",
            "@com_github_stretchr_testify//require",
        ],
        "@rules_go//go/platform:linux": [
            "//pkg/util/log",
            "@com_github_stretchr_testify//assert",
            "@com_github_stretchr_testify//require",
        ],
        "//conditions:default": [],
    }),
)
