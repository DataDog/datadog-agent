load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "jobids",
    srcs = ["handler.go"],
    importpath = "github.com/DataDog/datadog-agent/pkg/gpu/jobids",
    visibility = ["//visibility:public"],
    deps = select({
        "@rules_go//go/platform:android": [
            "//pkg/collector/corechecks/gpu/model",
            "//pkg/gpu/config",
            "//pkg/util/kernel",
            "//pkg/util/log",
        ],
        "@rules_go//go/platform:linux": [
            "//pkg/collector/corechecks/gpu/model",
            "//pkg/gpu/config",
            "//pkg/util/kernel",
            "//pkg/util/log",
        ],
        "//conditions:default": [],
    }),
)

dd_agent_go_test(
    name = "jobids_test",
    srcs = ["handler_test.go"],
    embed = [":jobids"],
    deps = select({
        "@rules_go//go/platform:android": [
            "//pkg/collector/corechecks/gpu/model",
            "//pkg/gpu/config",
            "@com_github_stretchr_testify//assert",
            "@com_github_stretchr_testify//require",
        ],
        "@rules_go//go/platform:linux": [
            "//pkg/collector/corechecks/gpu/model",
            "//pkg/gpu/config",
            "@com_github_stretchr_testify//assert",
            "@com_github_stretchr_testify//require",
        ],
        "//conditions:default": [],
    }),
)
