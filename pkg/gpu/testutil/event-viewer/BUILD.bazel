load("@rules_go//go:def.bzl", "go_binary", "go_library")

go_library(
    name = "event-viewer_lib",
    srcs = ["main.go"],
    importpath = "github.com/DataDog/datadog-agent/pkg/gpu/testutil/event-viewer",
    visibility = ["//visibility:private"],
    deps = select({
        "@rules_go//go/platform:android": [
            "//pkg/gpu/testutil",
        ],
        "@rules_go//go/platform:linux": [
            "//pkg/gpu/testutil",
        ],
        "//conditions:default": [],
    }),
)

go_binary(
    name = "event-viewer",
    embed = [":event-viewer_lib"],
    gotags = [
        "bpf",
        "test",
    ],
    target_compatible_with = ["@platforms//os:linux"],  # keep
    visibility = ["//visibility:public"],
)
