load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "amd",
    srcs = [
        "device.go",
        "gpumetrics.go",
        "kfd.go",
        "kubernetes.go",
        "metrics.go",
        "names.go",
        "testutil.go",
    ],
    importpath = "github.com/DataDog/datadog-agent/pkg/gpu/amd",
    visibility = ["//visibility:public"],
    deps = select({
        "@rules_go//go/platform:android": [
            "@com_github_stretchr_testify//require",
            "@in_yaml_go_yaml_v3//:yaml",
        ],
        "@rules_go//go/platform:linux": [
            "@com_github_stretchr_testify//require",
            "@in_yaml_go_yaml_v3//:yaml",
        ],
        "//conditions:default": [],
    }),
)

dd_agent_go_test(
    name = "amd_test",
    srcs = [
        "device_test.go",
        "fuzz_test.go",
        "gpumetrics_test.go",
        "kfd_test.go",
        "kubernetes_test.go",
        "metrics_test.go",
        "names_test.go",
        "realhw_test.go",
        "topology_test.go",
    ],
    data = glob([
        "testdata/mi300x_vf/*",
        "testdata/mi300x_vf/device/*",
        "testdata/mi300x_vf/hwmon/*",
        "testdata/mi350x_vf/*",
        "testdata/mi350x_vf/device/*",
        "testdata/mi350x_vf/hwmon/*",
        "testdata/mi350x_vf/kfd/*",
        "testdata/smu15_0_8_synthetic/*",
        "testdata/smu15_0_8_synthetic/device/*",
    ]),
    embed = [":amd"],
    embedsrcs = [
        "testdata/mi300x_vf/device/gpu_metrics",
        "testdata/mi350x_vf/device/gpu_metrics",
    ],
    deps = select({
        "@rules_go//go/platform:android": [
            "//pkg/util/gpu",
            "@com_github_stretchr_testify//assert",
            "@com_github_stretchr_testify//require",
        ],
        "@rules_go//go/platform:linux": [
            "//pkg/util/gpu",
            "@com_github_stretchr_testify//assert",
            "@com_github_stretchr_testify//require",
        ],
        "//conditions:default": [],
    }),
)
