load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "sysfsroot",
    srcs = [
        "sysfsroot.go",
        "testutil.go",
    ],
    importpath = "github.com/DataDog/datadog-agent/pkg/gpu/amd/sysfsroot",
    visibility = ["//visibility:public"],
    deps = select({
        "@rules_go//go/platform:android": [
            "//pkg/util/funcs",
            "//pkg/util/kernel",
        ],
        "@rules_go//go/platform:linux": [
            "//pkg/util/funcs",
            "//pkg/util/kernel",
        ],
        "//conditions:default": [],
    }),
)

dd_agent_go_test(
    name = "sysfsroot_test",
    srcs = ["sysfsroot_test.go"],
    embed = [":sysfsroot"],
    deps = select({
        "@rules_go//go/platform:android": [
            "//pkg/util/kernel",
            "@com_github_stretchr_testify//assert",
            "@com_github_stretchr_testify//require",
        ],
        "@rules_go//go/platform:linux": [
            "//pkg/util/kernel",
            "@com_github_stretchr_testify//assert",
            "@com_github_stretchr_testify//require",
        ],
        "//conditions:default": [],
    }),
)
