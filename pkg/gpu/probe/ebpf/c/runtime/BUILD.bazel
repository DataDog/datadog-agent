load("//bazel/rules/ebpf:ebpf.bzl", "ebpf_program_suite")

exports_files(["gpu.c"])

ebpf_program_suite(
    name = "gpu",
    src = "gpu.c",
    core = True,
    extra_flags = [
        "-Ipkg/gpu/probe/ebpf/c",
        "-Ipkg/gpu/probe/ebpf/c/runtime",
        "-Ipkg/network/ebpf/c",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/ebpf/c:ebpf_c_headers",
        "//pkg/gpu/probe/ebpf/c:gpu_headers",
        "//pkg/network/ebpf/c:ebpf_c_network",
    ],
