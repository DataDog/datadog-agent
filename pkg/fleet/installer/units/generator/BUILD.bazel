load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

exports_files(
    glob(["tmpl/*.tmpl"]),
    visibility = ["//pkg/procmgr/rust:__pkg__"],
)

go_library(
    name = "generator_lib",
    srcs = ["main.go"],
    embedsrcs = [
        "tmpl/com.datadoghq.agent.plist.tmpl",
        "tmpl/com.datadoghq.data-plane.plist.tmpl",
        "tmpl/com.datadoghq.installer.plist.tmpl",
        "tmpl/com.datadoghq.procmgr.plist.tmpl",
        "tmpl/com.datadoghq.sysprobe.plist.tmpl",
        "tmpl/datadog-agent-action-executor-windows.yaml.tmpl",
        "tmpl/datadog-agent-action-executor.yaml.tmpl",
        "tmpl/datadog-agent-action-windows.yaml.tmpl",
        "tmpl/datadog-agent-action.service.tmpl",
        "tmpl/datadog-agent-data-plane-windows.yaml.tmpl",
        "tmpl/datadog-agent-data-plane.service.tmpl",
        "tmpl/datadog-agent-ddot-windows.yaml.tmpl",
        "tmpl/datadog-agent-ddot.service.tmpl",
        "tmpl/datadog-agent-ddot.yaml.tmpl",
        "tmpl/datadog-agent-installer.service.tmpl",
        "tmpl/datadog-agent-par-control-windows.yaml.tmpl",
        "tmpl/datadog-agent-par-control.yaml.tmpl",
        "tmpl/datadog-agent-process-windows.yaml.tmpl",
        "tmpl/datadog-agent-process.service.tmpl",
        "tmpl/datadog-agent-procmgr.service.tmpl",
        "tmpl/datadog-agent-rshell-privileged.service.tmpl",
        "tmpl/datadog-agent-rshell-privileged.socket.tmpl",
        "tmpl/datadog-agent-security-windows.yaml.tmpl",
        "tmpl/datadog-agent-security.service.tmpl",
        "tmpl/datadog-agent-sysprobe-darwin.yaml.tmpl",
        "tmpl/datadog-agent-sysprobe-windows.yaml.tmpl",
        "tmpl/datadog-agent-sysprobe.service.tmpl",
        "tmpl/datadog-agent-trace-windows.yaml.tmpl",
        "tmpl/datadog-agent-trace.service.tmpl",
        "tmpl/datadog-agent.service.tmpl",
    ],
    importpath = "github.com/DataDog/datadog-agent/pkg/fleet/installer/units/generator",
    visibility = ["//visibility:private"],
    deps = [
        "//pkg/fleet/installer/units",
        "//pkg/fleet/installer/units/darwinunits",
        "//pkg/fleet/installer/units/linuxunits",
        "//pkg/fleet/installer/units/windowsunits",
        "//pkg/template/text",
    ],
)

go_binary(
    name = "generator",
    embed = [":generator_lib"],
    visibility = ["//visibility:public"],
)

dd_agent_go_test(
    name = "generator_test",
    srcs = ["main_test.go"],
    data = [
        "//pkg/fleet/installer/units/darwinunits:gen",
        "//pkg/fleet/installer/units/linuxunits:gen",
        "//pkg/fleet/installer/units/windowsunits:gen",
    ],
    embed = [":generator_lib"],
    deps = [
        "//pkg/fleet/installer/fixtures",
        "//pkg/fleet/installer/units",
        "//pkg/fleet/installer/units/darwinunits",
        "//pkg/fleet/installer/units/linuxunits",
        "//pkg/fleet/installer/units/windowsunits",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
