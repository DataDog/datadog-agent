load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "exec",
    srcs = [
        "apm_inject_exec_windows.go",
        "dotnet_library_exec.go",
    ],
    importpath = "github.com/DataDog/datadog-agent/pkg/fleet/installer/packages/exec",
    target_compatible_with = ["@platforms//os:windows"],
    visibility = ["//visibility:public"],
    deps = select({
        "@rules_go//go/platform:windows": [
            "//pkg/fleet/installer/errors",
            "//pkg/fleet/installer/paths",
            "//pkg/fleet/installer/telemetry",
        ],
        "//conditions:default": [],
    }),
)

dd_agent_go_test(
    name = "exec_test",
    srcs = ["apm_inject_exec_windows_test.go"],
    embed = [":exec"],
    target_compatible_with = ["@platforms//os:windows"],
    deps = select({
        "@rules_go//go/platform:windows": [
            "//pkg/fleet/installer/paths",
            "@com_github_stretchr_testify//assert",
        ],
        "//conditions:default": [],
    }),
)
