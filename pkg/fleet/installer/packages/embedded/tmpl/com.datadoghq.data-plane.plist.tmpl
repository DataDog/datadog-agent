<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
    <dict>
        <key>Label</key>
        <string>com.datadoghq.data-plane{{if not .Stable}}-exp{{end}}</string>
{{- /* Only the stable set starts at load and is relaunched by launchd: a reboot mid-experiment
       brings back only the stable set. The experiment job is never relaunched: a failed exit of it
       fails the experiment, and the unit supervisor starts the stable set again. A clean exit, as
       when its feature is off, leaves it down. */}}
        <key>RunAtLoad</key>
        <{{if .Stable}}true{{else}}false{{end}}/>
{{- if .Stable}}
        <key>KeepAlive</key>
        <dict>
            <key>SuccessfulExit</key>
            <false/>
        </dict>
{{- end}}
        <key>EnvironmentVariables</key>
        <dict>
            <key>DD_LOG_TO_CONSOLE</key>
            <string>false</string>
{{- if not .Stable}}
            <key>DD_INVENTORIES_FIRST_RUN_DELAY</key>
            <string>5</string>
{{- end}}
        </dict>
        <key>ProgramArguments</key>
        <array>
            <string>{{.ProgramDir}}/embedded/bin/agent-data-plane</string>
            <string>--config</string>
            <string>{{.EtcDir}}/datadog.yaml</string>
            <string>run</string>
            <string>--pidfile</string>
            <string>{{.RunDir}}/agent-data-plane.pid</string>
        </array>
        <key>StandardOutPath</key>
        <string>{{.LogDir}}/launchd_data_plane{{if not .Stable}}-exp{{end}}.log</string>
        <key>StandardErrorPath</key>
        <string>{{.LogDir}}/launchd_data_plane{{if not .Stable}}-exp{{end}}.log</string>
        <key>ExitTimeOut</key>
        <integer>10</integer>
        <key>UserName</key>
        <string>{{.AgentUser}}</string>
        <key>GroupName</key>
        <string>{{.AgentGroup}}</string>
    </dict>
</plist>
