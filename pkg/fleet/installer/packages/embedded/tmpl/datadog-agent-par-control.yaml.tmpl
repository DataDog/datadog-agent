description: Datadog Private Action Runner - Control Plane
command: ${DD_INSTALL_DIR}/embedded/bin/par-control
args:
  - --executor-socket
  - ${DD_INSTALL_DIR}/run/par-executor.sock
  - --ipc-cert-file
  - ${DD_CONF_DIR}/ipc_cert.pem
auto_start: true
# par-control drains for at most 170 seconds, including terminal publication.
stop_timeout: 180
condition_path_exists: ${DD_INSTALL_DIR}/embedded/bin/par-control
restart: on-failure
restart_sec: 2
# A bootstrap failure (e.g. a rejected enrollment) exits after a few seconds.
# With the default 1-second runtime_success_sec that counts as a healthy run,
# so the delay reset to restart_sec on every cycle and par-control re-enrolled
# every ~3s forever. Only a run of at least a minute counts as healthy, so
# repeated failures back off up to restart_max_delay_sec.
runtime_success_sec: 60
restart_max_delay_sec: 300
start_limit_interval_sec: 10
start_limit_burst: 5
environment_file: -${DD_CONF_DIR}/environment
env:
  DD_FLEET_POLICIES_DIR: ${DD_CONF_DIR}/managed/datadog-agent/stable
  PATH: /usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
stdout: inherit
stderr: inherit
