description: Datadog Private Action Runner - Control Plane
command: '{{.InstallDir}}/bin/agent/par-control.exe'
args:
  - --config
  - '{{.EtcDir}}/datadog.yaml'
auto_start: true
# par-control exits on SIGTERM, so it does not need the 90s default.
stop_timeout: 30
condition_path_exists: '{{.InstallDir}}/bin/agent/par-control.exe'
restart: on-failure
restart_sec: 2
start_limit_interval_sec: 10
start_limit_burst: 5
stdout: inherit
stderr: inherit
