[Unit]
Before=datadog-agent.service datadog-agent-exp.service
{{- if .Stable}}
Description=Datadog rshell privileged helper
BindsTo=datadog-agent.service
Conflicts=datadog-agent-exp.service datadog-agent-rshell-privileged-exp.service
{{- else}}
Description=Datadog rshell privileged helper experiment
BindsTo=datadog-agent-exp.service
Conflicts=datadog-agent.service datadog-agent-rshell-privileged.service
# Both variants share a runtime directory; stop the old helper before starting the new one.
After=datadog-agent-rshell-privileged.service
{{- end}}
ConditionPathExists={{.InstallDir}}/embedded/bin/rshell

[Service]
Type=simple
Group=dd-agent
UMask=0077
RuntimeDirectory=datadog-agent-rshell
RuntimeDirectoryMode=0755
EnvironmentFile=-{{.EtcDir}}/environment
Environment="DD_FLEET_POLICIES_DIR={{.FleetPoliciesDir}}"
ExecStart={{.InstallDir}}/embedded/bin/rshell privileged-helper --config={{.EtcDir}}/datadog.yaml --socket=/run/datadog-agent-rshell/privileged.sock --policy=/etc/datadog-agent-rshell/policy.json --idle-timeout=0
Restart=on-failure
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
LockPersonality=yes
RestrictRealtime=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
