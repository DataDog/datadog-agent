[Unit]
# Pulled in by the matching Agent unit's Wants= and stopped with it. The
# privateactionrunner launcher exits without creating the socket unless the
# Agent configuration enables the helper; otherwise it creates the socket and
# replaces itself with the rshell helper, which serves it until the Agent
# stops.
{{- if .Stable}}
Description=Datadog rshell privileged helper
PartOf=datadog-agent.service
Conflicts=datadog-agent-rshell-privileged-exp.service
{{- else}}
Description=Datadog rshell privileged helper experiment
PartOf=datadog-agent-exp.service
Conflicts=datadog-agent-rshell-privileged.service
# Both variants use the same socket: release it before creating it.
After=datadog-agent-rshell-privileged.service
{{- end}}
ConditionPathExists={{.InstallDir}}/embedded/bin/rshell

[Service]
Type=simple
Group=dd-agent
UMask=0077
RuntimeDirectory=datadog-agent-rshell
RuntimeDirectoryMode=0755
EnvironmentFile=-{{.EtcDir}}/environment
Environment="DD_FLEET_POLICIES_DIR={{.FleetPoliciesDir}}"
ExecStart={{.InstallDir}}/embedded/bin/privateactionrunner privileged-helper --cfgpath={{.EtcDir}}/datadog.yaml --helper={{.InstallDir}}/embedded/bin/rshell --socket=/run/datadog-agent-rshell/privileged.sock --policy=/etc/datadog-agent-rshell/policy.json
Restart=on-failure
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
LockPersonality=yes
RestrictRealtime=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
