[Unit]
{{- if .Stable}}
Description=Datadog rshell privileged helper
PartOf=datadog-agent.service
Conflicts=datadog-agent-rshell-privileged-exp.service
ConditionPathExists={{.InstallDir}}/embedded/bin/rshell
ConditionPathExists=/etc/datadog-agent-rshell/enabled
{{- else}}
Description=Datadog rshell privileged helper experiment
PartOf=datadog-agent-exp.service
Conflicts=datadog-agent-rshell-privileged.service
ConditionPathExists={{.InstallDir}}/embedded/bin/rshell
ConditionPathExists=/etc/datadog-agent-rshell/enabled
{{- end}}

[Service]
Type=simple
Group=dd-agent
UMask=0077
ExecStart={{.InstallDir}}/embedded/bin/rshell privileged-helper --policy=/etc/datadog-agent-rshell/policy.json --idle-timeout=30s
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
LockPersonality=yes
RestrictRealtime=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
