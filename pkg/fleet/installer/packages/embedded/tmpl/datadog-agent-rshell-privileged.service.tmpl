[Unit]
{{- if .Stable}}
Description=Datadog rshell privileged helper
# Keep this unit out of the action runner transaction so package experiments
# can hand stable and experiment units over independently.
After=datadog-agent.service
BindsTo=datadog-agent.service
Conflicts=datadog-agent-rshell-privileged-exp.service
ConditionPathExists={{.InstallDir}}/embedded/bin/rshell
{{- else}}
Description=Datadog rshell privileged helper experiment
# Keep this unit out of the action runner transaction so package experiments
# can hand stable and experiment units over independently.
After=datadog-agent-exp.service
BindsTo=datadog-agent-exp.service
Conflicts=datadog-agent-rshell-privileged.service
ConditionPathExists={{.InstallDir}}/embedded/bin/rshell
{{- end}}

[Service]
Type=simple
Group=dd-agent
UMask=0077
ExecStart={{.InstallDir}}/embedded/bin/rshell privileged-helper --policy=/etc/datadog-agent-rshell/policy.json --idle-timeout=30s
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
LockPersonality=yes
RestrictRealtime=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
