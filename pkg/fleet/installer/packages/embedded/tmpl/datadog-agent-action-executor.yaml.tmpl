description: Datadog Private Action Runner - On-Demand Executor
command: ${DD_INSTALL_DIR}/embedded/bin/privateactionrunner
args:
  - run-executor
  - --cfgpath
  - ${DD_CONF_DIR}/datadog.yaml
auto_start: false
condition_path_exists: ${DD_INSTALL_DIR}/embedded/bin/privateactionrunner
restart: never
environment_file: -${DD_CONF_DIR}/environment
env:
  DD_FLEET_POLICIES_DIR: ${DD_CONF_DIR}/managed/datadog-agent/stable
  PATH: /usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
stdout: inherit
stderr: inherit
