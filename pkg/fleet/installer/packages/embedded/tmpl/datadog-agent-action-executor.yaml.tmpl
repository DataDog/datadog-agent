description: Datadog Private Action Runner - On-Demand Executor
command: {{.InstallDir}}/embedded/bin/privateactionrunner
args:
  - run-executor
  - --cfgpath
  - {{.EtcDir}}/datadog.yaml
auto_start: false
{{- if .InheritEnvironment }}
inherit_environment: true
{{- end }}
condition_path_exists: {{.InstallDir}}/embedded/bin/privateactionrunner
restart: never
environment_file: -{{.EtcDir}}/environment
env:
  DD_FLEET_POLICIES_DIR: {{.FleetPoliciesDir}}
  PATH: /usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
stdout: inherit
stderr: inherit
