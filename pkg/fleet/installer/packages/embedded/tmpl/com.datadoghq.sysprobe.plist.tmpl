<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
    <dict>
        <key>Label</key>
        <string>com.datadoghq.sysprobe{{.LabelSuffix}}</string>
        <key>RunAtLoad</key>
        <true/>
{{- if .Supervised}}
        <key>KeepAlive</key>
        <dict>
            <key>SuccessfulExit</key>
            <false/>
        </dict>
{{- end}}
        <key>EnvironmentVariables</key>
        <dict>
            <key>DD_LOG_TO_CONSOLE</key>
            <string>false</string>
            <key>DD_FLEET_POLICIES_DIR</key>
            <string>{{.FleetPoliciesDir}}</string>
{{- if not .Stable}}
            <key>DD_INVENTORIES_FIRST_RUN_DELAY</key>
            <string>5</string>
{{- end}}
        </dict>
        <key>ProgramArguments</key>
        <array>
            <string>{{.ProgramDir}}/embedded/bin/system-probe</string>
            <string>run</string>
            <string>-c</string>
            <string>{{.EtcDir}}</string>
        </array>
        <key>StandardOutPath</key>
        <string>{{.LogDir}}/launchd_sysprobe{{.LabelSuffix}}.log</string>
        <key>StandardErrorPath</key>
        <string>{{.LogDir}}/launchd_sysprobe{{.LabelSuffix}}.log</string>
        <key>ExitTimeOut</key>
        <integer>10</integer>
        <!-- system-probe needs privileges the Agent account does not have. -->
        <key>UserName</key>
        <string>root</string>
        <key>GroupName</key>
        <string>admin</string>
    </dict>
</plist>
