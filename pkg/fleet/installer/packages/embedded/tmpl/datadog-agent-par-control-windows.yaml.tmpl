description: Datadog Private Action Runner - Control Plane
command: '{{.InstallDir}}/bin/agent/par-control.exe'
args:
  - --config
  - '{{.EtcDir}}/datadog.yaml'
# Activation follows with the bootstrap/configuration changes.
auto_start: false
# par-control drains for at most 170 seconds, including terminal publication.
stop_timeout: 180
condition_path_exists: '{{.InstallDir}}/bin/agent/par-control.exe'
restart: on-failure
restart_sec: 2
start_limit_interval_sec: 10
start_limit_burst: 5
# Windows services have no console to inherit, so dd-procmgrd owns the log file.
stdout: '{{.EtcDir}}/logs/par-control.log'
stderr: '{{.EtcDir}}/logs/par-control.log'
