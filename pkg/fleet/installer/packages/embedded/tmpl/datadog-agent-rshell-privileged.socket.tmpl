[Unit]
# No default dependencies: they would order this socket before sockets.target,
# but it is ordered after the agent services, which start after basic.target and
# so after sockets.target. systemd breaks that cycle at boot by dropping a start
# job. The other default dependencies are kept explicitly below.
DefaultDependencies=no
Requires=sysinit.target
After=sysinit.target
Before=shutdown.target
Conflicts=shutdown.target
{{- if .Stable}}
Description=Datadog rshell privileged helper socket
After=datadog-agent.service datadog-agent-action.service
BindsTo=datadog-agent.service datadog-agent-action.service
Conflicts=datadog-agent-rshell-privileged-exp.socket
ConditionPathExists={{.InstallDir}}/embedded/bin/rshell
{{- else}}
Description=Datadog rshell privileged helper experiment socket
After=datadog-agent-exp.service datadog-agent-action-exp.service
BindsTo=datadog-agent-exp.service datadog-agent-action-exp.service
Conflicts=datadog-agent-rshell-privileged.socket
ConditionPathExists={{.InstallDir}}/embedded/bin/rshell
{{- end}}

[Socket]
{{- if .Stable}}
ListenStream=/run/datadog/rshell-privileged.sock
Service=datadog-agent-rshell-privileged.service
{{- else}}
ListenStream=/run/datadog/rshell-privileged.sock
Service=datadog-agent-rshell-privileged-exp.service
{{- end}}
SocketUser=dd-agent
SocketGroup=dd-agent
SocketMode=0600
DirectoryMode=0750
RemoveOnStop=yes

[Install]
{{- if .Stable}}
WantedBy=sockets.target datadog-agent-action.service
{{- else}}
WantedBy=sockets.target datadog-agent-action-exp.service
{{- end}}
