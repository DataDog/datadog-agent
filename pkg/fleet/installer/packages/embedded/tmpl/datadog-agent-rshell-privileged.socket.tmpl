[Unit]
# The socket is pulled in by the matching Agent unit's Wants= and stops with
# it, so it is never enabled. It lives outside /run/datadog, the Agent's
# RuntimeDirectory, so it needs no ordering against the Agent and keeps the
# default socket dependencies. systemd starts the root helper only when a
# client connects; PAR only connects when the helper is enabled in its config.
{{- if .Stable}}
Description=Datadog rshell privileged helper socket
PartOf=datadog-agent.service
Conflicts=datadog-agent-rshell-privileged-exp.socket
{{- else}}
Description=Datadog rshell privileged helper experiment socket
PartOf=datadog-agent-exp.service
Conflicts=datadog-agent-rshell-privileged.socket
# Both variants listen on the same path: release it before binding.
After=datadog-agent-rshell-privileged.socket
{{- end}}
ConditionPathExists={{.InstallDir}}/embedded/bin/rshell

[Socket]
ListenStream=/run/datadog-agent-rshell/privileged.sock
{{- if .Stable}}
Service=datadog-agent-rshell-privileged.service
{{- else}}
Service=datadog-agent-rshell-privileged-exp.service
{{- end}}
SocketUser=dd-agent
SocketGroup=dd-agent
SocketMode=0600
DirectoryMode=0755
RemoveOnStop=yes
