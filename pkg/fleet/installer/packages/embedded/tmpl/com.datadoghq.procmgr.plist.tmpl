<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
    <dict>
        <key>Label</key>
        <string>com.datadoghq.procmgr{{.LabelSuffix}}</string>
        <key>RunAtLoad</key>
        <true/>
        <key>KeepAlive</key>
        <dict>
            <key>SuccessfulExit</key>
            <false/>
        </dict>
        <key>EnvironmentVariables</key>
        <dict>
            <key>DD_LOG_TO_CONSOLE</key>
            <string>false</string>
            <key>DD_INSTALL_DIR</key>
            <string>{{.ProgramDir}}</string>
            <key>DD_CONF_DIR</key>
            <string>{{.EtcDir}}</string>
            <key>DD_PID_DIR</key>
            <string>{{.RunDir}}</string>
            <key>DD_PM_CONFIG_DIR</key>
            <string>{{.ProgramDir}}/processes.d</string>
        </dict>
        <key>ProgramArguments</key>
        <array>
            <string>{{.ProgramDir}}/embedded/bin/dd-procmgrd</string>
        </array>
        <key>StandardOutPath</key>
        <string>{{.LogDir}}/launchd_procmgr{{.LabelSuffix}}.log</string>
        <key>StandardErrorPath</key>
        <string>{{.LogDir}}/launchd_procmgr{{.LabelSuffix}}.log</string>
        <key>ExitTimeOut</key>
        <integer>10</integer>
        <!-- root: supervises privileged children such as system-probe -->
        <key>UserName</key>
        <string>root</string>
        <key>GroupName</key>
        <string>admin</string>
    </dict>
</plist>
