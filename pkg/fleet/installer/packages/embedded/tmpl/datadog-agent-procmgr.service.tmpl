[Unit]
{{- if .Stable}}
Description=Datadog Process Manager Daemon
After=datadog-agent.service datadog-agent-exp.service
BindsTo=datadog-agent.service
Conflicts=datadog-agent-exp.service datadog-agent-procmgr-exp.service
{{- else}}
Description=Datadog Process Manager Daemon Experiment
After=datadog-agent.service datadog-agent-exp.service
BindsTo=datadog-agent-exp.service
Conflicts=datadog-agent.service datadog-agent-procmgr.service
{{- end}}
ConditionPathExists={{.InstallDir}}/embedded/bin/dd-procmgrd

[Service]
Type=simple
User=dd-agent
Restart=on-failure
EnvironmentFile=-{{.EtcDir}}/environment
Environment="DD_PM_CONFIG_DIR={{.InstallDir}}/processes.d"
Environment="DD_CONF_DIR={{.EtcDir}}"
Environment="DD_PID_DIR={{.PIDDir}}"
Environment="DD_INSTALL_DIR={{.InstallDir}}"
{{- if not .Stable}}
Environment="DD_INVENTORIES_FIRST_RUN_DELAY=5"
{{- end}}
RuntimeDirectory=datadog-procmgrd
ExecStart={{.InstallDir}}/embedded/bin/dd-procmgrd
StartLimitInterval=10
StartLimitBurst=5
# Signal only dd-procmgrd on stop so it can stop its processes in dependency order.
# systemd SIGKILLs any leftover processes once it exits.
# TimeoutStopSec covers a chain of 3 processes at the default stop_timeout (90s each, plus a 10s force-kill wait each, 300s in total) with 60s of slack.
# Longer chains or longer stop_timeout values need a lower stop_timeout to fit.
KillMode=mixed
TimeoutStopSec=360

[Install]
WantedBy=multi-user.target
