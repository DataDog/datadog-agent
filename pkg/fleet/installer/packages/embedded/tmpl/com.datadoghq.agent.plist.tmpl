<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
    <dict>
        <key>Label</key>
        <string>com.datadoghq.agent{{if not .Stable}}-exp{{end}}</string>
{{- /* Only the stable set starts at load and is relaunched by launchd. The experiment Agent is
       never relaunched: like its Linux unit (Restart=no, ExecStopPost=/bin/false, OnFailure=), any
       exit of it fails the experiment, and the unit supervisor starts the stable set again. A
       reboot mid-experiment brings back only the stable set. */}}
        <key>RunAtLoad</key>
        <{{if .Stable}}true{{else}}false{{end}}/>
{{- if .Stable}}
        <key>KeepAlive</key>
        <dict>
            <key>SuccessfulExit</key>
            <false/>
        </dict>
{{- end}}
        <key>EnvironmentVariables</key>
        <dict>
            <key>DD_LOG_TO_CONSOLE</key>
            <string>false</string>
{{- if not .Stable}}
            <key>DD_INVENTORIES_FIRST_RUN_DELAY</key>
            <string>5</string>
            <key>DD_CONFD_PATH</key>
            <string>{{.EtcDir}}/conf.d</string>
{{- end}}
        </dict>
        <key>ProgramArguments</key>
        <array>
            <string>{{.ProgramDir}}/bin/agent/agent</string>
            <string>run</string>
            <string>-c</string>
            <string>{{.EtcDir}}</string>
            <string>--sysprobecfgpath={{.EtcDir}}/system-probe.yaml</string>
        </array>
        <key>StandardOutPath</key>
        <string>{{.LogDir}}/launchd{{if not .Stable}}-exp{{end}}.log</string>
        <key>StandardErrorPath</key>
        <string>{{.LogDir}}/launchd{{if not .Stable}}-exp{{end}}.log</string>
        <key>ExitTimeOut</key>
        <integer>10</integer>
        <key>UserName</key>
        <string>{{.AgentUser}}</string>
        <key>GroupName</key>
        <string>{{.AgentGroup}}</string>
    </dict>
</plist>
