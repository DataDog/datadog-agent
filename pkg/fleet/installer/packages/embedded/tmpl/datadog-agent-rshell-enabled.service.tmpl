[Unit]
# Runs before every start of the privileged helper, which Requires= it: the
# helper does no work unless the Agent configuration enables it. It loads the
# configuration as dd-agent, never as root, because loading it can run the
# configured secret backend.
{{- if .Stable}}
Description=Datadog rshell privileged helper enablement check
{{- else}}
Description=Datadog rshell privileged helper experiment enablement check
{{- end}}
ConditionPathExists={{.InstallDir}}/embedded/bin/privateactionrunner

[Service]
Type=oneshot
User=dd-agent
EnvironmentFile=-{{.EtcDir}}/environment
Environment="DD_FLEET_POLICIES_DIR={{.FleetPoliciesDir}}"
ExecStart={{.InstallDir}}/embedded/bin/privateactionrunner privileged-helper-enabled --cfgpath={{.EtcDir}}/datadog.yaml
