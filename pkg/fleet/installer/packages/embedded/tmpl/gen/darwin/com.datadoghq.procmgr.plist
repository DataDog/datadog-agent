<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
    <dict>
        <key>Label</key>
        <string>com.datadoghq.procmgr</string>
        <key>RunAtLoad</key>
        <true/>
        <key>KeepAlive</key>
        <dict>
            <key>SuccessfulExit</key>
            <false/>
        </dict>
        <key>EnvironmentVariables</key>
        <dict>
            <key>DD_LOG_TO_CONSOLE</key>
            <string>false</string>
            <key>DD_INSTALL_DIR</key>
            <string>/opt/datadog-agent</string>
            <key>DD_CONF_DIR</key>
            <string>/opt/datadog-agent/etc</string>
            <key>DD_PID_DIR</key>
            <string>/opt/datadog-agent/run</string>
            <key>DD_PM_CONFIG_DIR</key>
            <string>/opt/datadog-agent/processes.d</string>
        </dict>
        <key>ProgramArguments</key>
        <array>
            <string>/opt/datadog-agent/embedded/bin/dd-procmgrd</string>
        </array>
        <key>StandardOutPath</key>
        <string>/opt/datadog-agent/logs/launchd_procmgr.log</string>
        <key>StandardErrorPath</key>
        <string>/opt/datadog-agent/logs/launchd_procmgr.log</string>
        <key>ExitTimeOut</key>
        <integer>10</integer>
        <!-- root: supervises privileged children such as system-probe.
             Group daemon (not admin): the UDS is 0660 with no peer auth, so the socket
             group must stay the Agent primary group. admin would let any admin-group
             user call mutating RPCs as root. -->
        <key>UserName</key>
        <string>root</string>
        <key>GroupName</key>
        <string>daemon</string>
    </dict>
</plist>
