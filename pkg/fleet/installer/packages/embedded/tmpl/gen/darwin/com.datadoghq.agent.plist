<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
    <dict>
        <key>Label</key>
        <string>com.datadoghq.agent</string>
        <!-- RunAtLoad only on the stable set: the experiment set must not restart itself, since
             the stable definition stays on disk (unloaded, not removed) for the whole time an
             experiment runs, and a reboot mid-experiment must bring back only the stable job. -->
        <key>RunAtLoad</key>
        <true/>
        <key>KeepAlive</key>
        <dict>
            <key>SuccessfulExit</key>
            <false/>
        </dict>
        <key>EnvironmentVariables</key>
        <dict>
            <key>DD_LOG_TO_CONSOLE</key>
            <string>false</string>
        </dict>
        <key>ProgramArguments</key>
        <array>
            <string>/opt/datadog-agent/bin/agent/agent</string>
            <string>run</string>
            <string>-c</string>
            <string>/opt/datadog-agent/etc</string>
            <string>--sysprobecfgpath</string>
            <string>/opt/datadog-agent/etc</string>
            <string>-p</string>
            <string>/opt/datadog-agent/run/agent.pid</string>
        </array>
        <key>StandardOutPath</key>
        <string>/opt/datadog-agent/logs/launchd.log</string>
        <key>StandardErrorPath</key>
        <string>/opt/datadog-agent/logs/launchd.log</string>
        <key>ExitTimeOut</key>
        <integer>10</integer>
        <key>UserName</key>
        <string>_dd-agent</string>
        <key>GroupName</key>
        <string>daemon</string>
    </dict>
</plist>
