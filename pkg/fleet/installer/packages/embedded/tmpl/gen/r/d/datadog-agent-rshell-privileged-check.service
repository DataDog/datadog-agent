[Unit]
# Runs before every start of the privileged helper, which Requires= it: the
# helper does no work unless the Agent configuration enables it. It loads the
# configuration as dd-agent, never as root, because loading it can run the
# configured secret backend.
Description=Datadog rshell privileged helper enablement check
ConditionPathExists=/opt/datadog-agent/embedded/bin/privateactionrunner

[Service]
Type=oneshot
User=dd-agent
EnvironmentFile=-/etc/datadog-agent/environment
Environment="DD_FLEET_POLICIES_DIR=/etc/datadog-agent/managed/datadog-agent/stable"
ExecStart=/opt/datadog-agent/embedded/bin/privateactionrunner privileged-helper-enabled --cfgpath=/etc/datadog-agent/datadog.yaml
