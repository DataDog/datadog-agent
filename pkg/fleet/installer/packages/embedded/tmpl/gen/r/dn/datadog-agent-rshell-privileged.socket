[Unit]
# The socket is pulled in by the matching Agent unit's Wants= and stops with
# it. It is never enabled: the root-owned marker below is the only
# opt-in. The socket lives outside /run/datadog, which is the Agent's
# RuntimeDirectory, so it needs no ordering against the Agent and keeps the
# default socket dependencies.
Description=Datadog rshell privileged helper socket
PartOf=datadog-agent.service
Conflicts=datadog-agent-rshell-privileged-exp.socket
ConditionPathExists=/opt/datadog-agent/embedded/bin/rshell
ConditionPathExists=/etc/datadog-agent-rshell/enabled

[Socket]
ListenStream=/run/datadog-agent-rshell/privileged.sock
Service=datadog-agent-rshell-privileged.service
SocketUser=dd-agent
SocketGroup=dd-agent
SocketMode=0600
DirectoryMode=0755
RemoveOnStop=yes
