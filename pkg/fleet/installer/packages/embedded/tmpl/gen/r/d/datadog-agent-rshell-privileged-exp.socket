[Unit]
# Default dependencies would order the socket before sockets.target, which is
# itself ordered before the PAR service this socket is ordered after: a boot
# ordering cycle that makes systemd drop sockets.target.
DefaultDependencies=no
Before=shutdown.target
Conflicts=shutdown.target
Description=Datadog rshell privileged helper experiment socket
After=datadog-agent-exp.service datadog-agent-action-exp.service
BindsTo=datadog-agent-exp.service datadog-agent-action-exp.service
Conflicts=datadog-agent-rshell-privileged.socket
ConditionPathExists=/opt/datadog-agent/embedded/bin/rshell
ConditionPathExists=/run/datadog-agent-rshell/enabled-exp

[Socket]
ListenStream=/run/datadog/rshell-privileged.sock
Service=datadog-agent-rshell-privileged-exp.service
SocketUser=dd-agent
SocketGroup=dd-agent
SocketMode=0600
DirectoryMode=0750
RemoveOnStop=yes

[Install]
WantedBy=datadog-agent-action-exp.service
