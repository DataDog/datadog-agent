[Unit]
# Starting after the Agent must not also order this socket before sockets.target.
DefaultDependencies=no
Requires=sysinit.target
After=sysinit.target
Before=shutdown.target
Conflicts=shutdown.target
Description=Datadog rshell privileged helper experiment socket
After=datadog-agent-exp.service
BindsTo=datadog-agent-exp.service
Conflicts=datadog-agent-rshell-privileged.socket
ConditionPathExists=/opt/datadog-agent/embedded/bin/rshell

[Socket]
ListenStream=/run/datadog/rshell-privileged.sock
Service=datadog-agent-rshell-privileged-exp.service
SocketUser=dd-agent
SocketGroup=dd-agent
SocketMode=0600
DirectoryMode=0750
RemoveOnStop=yes

[Install]
WantedBy=sockets.target datadog-agent-exp.service
