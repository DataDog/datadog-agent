[Unit]
Description=Datadog rshell privileged helper
# Keep this unit out of the action runner transaction so package experiments
# can hand stable and experiment units over independently.
After=datadog-agent.service
BindsTo=datadog-agent.service
Conflicts=datadog-agent-rshell-privileged-exp.service
ConditionPathExists=/opt/datadog-agent/embedded/bin/rshell

[Service]
Type=simple
Group=dd-agent
UMask=0077
ExecStart=/opt/datadog-agent/embedded/bin/rshell privileged-helper --policy=/etc/datadog-agent-rshell/policy.json --idle-timeout=30s
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
LockPersonality=yes
RestrictRealtime=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
