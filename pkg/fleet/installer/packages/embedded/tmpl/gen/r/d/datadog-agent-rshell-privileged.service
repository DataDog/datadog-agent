[Unit]
# Pulled in by the matching Agent unit's Wants= and bound to it, so it is
# stopped and its RuntimeDirectory removed whenever the Agent stops or fails. The
# privateactionrunner launcher exits unless the Agent configuration enables the
# helper; otherwise it replaces itself with the rshell helper, which creates
# the socket in this unit's RuntimeDirectory and serves it until the Agent
# stops.
Description=Datadog rshell privileged helper
BindsTo=datadog-agent.service
After=datadog-agent.service datadog-agent-exp.service
Conflicts=datadog-agent-exp.service datadog-agent-rshell-privileged-exp.service
ConditionPathExists=/opt/datadog-agent/embedded/bin/rshell

[Service]
Type=simple
Group=dd-agent
UMask=0077
RuntimeDirectory=datadog-agent-rshell
RuntimeDirectoryMode=0755
# No EnvironmentFile=: this unit runs as root and /etc/datadog-agent is writable by
# dd-agent, so sourcing an environment file from there would let dd-agent inject
# variables (e.g. LD_PRELOAD) into the root launcher before any of its checks
# run. The launcher needs nothing from it; the only variable it is given is this
# root-controlled literal baked into the unit.
Environment="DD_FLEET_POLICIES_DIR=/etc/datadog-agent/managed/datadog-agent/stable"
ExecStart=/opt/datadog-agent/embedded/bin/privateactionrunner privileged-helper --cfgpath=/etc/datadog-agent/datadog.yaml --helper=/opt/datadog-agent/embedded/bin/rshell --socket=/run/datadog-agent-rshell/privileged.sock --policy=/etc/datadog-agent-rshell/policy.json
Restart=on-failure
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
LockPersonality=yes
RestrictRealtime=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
