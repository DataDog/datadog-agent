description: Datadog Private Action Runner
command: {{yamlQuote (print .InstallDir "/bin/agent/privateactionrunner.exe")}}
args:
  - run
  - --cfgpath
  - {{yamlQuote (print .EtcDir "/datadog.yaml")}}
auto_start: true
condition_path_exists: {{yamlQuote (print .InstallDir "/bin/agent/privateactionrunner.exe")}}
restart: on-failure
restart_sec: 2
start_limit_interval_sec: 10
start_limit_burst: 5
stdout: inherit
stderr: inherit
