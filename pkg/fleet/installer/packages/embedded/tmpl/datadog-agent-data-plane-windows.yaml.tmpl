description: Datadog Agent Data Plane
command: '{{.InstallDir}}/bin/agent/agent-data-plane.exe'
args:
  - --config
  - '{{.EtcDir}}/datadog.yaml'
  - run
  - --pidfile
  - '{{.EtcDir}}/run/agent-data-plane.pid'
auto_start: true
condition_path_exists: '{{.InstallDir}}/bin/agent/agent-data-plane.exe'
# Start ADP only when data_plane.enabled is true. Without this gate procmgr would
# spawn ADP on every host just to watch it exit when disabled.
condition_config_any:
  - path: '{{.EtcDir}}/datadog.yaml'
    keys:
      - data_plane.enabled
restart: on-failure
restart_sec: 2
start_limit_interval_sec: 10
start_limit_burst: 5
stdout: inherit
stderr: inherit
