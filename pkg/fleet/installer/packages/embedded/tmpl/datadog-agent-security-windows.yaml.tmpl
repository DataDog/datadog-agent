description: Datadog Security Agent
command: '{{.InstallDir}}/bin/agent/security-agent.exe'
args:
  - start
  - -c
  - '{{.EtcDir}}/datadog.yaml'
  - -c
  - '{{.EtcDir}}/security-agent.yaml'
  - --sysprobe-config
  - '{{.EtcDir}}/system-probe.yaml'
# Keep true with SCM suppression: false leaves no security-agent when the legacy service is skipped.
auto_start: true
condition_path_exists: '{{.InstallDir}}/bin/agent/security-agent.exe'
# cws Servicedef (sysprobeConf). Compliance-only omitted: Windows does not start SCM for that today.
condition_config_any:
  - path: '{{.EtcDir}}/system-probe.yaml'
    keys:
      - runtime_security_config.enabled
# on-failure: disabled security-agent exits 0; `always` would respawn.
restart: on-failure
restart_sec: 2
start_limit_interval_sec: 10
start_limit_burst: 5
stdout: inherit
stderr: inherit
