description: Datadog Security Agent
command: '{{.InstallDir}}/bin/agent/security-agent.exe'
args:
  - start
  - -c
  - '{{.EtcDir}}/datadog.yaml'
  - -c
  - '{{.EtcDir}}/security-agent.yaml'
  - --sysprobe-config
  - '{{.EtcDir}}/system-probe.yaml'
auto_start: false
condition_path_exists: '{{.InstallDir}}/bin/agent/security-agent.exe'
# Gate matches the cws dependent service (sysprobeConf). Compliance-only is omitted:
# Windows does not start datadog-security-agent for that case today.
condition_config_any:
  - path: '{{.EtcDir}}/system-probe.yaml'
    keys:
      - runtime_security_config.enabled
# on-failure: security-agent exits 0 when all components are disabled; `always` would respawn.
restart: on-failure
restart_sec: 2
start_limit_interval_sec: 10
start_limit_burst: 5
stdout: inherit
stderr: inherit
