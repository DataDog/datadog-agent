description: Datadog Trace Agent
command: '{{.InstallDir}}/bin/agent/trace-agent.exe'
args:
  - --config
  - '{{.EtcDir}}/datadog.yaml'
# dd-procmgr supervises trace-agent on Windows when this file exists, process_manager.enabled
# is set, and dd-procmgr-service starts successfully. The core Agent then skips the legacy
# datadog-trace-agent service. If dd-procmgr does not start, IsEnabled falls back to that
# SCM service. Setting auto_start back to false would leave trace-agent unsupervised when
# suppression succeeds.
auto_start: true
condition_path_exists: '{{.InstallDir}}/bin/agent/trace-agent.exe'
# Transcribes the apm Servicedef in dependent_services_windows.go: any-of over
# apm_config.enabled and apm_config.error_tracking_standalone.enabled, matching
# utils.IsAPMEnabled. The same keys drive the SCM fallback when dd-procmgr is down.
condition_config_any:
  - path: '{{.EtcDir}}/datadog.yaml'
    keys:
      - apm_config.enabled
      - apm_config.error_tracking_standalone.enabled
restart: on-failure
restart_sec: 2
start_limit_interval_sec: 10
start_limit_burst: 5
stdout: inherit
stderr: inherit
