"""Scripts and configuration embedded into the installer as data."""

# Don't try to make a package for the generator functions. We do that here as :tmpl_lib.
# gazelle:exclude tmpl/*.go

load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

exports_files(
    glob(["**/*.tmpl"]),
    visibility = ["//pkg/procmgr/rust:__pkg__"],
)

# keep
service_srcs = glob([
    "tmpl/gen/pm/processes.d/*.yaml",
    "tmpl/gen/windows/*.yaml",
    "tmpl/gen/pm/debrpm/*.service",
    "tmpl/gen/pm/oci/*.service",
    "tmpl/gen/sd/debrpm/*.service",
    "tmpl/gen/sd/oci/*.service",
])

# Selected by GetSystemdUnit/GetProcmgrUnit on hosts without ambient capability support. These must
# be embedded in the production library, not just in tmpl_test, or the shipped binary cannot read
# them.
# keep
nocap_service_srcs = glob([
    "tmpl/gen/pm/debrpm-nc/*.service",
    "tmpl/gen/pm/oci-nc/*.service",
    "tmpl/gen/sd/debrpm-nc/*.service",
    "tmpl/gen/sd/oci-nc/*.service",
])

go_library(
    name = "embedded",
    srcs = ["embed.go"],
    # keep
    embedsrcs = [
        "scripts/dd-cleanup",
        "scripts/dd-container-install",
        "scripts/dd-host-install",
    ] + service_srcs + nocap_service_srcs,
    importpath = "github.com/DataDog/datadog-agent/pkg/fleet/installer/packages/embedded",
    visibility = ["//visibility:public"],
)

# keep
go_library(
    name = "tmpl_lib",
    srcs = ["tmpl/main.go"],
    embedsrcs = [
        "tmpl/datadog-agent-action-executor.yaml.tmpl",
        "tmpl/datadog-agent-action-executor-windows.yaml.tmpl",
        "tmpl/datadog-agent-action.service.tmpl",
        "tmpl/datadog-agent-rshell-privileged.service.tmpl",
        "tmpl/datadog-agent-rshell-privileged.socket.tmpl",
        "tmpl/datadog-agent-action-windows.yaml.tmpl",
        "tmpl/datadog-agent-data-plane.service.tmpl",
        "tmpl/datadog-agent-data-plane-windows.yaml.tmpl",
        "tmpl/datadog-agent-ddot.service.tmpl",
        "tmpl/datadog-agent-ddot.yaml.tmpl",
        "tmpl/datadog-agent-ddot-windows.yaml.tmpl",
        "tmpl/datadog-agent-installer.service.tmpl",
        "tmpl/datadog-agent-process.service.tmpl",
        "tmpl/datadog-agent-procmgr.service.tmpl",
        "tmpl/datadog-agent-security.service.tmpl",
        "tmpl/datadog-agent-sysprobe.service.tmpl",
        "tmpl/datadog-agent-trace.service.tmpl",
        "tmpl/datadog-agent.service.tmpl",
    ],
    importpath = "github.com/DataDog/datadog-agent/pkg/fleet/installer/packages/embedded/tmpl",
    visibility = ["//visibility:private"],
    deps = ["//pkg/template/text"],
)

go_binary(
    name = "tmpl",
    embed = [":tmpl_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "tmpl_test",
    srcs = ["tmpl/main_test.go"],
    embed = [":tmpl_lib"],
    # keep
    embedsrcs = glob(["tmpl/**"]),
    tags = ["dd_agent_go_test"],
    deps = [
        "//pkg/fleet/installer/fixtures",
        "@com_github_stretchr_testify//assert",
    ],
)

dd_agent_go_test(
    name = "embedded_test",
    srcs = ["embed_test.go"],
    embed = [":embedded"],
    deps = [
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
