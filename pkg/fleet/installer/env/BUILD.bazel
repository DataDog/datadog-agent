load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "env",
    srcs = [
        "env.go",
        "process_manager_default.go",
        "process_manager_linux.go",
        "process_manager_windows.go",
    ],
    importpath = "github.com/DataDog/datadog-agent/pkg/fleet/installer/env",
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/fips",
        "@org_golang_x_net//http/httpproxy",
    ] + select({
        "@rules_go//go/platform:windows": [
            "@org_golang_x_sys//windows/registry",
        ],
        "//conditions:default": [],
    }),
)

dd_agent_go_test(
    name = "env_test",
    srcs = [
        "env_test.go",
        "process_manager_linux_test.go",
    ],
    embed = [":env"],
    deps = [
        "//pkg/fips",
        "@com_github_stretchr_testify//assert",
    ] + select({
        "@rules_go//go/platform:android": [
            "@com_github_stretchr_testify//require",
        ],
        "@rules_go//go/platform:linux": [
            "@com_github_stretchr_testify//require",
        ],
        "//conditions:default": [],
    }),
)
