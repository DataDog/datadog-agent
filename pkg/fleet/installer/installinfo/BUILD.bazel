load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

package(default_package_metadata = ["//pkg/fleet/installer:go_package_metadata"])

go_library(
    name = "installinfo",
    srcs = ["installinfo.go"],
    importpath = "github.com/DataDog/datadog-agent/pkg/fleet/installer/installinfo",
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/fleet/installer/paths",
        "//pkg/fleet/installer/telemetry",
        "//pkg/util/log",
        "//pkg/version",
        "@com_github_google_uuid//:uuid",
        "@in_yaml_go_yaml_v3//:yaml",
    ],
)

dd_agent_go_test(
    name = "installinfo_test",
    srcs = ["installinfo_test.go"],
    embed = [":installinfo"],
    deps = [
        "//pkg/version",
        "@com_github_google_uuid//:uuid",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
        "@in_yaml_go_yaml_v3//:yaml",
    ],
)
