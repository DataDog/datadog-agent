load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "perf",
    srcs = ["event.go"],
    importpath = "github.com/DataDog/datadog-agent/pkg/ebpf/perf",
    visibility = ["//visibility:public"],
    deps = select({
        "@rules_go//go/platform:android": [
            "//pkg/ebpf",
            "//pkg/ebpf/modifiers",
            "//pkg/ebpf/names",
            "//pkg/ebpf/telemetry",
            "//pkg/util/sync",
            "@com_github_cilium_ebpf//:ebpf",
            "@com_github_cilium_ebpf//asm",
            "@com_github_cilium_ebpf//features",
            "@com_github_cilium_ebpf//perf",
            "@com_github_cilium_ebpf//ringbuf",
            "@com_github_datadog_ebpf_manager//:ebpf-manager",
        ],
        "@rules_go//go/platform:linux": [
            "//pkg/ebpf",
            "//pkg/ebpf/modifiers",
            "//pkg/ebpf/names",
            "//pkg/ebpf/telemetry",
            "//pkg/util/sync",
            "@com_github_cilium_ebpf//:ebpf",
            "@com_github_cilium_ebpf//asm",
            "@com_github_cilium_ebpf//features",
            "@com_github_cilium_ebpf//perf",
            "@com_github_cilium_ebpf//ringbuf",
            "@com_github_datadog_ebpf_manager//:ebpf-manager",
        ],
        "//conditions:default": [],
    }),
)

dd_agent_go_test(
    name = "perf_test",
    srcs = ["event_test.go"],
    embed = [":perf"],
    gotags_sets = [["bpf"]],
    include_default = False,
    deps = select({
        "@rules_go//go/platform:android": [
            "//pkg/ebpf/names",
            "@com_github_cilium_ebpf//perf",
            "@com_github_cilium_ebpf//ringbuf",
            "@com_github_datadog_ebpf_manager//:ebpf-manager",
            "@com_github_stretchr_testify//assert",
            "@com_github_stretchr_testify//require",
        ],
        "@rules_go//go/platform:linux": [
            "//pkg/ebpf/names",
            "@com_github_cilium_ebpf//perf",
            "@com_github_cilium_ebpf//ringbuf",
            "@com_github_datadog_ebpf_manager//:ebpf-manager",
            "@com_github_stretchr_testify//assert",
            "@com_github_stretchr_testify//require",
        ],
        "//conditions:default": [],
    }),
)
