# gazelle:ebpf_c on

# Both variants are reached only through vmlinux.h, which picks one by
# architecture; route them to the target that makes that choice in Bazel.
# gazelle:resolve ebpf_c vmlinux_6_14_0.h //pkg/ebpf/c:hdr/vmlinux_arch
# gazelle:resolve ebpf_c vmlinux_6_14_0_arm.h //pkg/ebpf/c:hdr/vmlinux_arch

load("@linux_headers//:defs.bzl", "KERNEL_ARCH")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel/rules/ebpf:ebpf.bzl", "ebpf_prog")

# Must match _get_arch_flags in //bazel/rules/ebpf:ebpf.bzl, which falls back to
# the detected kernel arch when the target_arch flag is unset.
_DEFAULT_VMLINUX = ":hdr/vmlinux_6_14_0_arm" if KERNEL_ARCH == "arm64" else ":hdr/vmlinux_6_14_0"

# vmlinux.h switches on __TARGET_ARCH_arm64, a define the rule derives from the
# same flag, so only the selected variant is ever read.
# keep
cc_library(
    name = "hdr/vmlinux_arch",
    visibility = ["//visibility:public"],
    deps = select({
        "//bazel/rules/ebpf:target_arch_aarch64": [":hdr/vmlinux_6_14_0_arm"],
        "//bazel/rules/ebpf:target_arch_x86_64": [":hdr/vmlinux_6_14_0"],
        "//conditions:default": [_DEFAULT_VMLINUX],
    }),
)

_HDRS = glob(["*.h"])

cc_library(
    name = "ebpf_c_headers",
    hdrs = _HDRS,
    includes = ["."],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "ebpf_c_headers_files",
    srcs = _HDRS,
    visibility = ["//visibility:public"],
)

ebpf_prog(
    name = "lock_contention",
    src = "lock_contention.c",
    core = True,
    visibility = ["//visibility:public"],
    deps = [
        ":hdr/bpf_builtins",
        ":hdr/bpf_core_read",
        ":hdr/bpf_helpers",
        ":hdr/bpf_metadata",
        ":hdr/bpf_tracing",
        ":hdr/compiler",
        ":hdr/ktypes",
        ":hdr/lock_contention",
        ":hdr/map-defs",
    ],
)

ebpf_prog(
    name = "ksyms_iter",
