load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/ebpf:cgo_godefs.bzl", "cgo_godefs")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

# gazelle:resolve go github.com/DataDog/datadog-agent/pkg/ebpf/ebpftest //pkg/ebpf/ebpftest:cgo_align

exports_files([
    "types_linux.go",
    "types_linux_test.go",
])

cgo_godefs(
    name = "types_godefs",
    src = "types.go",
    visibility = ["//visibility:public"],
)

go_library(
    name = "usdt",
    srcs = [
        "args.go",
        "doc.go",
        "probes.go",
        "registry.go",
        "types_linux.go",
    ],
    cgo = True,
    importpath = "github.com/DataDog/datadog-agent/pkg/ebpf/usdt",
    visibility = ["//visibility:public"],
    deps = select({
        "@rules_go//go/platform:android": [
            "//pkg/util/safeelf",
        ],
        "@rules_go//go/platform:linux": [
            "//pkg/util/safeelf",
        ],
        "//conditions:default": [],
    }),
)

dd_agent_go_test(
    name = "usdt_test",
    srcs = [
        "args_test.go",
        "probes_test.go",
        "registry_test.go",
        "types_linux_test.go",
    ],
    data = glob(["testdata/**"]),
    embed = [":usdt"],
    deps = select({
        "@rules_go//go/platform:android": [
            "//pkg/ebpf/ebpftest:cgo_align",
            "//pkg/util/safeelf",
            "@com_github_stretchr_testify//assert",
            "@com_github_stretchr_testify//require",
        ],
        "@rules_go//go/platform:linux": [
            "//pkg/ebpf/ebpftest:cgo_align",
            "//pkg/util/safeelf",
            "@com_github_stretchr_testify//assert",
            "@com_github_stretchr_testify//require",
        ],
        "//conditions:default": [],
    }),
)
