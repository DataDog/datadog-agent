# Convenience: build every eBPF program (.o) and runtime bundle (.c) at once.
#   bazel build //pkg/ebpf:all_ebpf_programs
filegroup(
    name = "all_ebpf_programs",
    srcs = select({
        "@platforms//os:linux": [
            ":co_re_objects",
            ":prebuilt_objects",
            ":prebuilt_test_objects",
            ":runtime_sources",
            "//pkg/ebpf/kernelbugs:uprobe-trigger",
        ],
        "//conditions:default": [],
    }) + select({
        "@platforms//cpu:x86_64": ["//pkg/ebpf/kernelbugs:detect-seccomp-bug"],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
)

# Stages eBPF assets into the source tree, as `dda inv system-probe.object-files` does:
#   bazel run //pkg/ebpf:install_object_files -- --destdir=$PWD
config_setting(
    name = "host_aarch64",
    constraint_values = ["@platforms//cpu:aarch64"],
    flag_values = {"//bazel/rules/ebpf:target_arch": ""},
)

selects.config_setting_group(
    name = "ebpf_aarch64",
    match_any = [
        ":host_aarch64",
        "//bazel/rules/ebpf:target_arch_aarch64",
    ],
)

# The arch directories must match get_ebpf_build_dir() in tasks/system_probe.py.
pkg_files(
    name = "install_prebuilt_objects",
    srcs = [
        ":prebuilt_objects",
        ":prebuilt_test_objects",
    ],
    attributes = pkg_attributes(mode = "644"),
    prefix = select({
        ":ebpf_aarch64": "pkg/ebpf/bytecode/build/arm64",
        "//conditions:default": "pkg/ebpf/bytecode/build/x86_64",
    }),
)

pkg_files(
    name = "install_co_re_objects",
    srcs = [":co_re_objects"],
    attributes = pkg_attributes(mode = "644"),
    prefix = select({
        ":ebpf_aarch64": "pkg/ebpf/bytecode/build/arm64/co-re",
        "//conditions:default": "pkg/ebpf/bytecode/build/x86_64/co-re",
    }),
)

pkg_files(
    name = "install_runtime_sources",
    srcs = [":runtime_sources"],
    attributes = pkg_attributes(mode = "644"),
    prefix = "pkg/ebpf/bytecode/build/runtime",
)

pkg_files(
    name = "install_runtime_hashes",
    srcs = [
        "//pkg/ebpf/bytecode:conntrack_gen",
        "//pkg/ebpf/bytecode:gpu_gen",
        "//pkg/ebpf/bytecode:offsetguess-test_gen",
        "//pkg/ebpf/bytecode:oom-kill_gen",
        "//pkg/ebpf/bytecode:runtime-security_gen",
        "//pkg/ebpf/bytecode:shared-libraries_gen",
        "//pkg/ebpf/bytecode:tcp-queue-length_gen",
        "//pkg/ebpf/bytecode:tracer_gen",
        "//pkg/ebpf/bytecode:usm_gen",
    ],
    attributes = pkg_attributes(mode = "644"),
    prefix = "pkg/ebpf/bytecode/runtime",
)

pkg_files(
    name = "install_kernelbugs_objects",
    srcs = ["//pkg/ebpf/kernelbugs:uprobe-trigger.stripped"],
    attributes = pkg_attributes(mode = "644"),
    prefix = "pkg/ebpf/kernelbugs/c",
)

pkg_files(
    name = "install_kernelbugs_binaries",
    srcs = select({
        ":ebpf_aarch64": [],
        "//conditions:default": ["//pkg/ebpf/kernelbugs:detect-seccomp-bug"],
    }),
    attributes = pkg_attributes(mode = "755"),
    prefix = "pkg/ebpf/kernelbugs/c",
)

pkg_install(
    name = "install_object_files",
    srcs = [
        ":install_co_re_objects",
        ":install_kernelbugs_binaries",
        ":install_kernelbugs_objects",
        ":install_prebuilt_objects",
        ":install_runtime_hashes",
        ":install_runtime_sources",
    ],
    target_compatible_with = ["@platforms//os:linux"],
)

# CWS unit tests load Baloum builds under the shipped object names.
pkg_files(
    name = "install_prebuilt_objects_without_cws",
    srcs = [
        ":prebuilt_objects",
        ":prebuilt_test_objects",
    ],
    attributes = pkg_attributes(mode = "644"),
    excludes = [
        "//pkg/security/ebpf/c/prebuilt:runtime-security-fentry.stripped",
        "//pkg/security/ebpf/c/prebuilt:runtime-security-syscall-wrapper.stripped",
        "//pkg/security/ebpf/c/prebuilt:runtime-security.stripped",
    ],
    prefix = select({
        ":ebpf_aarch64": "pkg/ebpf/bytecode/build/arm64",
        "//conditions:default": "pkg/ebpf/bytecode/build/x86_64",
    }),
)

pkg_files(
    name = "install_baloum_objects",
    srcs = [
        "//pkg/security/ebpf/c/prebuilt:runtime-security-baloum",
        "//pkg/security/ebpf/c/prebuilt:runtime-security-fentry-baloum",
        "//pkg/security/ebpf/c/prebuilt:runtime-security-syscall-wrapper-baloum",
    ],
    attributes = pkg_attributes(mode = "444"),
    prefix = select({
        ":ebpf_aarch64": "pkg/ebpf/bytecode/build/arm64",
        "//conditions:default": "pkg/ebpf/bytecode/build/x86_64",
    }),
    renames = {
        "//pkg/security/ebpf/c/prebuilt:runtime-security-baloum": "runtime-security.o",
        "//pkg/security/ebpf/c/prebuilt:runtime-security-fentry-baloum": "runtime-security-fentry.o",
        "//pkg/security/ebpf/c/prebuilt:runtime-security-syscall-wrapper-baloum": "runtime-security-syscall-wrapper.o",
    },
)

pkg_install(
    name = "install_object_files_baloum",
    srcs = [
        ":install_baloum_objects",
        ":install_co_re_objects",
        ":install_kernelbugs_binaries",
        ":install_kernelbugs_objects",
        ":install_prebuilt_objects_without_cws",
        ":install_runtime_hashes",
        ":install_runtime_sources",
    ],
    target_compatible_with = ["@platforms//os:linux"],
)

