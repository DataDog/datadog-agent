load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "features",
    srcs = [
        "features.go",
        "iterator.go",
        "tp_btf.go",
        "tracing.go",
    ],
    importpath = "github.com/DataDog/datadog-agent/pkg/ebpf/features",
    tags = ["manual"],
    visibility = ["//visibility:public"],
    deps = select({
        "@rules_go//go/platform:android": [
            "//pkg/ebpf/kernelbugs",
            "//pkg/util/funcs",
            "@com_github_cilium_ebpf//:ebpf",
            "@com_github_cilium_ebpf//asm",
            "@com_github_cilium_ebpf//features",
            "@com_github_cilium_ebpf//link",
            "@org_golang_x_sys//unix",
        ],
        "@rules_go//go/platform:linux": [
            "//pkg/ebpf/kernelbugs",
            "//pkg/util/funcs",
            "@com_github_cilium_ebpf//:ebpf",
            "@com_github_cilium_ebpf//asm",
            "@com_github_cilium_ebpf//features",
            "@com_github_cilium_ebpf//link",
            "@org_golang_x_sys//unix",
        ],
        "//conditions:default": [],
    }),
)

dd_agent_go_test(
    name = "features_test",
    srcs = ["tp_btf_test.go"],
    embed = [":features"],
    gotags_sets = [["bpf"]],
    include_default = False,
    deps = select({
        "@rules_go//go/platform:android": [
            "@com_github_cilium_ebpf//:ebpf",
            "@com_github_stretchr_testify//assert",
        ],
        "@rules_go//go/platform:linux": [
            "@com_github_cilium_ebpf//:ebpf",
            "@com_github_stretchr_testify//assert",
        ],
        "//conditions:default": [],
    }),
)
