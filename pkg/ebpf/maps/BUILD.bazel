load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "maps",
    srcs = ["generic_map.go"],
    importpath = "github.com/DataDog/datadog-agent/pkg/ebpf/maps",
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:linux"],
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/util/funcs",
        "//pkg/util/log",
        "@com_github_cilium_ebpf//:ebpf",
        "@com_github_datadog_ebpf_manager//:ebpf-manager",
    ],
)

dd_agent_go_test(
    name = "maps_test",
    srcs = ["generic_map_test.go"],
    embed = [":maps"],
    gotags_sets = [["linux_bpf"]],
    include_default = False,
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        "//pkg/security/ebpf/kernel",
        "//pkg/util/kernel",
        "@com_github_cilium_ebpf//:ebpf",
        "@com_github_cilium_ebpf//rlimit",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
