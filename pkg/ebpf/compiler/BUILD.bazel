load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "compiler",
    srcs = [
        "compiler.go",
        "stdarg.h",
    ],
    embedsrcs = select({
        "@rules_go//go/platform:android": [
            "stdarg.h",
        ],
        "@rules_go//go/platform:linux": [
            "stdarg.h",
        ],
        "//conditions:default": [],
    }),
    importpath = "github.com/DataDog/datadog-agent/pkg/ebpf/compiler",
    visibility = ["//visibility:public"],
    deps = select({
        "@rules_go//go/platform:android": [
            "//pkg/util/defaultpaths",
            "//pkg/util/kernel",
            "//pkg/util/log",
        ],
        "@rules_go//go/platform:linux": [
            "//pkg/util/defaultpaths",
            "//pkg/util/kernel",
            "//pkg/util/log",
        ],
        "//conditions:default": [],
    }),
)

dd_agent_go_test(
    name = "compiler_test",
    srcs = ["compiler_test.go"],
    embed = [":compiler"],
    gotags_sets = [["bpf"]],
    include_default = False,
    deps = select({
        "@rules_go//go/platform:android": [
            "@com_github_stretchr_testify//assert",
            "@com_github_stretchr_testify//require",
        ],
        "@rules_go//go/platform:linux": [
            "@com_github_stretchr_testify//assert",
            "@com_github_stretchr_testify//require",
        ],
        "//conditions:default": [],
    }),
)
