load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "easyjson_bootstrap_lib",
    srcs = ["main.go"],
    importpath = "github.com/DataDog/datadog-agent/pkg/security/generators/easyjson_bootstrap",
    visibility = ["//visibility:private"],
)

go_binary(
    name = "easyjson_bootstrap",
    embed = [":easyjson_bootstrap_lib"],
    visibility = ["//visibility:public"],
)

dd_agent_go_test(
    name = "easyjson_bootstrap_test",
    srcs = ["main_test.go"],
    embed = [":easyjson_bootstrap_lib"],
    deps = [
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
