load("@bazel_lib//lib:write_source_files.bzl", "write_source_file")
load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go_package_metadata:defs.bzl", "go_package_metadata")

package(default_package_metadata = [":go_package_metadata"])

go_package_metadata(
    name = "go_package_metadata",
    module = "github.com/DataDog/datadog-agent/pkg/security/seclwin",
)

write_source_file(
    name = "sync",
    in_file = "//pkg/security/secl:doc.go",
    out_file = "doc.go",
    visibility = ["//pkg/security:__pkg__"],
)

go_library(
    name = "seclwin",
    srcs = ["doc.go"],
    importpath = "github.com/DataDog/datadog-agent/pkg/security/seclwin",
    visibility = ["//visibility:public"],
)
