load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "otelthreadctx",
    srcs = [
        "attributes.go",
        "errors.go",
        "layout.go",
        "reader.go",
        "reader_nodejs.go",
        "resolve.go",
    ],
    importpath = "github.com/DataDog/datadog-agent/pkg/security/otelthreadctx",
    visibility = ["//visibility:public"],
    deps = select({
        "@rules_go//go/platform:android": [
            "//pkg/security/otelprocessctx",
            "//pkg/security/probe/procfs/procmaps",
            "//pkg/security/secl/model/utils",
            "@io_opentelemetry_go_ebpf_profiler//libc",
            "@io_opentelemetry_go_ebpf_profiler//libpf",
            "@io_opentelemetry_go_ebpf_profiler//libpf/pfelf",
            "@io_opentelemetry_go_ebpf_profiler//remotememory",
            "@io_opentelemetry_go_ebpf_profiler//tls",
        ],
        "@rules_go//go/platform:linux": [
            "//pkg/security/otelprocessctx",
            "//pkg/security/probe/procfs/procmaps",
            "//pkg/security/secl/model/utils",
            "@io_opentelemetry_go_ebpf_profiler//libc",
            "@io_opentelemetry_go_ebpf_profiler//libpf",
            "@io_opentelemetry_go_ebpf_profiler//libpf/pfelf",
            "@io_opentelemetry_go_ebpf_profiler//remotememory",
            "@io_opentelemetry_go_ebpf_profiler//tls",
        ],
        "//conditions:default": [],
    }),
)

dd_agent_go_test(
    name = "otelthreadctx_test",
    srcs = [
        "layout_test.go",
        "layout_tlsdesc_live_test.go",
    ],
    data = select({
        "@platforms//os:linux": [
            "//pkg/security/tests/syscall_tester/c:otel_tls_dlopen_glibc",
            "//pkg/security/tests/syscall_tester/c:otel_tls_glibc_big",
        ],
        "//conditions:default": [],
    }),
    embed = [":otelthreadctx"],
    env = select({
        "@platforms//os:linux": {
            "OTEL_TLS_TEST_BIG_SO": "$(rlocationpath //pkg/security/tests/syscall_tester/c:otel_tls_glibc_big)",
            "OTEL_TLS_TEST_DLOPEN_DRIVER": "$(rlocationpath //pkg/security/tests/syscall_tester/c:otel_tls_dlopen_glibc)",
        },
        "//conditions:default": {},
    }),
    deps = select({
        "@rules_go//go/platform:android": [
            "//pkg/util/kernel",
            "@com_github_stretchr_testify//require",
            "@io_opentelemetry_go_ebpf_profiler//tls",
            "@rules_go//go/runfiles",
        ],
        "@rules_go//go/platform:linux": [
            "//pkg/util/kernel",
            "@com_github_stretchr_testify//require",
            "@io_opentelemetry_go_ebpf_profiler//tls",
            "@rules_go//go/runfiles",
        ],
        "//conditions:default": [],
    }),
)
