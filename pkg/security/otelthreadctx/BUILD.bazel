dd_agent_go_test(
    name = "otelthreadctx_test",
    srcs = ["layout_test.go"],
    embed = [":otelthreadctx"],
    deps = select({
        "@rules_go//go/platform:android": [
            "//pkg/util/kernel",
            "@com_github_stretchr_testify//require",
        ],
        "@rules_go//go/platform:linux": [
            "//pkg/util/kernel",
            "@com_github_stretchr_testify//require",
        ],
        "//conditions:default": [],
    }),
