        "layout.go",
        "reader.go",
        "resolve.go",
        "upstream_access.go",
        "upstream_pfelf.go",
    ],
    importpath = "github.com/DataDog/datadog-agent/pkg/security/otelthreadctx",
    visibility = ["//visibility:public"],
    deps = select({
        "@rules_go//go/platform:android": [
            "//pkg/security/otelprocessctx",
            "//pkg/security/probe/procfs/procmaps",
            "//pkg/security/secl/model/utils",
            "//pkg/util/safeelf",
            "@io_opentelemetry_go_ebpf_profiler//libc",
            "@io_opentelemetry_go_ebpf_profiler//libpf",
            "@io_opentelemetry_go_ebpf_profiler//libpf/pfbufio",
            "@io_opentelemetry_go_ebpf_profiler//libpf/pfelf",
            "@io_opentelemetry_go_ebpf_profiler//libpf/pfunsafe",
        ],
        "@rules_go//go/platform:linux": [
            "//pkg/security/otelprocessctx",
            "//pkg/security/probe/procfs/procmaps",
            "//pkg/security/secl/model/utils",
            "//pkg/util/safeelf",
            "@io_opentelemetry_go_ebpf_profiler//libc",
            "@io_opentelemetry_go_ebpf_profiler//libpf",
            "@io_opentelemetry_go_ebpf_profiler//libpf/pfbufio",
            "@io_opentelemetry_go_ebpf_profiler//libpf/pfelf",
            "@io_opentelemetry_go_ebpf_profiler//libpf/pfunsafe",
        ],
        "//conditions:default": [],
