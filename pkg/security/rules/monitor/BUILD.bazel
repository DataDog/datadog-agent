# gazelle:go_split_generated *_easyjson.go

easyjson(
    name = "policy_monitor_easyjson",
    src = "policy_monitor.go",
    output = "policy_monitor_easyjson.go",
    package = ":monitor_easyjson_stubs",
    package_path = "github.com/DataDog/datadog-agent/pkg/security/rules/monitor",
    visibility = ["//pkg/security:__pkg__"],
)

easyjson_stubs(
    name = "monitor_easyjson_stubs",
    package_path = "github.com/DataDog/datadog-agent/pkg/security/rules/monitor",
    sources = ":monitor_sources",
    stubs = [
        ":policy_monitor_easyjson_stub",
    ],
)

go_library(
    name = "monitor",
    srcs = ["policy_monitor_easyjson.go"],
    embed = [":monitor_sources"],
    importpath = "github.com/DataDog/datadog-agent/pkg/security/rules/monitor",
    visibility = ["//visibility:public"],
)

