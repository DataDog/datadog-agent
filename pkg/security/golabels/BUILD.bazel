unstripped_go_binary(
    name = "go_labels_nocgo_plain",
    srcs = ["testdata/main.go"],
    linkmode = "normal",
    pure = "on",
    race = "off",
    target_compatible_with = ["@platforms//os:linux"],
)

unstripped_go_binary(
    name = "go_labels_nocgo_stripped",
    srcs = ["testdata/main.go"],
    gc_linkopts = [
        "-s",
        "-w",
    ],
    linkmode = "normal",
    pure = "on",
    race = "off",
    target_compatible_with = ["@platforms//os:linux"],
)

unstripped_go_binary(
    name = "go_labels_cgo_plain",
    srcs = ["testdata/main.go"],
    linkmode = "normal",
    pure = "off",
    race = "off",
    target_compatible_with = ["@platforms//os:linux"],
)

unstripped_go_binary(
    name = "go_labels_cgo_stripped",
    srcs = ["testdata/main.go"],
    gc_linkopts = [
        "-s",
        "-w",
    ],
    linkmode = "normal",
    pure = "off",
    race = "off",
    target_compatible_with = ["@platforms//os:linux"],
)

# Note on the PIE fixtures:
# In rules_go, setting linkmode="pie" forces `external` linking mode, which brings the C linker into play.
# That can cause the generated code to be different enough that the current code wouldn't be able to find the
# g offset.
# Using linkmode="normal" and adding `-buildmode=pie` via explicit linker flags instead uses the internal
# go linker instead.
unstripped_go_binary(
    name = "go_labels_cgo_pie_plain",
    srcs = ["testdata/main.go"],
    gc_linkopts = ["-buildmode=pie"],
    linkmode = "normal",
    pure = "off",
    race = "off",
    target_compatible_with = ["@platforms//os:linux"],
)

unstripped_go_binary(
    name = "go_labels_cgo_pie_stripped",
    srcs = ["testdata/main.go"],
    gc_linkopts = [
        "-buildmode=pie",
        "-s",
        "-w",
    ],
    linkmode = "normal",
    pure = "off",
    race = "off",
    target_compatible_with = ["@platforms//os:linux"],
)

dd_agent_go_test(
    name = "golabels_test",
    srcs = [
        "reader_test.go",
        "tls_test.go",
    ],
    data = glob(["testdata/**"]) + select({
        "@platforms//os:linux": [
            ":go_labels_cgo_pie_plain",
            ":go_labels_cgo_pie_stripped",
            ":go_labels_cgo_plain",
            ":go_labels_cgo_stripped",
            ":go_labels_nocgo_plain",
            ":go_labels_nocgo_stripped",
        ],
        "//conditions:default": [],
    }),
    embed = [":golabels"],
    env = select({
        "@platforms//os:linux": {
            "GO_LABELS_TEST_FIXTURE_CGO_PIE_PLAIN": "$(rlocationpath :go_labels_cgo_pie_plain)",
            "GO_LABELS_TEST_FIXTURE_CGO_PIE_STRIPPED": "$(rlocationpath :go_labels_cgo_pie_stripped)",
            "GO_LABELS_TEST_FIXTURE_CGO_PLAIN": "$(rlocationpath :go_labels_cgo_plain)",
            "GO_LABELS_TEST_FIXTURE_CGO_STRIPPED": "$(rlocationpath :go_labels_cgo_stripped)",
            "GO_LABELS_TEST_FIXTURE_NOCGO_PLAIN": "$(rlocationpath :go_labels_nocgo_plain)",
            "GO_LABELS_TEST_FIXTURE_NOCGO_STRIPPED": "$(rlocationpath :go_labels_nocgo_stripped)",
        },
        "//conditions:default": {},
    }),
    deps = select({
        "@rules_go//go/platform:android": [
            "//pkg/security/resolvers/process/gooffsets",
            "//pkg/security/secl/model/utils",
            "//pkg/util/safeelf",
