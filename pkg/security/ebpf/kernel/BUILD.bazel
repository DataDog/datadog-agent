load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "kernel",
    srcs = [
        "kernel.go",
        "kernel_bpf.go",
        "kernel_nobpf.go",
    ],
    importpath = "github.com/DataDog/datadog-agent/pkg/security/ebpf/kernel",
    visibility = ["//visibility:public"],
    deps = select({
        "@rules_go//go/platform:android": [
            "//pkg/config/env",
            "//pkg/ebpf/btf",
            "//pkg/util/filesystem",
            "//pkg/util/kernel",
            "@com_github_acobaugh_osrelease//:osrelease",
            "@com_github_cilium_ebpf//:ebpf",
            "@com_github_cilium_ebpf//asm",
            "@com_github_cilium_ebpf//features",
            "@com_github_cilium_ebpf//link",
            "@org_golang_x_sys//unix",
        ],
        "@rules_go//go/platform:linux": [
            "//pkg/config/env",
            "//pkg/ebpf/btf",
            "//pkg/util/filesystem",
            "//pkg/util/kernel",
            "@com_github_acobaugh_osrelease//:osrelease",
            "@com_github_cilium_ebpf//:ebpf",
            "@com_github_cilium_ebpf//asm",
            "@com_github_cilium_ebpf//features",
            "@com_github_cilium_ebpf//link",
            "@org_golang_x_sys//unix",
        ],
        "//conditions:default": [],
    }),
)

dd_agent_go_test(
    name = "kernel_test",
    srcs = ["kernel_test.go"],
    embed = [":kernel"],
    gotags_sets = [["bpf"]],
    deps = select({
        "@rules_go//go/platform:android": [
            "@com_github_stretchr_testify//assert",
        ],
        "@rules_go//go/platform:linux": [
            "@com_github_stretchr_testify//assert",
        ],
        "//conditions:default": [],
    }),
)
