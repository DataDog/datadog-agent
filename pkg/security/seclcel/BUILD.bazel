load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/cws_codegen:defs.bzl", "cel_types")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "seclcel",
    srcs = [
        "celtypes_unix.go",
        "celtypes_windows.go",
        "describe.go",
        "env.go",
        "errors.go",
        "fieldtypes.go",
        "funcs.go",
        "funcs_rootdomain.go",
        "funcs_rootdomain_stub.go",
        "lexer.go",
        "list.go",
        "modelfieldtypes.go",
        "parser.go",
        "provider.go",
        "runtime.go",
        "seclcel.go",
    ],
    importpath = "github.com/DataDog/datadog-agent/pkg/security/seclcel",
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/security/secl/compiler/eval",
        "//pkg/security/secl/model",
        "@com_github_google_cel_go//cel:go_default_library",
        "@com_github_google_cel_go//common:go_default_library",
        "@com_github_google_cel_go//common/ast:go_default_library",
        "@com_github_google_cel_go//common/operators:go_default_library",
        "@com_github_google_cel_go//common/types:go_default_library",
        "@com_github_google_cel_go//common/types/ref:go_default_library",
        "@com_github_google_cel_go//common/types/traits:go_default_library",
        "@com_github_google_cel_go//ext:go_default_library",
        "@com_github_google_cel_go//interpreter:go_default_library",
    ],
)

# The CEL type declarations are generated here rather than next to the model so
# that cel-go stays out of //pkg/security/secl, which is synchronised into
# //pkg/security/seclwin. They come from the same accessors generator, run with
# only its CEL types output requested.
[
    cel_types(
        name = "celtypes_{}".format(variant["suffix"]),
        srcs = ["//pkg/security/secl/model:{}".format(f) for f in variant["consts"]],
        model = "//pkg/security/secl/model:{}".format(variant["model"]),
        output = "celtypes_{}.go".format(variant["suffix"]),
        package_path = "github.com/DataDog/datadog-agent/pkg/security/secl/model",
        tags = variant["tags"],
        types_file = "//pkg/security/secl/model:model.go",
    )
    for variant in [
        {
            "suffix": "unix",
            "tags": "unix",
            "model": "model_unix.go",
            "consts": [
                "consts_common.go",
                "consts_linux.go",
                "consts_linux_amd64.go",
                "consts_linux_arm.go",
                "consts_linux_arm64.go",
            ],
        },
        {
            "suffix": "windows",
            "tags": "windows",
            "model": "model_windows.go",
            "consts": [
                "consts_common.go",
                "consts_windows.go",
            ],
        },
    ]
]

