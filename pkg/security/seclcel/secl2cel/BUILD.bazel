load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "secl2cel_lib",
    srcs = [
        "coverage.go",
        "main.go",
    ],
    importpath = "github.com/DataDog/datadog-agent/pkg/security/seclcel/secl2cel",
    visibility = ["//visibility:private"],
    deps = [
        "//pkg/security/secl/compiler/ast",
        "//pkg/security/secl/compiler/eval",
        "//pkg/security/secl/model",
        "//pkg/security/seclcel",
        "@com_github_google_cel_go//cel:go_default_library",
        "@in_gopkg_yaml_v3//:yaml_v3",
    ],
)

go_binary(
    name = "secl2cel",
    embed = [":secl2cel_lib"],
    visibility = ["//visibility:public"],
)

