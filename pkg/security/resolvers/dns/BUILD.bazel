load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "dns",
    srcs = [
        "request_tracker.go",
        "resolver.go",
    ],
    importpath = "github.com/DataDog/datadog-agent/pkg/security/resolvers/dns",
    visibility = ["//visibility:public"],
    deps = select({
        "@rules_go//go/platform:android": [
            "//pkg/security/metrics",
            "//pkg/security/probe/config",
            "//pkg/security/secl/model",
            "//pkg/security/utils/lru/simplelru",
            "@com_github_datadog_datadog_go_v5//statsd",
            "@com_github_hashicorp_golang_lru_v2//:golang-lru",
            "@org_uber_go_atomic//:atomic",
        ],
        "@rules_go//go/platform:linux": [
            "//pkg/security/metrics",
            "//pkg/security/probe/config",
            "//pkg/security/secl/model",
            "//pkg/security/utils/lru/simplelru",
            "@com_github_datadog_datadog_go_v5//statsd",
            "@com_github_hashicorp_golang_lru_v2//:golang-lru",
            "@org_uber_go_atomic//:atomic",
        ],
        "//conditions:default": [],
    }),
)

dd_agent_go_test(
    name = "dns_test",
    srcs = ["request_tracker_test.go"],
    embed = [":dns"],
    deps = select({
        "@rules_go//go/platform:android": [
            "//pkg/security/secl/model",
            "@com_github_stretchr_testify//assert",
            "@com_github_stretchr_testify//require",
        ],
        "@rules_go//go/platform:linux": [
            "//pkg/security/secl/model",
            "@com_github_stretchr_testify//assert",
            "@com_github_stretchr_testify//require",
        ],
        "//conditions:default": [],
    }),
)
