load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "tags",
    srcs = [
        "resolver.go",
        "resolver_linux.go",
        "resolver_other.go",
    ],
    importpath = "github.com/DataDog/datadog-agent/pkg/security/resolvers/tags",
    visibility = ["//visibility:public"],
    deps = [
        "//comp/core/tagger/types",
        "//pkg/security/secl/containerutils",
        "//pkg/security/seclog",
        "//pkg/security/utils",
    ] + select({
        "@rules_go//go/platform:android": [
            "//pkg/security/resolvers/cgroup",
            "//pkg/security/resolvers/cgroup/model",
        ],
        "@rules_go//go/platform:linux": [
            "//pkg/security/resolvers/cgroup",
            "//pkg/security/resolvers/cgroup/model",
        ],
        "//conditions:default": [],
    }),
)

dd_agent_go_test(
    name = "tags_test",
    srcs = ["resolver_linux_test.go"],
    embed = [":tags"],
    deps = select({
        "@rules_go//go/platform:android": [
            "//comp/core/tagger/types",
            "//pkg/security/resolvers/cgroup/model",
            "//pkg/security/secl/containerutils",
            "//pkg/security/secl/model",
        ],
        "@rules_go//go/platform:linux": [
            "//comp/core/tagger/types",
            "//pkg/security/resolvers/cgroup/model",
            "//pkg/security/secl/containerutils",
            "//pkg/security/secl/model",
        ],
        "//conditions:default": [],
    }),
