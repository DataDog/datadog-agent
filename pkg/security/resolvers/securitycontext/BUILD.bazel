load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "securitycontext",
    srcs = [
        "resolver.go",
        "resolver_linux.go",
    ],
    importpath = "github.com/DataDog/datadog-agent/pkg/security/resolvers/securitycontext",
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/security/secl/containerutils",
    ] + select({
        "@rules_go//go/platform:android": [
            "//comp/core/workloadmeta/def",
        ],
        "@rules_go//go/platform:linux": [
            "//comp/core/workloadmeta/def",
        ],
        "//conditions:default": [],
    }),
)

dd_agent_go_test(
    name = "securitycontext_test",
    srcs = ["resolver_linux_test.go"],
    embed = [":securitycontext"],
    deps = select({
        "@rules_go//go/platform:android": [
            "//comp/core/workloadmeta/def",
            "//pkg/security/secl/containerutils",
            "@com_github_stretchr_testify//assert",
            "@com_github_stretchr_testify//require",
        ],
        "@rules_go//go/platform:linux": [
            "//comp/core/workloadmeta/def",
            "//pkg/security/secl/containerutils",
            "@com_github_stretchr_testify//assert",
            "@com_github_stretchr_testify//require",
        ],
        "//conditions:default": [],
    }),
)
