load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_shared_library.bzl", "cc_shared_library")
load(":otel_tls.bzl", "TLS_DIALECT", "otel_tls_dsos")

# The OTel thread context testers: the native ones, one per access model a
# tracer can publish otel_thread_ctx_v1 through, and the Node.js one, which
# publishes through otel_thread_ctx_nodejs_v1 instead. Built here rather than by
# the ninja/invoke path so they link against the hermetic crosstool-NG sysroot:
# its glibc is older than every KMT host and than the ubuntu:20.04 image
# RunMultiMode's docker leg uses, which is what lets the dynamically linked
# variants run there at all.

filegroup(
    name = "otel_tls_headers",
    srcs = [
        "otel_process_ctx_common.h",
        "otel_tls_common.h",
        "otel_tls_lib.h",
    ],
)

filegroup(
    name = "otel_nodejs_headers",
    srcs = [
        "otel_nodejs_common.h",
        "otel_nodejs_lib.h",
        "otel_process_ctx_common.h",
        "otel_tls_common.h",
    ],
)

# The variable lives in the executable's own static TLS block (local-exec), read
# from .dynsym here and from .symtab in the fully static build below.
cc_binary(
    name = "otel_tls_exe_glibc",
    srcs = [
        "otel_tls_driver.c",
        "otel_tls_lib.c",
        ":otel_tls_headers",
    ],
    copts = ["-pthread"],
    linkopts = [
        "-Wl,--export-dynamic",
        "-pthread",
    ],
    target_compatible_with = ["@platforms//os:linux"],
    visibility = ["//visibility:public"],
)

cc_binary(
    name = "otel_tls_exe_static_glibc",
    srcs = [
        "otel_tls_driver.c",
        "otel_tls_lib.c",
        ":otel_tls_headers",
    ],
    features = ["fully_static_link"],
    target_compatible_with = ["@platforms//os:linux"],
    visibility = ["//visibility:public"],
)

# The dlopen driver takes the shared object to load as its first argument, so
# one binary covers every flavor.
cc_binary(
    name = "otel_tls_dlopen_glibc",
    srcs = [
        "otel_tls_driver.c",
        ":otel_tls_headers",
    ],
    defines = ["USE_DLOPEN"],
    linkopts = ["-ldl"],
    target_compatible_with = ["@platforms//os:linux"],
    visibility = ["//visibility:public"],
)

# The Node.js tester's shared object: only the TLSDESC/general-dynamic dialect,
# and only out of a shared object -- that is how a Node addon publishes the
# discovery thread-local, and the native testers above already cover the other
# access models.
cc_library(
    name = "otel_nodejs_glibc_srcs",
    srcs = [
        "otel_nodejs_lib.c",
        ":otel_nodejs_headers",
    ],
    copts = [
        "-fPIC",
        "-pthread",
    ] + TLS_DIALECT,
    linkopts = ["-pthread"],
    target_compatible_with = ["@platforms//os:linux"],
)

cc_shared_library(
    name = "otel_nodejs_glibc",
    target_compatible_with = ["@platforms//os:linux"],
    visibility = ["//visibility:public"],
    deps = [":otel_nodejs_glibc_srcs"],
)

# The dlopen driver for the Node.js tester: dlopen is the only access path that
# matters, since that is how a Node addon is loaded.
cc_binary(
    name = "otel_nodejs_dlopen_glibc",
    srcs = [
        "otel_nodejs_driver.c",
        ":otel_nodejs_headers",
    ],
    linkopts = ["-ldl"],
    target_compatible_with = ["@platforms//os:linux"],
    visibility = ["//visibility:public"],
)

otel_tls_dsos(name = "otel_tls_dso_artifacts")

filegroup(
    name = "otel_tls_artifacts",
    srcs = [
        ":otel_nodejs_dlopen_glibc",
        ":otel_nodejs_glibc",
        ":otel_tls_dlopen_glibc",
        ":otel_tls_dso_artifacts",
        ":otel_tls_exe_glibc",
        ":otel_tls_exe_static_glibc",
    ],
    visibility = ["//visibility:public"],
)
