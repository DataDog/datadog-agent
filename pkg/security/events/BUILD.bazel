load("@rules_go//go:def.bzl", "go_library", "go_source")
load("//bazel/rules/cws_codegen:defs.bzl", "easyjson", "easyjson_stubs")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

# gazelle:go_split_generated *_easyjson.go

easyjson(
    name = "event_easyjson",
    src = "event.go",
    output = "event_easyjson.go",
    package = ":events_easyjson_stubs",
    package_path = "github.com/DataDog/datadog-agent/pkg/security/events",
    visibility = ["//pkg/security:__pkg__"],
)

easyjson_stubs(
    name = "events_easyjson_stubs",
    package_path = "github.com/DataDog/datadog-agent/pkg/security/events",
    sources = ":events_sources",
    stubs = [":event_easyjson_stub"],
)

go_library(
    name = "events",
    srcs = ["event_easyjson.go"],
    embed = [":events_sources"],
    importpath = "github.com/DataDog/datadog-agent/pkg/security/events",
    visibility = ["//visibility:public"],
)

go_source(
    name = "events_sources",
    srcs = [
        "ad_limiter.go",
        "custom.go",
        "event.go",
        "json.go",
        "rate_limiter.go",
        "std_limiter.go",
        "token_limiter.go",
    ],
    deps = [
        "//pkg/security/config",
        "//pkg/security/metrics",
        "//pkg/security/secl/compiler/eval",
        "//pkg/security/secl/containerutils",
        "//pkg/security/secl/model",
        "//pkg/security/secl/rules",
        "//pkg/security/seclog",
        "//pkg/security/utils",
        "@com_github_datadog_datadog_go_v5//statsd",
        "@com_github_mailru_easyjson//:easyjson",
        "@com_github_mailru_easyjson//jlexer",
        "@com_github_mailru_easyjson//jwriter",
        "@org_golang_x_time//rate",
        "@org_uber_go_atomic//:atomic",
    ],
)

dd_agent_go_test(
    name = "events_test",
    srcs = ["ad_limiter_test.go"],
    embed = [":events"],
    deps = [
        "//pkg/security/secl/compiler/eval",
        "//pkg/security/secl/model",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
