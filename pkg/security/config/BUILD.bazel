load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")
load("//bazel/rules/go_stringer:defs.bzl", "go_stringer")

go_library(
    name = "config",
    srcs = [
        "config.go",
        "config_linux.go",
        "config_others.go",
        "dump.go",
        "enum_string.go",
    ],
    importpath = "github.com/DataDog/datadog-agent/pkg/security/config",
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/config/model",
        "//pkg/config/setup",
        "//pkg/config/utils",
        "//pkg/security/probe/config",
        "//pkg/security/proto/api",
        "//pkg/security/secl/model",
        "//pkg/security/seclog",
        "//pkg/security/utils",
        "//pkg/system-probe/config",
        "//pkg/util/fargate",
    ],
)

go_stringer(
    name = "enum_string",
    src = "dump.go",
    linecomment = True,
    output = "enum_string.go",
    types = [
        "StorageFormat",
        "StorageType",
    ],
)

dd_agent_go_test(
    name = "config_test",
    srcs = ["credential_endpoints_test.go"],
    embed = [":config"],
    deps = [
        "//pkg/security/secl/model",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
