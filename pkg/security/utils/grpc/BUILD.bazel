load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "grpc",
    srcs = [
        "auth.go",
        "grpc.go",
    ],
    importpath = "github.com/DataDog/datadog-agent/pkg/security/utils/grpc",
    visibility = ["//visibility:public"],
    deps = [
        "//comp/core/ipc/def",
        "//pkg/config/setup",
        "//pkg/security/seclog",
        "//pkg/util/grpc",
        "//pkg/util/system/socket",
        "@com_github_grpc_ecosystem_go_grpc_middleware_v2//interceptors/auth",
        "@com_github_mdlayher_vsock//:vsock",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//credentials",
        "@org_golang_google_grpc//credentials/insecure",
    ],
)

dd_agent_go_test(
    name = "grpc_test",
    srcs = ["auth_test.go"],
    embed = [":grpc"],
    deps = [
        "//comp/core/ipc/mock",
        "//pkg/security/proto/api",
        "//pkg/util/grpc",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//credentials",
        "@org_golang_google_grpc//credentials/insecure",
        "@org_golang_google_grpc//status",
    ],
)
