        "proc_maps_parser.go",
        "snapshot_bound_sockets.go",
        "snapshot_mmapped_files.go",
        "snapshot_script.go",
    ],
    importpath = "github.com/DataDog/datadog-agent/pkg/security/probe/procfs",
    visibility = ["//visibility:public"],
    deps = select({
        "@rules_go//go/platform:android": [
            "//pkg/security/probe/procfs/procmaps",
            "//pkg/security/secl/model",
            "//pkg/security/seclog",
            "//pkg/security/utils",
            "//pkg/util/kernel",
            "@com_github_cyphar_filepath_securejoin//:filepath-securejoin",
            "@com_github_shirou_gopsutil_v4//process",
            "@org_golang_x_sys//unix",
        ],
        "@rules_go//go/platform:linux": [
            "//pkg/security/probe/procfs/procmaps",
            "//pkg/security/secl/model",
            "//pkg/security/seclog",
            "//pkg/security/utils",
            "//pkg/util/kernel",
            "@com_github_cyphar_filepath_securejoin//:filepath-securejoin",
            "@com_github_shirou_gopsutil_v4//process",
            "@org_golang_x_sys//unix",
        ],
        "//conditions:default": [],
    }),
)

dd_agent_go_test(
    name = "procfs_test",
    srcs = [
        "proc_maps_parser_test.go",
        "snapshot_bound_sockets_test.go",
