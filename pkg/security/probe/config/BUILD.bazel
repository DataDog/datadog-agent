load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "config",
    srcs = ["config.go"],
    importpath = "github.com/DataDog/datadog-agent/pkg/security/probe/config",
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/config/env",
        "//pkg/config/setup",
        "//pkg/ebpf",
        "//pkg/system-probe/config",
        "//pkg/util/filesystem",
        "//pkg/util/log",
    ],
)

dd_agent_go_test(
    name = "config_test",
    srcs = ["config_test.go"],
    embed = [":config"],
    deps = select({
        "@rules_go//go/platform:android": [
            "//pkg/config/mock",
            "@com_github_stretchr_testify//assert",
            "@com_github_stretchr_testify//require",
        ],
        "@rules_go//go/platform:linux": [
            "//pkg/config/mock",
            "@com_github_stretchr_testify//assert",
            "@com_github_stretchr_testify//require",
        ],
        "//conditions:default": [],
    }),
)
