{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "setns.schema.json",
    "type": "object",
    "allOf": [
        {
            "$ref": "event.schema.json"
        },
        {
            "$ref": "usr.schema.json"
        },
        {
            "$ref": "process_context.schema.json"
        },
        {
            "date": {
                "$ref": "datetime.schema.json"
            }
        },
        {
            "properties": {
                "setns": {
                    "type": "object",
                    "required": [
                        "fd",
                        "nstype"
                    ],
                    "properties": {
                        "fd": {
                            "type": "integer"
                        },
                        "nstype": {
                            "type": "string"
                        },
                        "mntns": {
                            "type": "integer"
                        },
                        "netns": {
                            "type": "integer"
                        }
                    }
                }
            },
            "required": [
                "setns"
            ]
        }
    ]
}
