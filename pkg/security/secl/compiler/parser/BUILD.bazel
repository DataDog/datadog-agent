)

dd_agent_go_test(
    name = "parser_test",
    srcs = ["parser_test.go"],
    embed = [":parser"],
    deps = [
        "//pkg/security/secl/compiler/ast",
        "@com_github_stretchr_testify//require",
    ],
)
