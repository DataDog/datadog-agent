load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "seccomp",
    srcs = [
        "policy.go",
        "seccomp.go",
        "seccomp_linux.go",
        "seccomp_unsupported.go",
    ],
    importpath = "github.com/DataDog/datadog-agent/pkg/rshell/internal/sandbox/seccomp",
    visibility = [
        "//pkg/rshell:__subpackages__",
        "@com_github_datadog_datadog_agent_pkg_rshell//:__subpackages__",
    ],
    deps = [
        "@com_github_elastic_go_seccomp_bpf//:go-seccomp-bpf",
        "@com_github_elastic_go_seccomp_bpf//arch",
    ],
)

dd_agent_go_test(
    name = "seccomp_test",
    srcs = [
        "elevation_purego_linux_test.go",
        "policy_test.go",
        "race_disabled_test.go",
        "race_enabled_test.go",
        "seccomp_linux_test.go",
        "seccomp_test.go",
        "seccomp_unsupported_test.go",
    ],
    embed = [":seccomp"],
    deps = [
        "@com_github_elastic_go_seccomp_bpf//:go-seccomp-bpf",
    ] + select({
        "@rules_go//go/platform:android": [
            "@org_golang_x_sys//unix",
        ],
        "@rules_go//go/platform:linux": [
            "@org_golang_x_sys//unix",
        ],
        "//conditions:default": [],
    }),
)

# The rshell binary is built without cgo (pure = "on"), so run the sandbox tests
# that way too: the *_purego_linux_test.go enforcement tests only build without cgo.
dd_agent_go_test(
    # keep
    name = "seccomp_pure_test",
    srcs = [
        "elevation_purego_linux_test.go",
        "policy_test.go",
        "race_disabled_test.go",
        "race_enabled_test.go",
        "seccomp_linux_test.go",
        "seccomp_test.go",
        "seccomp_unsupported_test.go",
    ],
    embed = [":seccomp"],
    pure = "on",
    race = "off",
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        "@com_github_elastic_go_seccomp_bpf//:go-seccomp-bpf",
    ] + select({
        "@rules_go//go/platform:android": [
            "@org_golang_x_sys//unix",
        ],
        "@rules_go//go/platform:linux": [
            "@org_golang_x_sys//unix",
        ],
        "//conditions:default": [],
    }),
)

filegroup(
    name = "source_files",
    srcs = glob(["*.go"]),
    visibility = ["//pkg/rshell:__pkg__"],
)
