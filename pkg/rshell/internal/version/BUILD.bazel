load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")
load("//bazel/rules/variables:variables.bzl", "compute_version_variables")

go_library(
    name = "version",
    srcs = ["version.go"],
    importpath = "github.com/DataDog/datadog-agent/pkg/rshell/internal/version",
    visibility = [
        "//pkg/rshell:__subpackages__",
        "@com_github_datadog_datadog_agent_pkg_rshell//:__subpackages__",
    ],
    x_defs = {"Version": compute_version_variables()["agent_version"]},
)

dd_agent_go_test(
    name = "version_test",
    srcs = ["version_test.go"],
    embed = [":version"],
)

filegroup(
    name = "source_files",
    srcs = glob(["*.go"]),
    visibility = ["//pkg/rshell:__pkg__"],
)
