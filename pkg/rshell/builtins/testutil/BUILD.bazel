load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "testutil",
    srcs = [
        "gnu.go",
        "testutil.go",
    ],
    importpath = "github.com/DataDog/datadog-agent/pkg/rshell/builtins/testutil",
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/rshell/internal/interpoption",
        "//pkg/rshell/interp",
        "@cc_mvdan_sh_v3//syntax",
        "@com_github_stretchr_testify//require",
    ],
)

dd_agent_go_test(
    name = "testutil_test",
    srcs = ["gnu_test.go"],
    embed = [":testutil"],
)

filegroup(
    name = "source_files",
    srcs = glob(["*.go"]),
    visibility = ["//pkg/rshell:__pkg__"],
)
