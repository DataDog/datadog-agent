load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "sha256sum",
    srcs = ["sha256sum.go"],
    importpath = "github.com/DataDog/datadog-agent/pkg/rshell/builtins/sha256sum",
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/rshell/builtins",
        "//pkg/rshell/builtins/internal/flagparser",
    ],
)

dd_agent_go_test(
    name = "sha256sum_test",
    srcs = [
        "sha256sum_internal_test.go",
        "sha256sum_test.go",
    ],
    embed = [":sha256sum"],
    deps = [
        "//pkg/rshell/builtins",
        "//pkg/rshell/builtins/testutil",
        "//pkg/rshell/interp",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)

filegroup(
    name = "source_files",
    srcs = glob(["*.go"]),
    visibility = ["//pkg/rshell:__pkg__"],
)
