load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

dd_agent_go_test(
    name = "wc_test",
    srcs = [
        "helpers_test.go",
        "wc_differential_fuzz_test.go",
        "wc_fuzz_test.go",
        "wc_pentest_test.go",
    ],
    data = glob(["testdata/**"]),
    deps = [
        "//pkg/rshell/builtins/testutil",
        "//pkg/rshell/internal/interpoption",
