load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "tee",
    srcs = ["tee.go"],
    importpath = "github.com/DataDog/datadog-agent/pkg/rshell/builtins/tee",
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/rshell/builtins",
        "//pkg/rshell/builtins/internal/flagparser",
    ],
)

dd_agent_go_test(
    name = "tee_test",
    srcs = ["tee_internal_test.go"],
    embed = [":tee"],
    deps = [
        "//pkg/rshell/builtins",
        "@com_github_spf13_pflag//:pflag",
    ],
)

filegroup(
    name = "source_files",
    srcs = glob(["*.go"]),
    visibility = ["//pkg/rshell:__pkg__"],
)
