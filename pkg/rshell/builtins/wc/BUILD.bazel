load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "wc",
    srcs = [
        "wc.go",
        "wc_isdir_unix.go",
        "wc_isdir_windows.go",
    ],
    importpath = "github.com/DataDog/datadog-agent/pkg/rshell/builtins/wc",
    visibility = ["//visibility:public"],
    deps = ["//pkg/rshell/builtins"],
)

dd_agent_go_test(
    name = "wc_test",
    srcs = [
        "builtin_wc_pentest_test.go",
        "wc_bench_test.go",
        "wc_gnu_compat_test.go",
        "wc_test.go",
        "wc_unix_test.go",
        "wc_vuln_hunt_test.go",
    ],
    deps = [
        "//pkg/rshell/builtins/testutil",
        "//pkg/rshell/interp",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)

filegroup(
    name = "source_files",
    srcs = glob(["*.go"]),
    visibility = ["//pkg/rshell:__pkg__"],
)
