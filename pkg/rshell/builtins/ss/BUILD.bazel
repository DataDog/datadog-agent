load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "ss",
    srcs = [
        "ss.go",
        "ss_darwin.go",
        "ss_linux.go",
        "ss_other.go",
        "ss_windows.go",
    ],
    importpath = "github.com/DataDog/datadog-agent/pkg/rshell/builtins/ss",
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/rshell/builtins",
    ] + select({
        "@rules_go//go/platform:android": [
            "//pkg/rshell/builtins/internal/procnetsocket",
            "//pkg/rshell/builtins/internal/procpath",
        ],
        "@rules_go//go/platform:darwin": [
            "@org_golang_x_sys//unix",
        ],
        "@rules_go//go/platform:ios": [
            "@org_golang_x_sys//unix",
        ],
        "@rules_go//go/platform:linux": [
            "//pkg/rshell/builtins/internal/procnetsocket",
            "//pkg/rshell/builtins/internal/procpath",
        ],
        "@rules_go//go/platform:windows": [
            "//pkg/rshell/builtins/internal/winnet",
        ],
        "//conditions:default": [],
    }),
)

dd_agent_go_test(
    name = "ss_test",
    srcs = [
        "builtin_ss_pentest_test.go",
        "ss_helpers_test.go",
        "ss_linux_test.go",
        "ss_test.go",
        "ss_vuln_hunt_test.go",
    ],
    embed = [":ss"],
    deps = [
        "//pkg/rshell/builtins/testutil",
        "//pkg/rshell/interp",
        "@com_github_stretchr_testify//assert",
    ],
)

filegroup(
    name = "source_files",
    srcs = glob(["*.go"]),
    visibility = ["//pkg/rshell:__pkg__"],
)
