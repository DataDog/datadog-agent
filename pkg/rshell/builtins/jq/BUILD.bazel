load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "jq",
    srcs = [
        "eval.go",
        "jq.go",
        "lexer.go",
        "parser.go",
        "surrogate.go",
        "value.go",
    ],
    importpath = "github.com/DataDog/datadog-agent/pkg/rshell/builtins/jq",
    visibility = ["//visibility:public"],
    deps = ["//pkg/rshell/builtins"],
)

dd_agent_go_test(
    name = "jq_test",
    srcs = [
        "fuzz_test.go",
        "jq_test.go",
        "value_test.go",
    ],
    embed = [":jq"],
    deps = [
        "//pkg/rshell/builtins",
        "@com_github_spf13_pflag//:pflag",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)

filegroup(
    name = "source_files",
    srcs = glob(["*.go"]),
    visibility = ["//pkg/rshell:__pkg__"],
)
