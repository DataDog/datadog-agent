load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "xargs",
    srcs = ["xargs.go"],
    importpath = "github.com/DataDog/datadog-agent/pkg/rshell/builtins/xargs",
    visibility = ["//visibility:public"],
    deps = ["//pkg/rshell/builtins"],
)

dd_agent_go_test(
    name = "xargs_test",
    srcs = [
        "builtin_xargs_pentest_test.go",
        "xargs_gnu_compat_test.go",
        "xargs_hardening_test.go",
        "xargs_internal_test.go",
        "xargs_test.go",
        "xargs_vuln_hunt_test.go",
    ],
    embed = [":xargs"],
    deps = [
        "//pkg/rshell/builtins",
        "//pkg/rshell/builtins/testutil",
        "//pkg/rshell/interp",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)

filegroup(
    name = "source_files",
    srcs = glob(["*.go"]),
    visibility = ["//pkg/rshell:__pkg__"],
)
