load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "head",
    srcs = ["head.go"],
    importpath = "github.com/DataDog/datadog-agent/pkg/rshell/builtins/head",
    visibility = ["//visibility:public"],
    deps = ["//pkg/rshell/builtins"],
)

dd_agent_go_test(
    name = "head_test",
    srcs = [
        "builtin_head_pentest_test.go",
        "head_bench_test.go",
        "head_gnu_compat_test.go",
        "head_test.go",
        "head_unix_test.go",
        "head_windows_test.go",
    ],
    deps = [
        "//pkg/rshell/builtins/testutil",
        "//pkg/rshell/interp",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)

filegroup(
    name = "source_files",
    srcs = glob(["*.go"]),
    visibility = ["//pkg/rshell:__pkg__"],
)
