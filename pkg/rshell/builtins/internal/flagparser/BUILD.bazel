load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "flagparser",
    srcs = [
        "flagparser.go",
        "noargbool.go",
    ],
    importpath = "github.com/DataDog/datadog-agent/pkg/rshell/builtins/internal/flagparser",
    visibility = ["//pkg/rshell/builtins:__subpackages__"],
    deps = ["@com_github_spf13_pflag//:pflag"],
)

dd_agent_go_test(
    name = "flagparser_test",
    srcs = ["flagparser_test.go"],
    embed = [":flagparser"],
    deps = ["@com_github_spf13_pflag//:pflag"],
)

filegroup(
    name = "source_files",
    srcs = glob(["*.go"]),
    visibility = ["//pkg/rshell:__pkg__"],
)
