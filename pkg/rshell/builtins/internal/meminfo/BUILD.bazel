load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "meminfo",
    srcs = [
        "meminfo.go",
        "meminfo_linux.go",
        "meminfo_other.go",
    ],
    importpath = "github.com/DataDog/datadog-agent/pkg/rshell/builtins/internal/meminfo",
    visibility = ["//pkg/rshell/builtins:__subpackages__"],
)

dd_agent_go_test(
    name = "meminfo_test",
    srcs = ["meminfo_linux_test.go"],
    embed = [":meminfo"],
    deps = select({
        "@rules_go//go/platform:android": [
            "@com_github_stretchr_testify//assert",
        ],
        "@rules_go//go/platform:linux": [
            "@com_github_stretchr_testify//assert",
        ],
        "//conditions:default": [],
    }),
)

filegroup(
    name = "source_files",
    srcs = glob(["*.go"]),
    visibility = ["//pkg/rshell:__pkg__"],
)
