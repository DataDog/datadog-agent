load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "procmaps",
    srcs = [
        "procmaps.go",
        "procmaps_darwin.go",
        "procmaps_linux.go",
        "procmaps_other.go",
        "procmaps_windows.go",
    ],
    importpath = "github.com/DataDog/datadog-agent/pkg/rshell/builtins/internal/procmaps",
    visibility = ["//pkg/rshell/builtins:__subpackages__"],
    deps = select({
        "@rules_go//go/platform:darwin": [
            "@org_golang_x_sys//unix",
        ],
        "@rules_go//go/platform:ios": [
            "@org_golang_x_sys//unix",
        ],
        "@rules_go//go/platform:windows": [
            "@org_golang_x_sys//windows",
        ],
        "//conditions:default": [],
    }),
)

dd_agent_go_test(
    name = "procmaps_test",
    srcs = [
        "procmaps_darwin_test.go",
        "procmaps_linux_test.go",
        "procmaps_windows_test.go",
    ],
    embed = [":procmaps"],
    deps = select({
        "@rules_go//go/platform:android": [
            "@com_github_stretchr_testify//assert",
        ],
        "@rules_go//go/platform:darwin": [
            "@com_github_stretchr_testify//assert",
        ],
        "@rules_go//go/platform:ios": [
            "@com_github_stretchr_testify//assert",
        ],
        "@rules_go//go/platform:linux": [
            "@com_github_stretchr_testify//assert",
        ],
        "@rules_go//go/platform:windows": [
            "@com_github_stretchr_testify//assert",
            "@org_golang_x_sys//windows",
        ],
        "//conditions:default": [],
    }),
)

filegroup(
    name = "source_files",
    srcs = glob(["*.go"]),
    visibility = ["//pkg/rshell:__pkg__"],
)
