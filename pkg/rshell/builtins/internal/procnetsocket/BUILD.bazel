load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "procnetsocket",
    srcs = [
        "procnetsocket.go",
        "procnetsocket_linux.go",
        "procnetsocket_other.go",
    ],
    importpath = "github.com/DataDog/datadog-agent/pkg/rshell/builtins/internal/procnetsocket",
    visibility = ["//pkg/rshell/builtins:__subpackages__"],
    deps = ["//pkg/rshell/builtins/internal/procpath"],
)

dd_agent_go_test(
    name = "procnetsocket_test",
    srcs = [
        "procnetsocket_linux_fuzz_test.go",
        "procnetsocket_linux_parse_test.go",
        "procnetsocket_linux_vuln_hunt_test.go",
        "procnetsocket_other_vuln_hunt_test.go",
        "procnetsocket_vuln_hunt_test.go",
    ],
    embed = [":procnetsocket"],
    deps = select({
        "@rules_go//go/platform:android": [
            "@com_github_stretchr_testify//assert",
            "@com_github_stretchr_testify//require",
        ],
        "@rules_go//go/platform:linux": [
            "@com_github_stretchr_testify//assert",
            "@com_github_stretchr_testify//require",
        ],
        "//conditions:default": [],
    }),
)

filegroup(
    name = "source_files",
    srcs = glob(["*.go"]),
    visibility = ["//pkg/rshell:__pkg__"],
)
