load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "procfd",
    srcs = [
        "procfd.go",
        "procfd_linux.go",
        "procfd_other.go",
    ],
    importpath = "github.com/DataDog/datadog-agent/pkg/rshell/builtins/internal/procfd",
    visibility = ["//pkg/rshell/builtins:__subpackages__"],
    deps = select({
        "@rules_go//go/platform:android": [
            "@org_golang_x_sys//unix",
        ],
        "@rules_go//go/platform:linux": [
            "@org_golang_x_sys//unix",
        ],
        "//conditions:default": [],
    }),
)

dd_agent_go_test(
    name = "procfd_test",
    srcs = [
        "procfd_linux_fuzz_test.go",
        "procfd_linux_test.go",
        "procfd_other_test.go",
    ],
    embed = [":procfd"],
    deps = select({
        "@rules_go//go/platform:android": [
            "//pkg/rshell/builtins/internal/procpath",
            "@org_golang_x_sys//unix",
        ],
        "@rules_go//go/platform:linux": [
            "//pkg/rshell/builtins/internal/procpath",
            "@org_golang_x_sys//unix",
        ],
        "//conditions:default": [],
    }),
)

filegroup(
    name = "source_files",
    srcs = glob(["*.go"]),
    visibility = ["//pkg/rshell:__pkg__"],
)
