load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "procsyskernel",
    srcs = ["procsyskernel.go"],
    importpath = "github.com/DataDog/datadog-agent/pkg/rshell/builtins/internal/procsyskernel",
    visibility = ["//pkg/rshell/builtins:__subpackages__"],
)

dd_agent_go_test(
    name = "procsyskernel_test",
    srcs = [
        "procsyskernel_fifo_vuln_hunt_test.go",
        "procsyskernel_vuln_hunt_test.go",
    ],
    embed = [":procsyskernel"],
)

filegroup(
    name = "source_files",
    srcs = glob(["*.go"]),
    visibility = ["//pkg/rshell:__pkg__"],
)
