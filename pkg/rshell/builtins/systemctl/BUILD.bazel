load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "systemctl",
    srcs = ["systemctl.go"],
    importpath = "github.com/DataDog/datadog-agent/pkg/rshell/builtins/systemctl",
    visibility = ["//visibility:public"],
    deps = ["//pkg/rshell/builtins"],
)

dd_agent_go_test(
    name = "systemctl_test",
    srcs = ["systemctl_test.go"],
    embed = [":systemctl"],
    deps = [
        "//pkg/rshell/builtins",
        "@com_github_spf13_pflag//:pflag",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)

filegroup(
    name = "source_files",
    srcs = glob(["*.go"]),
    visibility = ["//pkg/rshell:__pkg__"],
)
