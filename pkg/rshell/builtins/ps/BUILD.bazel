load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "ps",
    srcs = [
        "format.go",
        "ps.go",
    ],
    importpath = "github.com/DataDog/datadog-agent/pkg/rshell/builtins/ps",
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/rshell/builtins",
        "//pkg/rshell/builtins/internal/procinfo",
    ],
)

dd_agent_go_test(
    name = "ps_test",
    srcs = [
        "format_test.go",
        "ps_procpath_linux_test.go",
        "ps_test.go",
    ],
    embed = [":ps"],
    deps = [
        "//pkg/rshell/builtins",
        "//pkg/rshell/builtins/internal/procinfo",
        "//pkg/rshell/internal/interpoption",
        "//pkg/rshell/interp",
        "@cc_mvdan_sh_v3//syntax",
        "@com_github_stretchr_testify//require",
    ],
)

filegroup(
    name = "source_files",
    srcs = glob(["*.go"]),
    visibility = ["//pkg/rshell:__pkg__"],
)
