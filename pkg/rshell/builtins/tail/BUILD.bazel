load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "tail",
    srcs = ["tail.go"],
    importpath = "github.com/DataDog/datadog-agent/pkg/rshell/builtins/tail",
    visibility = ["//visibility:public"],
    deps = ["//pkg/rshell/builtins"],
)

dd_agent_go_test(
    name = "tail_test",
    srcs = [
        "builtin_tail_pentest_test.go",
        "tail_bench_test.go",
        "tail_gnu_compat_test.go",
        "tail_test.go",
        "tail_unix_test.go",
        "tail_windows_test.go",
    ],
    deps = [
        ":tail",
        "//pkg/rshell/builtins/testutil",
        "//pkg/rshell/interp",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)

filegroup(
    name = "source_files",
    srcs = glob(["*.go"]),
    visibility = ["//pkg/rshell:__pkg__"],
)
