load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "builtins",
    srcs = [
        "builtins.go",
        "features.go",
        "is_broken_pipe_other.go",
        "is_broken_pipe_windows.go",
        "proc_provider.go",
        "system_service.go",
    ],
    importpath = "github.com/DataDog/datadog-agent/pkg/rshell/builtins",
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/rshell/builtins/internal/flagparser",
        "//pkg/rshell/builtins/internal/procfd",
        "//pkg/rshell/builtins/internal/procinfo",
        "//pkg/rshell/builtins/internal/procmaps",
        "//pkg/rshell/builtins/internal/procsyskernel",
        "@com_github_spf13_pflag//:pflag",
    ],
)

dd_agent_go_test(
    name = "builtins_test",
    srcs = [
        "features_test.go",
        "is_broken_pipe_other_test.go",
        "is_broken_pipe_test.go",
        "is_broken_pipe_windows_test.go",
        "safe_operand_test.go",
        "system_service_test.go",
    ],
    embed = [":builtins"],
)

filegroup(
    name = "source_files",
    srcs = glob(["*.go"]),
    visibility = ["//pkg/rshell:__pkg__"],
)
