load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "lsof",
    srcs = ["lsof.go"],
    importpath = "github.com/DataDog/datadog-agent/pkg/rshell/builtins/lsof",
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/rshell/builtins",
        "//pkg/rshell/builtins/internal/procfd",
    ],
)

dd_agent_go_test(
    name = "lsof_test",
    srcs = [
        "lsof_fuzz_test.go",
        "lsof_test.go",
    ],
    embed = [":lsof"],
    deps = ["//pkg/rshell/builtins/internal/procfd"],
)

filegroup(
    name = "source_files",
    srcs = glob(["*.go"]),
    visibility = ["//pkg/rshell:__pkg__"],
)
