load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "pmap",
    srcs = ["pmap.go"],
    importpath = "github.com/DataDog/datadog-agent/pkg/rshell/builtins/pmap",
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/rshell/builtins",
        "//pkg/rshell/builtins/internal/procmaps",
    ],
)

dd_agent_go_test(
    name = "pmap_test",
    srcs = [
        "pmap_procpath_linux_test.go",
        "pmap_test.go",
    ],
    deps = [
        "//pkg/rshell/builtins/testutil",
        "//pkg/rshell/interp",
        "@com_github_stretchr_testify//assert",
    ] + select({
        "@rules_go//go/platform:android": [
            "//pkg/rshell/internal/interpoption",
            "@cc_mvdan_sh_v3//syntax",
            "@com_github_stretchr_testify//require",
        ],
        "@rules_go//go/platform:linux": [
            "//pkg/rshell/internal/interpoption",
            "@cc_mvdan_sh_v3//syntax",
            "@com_github_stretchr_testify//require",
        ],
        "//conditions:default": [],
    }),
)

filegroup(
    name = "source_files",
    srcs = glob(["*.go"]),
    visibility = ["//pkg/rshell:__pkg__"],
)
