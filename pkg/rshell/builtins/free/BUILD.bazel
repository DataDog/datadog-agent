load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "free",
    srcs = ["free.go"],
    importpath = "github.com/DataDog/datadog-agent/pkg/rshell/builtins/free",
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/rshell/builtins",
        "//pkg/rshell/builtins/internal/meminfo",
    ],
)

dd_agent_go_test(
    name = "free_test",
    srcs = [
        "free_internal_test.go",
        "free_test.go",
    ],
    embed = [":free"],
    deps = [
        "//pkg/rshell/builtins",
        "//pkg/rshell/builtins/internal/meminfo",
        "//pkg/rshell/builtins/testutil",
        "//pkg/rshell/interp",
        "@com_github_stretchr_testify//assert",
    ],
)

filegroup(
    name = "source_files",
    srcs = glob(["*.go"]),
    visibility = ["//pkg/rshell:__pkg__"],
)
