load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "uptime",
    srcs = ["uptime.go"],
    importpath = "github.com/DataDog/datadog-agent/pkg/rshell/builtins/uptime",
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/rshell/builtins",
        "//pkg/rshell/builtins/internal/sysinfo",
    ],
)

dd_agent_go_test(
    name = "uptime_test",
    srcs = ["uptime_test.go"],
    embed = [":uptime"],
    deps = [
        "//pkg/rshell/builtins/internal/sysinfo",
        "@com_github_stretchr_testify//assert",
    ],
)

filegroup(
    name = "source_files",
    srcs = glob(["*.go"]),
    visibility = ["//pkg/rshell:__pkg__"],
)
