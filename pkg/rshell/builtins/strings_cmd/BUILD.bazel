load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "strings_cmd",
    srcs = ["strings.go"],
    importpath = "github.com/DataDog/datadog-agent/pkg/rshell/builtins/strings_cmd",
    visibility = ["//visibility:public"],
    deps = ["//pkg/rshell/builtins"],
)

dd_agent_go_test(
    name = "strings_cmd_test",
    srcs = [
        "strings_bench_test.go",
        "strings_cmd_vuln_hunt_test.go",
        "strings_pentest_test.go",
    ],
    deps = [
        "//pkg/rshell/builtins/testutil",
        "//pkg/rshell/internal/interpoption",
        "//pkg/rshell/interp",
        "@cc_mvdan_sh_v3//syntax",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)

filegroup(
    name = "source_files",
    srcs = glob(["*.go"]),
    visibility = ["//pkg/rshell:__pkg__"],
)
