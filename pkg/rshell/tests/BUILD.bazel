load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

dd_agent_go_test(
    name = "tests_test",
    srcs = [
        "compliance_test.go",
        "scenarios_test.go",
    ],
    data = ["//pkg/rshell:source_files"] + glob(["scenarios/**"]),
    deps = [
        "//pkg/rshell/internal/interpoption",
        "//pkg/rshell/interp",
        "@cc_mvdan_sh_v3//syntax",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
        "@in_gopkg_yaml_v3//:yaml_v3",
    ],
)

filegroup(
    name = "source_files",
    srcs = glob(["*.go"]),
    visibility = ["//pkg/rshell:__pkg__"],
)
