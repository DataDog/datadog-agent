# gazelle:go_visibility //pkg/privateactionrunner/rshell:__pkg__

load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "rshell_lib",
    srcs = [
        "main.go",
        "privileged_helper_linux.go",
        "privileged_helper_unsupported.go",
        "privileged_worker_linux.go",
        "telemetry_off.go",
    ],
    importpath = "github.com/DataDog/datadog-agent/pkg/rshell/cmd/rshell",
    visibility = ["//pkg/privateactionrunner/rshell:__pkg__"],
    deps = [
        "//pkg/rshell/internal/interpoption",
        "//pkg/rshell/internal/version",
        "//pkg/rshell/interp",
        "@com_github_spf13_cobra//:cobra",
    ] + select({
        "@rules_go//go/platform:android": [
            "//pkg/rshell/internal/sandbox/landlock",
            "//pkg/rshell/internal/sandbox/seccomp",
            "//pkg/rshell/internal/systemd",
            "//pkg/rshell/privilegedhelper",
            "@cc_mvdan_sh_v3//syntax",
        ],
        "@rules_go//go/platform:linux": [
            "//pkg/rshell/internal/sandbox/landlock",
            "//pkg/rshell/internal/sandbox/seccomp",
            "//pkg/rshell/internal/systemd",
            "//pkg/rshell/privilegedhelper",
            "@cc_mvdan_sh_v3//syntax",
        ],
        "//conditions:default": [],
    }),
)

go_binary(
    name = "rshell",
    embed = [":rshell_lib"],
    visibility = ["//visibility:public"],
)

dd_agent_go_test(
    name = "rshell_test",
    srcs = [
        "main_procpath_linux_test.go",
        "main_test.go",
        "privileged_helper_linux_test.go",
        "privileged_helper_root_integration_test.go",
        "privileged_worker_linux_test.go",
    ],
    embed = [":rshell_lib"],
    deps = [
        "//pkg/rshell/internal/version",
        "//pkg/rshell/interp",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ] + select({
        "@rules_go//go/platform:android": [
            "//pkg/rshell/internal/sandbox/landlock",
            "//pkg/rshell/internal/systemd",
            "//pkg/rshell/privilegedhelper",
            "@org_golang_google_protobuf//proto",
            "@org_golang_google_protobuf//types/known/structpb",
            "@org_golang_google_protobuf//types/known/timestamppb",
        ],
        "@rules_go//go/platform:linux": [
            "//pkg/rshell/internal/sandbox/landlock",
            "//pkg/rshell/internal/systemd",
            "//pkg/rshell/privilegedhelper",
            "@org_golang_google_protobuf//proto",
            "@org_golang_google_protobuf//types/known/structpb",
            "@org_golang_google_protobuf//types/known/timestamppb",
        ],
        "//conditions:default": [],
    }),
)

filegroup(
    name = "source_files",
    srcs = glob(["*.go"]),
    visibility = ["//pkg/rshell:__pkg__"],
)
