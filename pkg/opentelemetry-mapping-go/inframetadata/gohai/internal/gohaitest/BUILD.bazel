load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")
load("//bazel/rules/go_package_metadata:defs.bzl", "go_package_metadata")

package(default_package_metadata = [":go_package_metadata"])

go_package_metadata(
    name = "go_package_metadata",
    module = "github.com/DataDog/datadog-agent/pkg/opentelemetry-mapping-go/inframetadata/gohai/internal/gohaitest",
)

dd_agent_go_test(
    name = "gohaitest_test",
    srcs = ["gohai_test.go"],
    env_inherit = select({
        "@platforms//os:macos": ["PATH"],  # gohai's darwin collectors shell out to sysctl, df, and uname
        "//conditions:default": [],
    }),
    deps = [
        "//pkg/opentelemetry-mapping-go/inframetadata/gohai",
        "@com_github_datadog_gohai//cpu",
        "@com_github_datadog_gohai//filesystem",
        "@com_github_datadog_gohai//memory",
        "@com_github_datadog_gohai//network",
        "@com_github_datadog_gohai//platform",
        "@com_github_stretchr_testify//require",
    ],
)
