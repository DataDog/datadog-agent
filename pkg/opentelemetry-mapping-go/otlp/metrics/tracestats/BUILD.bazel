load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "tracestats",
    srcs = ["sdk_trace_stats.go"],
    importpath = "github.com/DataDog/datadog-agent/pkg/opentelemetry-mapping-go/otlp/metrics/tracestats",
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/opentelemetry-mapping-go/otlp/attributes",
        "//pkg/opentelemetry-mapping-go/otlp/metrics/tracestats/pb",
        "//pkg/trace/traceutil/normalize",
