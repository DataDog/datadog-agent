dd_agent_go_test(
    name = "artifactstore_test",
    srcs = ["store_test.go"],
    embed = [":artifactstore"],
    deps = [
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
