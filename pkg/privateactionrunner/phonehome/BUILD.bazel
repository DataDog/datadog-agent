load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "phonehome",
    srcs = [
        "controller.go",
        "source.go",
    ],
    importpath = "github.com/DataDog/datadog-agent/pkg/privateactionrunner/phonehome",
    visibility = ["//visibility:public"],
    deps = [
        "//comp/privateactionrunner/phonehome/def",
        "//comp/remote-config/rcservice/def",
        "//pkg/config/env",
        "//pkg/config/model",
        "//pkg/config/utils",
        "//pkg/fips",
        "//pkg/privateactionrunner",
        "//pkg/privateactionrunner/adapters/constants",
        "//pkg/privateactionrunner/enrollment",
        "//pkg/privateactionrunner/opms",
        "//pkg/privateactionrunner/util",
        "//pkg/proto/pbgo/procmgr",
        "//pkg/util/flavor",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//credentials/insecure",
    ],
)

dd_agent_go_test(
    name = "phonehome_test",
    srcs = [
        "controller_test.go",
        "http_stack_test.go",
        "source_test.go",
    ],
    data = glob(["testdata/**"]),
    embed = [":phonehome"],
    deps = [
        "//comp/remote-config/rcservice/def",
        "//pkg/config/mock",
        "//pkg/config/model",
        "//pkg/config/remote/service",
        "//pkg/privateactionrunner",
        "//pkg/privateactionrunner/adapters/constants",
        "//pkg/privateactionrunner/enrollment",
        "//pkg/privateactionrunner/opms",
        "//pkg/privateactionrunner/util",
        "//pkg/proto/pbgo/core",
        "//pkg/proto/pbgo/procmgr",
        "@com_github_benbjohnson_clock//:clock",
        "@com_github_stretchr_testify//require",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_protobuf//proto",
    ],
)
