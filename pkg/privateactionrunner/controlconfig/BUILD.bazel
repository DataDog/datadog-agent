load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "controlconfig",
    srcs = ["config.go"],
    importpath = "github.com/DataDog/datadog-agent/pkg/privateactionrunner/controlconfig",
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/config/model",
        "//pkg/config/utils",
        "//pkg/privateactionrunner/enrollment",
    ],
)

dd_agent_go_test(
    name = "controlconfig_test",
    srcs = ["config_test.go"],
    embed = [":controlconfig"],
    deps = [
        "//comp/core/delegatedauth/mock",
        "//comp/core/secrets/mock",
        "//pkg/config/mock",
        "//pkg/config/setup",
        "//pkg/privateactionrunner/enrollment",
        "@com_github_stretchr_testify//require",
    ],
)
