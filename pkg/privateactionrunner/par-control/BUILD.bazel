load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")
load(":version.bzl", "par_control_agent_version")

_RUSTC_ENV = {"DD_AGENT_VERSION": par_control_agent_version()}

_LINUX_OR_WINDOWS = select({
    "@platforms//os:linux": [],
    "@platforms//os:windows": [],
    "//conditions:default": ["@platforms//:incompatible"],
})

# rust_prost_library propagates CcInfo from proto_library, which transitively
# includes abseil-cpp (C++). The Rust linker does not add libstdc++ by default.
cc_library(
    name = "cpp_stdlib",
    linkopts = select({
        "@platforms//os:windows": [],
        "@platforms//os:macos": [],
        "//conditions:default": ["-lstdc++"],
    }),
)

rust_library(
    name = "par-control-lib",
    srcs = [
        "src/bootstrap.rs",
        "src/config.rs",
        "src/executor.rs",
        "src/identity.rs",
        "src/lib.rs",
        "src/platform.rs",
        "src/procmgr.rs",
        "src/proto.rs",
        "src/test_support.rs",
        "src/tls.rs",
        "src/transport.rs",
    ],
    crate_name = "par_control",
    edition = "2024",
    link_deps = [":cpp_stdlib"],
    rustc_env = _RUSTC_ENV,
    rustc_flags = ["--cfg=bazel"],
    target_compatible_with = _LINUX_OR_WINDOWS,
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/proto/datadog/privateactionrunner:executor_rust_proto",
        "//pkg/proto/datadog/procmgr:procmgr_rust_proto",
        "@crates//:anyhow",
        "@crates//:hyper-util",
        "@crates//:log",
        "@crates//:native-tls",
        "@crates//:openssl",
        "@crates//:prost",
        "@crates//:reqwest",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:serde_yaml",
        "@crates//:tokio",
        "@crates//:tokio-native-tls",
        "@crates//:tokio-stream",
        "@crates//:tonic",
        "@crates//:tonic-prost",
        "@crates//:tower",
    ] + select({
        "@platforms//os:windows": [
            "@crates//:windows-registry",
            "@crates//:windows-sys",
        ],
        "//conditions:default": [],
    }),
)

rust_binary(
    name = "par-control",
    srcs = ["src/bins/par-control.rs"],
    edition = "2024",
    rustc_flags = ["--cfg=bazel"],
    target_compatible_with = _LINUX_OR_WINDOWS,
    visibility = ["//visibility:public"],
    deps = [
        ":par-control-lib",
        "//comp/core/log/rust:dd-agent-log",
        "@crates//:anyhow",
        "@crates//:clap",
        "@crates//:log",
        "@crates//:tokio",
    ],
)

rust_test(
    name = "par-control_test",
    crate = ":par-control-lib",
    edition = "2024",
    rustc_env = _RUSTC_ENV,
    rustc_flags = ["--cfg=bazel"],
    target_compatible_with = _LINUX_OR_WINDOWS,
    deps = [
        "@crates//:tempfile",
        "@crates//:tokio-stream",
    ],
)
