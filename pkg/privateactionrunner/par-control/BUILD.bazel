load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

_LINUX_OR_WINDOWS = select({
    "@platforms//os:linux": [],
    "@platforms//os:windows": [],
    "//conditions:default": ["@platforms//:incompatible"],
})

# The executor rust_prost_library propagates C++ link requirements.
cc_library(
    name = "cpp_stdlib",
    linkopts = select({
        "@platforms//os:windows": [],
        "@platforms//os:macos": [],
        "//conditions:default": ["-lstdc++"],
    }),
)

rust_library(
    name = "par-control-lib",
    srcs = [
        "src/bootstrap.rs",
        "src/config.rs",
        "src/executor.rs",
        "src/identity.rs",
        "src/jwt.rs",
        "src/lib.rs",
        "src/opms.rs",
        "src/orchestrator.rs",
        "src/procmgr.rs",
        "src/proto.rs",
        "src/test_support.rs",
        "src/tls.rs",
        "src/transport.rs",
    ],
    compile_data = glob(["testdata/*.txt"]),
    crate_name = "par_control",
    edition = "2024",
    link_deps = [":cpp_stdlib"],
    rustc_flags = ["--cfg=bazel"],
    target_compatible_with = _LINUX_OR_WINDOWS,
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/procmgr/rust/client:dd-procmgr-client",
        "//pkg/proto/datadog/privateactionrunner:executor_rust_proto",
        "@crates//:anyhow",
        "@crates//:base64",
        "@crates//:chrono",
        "@crates//:datadog-agent-commons",
        "@crates//:hyper-util",
        "@crates//:log",
        "@crates//:p256",
        "@crates//:prost",
        "@crates//:reqwest",
        "@crates//:rustls",
        "@crates//:rustls-pki-types",
        "@crates//:saluki-tls",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:tokio",
        "@crates//:tokio-rustls",
        "@crates//:tokio-stream",
        "@crates//:tonic",
        "@crates//:tonic-prost",
        "@crates//:tower",
    ],
)

rust_binary(
    name = "par-control",
    srcs = ["src/bins/par-control.rs"],
    edition = "2024",
    target_compatible_with = _LINUX_OR_WINDOWS,
    visibility = ["//visibility:public"],
    deps = [
        ":par-control-lib",
        "//comp/core/log/rust:dd-agent-log",
        "@crates//:anyhow",
        "@crates//:clap",
        "@crates//:log",
        "@crates//:tokio",
    ],
)

rust_test(
    name = "par-control_test",
    crate = ":par-control-lib",
    edition = "2024",
    rustc_flags = ["--cfg=bazel"],
    target_compatible_with = _LINUX_OR_WINDOWS,
    deps = [
        "@crates//:tempfile",
        "@crates//:tokio",
        "@crates//:tokio-stream",
    ],
)
