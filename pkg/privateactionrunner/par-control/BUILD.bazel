load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")
load(":version.bzl", "par_control_agent_version")

# par-control reports this to OPMS in the X-Datadog-OnPrem-Version header, so it
# must be the agent version rather than the crate version. Crate-local for now;
# see version.bzl for why it is not yet shared with the Go binaries' x_defs.
_RUSTC_ENV = {"DD_AGENT_VERSION": par_control_agent_version()}

_LINUX_OR_WINDOWS = select({
    "@platforms//os:linux": [],
    "@platforms//os:windows": [],
    "//conditions:default": ["@platforms//:incompatible"],
})

# rust_prost_library propagates CcInfo from proto_library, which transitively
# includes abseil-cpp (C++). The Rust linker does not add libstdc++ by default,
# so we provide it explicitly (same pattern as //pkg/procmgr/rust).
cc_library(
    name = "cpp_stdlib",
    linkopts = select({
        "@platforms//os:windows": [],
        # macOS has no libstdc++; the toolchain already links libc++ by default.
        "@platforms//os:macos": [],
        "//conditions:default": ["-lstdc++"],
    }),
)

_LIB_SRCS = glob(
    ["src/**/*.rs"],
    exclude = ["src/bins/**"],
)

_LIB_DEPS = [
    "//pkg/proto/datadog/privateactionrunner:executor_rust_proto",
    "//pkg/proto/datadog/procmgr:procmgr_rust_proto",
    "@crates//:anyhow",
    "@crates//:base64",
    "@crates//:chrono",
    "@crates//:hyper-util",
    "@crates//:log",
    "@crates//:native-tls",
    "@crates//:openssl",
    "@crates//:p256",
    "@crates//:prost",
    "@crates//:reqwest",
    "@crates//:serde",
    "@crates//:serde_json",
    "@crates//:serde_yaml",
    "@crates//:tokio",
    "@crates//:tokio-native-tls",
    "@crates//:tokio-stream",
    "@crates//:tonic",
    "@crates//:tonic-prost",
    "@crates//:tower",
    "@crates//:uuid",
]

rust_library(
    name = "par-control-lib",
    srcs = _LIB_SRCS,
    crate_name = "par_control",
    edition = "2024",
    link_deps = [":cpp_stdlib"],
    rustc_env = _RUSTC_ENV,
    rustc_flags = ["--cfg=bazel"],
    target_compatible_with = _LINUX_OR_WINDOWS,
    visibility = ["//visibility:public"],
    deps = _LIB_DEPS,
)

rust_binary(
    name = "par-control",
    srcs = ["src/bins/par-control.rs"],
    edition = "2024",
    rustc_flags = ["--cfg=bazel"],
    target_compatible_with = _LINUX_OR_WINDOWS,
    visibility = ["//visibility:public"],
    deps = [
        ":par-control-lib",
        "//comp/core/log/rust:dd-agent-log",
        "@crates//:anyhow",
        "@crates//:clap",
        "@crates//:log",
        "@crates//:tokio",
    ],
)

rust_test(
    name = "par-control_test",
    crate = ":par-control-lib",
    edition = "2024",
    rustc_env = _RUSTC_ENV,
    rustc_flags = ["--cfg=bazel"],
    # Linux-only, unlike the library and binary above, which build for both.
    # The crate links the Agent's OpenSSL, which on Windows is
    # libcrypto-3-x64.dll / libssl-3-x64.dll consumed via import libs. Bazel
    # does not stage those next to a rust_test exe, so the test binary fails to
    # load before main() (STATUS_DLL_NOT_FOUND / exit -1073741515).
    # TODO(ACTP-xxxx): stage the OpenSSL DLLs so these tests run on Windows too.
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        "@crates//:tempfile",
        "@crates//:tokio",
    ],
)
