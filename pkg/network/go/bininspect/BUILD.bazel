    ],
    data = [
        ":pclntab_fixture",
        "//pkg/network/usm/testdata/site-packages/ddtrace:testdata",
    ],
    embed = [":bininspect"],
    env = {
        "BININSPECT_PCLNTAB_FIXTURE": "$(rlocationpath :pclntab_fixture)",
    },
    target_compatible_with = ["@platforms//os:linux"],
    deps = select({
        "@rules_go//go/platform:android": [
            "//pkg/network/protocols/http/testutil",
