load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "procnet",
    srcs = [
        "parser.go",
        "procnet.go",
    ],
    importpath = "github.com/DataDog/datadog-agent/pkg/network/usm/procnet",
    tags = ["manual"],
    visibility = ["//visibility:public"],
    deps = select({
        "@rules_go//go/platform:android": [
            "//pkg/util/kernel",
            "//pkg/util/kernel/netns",
        ],
        "@rules_go//go/platform:linux": [
            "//pkg/util/kernel",
            "//pkg/util/kernel/netns",
        ],
        "//conditions:default": [],
    }),
)

dd_agent_go_test(
    name = "procnet_test",
    srcs = [
        "parser_test.go",
        "procnet_test.go",
    ],
    embed = [":procnet"],
    gotags_sets = [["bpf"]],
    include_default = False,
    tags = ["requires_ebpf"],
    deps = select({
        "@rules_go//go/platform:android": [
            "//pkg/network/protocols/http/testutil",
            "@com_github_stretchr_testify//assert",
        ],
        "@rules_go//go/platform:linux": [
            "//pkg/network/protocols/http/testutil",
            "@com_github_stretchr_testify//assert",
        ],
        "//conditions:default": [],
    }),
)
