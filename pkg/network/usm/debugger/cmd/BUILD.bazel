load("@rules_go//go:def.bzl", "go_binary", "go_library")

# ebpf_bytecode.go embeds usm-debug.o and shared-libraries-debug.o by bare
# filename (//go:embed), so the prebuilt eBPF program outputs from
# //pkg/network/ebpf/c/prebuilt (a different package) must be copied into
# this package under matching names before they can be embedded.
genrule(
    name = "copy_usm_debug_o",
    srcs = ["//pkg/network/ebpf/c/prebuilt:usm-debug"],
    outs = ["usm-debug.o"],
    cmd = "cp $< $@",
    target_compatible_with = ["@platforms//os:linux"],
)

genrule(
    name = "copy_shared_libraries_debug_o",
    srcs = ["//pkg/network/ebpf/c/prebuilt:shared-libraries-debug"],
    outs = ["shared-libraries-debug.o"],
    cmd = "cp $< $@",
    target_compatible_with = ["@platforms//os:linux"],
)

go_binary(
    name = "usm_debugger",
    embed = [":cmd_lib"],
    gotags = [
        "linux_bpf",
    ],
    target_compatible_with = ["@platforms//os:linux"],
    visibility = ["//visibility:private"],
)

go_library(
    name = "cmd_lib",
    srcs = [
        "ebpf_bytecode.go",
        "usm_debugger.go",
    ],
    embedsrcs = select({
        "@rules_go//go/platform:android": [
            "shared-libraries-debug.o",
            "usm-debug.o",
        ],
        "@rules_go//go/platform:linux": [
            "shared-libraries-debug.o",
            "usm-debug.o",
        ],
        "//conditions:default": [],
    }),
    importpath = "github.com/DataDog/datadog-agent/pkg/network/usm/debugger/cmd",
    target_compatible_with = ["@platforms//os:linux"],
    visibility = ["//visibility:private"],
    deps = select({
        "@rules_go//go/platform:android": [
            "//pkg/config/setup",
            "//pkg/network/config",
            "//pkg/network/usm",
            "//pkg/system-probe/config",
            "//pkg/util/log",
            "//pkg/util/log/setup",
        ],
        "@rules_go//go/platform:linux": [
            "//pkg/config/setup",
            "//pkg/network/config",
            "//pkg/network/usm",
            "//pkg/system-probe/config",
            "//pkg/util/log",
            "//pkg/util/log/setup",
        ],
        "//conditions:default": [],
    }),
)
