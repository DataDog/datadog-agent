load("@rules_go//go:def.bzl", "go_binary")

# ebpf_bytecode.go embeds usm-debug.o and shared-libraries-debug.o by bare
# filename (//go:embed), so the prebuilt eBPF program outputs from
# //pkg/network/ebpf/c/prebuilt (a different package) must be copied into
# this package under matching names before they can be embedded.
genrule(
    name = "copy_usm_debug_o",
    srcs = ["//pkg/network/ebpf/c/prebuilt:usm-debug"],
    outs = ["usm-debug.o"],
    cmd = "cp $< $@",
)

genrule(
    name = "copy_shared_libraries_debug_o",
    srcs = ["//pkg/network/ebpf/c/prebuilt:shared-libraries-debug"],
    outs = ["shared-libraries-debug.o"],
    cmd = "cp $< $@",
)

go_binary(
    name = "usm_debugger",
    srcs = [
        "ebpf_bytecode.go",
        "usm_debugger.go",
    ],
    embedsrcs = [
        ":copy_shared_libraries_debug_o",
        ":copy_usm_debug_o",
    ],
    gotags = [
        "linux_bpf",
    ],
    target_compatible_with = ["@platforms//os:linux"],
    visibility = ["//visibility:private"],
    deps = [
        "//pkg/config/setup",
        "//pkg/network/config",
        "//pkg/network/usm",
        "//pkg/system-probe/config",
        "//pkg/util/log",
        "//pkg/util/log/setup",
    ],
)
