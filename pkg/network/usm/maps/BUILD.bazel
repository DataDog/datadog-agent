load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "maps",
    srcs = [
        "detector.go",
        "pid_validator.go",
        "types.go",
    ],
    importpath = "github.com/DataDog/datadog-agent/pkg/network/usm/maps",
    visibility = ["//visibility:public"],
    deps = select({
        "@rules_go//go/platform:android": [
            "//pkg/network/usm",
            "//pkg/util/kernel",
            "@com_github_cilium_ebpf//:ebpf",
        ],
        "@rules_go//go/platform:linux": [
            "//pkg/network/usm",
            "//pkg/util/kernel",
            "@com_github_cilium_ebpf//:ebpf",
        ],
        "//conditions:default": [],
    }),
)

dd_agent_go_test(
    name = "maps_test",
    srcs = [
        "detector_test.go",
        "pid_validator_test.go",
    ],
    embed = [":maps"],
    gotags_sets = [["bpf"]],
    include_default = False,
    tags = ["requires_ebpf"],
    deps = select({
        "@rules_go//go/platform:android": [
            "//pkg/util/kernel",
            "@com_github_cilium_ebpf//:ebpf",
            "@com_github_cilium_ebpf//rlimit",
            "@com_github_stretchr_testify//require",
        ],
        "@rules_go//go/platform:linux": [
            "//pkg/util/kernel",
            "@com_github_cilium_ebpf//:ebpf",
            "@com_github_cilium_ebpf//rlimit",
            "@com_github_stretchr_testify//require",
        ],
        "//conditions:default": [],
    }),
)
