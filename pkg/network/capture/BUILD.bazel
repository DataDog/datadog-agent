load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

# pcap is excluded from the default unit-test tags; Bazel links the static libpcap.
# gazelle:go_canonical_test_tag_set pcap

go_library(
    name = "capture",
    srcs = [
        "capture.go",
        "config.go",
        "trim.go",
    ],
    importpath = "github.com/DataDog/datadog-agent/pkg/network/capture",
    visibility = ["//visibility:public"],
    deps = select({
        "@rules_go//go/platform:android": [
            "@com_github_google_gopacket//:gopacket",
            "@com_github_google_gopacket//layers",
            "@com_github_google_gopacket//pcap",
            "@com_github_google_gopacket//pcapgo",
        ],
        "@rules_go//go/platform:linux": [
            "@com_github_google_gopacket//:gopacket",
            "@com_github_google_gopacket//layers",
            "@com_github_google_gopacket//pcap",
            "@com_github_google_gopacket//pcapgo",
        ],
        "//conditions:default": [],
    }),
)

dd_agent_go_test(
    name = "capture_test",
    srcs = [
        "capture_test.go",
        "drain_test.go",
        "pcap_output_test.go",
        "trim_test.go",
    ],
    embed = [":capture"],
    gotags_sets = [["pcap"]],
    include_default = False,
    deps = select({
        "@rules_go//go/platform:android": [
            "@com_github_google_gopacket//:gopacket",
            "@com_github_google_gopacket//layers",
            "@com_github_google_gopacket//pcapgo",
            "@com_github_stretchr_testify//assert",
            "@com_github_stretchr_testify//require",
        ],
        "@rules_go//go/platform:linux": [
            "@com_github_google_gopacket//:gopacket",
            "@com_github_google_gopacket//layers",
            "@com_github_google_gopacket//pcapgo",
            "@com_github_stretchr_testify//assert",
            "@com_github_stretchr_testify//require",
        ],
        "//conditions:default": [],
    }),
)
