load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "util",
    srcs = [
        "conn_tracer.go",
        "kernel.go",
    ],
    importpath = "github.com/DataDog/datadog-agent/pkg/network/tracer/connection/util",
    visibility = ["//visibility:public"],
    deps = select({
        "@rules_go//go/platform:android": [
            "//comp/core/telemetry/impl",
            "//pkg/ebpf/ksyms",
            "//pkg/network",
            "//pkg/network/ebpf",
            "//pkg/process/util",
            "//pkg/util/kernel",
            "//pkg/util/log",
            "@com_github_cilium_ebpf//:ebpf",
            "@com_github_datadog_ebpf_manager//:ebpf-manager",
            "@org_golang_x_sys//unix",
        ],
        "@rules_go//go/platform:linux": [
            "//comp/core/telemetry/impl",
            "//pkg/ebpf/ksyms",
            "//pkg/network",
            "//pkg/network/ebpf",
            "//pkg/process/util",
            "//pkg/util/kernel",
            "//pkg/util/log",
            "@com_github_cilium_ebpf//:ebpf",
            "@com_github_datadog_ebpf_manager//:ebpf-manager",
            "@org_golang_x_sys//unix",
        ],
        "//conditions:default": [],
    }),
)

dd_agent_go_test(
    name = "util_test",
    srcs = ["kernel_test.go"],
    embed = [":util"],
    gotags_sets = [["bpf"]],
    include_default = False,
    tags = ["requires_ebpf"],
    deps = select({
        "@rules_go//go/platform:android": [
            "@com_github_cilium_ebpf//:ebpf",
            "@com_github_cilium_ebpf//asm",
            "@com_github_cilium_ebpf//features",
            "@com_github_stretchr_testify//assert",
            "@com_github_stretchr_testify//require",
            "@org_golang_x_sys//unix",
        ],
        "@rules_go//go/platform:linux": [
            "@com_github_cilium_ebpf//:ebpf",
            "@com_github_cilium_ebpf//asm",
            "@com_github_cilium_ebpf//features",
            "@com_github_stretchr_testify//assert",
            "@com_github_stretchr_testify//require",
            "@org_golang_x_sys//unix",
        ],
        "//conditions:default": [],
    }),
)
