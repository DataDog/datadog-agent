load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "nstat",
    srcs = [
        "control.go",
        "parser.go",
    ],
    importpath = "github.com/DataDog/datadog-agent/pkg/network/tracer/connection/nstat",
    visibility = ["//visibility:public"],
    deps = select({
        "@rules_go//go/platform:darwin": [
            "@org_golang_x_sys//unix",
        ],
        "@rules_go//go/platform:ios": [
            "@org_golang_x_sys//unix",
        ],
        "//conditions:default": [],
    }),
)

dd_agent_go_test(
    name = "nstat_test",
    srcs = [
        "control_test.go",
        "parser_test.go",
    ],
    embed = [":nstat"],
    deps = select({
        "@rules_go//go/platform:darwin": [
            "@com_github_stretchr_testify//require",
        ],
        "@rules_go//go/platform:ios": [
            "@com_github_stretchr_testify//require",
        ],
        "//conditions:default": [],
    }),
)
