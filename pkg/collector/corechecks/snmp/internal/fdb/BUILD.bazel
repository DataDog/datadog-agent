load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "fdb",
    srcs = [
        "collect.go",
        "oids.go",
        "parse.go",
        "walk.go",
    ],
    importpath = "github.com/DataDog/datadog-agent/pkg/collector/corechecks/snmp/internal/fdb",
    visibility = ["//pkg/collector/corechecks/snmp:__subpackages__"],
    deps = [
        "//pkg/collector/corechecks/snmp/internal/session",
        "//pkg/collector/corechecks/snmp/internal/valuestore",
        "//pkg/networkdevice/metadata",
        "@com_github_gosnmp_gosnmp//:gosnmp",
    ],
)

dd_agent_go_test(
    name = "fdb_test",
    srcs = [
        "collect_test.go",
        "parse_test.go",
        "walk_corpus_test.go",
        "walk_fixtures_test.go",
    ],
    data = glob(["testdata/*"]),
    embed = [":fdb"],
    deps = [
        "//pkg/collector/corechecks/snmp/internal/session",
        "//pkg/networkdevice/metadata",
        "@com_github_gosnmp_gosnmp//:gosnmp",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
