load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "customprobe",
    srcs = [
        "command_nix.go",
        "command_windows.go",
        "customprobe.go",
    ],
    importpath = "github.com/DataDog/datadog-agent/pkg/collector/corechecks/customprobe",
    visibility = ["//visibility:public"],
    deps = [
        "//comp/core/autodiscovery/integration",
        "//comp/core/autodiscovery/providers/names",
        "//pkg/aggregator/sender",
        "//pkg/collector/check",
        "//pkg/collector/corechecks",
        "//pkg/metrics/event",
        "//pkg/metrics/servicecheck",
        "//pkg/util/hostname",
        "//pkg/util/option",
        "@in_yaml_go_yaml_v3//:yaml",
    ],
)

dd_agent_go_test(
    name = "customprobe_test",
    srcs = ["customprobe_test.go"],
    data = glob(
        ["*.go"],
        exclude = ["*_test.go"],
    ),
    embed = [":customprobe"],
    deps = [
        "//comp/core/autodiscovery/integration",
        "//pkg/aggregator/mocksender",
        "//pkg/collector/check/id",
        "//pkg/config/mock",
        "//pkg/metrics/event",
        "//pkg/metrics/servicecheck",
        "//pkg/util/hostname",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//mock",
        "@com_github_stretchr_testify//require",
    ],
)
