load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "metrics-list_lib",
    srcs = ["main.go"],
    importpath = "github.com/DataDog/datadog-agent/pkg/collector/corechecks/gpu/spec/metrics-list",
    visibility = ["//visibility:private"],
