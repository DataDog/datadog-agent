    name = "metrics-list_test",
    srcs = ["main_test.go"],
    embed = [":metrics-list_lib"],
    deps = [
        "//pkg/collector/corechecks/gpu/spec",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
