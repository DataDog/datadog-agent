load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "metadata_lib",
    srcs = ["main.go"],
    importpath = "github.com/DataDog/datadog-agent/pkg/collector/corechecks/gpu/spec/metadata",
    visibility = ["//visibility:private"],
    deps = ["//pkg/collector/corechecks/gpu/spec"],
)

go_binary(
    name = "metadata",
    embed = [":metadata_lib"],
    visibility = ["//visibility:public"],
)

dd_agent_go_test(
    name = "metadata_test",
    srcs = ["main_test.go"],
    embed = [":metadata_lib"],
)
