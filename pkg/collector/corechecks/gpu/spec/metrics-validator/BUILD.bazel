load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "metrics-validator_lib",
    srcs = [
        "client.go",
        "main.go",
        "types.go",
        "validation.go",
    ],
    importpath = "github.com/DataDog/datadog-agent/pkg/collector/corechecks/gpu/spec/metrics-validator",
    visibility = ["//visibility:private"],
    deps = [
        "//pkg/collector/corechecks/gpu/spec",
        "@com_github_datadog_datadog_api_client_go_v2//api/datadog",
        "@com_github_datadog_datadog_api_client_go_v2//api/datadogV2",
        "@org_golang_x_sync//errgroup",
    ],
)

go_binary(
    name = "metrics-validator",
    embed = [":metrics-validator_lib"],
    visibility = ["//visibility:public"],
)

dd_agent_go_test(
    name = "metrics-validator_test",
    srcs = ["client_test.go"],
    embed = [":metrics-validator_lib"],
    deps = ["//pkg/collector/corechecks/gpu/spec"],
)
