load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "collectors",
    srcs = [
        "collector.go",
        "errors.go",
        "k8scollector.go",
        "terminated.go",
        "terminated_testing.go",
    ],
    importpath = "github.com/DataDog/datadog-agent/pkg/collector/corechecks/cluster/orchestrator/collectors",
    visibility = ["//visibility:public"],
    deps = [
        "//comp/core/workloadmeta/def",
        "//pkg/collector/corechecks/cluster/orchestrator/processors",
        "//pkg/orchestrator/config",
        "//pkg/orchestrator/model",
        "//pkg/util/kubernetes/apiserver",
        "//pkg/util/log",
        "@com_github_benbjohnson_clock//:clock",
        "@com_github_datadog_agent_payload_v5//process",
        "@io_k8s_apiextensions_apiserver//pkg/client/informers/externalversions",
        "@io_k8s_autoscaler_vertical_pod_autoscaler//pkg/client/informers/externalversions",
        "@io_k8s_client_go//dynamic/dynamicinformer",
        "@io_k8s_client_go//informers",
        "@io_k8s_client_go//metadata/metadatainformer",
        "@io_k8s_client_go//tools/cache",
        "@org_uber_go_atomic//:atomic",
    ],
)

dd_agent_go_test(
    name = "collectors_test",
    srcs = ["terminated_test.go"],
    embed = [":collectors"],
    gotags_sets = [[
        "cel",
        "clusterchecks",
        "kubeapiserver",
        "kubelet",
    ]],
    include_default = False,
    deps = [
        "@com_github_stretchr_testify//assert",
        "@io_k8s_api//apps/v1:apps",
        "@io_k8s_apimachinery//pkg/apis/meta/v1:meta",
        "@io_k8s_client_go//tools/cache",
    ],
)
