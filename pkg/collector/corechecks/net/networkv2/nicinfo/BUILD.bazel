load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "nicinfo",
    srcs = [
        "doc.go",
        "nicinfo_darwin.go",
        "nicinfo_darwin.h",
        "nicinfo_darwin.m",
    ],
    cgo = True,
    clinkopts = select({
        "@rules_go//go/platform:darwin": [
            "-framework Foundation -framework IOKit -framework SystemConfiguration",
        ],
        "@rules_go//go/platform:ios": [
            "-framework Foundation -framework IOKit -framework SystemConfiguration",
        ],
        "//conditions:default": [],
    }),
    copts = select({
        "@rules_go//go/platform:darwin": [
            "-x objective-c -fobjc-arc",
        ],
        "@rules_go//go/platform:ios": [
            "-x objective-c -fobjc-arc",
        ],
        "//conditions:default": [],
    }),
    importpath = "github.com/DataDog/datadog-agent/pkg/collector/corechecks/net/networkv2/nicinfo",
    visibility = ["//visibility:public"],
)

dd_agent_go_test(
    name = "nicinfo_test",
    srcs = ["nicinfo_darwin_test.go"],
    embed = [":nicinfo"],
    deps = select({
        "@rules_go//go/platform:darwin": [
            "@com_github_stretchr_testify//assert",
            "@com_github_stretchr_testify//require",
        ],
        "@rules_go//go/platform:ios": [
            "@com_github_stretchr_testify//assert",
            "@com_github_stretchr_testify//require",
        ],
        "//conditions:default": [],
    }),
)
