load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "config",
    srcs = [
        "config.go",
        "enabled.go",
        "encoding.go",
        "metadata.go",
        "profile.go",
        "topology.go",
    ],
    importpath = "github.com/DataDog/datadog-agent/pkg/collector/corechecks/network-devices/gnmi/config",
    visibility = ["//visibility:public"],
    deps = [
        "//comp/core/autodiscovery/integration",
        "//pkg/collector/check/defaults",
        "//pkg/config/setup",
        "@com_github_openconfig_gnmi//proto/gnmi",
        "@in_yaml_go_yaml_v2//:yaml",
    ],
)

dd_agent_go_test(
    name = "config_test",
    srcs = [
        "config_test.go",
        "encoding_test.go",
        "metadata_test.go",
        "profile_test.go",
        "topology_test.go",
    ],
    embed = [":config"],
    deps = [
        "//comp/core/autodiscovery/integration",
        "//pkg/config/mock",
        "@com_github_openconfig_gnmi//proto/gnmi",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
