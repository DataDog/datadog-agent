load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("@rules_go//go:def.bzl", "go_library")
load("@rules_go//proto:def.bzl", "go_proto_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")
load("//bazel/rules/write_pb_go:defs.bzl", "write_pb_go")

proto_library(
    name = "gnmipb_proto",
    srcs = ["subscribe.proto"],
    visibility = ["//pkg/collector/corechecks/network-devices/gnmi:__subpackages__"],
    deps = ["@protobuf//:any_proto"],
)

go_proto_library(
    name = "gnmipb_go_proto",
    importpath = "github.com/DataDog/datadog-agent/pkg/collector/corechecks/network-devices/gnmi/internal/gnmipb",
    proto = ":gnmipb_proto",
    visibility = ["//pkg/collector/corechecks/network-devices/gnmi:__subpackages__"],
)

go_library(
    name = "gnmipb",
    embed = [":gnmipb_go_proto"],
    importpath = "github.com/DataDog/datadog-agent/pkg/collector/corechecks/network-devices/gnmi/internal/gnmipb",
    visibility = ["//pkg/collector/corechecks/network-devices/gnmi:__subpackages__"],
)

dd_agent_go_test(
    name = "gnmipb_test",
    srcs = ["messages_test.go"],
    embed = [":gnmipb"],
    deps = [
        "@com_github_openconfig_gnmi//proto/gnmi",
        "@com_github_stretchr_testify//require",
        "@org_golang_google_protobuf//proto",
    ],
)

write_pb_go(
    name = "write_pb_go",
    srcs = {
        ":gnmipb_go_proto": [
            "subscribe.pb.go",
        ],
    },
)
