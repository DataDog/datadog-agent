load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/ebpf:cgo_godefs.bzl", "cgo_godefs")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

exports_files([
    "c_types_linux.go",
    "c_types_linux_test.go",
])

cgo_godefs(
    name = "c_types_godefs",
    src = "c_types.go",
    hdrs = ["//pkg/collector/corechecks/ebpf/c/runtime:corecheck_ebpf_headers"],
    visibility = ["//visibility:public"],
)

go_library(
    name = "oomkill",
    srcs = [
        "c_types_linux.go",
        "oom_kill.go",
    ],
    cgo = True,
    importpath = "github.com/DataDog/datadog-agent/pkg/collector/corechecks/ebpf/probe/oomkill",
    tags = ["manual"],
    visibility = ["//visibility:public"],
    deps = select({
        "@rules_go//go/platform:android": [
            "//pkg/collector/corechecks/ebpf/probe/oomkill/model",
            "//pkg/ebpf",
            "//pkg/ebpf/bytecode",
            "//pkg/ebpf/bytecode/runtime",
            "//pkg/ebpf/maps",
            "//pkg/util/kernel",
            "//pkg/util/log",
            "@com_github_datadog_ebpf_manager//:ebpf-manager",
            "@org_golang_x_sys//unix",
        ],
        "@rules_go//go/platform:linux": [
            "//pkg/collector/corechecks/ebpf/probe/oomkill/model",
            "//pkg/ebpf",
            "//pkg/ebpf/bytecode",
            "//pkg/ebpf/bytecode/runtime",
            "//pkg/ebpf/maps",
            "//pkg/util/kernel",
            "//pkg/util/log",
            "@com_github_datadog_ebpf_manager//:ebpf-manager",
            "@org_golang_x_sys//unix",
        ],
        "//conditions:default": [],
    }),
)

dd_agent_go_test(
    name = "oomkill_test",
    srcs = [
        "c_types_linux_test.go",
        "oom_kill_test.go",
    ],
    embed = [":oomkill"],
    gotags_sets = [["bpf"]],
    tags = ["requires_ebpf"],
    deps = select({
        "@rules_go//go/platform:android": [
            "//pkg/collector/corechecks/ebpf/probe/oomkill/model",
            "//pkg/ebpf",
            "//pkg/ebpf/bytecode/runtime",
            "//pkg/ebpf/ebpftest",
            "//pkg/util/kernel",
            "@com_github_stretchr_testify//assert",
            "@com_github_stretchr_testify//require",
            "@org_golang_x_sys//unix",
        ],
        "@rules_go//go/platform:linux": [
            "//pkg/collector/corechecks/ebpf/probe/oomkill/model",
            "//pkg/ebpf",
            "//pkg/ebpf/bytecode/runtime",
            "//pkg/ebpf/ebpftest",
            "//pkg/util/kernel",
            "@com_github_stretchr_testify//assert",
            "@com_github_stretchr_testify//require",
            "@org_golang_x_sys//unix",
        ],
        "//conditions:default": [],
    }),
)
