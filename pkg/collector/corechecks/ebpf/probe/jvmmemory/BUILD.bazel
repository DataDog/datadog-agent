load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/ebpf:cgo_godefs.bzl", "cgo_godefs")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

exports_files([
    "ebpf_types_linux.go",
    "ebpf_types_linux_test.go",
])

cgo_godefs(
    name = "ebpf_types_godefs",
    src = "ebpf_types.go",
    hdrs = ["//pkg/collector/corechecks/ebpf/c/runtime:corecheck_ebpf_headers"],
    visibility = ["//visibility:public"],
)

go_library(
    name = "jvmmemory",
    srcs = [
        "attacher.go",
        "containerid.go",
        "doc.go",
        "ebpf_types_linux.go",
        "pidns.go",
        "probe.go",
        "scanner.go",
        "sites.go",
        "stats.go",
        "telemetry.go",
    ],
    cgo = True,
    importpath = "github.com/DataDog/datadog-agent/pkg/collector/corechecks/ebpf/probe/jvmmemory",
    tags = ["manual"],
    visibility = ["//visibility:public"],
    deps = select({
        "@rules_go//go/platform:android": [
            "//comp/core/telemetry/def",
            "//comp/core/telemetry/impl",
            "//pkg/collector/corechecks/ebpf/probe/jvmmemory/model",
            "//pkg/ebpf",
            "//pkg/ebpf/bytecode",
            "//pkg/ebpf/maps",
            "//pkg/ebpf/telemetry",
            "//pkg/ebpf/usdt",
            "//pkg/network/usm/utils",
            "//pkg/util/cgroups",
            "//pkg/util/kernel",
            "//pkg/util/log",
            "//pkg/util/safeelf",
            "@com_github_datadog_ebpf_manager//:ebpf-manager",
            "@org_golang_x_sys//unix",
        ],
        "@rules_go//go/platform:linux": [
            "//comp/core/telemetry/def",
            "//comp/core/telemetry/impl",
            "//pkg/collector/corechecks/ebpf/probe/jvmmemory/model",
            "//pkg/ebpf",
            "//pkg/ebpf/bytecode",
            "//pkg/ebpf/maps",
            "//pkg/ebpf/telemetry",
            "//pkg/ebpf/usdt",
            "//pkg/network/usm/utils",
            "//pkg/util/cgroups",
            "//pkg/util/kernel",
            "//pkg/util/log",
            "//pkg/util/safeelf",
            "@com_github_datadog_ebpf_manager//:ebpf-manager",
            "@org_golang_x_sys//unix",
        ],
        "//conditions:default": [],
    }),
)

# ebpf_types_linux_test.go and the other tests must be in separate rules because
# ebpf_types_linux_test.go needs //pkg/ebpf/ebpftest:cgo_align (for TestCgoAlignment)
# while probe_test.go needs //pkg/ebpf/ebpftest (for TestBuildMode/CORE).
# Both targets share importpath "github.com/DataDog/datadog-agent/pkg/ebpf/ebpftest"
# and cannot coexist in the same rule's deps.

dd_agent_go_test(
    name = "jvmmemory_types_test",
    # keep: split from jvmmemory_test; see comment above.
    srcs = ["ebpf_types_linux_test.go"],
    embed = [":jvmmemory"],
    # keep: cgo_align has the same importpath as ebpftest; see pkg/ebpf/ebpftest/BUILD.bazel.
    deps = select({
        "@rules_go//go/platform:android": [
            "//pkg/ebpf/ebpftest:cgo_align",
        ],
        "@rules_go//go/platform:linux": [
            "//pkg/ebpf/ebpftest:cgo_align",
        ],
        "//conditions:default": [],
    }),
)

dd_agent_go_test(
    name = "jvmmemory_test",
    # keep: split from jvmmemory_types_test; see comment above.
    srcs = [
        "containerid_test.go",
        "pidns_test.go",
        "probe_test.go",
        "scanner_test.go",
        "sites_test.go",
        "stats_test.go",
    ],
    data = glob(["testdata/**"]),
    embed = [":jvmmemory"],
    gotags_sets = [["bpf"]],
    tags = ["requires_ebpf"],
    deps = select({
        "@rules_go//go/platform:android": [
            "//pkg/collector/corechecks/ebpf/probe/jvmmemory/model",
            "//pkg/ebpf",
            "//pkg/ebpf/ebpftest",
            "//pkg/ebpf/usdt",
            "//pkg/network/usm/utils",
            "//pkg/util/kernel",
            "//pkg/util/safeelf",
            "//pkg/util/testutil",
            "//pkg/util/testutil/docker",
            "@com_github_cilium_ebpf//:ebpf",
            "@com_github_stretchr_testify//assert",
            "@com_github_stretchr_testify//require",
            "@org_golang_x_sys//unix",
        ],
        "@rules_go//go/platform:linux": [
            "//pkg/collector/corechecks/ebpf/probe/jvmmemory/model",
            "//pkg/ebpf",
            "//pkg/ebpf/ebpftest",
            "//pkg/ebpf/usdt",
            "//pkg/network/usm/utils",
            "//pkg/util/kernel",
            "//pkg/util/safeelf",
            "//pkg/util/testutil",
            "//pkg/util/testutil/docker",
            "@com_github_cilium_ebpf//:ebpf",
            "@com_github_stretchr_testify//assert",
            "@com_github_stretchr_testify//require",
            "@org_golang_x_sys//unix",
        ],
        "//conditions:default": [],
    }),
)
