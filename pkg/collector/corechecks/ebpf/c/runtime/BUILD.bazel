# gazelle:ebpf_c on

load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel/rules/ebpf:ebpf.bzl", "ebpf_program_suite")

exports_files([
    "oom-kill-kern.c",
    "tcp-queue-length-kern.c",
])

_CORECHECK_HDRS = glob(["*.h"])

cc_library(
    name = "corecheck_ebpf_headers",
    hdrs = _CORECHECK_HDRS,
    includes = ["."],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "corecheck_ebpf_headers_files",
    srcs = _CORECHECK_HDRS,
    visibility = ["//visibility:public"],
)

ebpf_program_suite(
    name = "oom-kill",
    src = "oom-kill-kern.c",
    # Included behind #ifdef COMPILE_RUNTIME, which is off for a CO-RE build.
    allowed_unused = ["pkg/ebpf/c/kconfig.h"],
    core = True,
    visibility = ["//visibility:public"],
    deps = [
        ":hdr/oom-kill-kern-user",
        "//pkg/ebpf/c:hdr/bpf_core_read",
        "//pkg/ebpf/c:hdr/bpf_metadata",
        "//pkg/ebpf/c:hdr/bpf_tracing",
        "//pkg/ebpf/c:hdr/cgroup",
        "//pkg/ebpf/c:hdr/kconfig",
        "//pkg/ebpf/c:hdr/ktypes",
        "//pkg/ebpf/c:hdr/map-defs",
    ],
)

ebpf_program_suite(
    name = "tcp-queue-length",
    src = "tcp-queue-length-kern.c",
    # Included behind #ifdef COMPILE_RUNTIME, which is off for a CO-RE build.
    allowed_unused = ["pkg/ebpf/c/kconfig.h"],
    core = True,
    visibility = ["//visibility:public"],
    deps = [
        ":hdr/tcp-queue-length-kern-user",
        "//pkg/ebpf/c:hdr/bpf_core_read",
        "//pkg/ebpf/c:hdr/bpf_metadata",
        "//pkg/ebpf/c:hdr/bpf_tracing",
        "//pkg/ebpf/c:hdr/cgroup",
        "//pkg/ebpf/c:hdr/kconfig",
        "//pkg/ebpf/c:hdr/ktypes",
        "//pkg/ebpf/c:hdr/map-defs",
    ],
)

ebpf_program_suite(
    name = "ebpf",
    src = "ebpf-kern.c",
    core = True,
    visibility = ["//visibility:public"],
    deps = [
        ":hdr/ebpf-kern-user",
        "//pkg/ebpf/c:hdr/bpf_core_read",
        "//pkg/ebpf/c:hdr/bpf_helpers",
        "//pkg/ebpf/c:hdr/bpf_metadata",
        "//pkg/ebpf/c:hdr/bpf_tracing",
        "//pkg/ebpf/c:hdr/map-defs",
    ],
)

ebpf_program_suite(
    name = "noisy-neighbor",
    src = "noisy-neighbor-kern.c",
    core = True,
    visibility = ["//visibility:public"],
    deps = [
        ":hdr/noisy-neighbor-kern-user",
        "//pkg/ebpf/c:hdr/bpf_core_read",
        "//pkg/ebpf/c:hdr/bpf_helpers",
        "//pkg/ebpf/c:hdr/bpf_metadata",
        "//pkg/ebpf/c:hdr/bpf_telemetry",
        "//pkg/ebpf/c:hdr/bpf_tracing",
        "//pkg/ebpf/c:hdr/map-defs",
    ],
)

cc_library(
    name = "hdr/ebpf-kern-user",
    hdrs = ["ebpf-kern-user.h"],
    includes = ["."],
    visibility = ["//visibility:public"],
    deps = ["//pkg/ebpf/c:hdr/ktypes"],
)

cc_library(
    name = "hdr/noisy-neighbor-kern-user",
    hdrs = ["noisy-neighbor-kern-user.h"],
    includes = ["."],
    visibility = ["//visibility:public"],
    deps = ["//pkg/ebpf/c:hdr/ktypes"],
)

cc_library(
    name = "hdr/oom-kill-kern-user",
    hdrs = ["oom-kill-kern-user.h"],
    includes = ["."],
    visibility = ["//visibility:public"],
    deps = ["//pkg/ebpf/c:hdr/ktypes"],
)

cc_library(
    name = "hdr/tcp-queue-length-kern-user",
    hdrs = ["tcp-queue-length-kern-user.h"],
    includes = ["."],
    visibility = ["//visibility:public"],
    deps = ["//pkg/ebpf/c:hdr/ktypes"],
