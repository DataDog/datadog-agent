    srcs = [
        "intake_test.go",
        "jsoncell_test.go",
        "request_test.go",
    ],
    embed = [":session"],
    deps = [
        "//pkg/config/mock",
        "//pkg/config/model",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
