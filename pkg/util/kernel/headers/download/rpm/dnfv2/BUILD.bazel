load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "dnfv2",
    srcs = [
        "builtins_linux.go",
        "utils.go",
    ],
    importpath = "github.com/DataDog/datadog-agent/pkg/util/kernel/headers/download/rpm/dnfv2",
    visibility = ["//visibility:public"],
    deps = select({
        "@rules_go//go/platform:android": [
            "//pkg/util/kernel",
            "//pkg/util/kernel/headers/download/extract",
            "//pkg/util/kernel/headers/download/rpm/dnfv2/backend",
            "//pkg/util/kernel/headers/download/rpm/dnfv2/repo",
            "//pkg/util/kernel/headers/download/types",
        ],
        "@rules_go//go/platform:linux": [
            "//pkg/util/kernel",
            "//pkg/util/kernel/headers/download/extract",
            "//pkg/util/kernel/headers/download/rpm/dnfv2/backend",
            "//pkg/util/kernel/headers/download/rpm/dnfv2/repo",
            "//pkg/util/kernel/headers/download/types",
        ],
        "//conditions:default": [],
    }),
)

dd_agent_go_test(
    name = "dnfv2_test",
    srcs = ["utils_test.go"],
    data = glob(["testdata/**"]),
    embed = [":dnfv2"],
    embedsrcs = select({
        "@rules_go//go/platform:android": [
            "testdata/simple-1.0.1-1.i386.rpm",
        ],
        "@rules_go//go/platform:linux": [
            "testdata/simple-1.0.1-1.i386.rpm",
        ],
        "//conditions:default": [],
    }),
    deps = select({
        "@rules_go//go/platform:android": [
            "//pkg/util/kernel/headers/download/rpm/dnfv2/repo",
            "//pkg/util/kernel/headers/download/types",
            "@com_github_stretchr_testify//require",
        ],
        "@rules_go//go/platform:linux": [
            "//pkg/util/kernel/headers/download/rpm/dnfv2/repo",
            "//pkg/util/kernel/headers/download/types",
            "@com_github_stretchr_testify//require",
        ],
        "//conditions:default": [],
    }),
)
