load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "repo",
    srcs = ["repo.go"],
    importpath = "github.com/DataDog/datadog-agent/pkg/util/kernel/headers/download/rpm/dnfv2/repo",
    visibility = ["//visibility:public"],
    deps = select({
        "@rules_go//go/platform:android": [
            "//pkg/util/kernel/headers/download/rpm/dnfv2/internal/utils",
            "//pkg/util/kernel/headers/download/rpm/dnfv2/types",
            "//pkg/util/kernel/headers/download/xmlite",
            "@com_github_protonmail_go_crypto//openpgp",
            "@com_github_sassoftware_go_rpmutils//:go-rpmutils",
            "@in_gopkg_ini_v1//:ini_v1",
        ],
        "@rules_go//go/platform:linux": [
            "//pkg/util/kernel/headers/download/rpm/dnfv2/internal/utils",
            "//pkg/util/kernel/headers/download/rpm/dnfv2/types",
            "//pkg/util/kernel/headers/download/xmlite",
            "@com_github_protonmail_go_crypto//openpgp",
            "@com_github_sassoftware_go_rpmutils//:go-rpmutils",
            "@in_gopkg_ini_v1//:ini_v1",
        ],
        "//conditions:default": [],
    }),
)

dd_agent_go_test(
    name = "repo_test",
    srcs = ["keys_test.go"],
    embed = [":repo"],
    deps = select({
        "@rules_go//go/platform:android": [
            "@com_github_protonmail_go_crypto//openpgp",
            "@com_github_protonmail_go_crypto//openpgp/armor",
            "@com_github_protonmail_go_crypto//openpgp/packet",
            "@com_github_stretchr_testify//require",
        ],
        "@rules_go//go/platform:linux": [
            "@com_github_protonmail_go_crypto//openpgp",
            "@com_github_protonmail_go_crypto//openpgp/armor",
            "@com_github_protonmail_go_crypto//openpgp/packet",
            "@com_github_stretchr_testify//require",
        ],
        "//conditions:default": [],
    }),
)
