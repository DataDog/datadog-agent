load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "rpm",
    srcs = [
        "amazonlinux.go",
        "centos.go",
        "fedora.go",
        "opensuse.go",
        "oracle.go",
        "rhel.go",
        "rocky.go",
        "sles.go",
    ],
    importpath = "github.com/DataDog/datadog-agent/pkg/util/kernel/headers/download/rpm",
    visibility = ["//visibility:public"],
    deps = select({
        "@rules_go//go/platform:android": [
            "//pkg/util/kernel/headers/download/rpm/dnfv2",
            "//pkg/util/kernel/headers/download/rpm/dnfv2/backend",
            "//pkg/util/kernel/headers/download/rpm/dnfv2/repo",
            "//pkg/util/kernel/headers/download/types",
        ],
        "@rules_go//go/platform:linux": [
            "//pkg/util/kernel/headers/download/rpm/dnfv2",
            "//pkg/util/kernel/headers/download/rpm/dnfv2/backend",
            "//pkg/util/kernel/headers/download/rpm/dnfv2/repo",
            "//pkg/util/kernel/headers/download/types",
        ],
        "//conditions:default": [],
    }),
)

dd_agent_go_test(
    name = "rpm_test",
    srcs = ["centos_test.go"],
    embed = [":rpm"],
    deps = select({
        "@rules_go//go/platform:android": [
            "//pkg/util/kernel/headers/download/types",
            "@com_github_stretchr_testify//require",
        ],
        "@rules_go//go/platform:linux": [
            "//pkg/util/kernel/headers/download/types",
            "@com_github_stretchr_testify//require",
        ],
        "//conditions:default": [],
    }),
)
