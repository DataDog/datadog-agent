load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "apt",
    srcs = [
        "apt.go",
        "config.go",
    ],
    importpath = "github.com/DataDog/datadog-agent/pkg/util/kernel/headers/download/apt",
    visibility = ["//visibility:public"],
    deps = select({
        "@rules_go//go/platform:android": [
            "//pkg/util/kernel/headers/download/extract",
            "//pkg/util/kernel/headers/download/types",
            "@com_github_aptly_dev_aptly//aptly",
            "@com_github_aptly_dev_aptly//deb",
            "@com_github_aptly_dev_aptly//http",
            "@com_github_aptly_dev_aptly//pgp",
            "@com_github_aptly_dev_aptly//utils",
            "@com_github_xor_gate_ar//:ar",
        ],
        "@rules_go//go/platform:linux": [
            "//pkg/util/kernel/headers/download/extract",
            "//pkg/util/kernel/headers/download/types",
            "@com_github_aptly_dev_aptly//aptly",
            "@com_github_aptly_dev_aptly//deb",
            "@com_github_aptly_dev_aptly//http",
            "@com_github_aptly_dev_aptly//pgp",
            "@com_github_aptly_dev_aptly//utils",
            "@com_github_xor_gate_ar//:ar",
        ],
        "//conditions:default": [],
    }),
)

dd_agent_go_test(
    name = "apt_test",
    srcs = ["apt_test.go"],
    embed = [":apt"],
    deps = select({
        "@rules_go//go/platform:android": [
            "//pkg/util/kernel/headers/download/types",
            "@com_github_aptly_dev_aptly//http",
            "@com_github_aptly_dev_aptly//utils",
            "@com_github_stretchr_testify//require",
            "@com_github_xor_gate_ar//:ar",
        ],
        "@rules_go//go/platform:linux": [
            "//pkg/util/kernel/headers/download/types",
            "@com_github_aptly_dev_aptly//http",
            "@com_github_aptly_dev_aptly//utils",
            "@com_github_stretchr_testify//require",
            "@com_github_xor_gate_ar//:ar",
        ],
        "//conditions:default": [],
    }),
)
