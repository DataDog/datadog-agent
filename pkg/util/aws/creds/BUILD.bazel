load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")
load("//bazel/rules/go_package_metadata:defs.bzl", "go_package_metadata")

package(default_package_metadata = [":go_package_metadata"])

go_package_metadata(
    name = "go_package_metadata",
    module = "github.com/DataDog/datadog-agent/pkg/util/aws/creds",
)

go_library(
    name = "creds",
    srcs = [
        "credentials.go",
        "detection.go",
    ],
    importpath = "github.com/DataDog/datadog-agent/pkg/util/aws/creds",
    visibility = ["//visibility:public"],
    deps = ["//pkg/util/aws/creds/internal"],
)

dd_agent_go_test(
    name = "creds_test",
    srcs = [
        "credentials_test.go",
        "detection_test.go",
    ],
    data = ["tags/payloads/security_cred.json"],
    embed = [":creds"],
    deps = [
        "//pkg/config/mock",
        "//pkg/util/aws/creds/internal",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
