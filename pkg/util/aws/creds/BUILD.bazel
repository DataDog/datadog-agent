load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "creds",
    srcs = [
        "credentials.go",
        "detection.go",
        "resolve_credentials.go",
    ],
    importpath = "github.com/DataDog/datadog-agent/pkg/util/aws/creds",
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/config/model",
        "//pkg/util/aws/creds/internal",
        "//pkg/util/http",
        "//pkg/util/log",
        "@com_github_aws_aws_sdk_go_v2//aws",
    ],
)

dd_agent_go_test(
    name = "creds_test",
    srcs = [
        "credentials_test.go",
        "detection_test.go",
        "resolve_credentials_providers_test.go",
    ],
    data = ["tags/payloads/security_cred.json"],
    embed = [":creds"],
    deps = [
        "//pkg/config/mock",
        "//pkg/util/aws/creds/internal",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
