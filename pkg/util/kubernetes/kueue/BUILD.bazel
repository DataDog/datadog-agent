dd_agent_go_test(
    name = "kueue_test",
    srcs = ["pod_test.go"],
    embed = [":kueue"],
    deps = [
        "//comp/core/workloadmeta/def",
        "//pkg/util/kubernetes",
        "@com_github_stretchr_testify//assert",
    ],
)
