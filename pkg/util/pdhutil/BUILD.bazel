load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "pdhutil",
    srcs = [
        "pdh.go",
        "pdh_386.go",
        "pdh_amd64.go",
        "pdhcounter.go",
        "pdhformatter.go",
        "pdhhelper.go",
        "pdhmocks_windows.go",
        "testdata_windows.go",
    ],
    importpath = "github.com/DataDog/datadog-agent/pkg/util/pdhutil",
    target_compatible_with = ["@platforms//os:windows"],  # keep
    visibility = ["//visibility:public"],
    deps = select({
        "@rules_go//go/platform:windows": [
            "//pkg/config/setup",
            "//pkg/util/log",
            "@org_golang_x_sys//windows",
            "@org_uber_go_atomic//:atomic",
        ],
        "//conditions:default": [],
    }),
)

dd_agent_go_test(
    name = "pdhutil_test",
    srcs = ["pdhhelper_test.go"],
    embed = [":pdhutil"],
    deps = select({
        "@rules_go//go/platform:windows": [
            "@com_github_stretchr_testify//assert",
            "@com_github_stretchr_testify//require",
            "@org_golang_x_sys//windows",
        ],
        "//conditions:default": [],
    }),
)
