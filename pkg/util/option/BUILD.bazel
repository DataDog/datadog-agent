load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")
load("//bazel/rules/go_package_metadata:defs.bzl", "go_package_metadata")

package(default_package_metadata = [":go_package_metadata"])

go_package_metadata(
    name = "go_package_metadata",
    module = "github.com/DataDog/datadog-agent/pkg/util/option",
)

go_library(
    name = "option",
    srcs = ["option.go"],
    importpath = "github.com/DataDog/datadog-agent/pkg/util/option",
    visibility = ["//visibility:public"],
)

dd_agent_go_test(
    name = "option_test",
    srcs = ["option_test.go"],
    embed = [":option"],
    deps = ["@com_github_stretchr_testify//require"],
)
