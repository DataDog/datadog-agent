load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "eks",
    srcs = ["cluster_identity.go"],
    importpath = "github.com/DataDog/datadog-agent/pkg/util/eks",
    visibility = ["//visibility:public"],
    deps = [
        "//comp/core/tagger/tags",
        "//pkg/util/cache",
        "//pkg/util/ec2",
        "@com_github_aws_aws_sdk_go_v2//aws",
        "@com_github_aws_aws_sdk_go_v2//aws/arn",
        "@com_github_aws_aws_sdk_go_v2_config//:config",
        "@com_github_aws_aws_sdk_go_v2_service_eks//:eks",
    ],
)

dd_agent_go_test(
    name = "eks_test",
    srcs = ["cluster_identity_test.go"],
    embed = [":eks"],
    deps = [
        "@com_github_aws_aws_sdk_go_v2//aws",
        "@com_github_aws_aws_sdk_go_v2_service_eks//:eks",
        "@com_github_aws_aws_sdk_go_v2_service_eks//types",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
