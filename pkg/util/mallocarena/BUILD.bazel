load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "mallocarena",
    srcs = [
        "mallocarena.go",
        "mallocarena_cgo.go",
        "mallocarena_unsupported.go",
    ],
    cgo = True,
    importpath = "github.com/DataDog/datadog-agent/pkg/util/mallocarena",
    visibility = ["//visibility:public"],
)

dd_agent_go_test(
    name = "mallocarena_test",
    srcs = [
        "mallocarena_linux_test.go",
        "mallocarena_test.go",
    ],
    embed = [":mallocarena"],
    deps = [
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ] + select({
        "@rules_go//go/platform:android": [
            "//pkg/util/mallocarena/internal/arenaprobe",
        ],
        "@rules_go//go/platform:linux": [
            "//pkg/util/mallocarena/internal/arenaprobe",
        ],
        "//conditions:default": [],
    }),
)
