load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "eudm",
    srcs = [
        "hostname.go",
        "hostname_darwin.go",
        "hostname_others.go",
        "hostname_supported.go",
        "hostname_windows.go",
    ],
    importpath = "github.com/DataDog/datadog-agent/pkg/util/hostname/eudm",
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/util/hostname/validate",
    ] + select({
        "@rules_go//go/platform:darwin": [
            "//pkg/inventory/systeminfo",
        ],
        "@rules_go//go/platform:ios": [
            "//pkg/inventory/systeminfo",
        ],
        "@rules_go//go/platform:windows": [
            "//pkg/inventory/systeminfo",
        ],
        "//conditions:default": [],
    }),
)

dd_agent_go_test(
    name = "eudm_test",
    srcs = [
        "hostname_darwin_test.go",
        "hostname_others_test.go",
        "hostname_supported_test.go",
        "hostname_test.go",
        "hostname_windows_test.go",
    ],
    embed = [":eudm"],
    deps = [
        "@com_github_stretchr_testify//require",
    ] + select({
        "@rules_go//go/platform:darwin": [
            "//pkg/inventory/systeminfo",
        ],
        "@rules_go//go/platform:ios": [
            "//pkg/inventory/systeminfo",
        ],
        "@rules_go//go/platform:windows": [
            "//pkg/inventory/systeminfo",
        ],
        "//conditions:default": [],
    }),
)
