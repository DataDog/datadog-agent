load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")
load("//bazel/rules/go_package_metadata:defs.bzl", "go_package_metadata")

package(default_package_metadata = [":go_package_metadata"])

go_package_metadata(
    name = "go_package_metadata",
    module = "github.com/DataDog/datadog-agent/pkg/util/hostname/validate",
)

go_library(
    name = "validate",
    srcs = [
        "normalize.go",
        "validate.go",
    ],
    importpath = "github.com/DataDog/datadog-agent/pkg/util/hostname/validate",
    visibility = ["//visibility:public"],
    deps = ["//pkg/util/log"],
)

dd_agent_go_test(
    name = "validate_test",
    srcs = [
        "normalize_test.go",
        "validate_test.go",
    ],
    embed = [":validate"],
    deps = ["@com_github_stretchr_testify//assert"],
)
