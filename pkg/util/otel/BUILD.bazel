load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")
load("//bazel/rules/go_package_metadata:defs.bzl", "go_package_metadata")

package(default_package_metadata = [":go_package_metadata"])

go_package_metadata(
    name = "go_package_metadata",
    module = "github.com/DataDog/datadog-agent/pkg/util/otel",
)

go_library(
    name = "otel",
    srcs = ["gatewayusage.go"],
    importpath = "github.com/DataDog/datadog-agent/pkg/util/otel",
    visibility = ["//visibility:public"],
    deps = ["//pkg/opentelemetry-mapping-go/otlp/attributes"],
)

dd_agent_go_test(
    name = "otel_test",
    srcs = ["gatewayusage_test.go"],
    embed = [":otel"],
    deps = ["@com_github_stretchr_testify//require"],
)
