load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")
load("//bazel/rules/go_package_metadata:defs.bzl", "go_package_metadata")

package(default_package_metadata = [":go_package_metadata"])

go_package_metadata(
    name = "go_package_metadata",
    module = "github.com/DataDog/datadog-agent/pkg/util/backoff",
)

go_library(
    name = "backoff",
    srcs = [
        "backoff.go",
        "policy.go",
    ],
    importpath = "github.com/DataDog/datadog-agent/pkg/util/backoff",
    visibility = ["//visibility:public"],
)

dd_agent_go_test(
    name = "backoff_test",
    srcs = ["backoff_test.go"],
    embed = [":backoff"],
    deps = ["@com_github_stretchr_testify//assert"],
)
