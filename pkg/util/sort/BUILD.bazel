load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")
load("//bazel/rules/go_package_metadata:defs.bzl", "go_package_metadata")

package(default_package_metadata = [":go_package_metadata"])

go_package_metadata(
    name = "go_package_metadata",
    module = "github.com/DataDog/datadog-agent/pkg/util/sort",
)

go_library(
    name = "sort",
    srcs = [
        "sort.go",
        "sort_uniq.go",
    ],
    importpath = "github.com/DataDog/datadog-agent/pkg/util/sort",
    visibility = ["//visibility:public"],
)

dd_agent_go_test(
    name = "sort_test",
    srcs = [
        "sort_test.go",
        "sort_uniq_test.go",
    ],
    embed = [":sort"],
    deps = ["@com_github_stretchr_testify//assert"],
)
