load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "etw",
    srcs = [
        "doc.go",
        "etl.go",
        "etw.c",
        "etw.h",
        "event.go",
        "guid.go",
        "properties.c",
        "properties.go",
        "properties.h",
        "session.go",
    ],
    cgo = True,
    clinkopts = select({
        "@rules_go//go/platform:windows": [
            "-ltdh",
        ],
        "//conditions:default": [],
    }),
    importpath = "github.com/DataDog/datadog-agent/pkg/util/winutil/etw",
    target_compatible_with = ["@platforms//os:windows"],  # keep
    visibility = ["//visibility:public"],
    deps = select({
        "@rules_go//go/platform:windows": [
            "@org_golang_x_sys//windows",
        ],
        "//conditions:default": [],
    }),
)

dd_agent_go_test(
    name = "etw_test",
    srcs = ["properties_test.go"],
    embed = [":etw"],
    target_compatible_with = ["@platforms//os:windows"],
    deps = select({
        "@rules_go//go/platform:windows": [
            "@com_github_stretchr_testify//assert",
        ],
        "//conditions:default": [],
    }),
)
