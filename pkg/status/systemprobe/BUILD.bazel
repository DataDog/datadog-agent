load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "systemprobe",
    srcs = ["status.go"],
    embedsrcs = ["status_templates/systemprobe.tmpl"],
    importpath = "github.com/DataDog/datadog-agent/pkg/status/systemprobe",
    visibility = ["//visibility:public"],
    deps = [
        "//comp/core/status",
        "//pkg/system-probe/api/client",
    ],
)

dd_agent_go_test(
    name = "systemprobe_test",
    srcs = ["status_test.go"],
    embed = [":systemprobe"],
    deps = [
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
