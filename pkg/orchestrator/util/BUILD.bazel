load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")
load("//bazel/rules/go_package_metadata:defs.bzl", "go_package_metadata")

package(default_package_metadata = [":go_package_metadata"])

go_package_metadata(
    name = "go_package_metadata",
    module = "github.com/DataDog/datadog-agent/pkg/orchestrator/util",
)

go_library(
    name = "util",
    srcs = ["chunking.go"],
    importpath = "github.com/DataDog/datadog-agent/pkg/orchestrator/util",
    visibility = ["//visibility:public"],
)

dd_agent_go_test(
    name = "util_test",
    srcs = ["chunking_test.go"],
    embed = [":util"],
    deps = ["@com_github_stretchr_testify//assert"],
)
