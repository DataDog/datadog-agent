load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "hardening",
    srcs = ["request.go"],
    importpath = "github.com/DataDog/datadog-agent/pkg/clusteragent/hardening",
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/remoteconfig/state",
        "//pkg/util/log",
    ],
)

dd_agent_go_test(
    name = "hardening_test",
    srcs = ["request_test.go"],
    embed = [":hardening"],
    gotags_sets = [[
        "cel",
        "clusterchecks",
        "kubeapiserver",
        "kubelet",
        "orchestrator",
    ]],
    include_default = False,
    deps = [
        "//pkg/remoteconfig/state",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
