load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "hardening",
    srcs = [
        "render.go",
        "request.go",
    ],
    importpath = "github.com/DataDog/datadog-agent/pkg/clusteragent/hardening",
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/remoteconfig/state",
        "//pkg/util/log",
        "@io_k8s_api//core/v1:core",
        "@io_k8s_utils//ptr",
    ],
)

dd_agent_go_test(
    name = "hardening_test",
    srcs = [
        "render_test.go",
        "request_test.go",
    ],
    embed = [":hardening"],
    gotags_sets = [[
        "cel",
        "clusterchecks",
        "kubeapiserver",
        "kubelet",
        "orchestrator",
    ]],
    include_default = False,
    deps = [
        "//pkg/remoteconfig/state",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
        "@io_k8s_api//core/v1:core",
        "@io_k8s_utils//ptr",
    ],
)
