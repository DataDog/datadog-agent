load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "hardening",
    srcs = ["webhook.go"],
    importpath = "github.com/DataDog/datadog-agent/pkg/clusteragent/admission/mutate/hardening",
    visibility = ["//visibility:public"],
    deps = [
        "//cmd/cluster-agent/admission",
        "//comp/core/config",
        "//pkg/clusteragent/admission/common",
        "//pkg/clusteragent/admission/mutate/common",
        "//pkg/clusteragent/hardening",
        "//pkg/util/kubernetes",
        "@io_k8s_api//admission/v1:admission",
        "@io_k8s_api//admissionregistration/v1:admissionregistration",
        "@io_k8s_api//core/v1:core",
        "@io_k8s_apimachinery//pkg/apis/meta/v1:meta",
        "@io_k8s_client_go//dynamic",
    ],
)

dd_agent_go_test(
    name = "hardening_test",
    srcs = ["webhook_test.go"],
    embed = [":hardening"],
    gotags_sets = [[
        "cel",
        "clusterchecks",
        "kubeapiserver",
        "kubelet",
        "orchestrator",
    ]],
    include_default = False,
    deps = [
        "//cmd/cluster-agent/admission",
        "//pkg/clusteragent/admission/mutate/common",
        "//pkg/clusteragent/hardening",
        "//pkg/config/mock",
        "//pkg/remoteconfig/state",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
        "@io_k8s_api//core/v1:core",
        "@io_k8s_utils//ptr",
    ],
)
