<div class="stat">
  <span class="stat_title">Workload Autoscaling</span>
  <span class="stat_data">
    {{- with .workloadAutoscaling }}
    {{- if .Disabled }}
      {{ .Disabled }}
    {{- else if not .Started }}
      Workload autoscaling is enabled but has not started yet.
    {{- else }}
      DatadogPodAutoscalers: {{ .PodAutoscalerCount }}
      <br>Leader: {{ if .IsLeader }}true{{ else }}false{{ end }}
      {{- range .RemoteConfigProducts }}
      <br>
      <br>{{ .Product }}
      {{- if not .Received }}
      <br>&nbsp;&nbsp;No update received yet (expected if no DatadogPodAutoscaler is configured remotely)
      {{- else }}
      <br>&nbsp;&nbsp;Last config version: {{ .LastVersion }}
      <br>&nbsp;&nbsp;Last update: {{ .LastUpdate }} ({{ .LastUpdateAge }} ago)
      <br>&nbsp;&nbsp;Configs in last update: {{ .ConfigCount }}
      <br>&nbsp;&nbsp;Updates received: {{ .UpdateCount }}
      {{- if .ErrorCount }}
      <br>&nbsp;&nbsp;Configs failed: {{ .ErrorCount }} of {{ .ConfigCount }}
      <br>&nbsp;&nbsp;Last error: {{ .LastError }}
      {{- end }}
      {{- end }}
      {{- end }}
    {{- end }}
    {{- end }}
  </span>
</div>
