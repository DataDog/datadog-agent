load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "yara",
    srcs = [
        "config.go",
        "consumer.go",
        "doc.go",
        "standin.go",
        "stats.go",
        "types.go",
    ],
    importpath = "github.com/DataDog/datadog-agent/pkg/eventmonitor/consumers/yara",
    visibility = ["//visibility:public"],
    deps = select({
        "@rules_go//go/platform:android": [
            "//pkg/config/model",
            "//pkg/config/setup",
            "//pkg/eventmonitor",
            "//pkg/security/secl/containerutils",
            "//pkg/security/secl/model",
            "//pkg/util/log",
        ],
        "@rules_go//go/platform:linux": [
            "//pkg/config/model",
            "//pkg/config/setup",
            "//pkg/eventmonitor",
            "//pkg/security/secl/containerutils",
            "//pkg/security/secl/model",
            "//pkg/util/log",
        ],
        "//conditions:default": [],
    }),
)

dd_agent_go_test(
    name = "yara_test",
    srcs = [
        "consumer_test.go",
        "standin_test.go",
    ],
    embed = [":yara"],
    deps = select({
        "@rules_go//go/platform:android": [
            "//pkg/config/mock",
            "//pkg/security/secl/containerutils",
            "//pkg/security/secl/model",
            "@com_github_stretchr_testify//assert",
            "@com_github_stretchr_testify//require",
        ],
        "@rules_go//go/platform:linux": [
            "//pkg/config/mock",
            "//pkg/security/secl/containerutils",
            "//pkg/security/secl/model",
            "@com_github_stretchr_testify//assert",
            "@com_github_stretchr_testify//require",
        ],
        "//conditions:default": [],
    }),
)
