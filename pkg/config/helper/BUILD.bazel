load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")
load("//bazel/rules/go_package_metadata:defs.bzl", "go_package_metadata")

package(default_package_metadata = [":go_package_metadata"])

go_package_metadata(
    name = "go_package_metadata",
    module = "github.com/DataDog/datadog-agent/pkg/config/helper",
)

go_library(
    name = "helper",
    srcs = [
        "env.go",
        "helpers.go",
        "ipc_address.go",
        "set_tree.go",
    ],
    importpath = "github.com/DataDog/datadog-agent/pkg/config/helper",
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/config/model",
        "//pkg/config/setup/constants",
        "//pkg/config/structure",
        "//pkg/util/log",
        "//pkg/util/system",
    ],
)

dd_agent_go_test(
    name = "helper_test",
    srcs = [
        "ipc_address_test.go",
        "set_tree_test.go",
    ],
    embed = [":helper"],
    deps = [
        "//pkg/config/model",
        "//pkg/config/nodetreemodel",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
