load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

# Committed snapshot of the generated settings, for external consumers only:
# in-repo builds use the copy in generatedsettings_local.
# gazelle:exclude generatedsettings

go_library(
    name = "setup",
    srcs = [
        "config.go",
        "config_accessor.go",
        "config_darwin.go",
        "config_init.go",
        "config_init_serverless.go",
        "config_nix.go",
        "config_test_accessor.go",
        "config_windows.go",
        "constants_compat.go",
        "delegated_auth_endpoints.go",
        "fixup_init.go",
        "otlp.go",
        "process.go",
        "system_probe.go",
        "test_config_accessor.go",
        "test_helpers.go",
    ],
    importpath = "github.com/DataDog/datadog-agent/pkg/config/setup",
    visibility = ["//visibility:public"],
    deps = [
        "//comp/core/delegatedauth/api/cloudauth/config",
        "//comp/core/delegatedauth/common",
        "//comp/core/delegatedauth/def",
        "//comp/core/secrets/def",
        "//pkg/config/create",
        "//pkg/config/env",
        "//pkg/config/model",
        "//pkg/config/setup/constants",
        "//pkg/config/setup/generatedsettings_local:generatedsettings",
        "//pkg/config/structure",
        "//pkg/fips",
        "//pkg/util/defaultpaths",
        "//pkg/util/log",
        "//pkg/util/scrubber",
        "//pkg/util/system",
        "@in_yaml_go_yaml_v3//:yaml",
    ] + select({
        "@rules_go//go/platform:windows": [
            "//pkg/util/winutil",
        ],
        "//conditions:default": [],
    }),
)

dd_agent_go_test(
    name = "setup_test",
    srcs = [
        "config_init_test.go",
        "config_secret_test.go",
        "config_test.go",
        "delegated_auth_endpoints_test.go",
        "process_test.go",
        "system_probe_test.go",
    ],
    embed = [":setup"],
    deps = [
        "//comp/core/delegatedauth/api/cloudauth/config",
        "//comp/core/delegatedauth/def",
        "//comp/core/delegatedauth/mock",
        "//comp/core/secrets/mock",
        "//pkg/config/model",
        "//pkg/config/nodetreemodel",
        "//pkg/config/setup/constants",
        "//pkg/config/setup/generatedsettings_local:generatedsettings",
        "//pkg/util/defaultpaths",
        "//pkg/util/scrubber",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
        "@in_yaml_go_yaml_v3//:yaml",
    ],
)
