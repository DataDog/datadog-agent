load("@bazel_lib//lib:run_binary.bzl", "run_binary")
load("@rules_go//go:def.bzl", "go_library")

# generated.go is generated by 'codegen_constants'
# gazelle:exclude generated.go

# Invoke the same code-generation logic as
#   dda inv schema.codegen
run_binary(
    name = "codegen_constants",
    srcs = [
        # Schema YAML files that drive code generation
        "//pkg/config/schema:yaml/core_schema.yaml",
        "//pkg/config/schema:core_schema_subfiles",
        "//pkg/config/schema:system_probe_schema_subfiles",  # includes system-probe_schema.yaml
    ],
    outs = ["generated.go"],
    args = [
        "$(RULEDIR)/",
        "constants",
    ],
    tool = "//tasks/schema:codegen_settings_main",
)

go_library(
    name = "constants",
    srcs = [
        "constants.go",
        ":codegen_constants",  # keep: generated constants file (see above)
    ],
    importpath = "github.com/DataDog/datadog-agent/pkg/config/setup/constants",
    visibility = ["//visibility:public"],
)
