load("@bazel_lib//lib:run_binary.bzl", "run_binary")
load("@rules_go//go:def.bzl", "go_library")

# In-repo copy of the generatedsettings module: go.work and every replace
# directive point here instead of ../generatedsettings, the snapshot committed
# for external consumers. Its generated *.go files are gitignored: `dda inv
# schema.codegen` writes them for `go` builds, and 'codegen_settings' generates
# them for Bazel. Only doc.go is committed, so the package and its dependencies
# resolve on a fresh checkout before codegen runs.

# The module path is that of ../generatedsettings, not this directory.
# gazelle:prefix github.com/DataDog/datadog-agent/pkg/config/setup/generatedsettings
# gazelle:exclude all_settings.go
# gazelle:exclude generated.go
# gazelle:exclude system_probe_settings.go

_CODEGEN_OUTPUT_FILES = [
    "all_settings.go",
    "generated.go",
    "system_probe_settings.go",
]

# Invoke the same code-generation logic as
#   dda inv schema.codegen
# but write outputs to the Bazel output tree (gen/) instead of the source
# tree.  Inputs are the merged schema YAML files.
# Re-runs automatically whenever any input changes.
run_binary(
    name = "codegen_settings",
    srcs = [
        # Schema YAML files that drive code generation
        "//pkg/config/schema:yaml/core_schema.yaml",
        "//pkg/config/schema:core_schema_subfiles",
        "//pkg/config/schema:system_probe_schema_subfiles",  # includes system-probe_schema.yaml
    ],
    outs = [f for f in _CODEGEN_OUTPUT_FILES],
    args = ["$(RULEDIR)/"],
    tool = "//tasks/schema:codegen_settings_main",
)

go_library(
    name = "generatedsettings",
    srcs = [
        "doc.go",
        ":codegen_settings",  # keep: generated *_settings.go files (see above)
    ],
    importpath = "github.com/DataDog/datadog-agent/pkg/config/setup/generatedsettings",
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/config/env",
        "//pkg/config/helper",
        "//pkg/config/model",
    ],
)
