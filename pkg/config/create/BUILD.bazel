load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")
load("//bazel/rules/go_package_metadata:defs.bzl", "go_package_metadata")

package(default_package_metadata = [":go_package_metadata"])

go_package_metadata(
    name = "go_package_metadata",
    module = "github.com/DataDog/datadog-agent/pkg/config/create",
)

go_library(
    name = "create",
    srcs = ["new.go"],
    importpath = "github.com/DataDog/datadog-agent/pkg/config/create",
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/config/model",
        "//pkg/config/nodetreemodel",
    ],
)

dd_agent_go_test(
    name = "create_test",
    srcs = ["new_test.go"],
    embed = [":create"],
    deps = [
        "//pkg/config/nodetreemodel",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
