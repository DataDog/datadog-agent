load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

package(default_package_metadata = ["//pkg/gohai:go_package_metadata"])

go_library(
    name = "network",
    srcs = [
        "interfaces_linux.go",
        "interfaces_other.go",
        "network.go",
    ],
    importpath = "github.com/DataDog/datadog-agent/pkg/gohai/network",
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/gohai/utils",
    ] + select({
        "@rules_go//go/platform:android": [
            "@com_github_vishvananda_netlink//nl",
            "@org_golang_x_sys//unix",
        ],
        "@rules_go//go/platform:linux": [
            "@com_github_vishvananda_netlink//nl",
            "@org_golang_x_sys//unix",
        ],
        "//conditions:default": [],
    }),
)

dd_agent_go_test(
    name = "network_test",
    srcs = [
        "interfaces_linux_test.go",
        "network_test.go",
    ],
    embed = [":network"],
    deps = [
        "//pkg/gohai/utils",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ] + select({
        "@rules_go//go/platform:android": [
            "@com_github_vishvananda_netlink//nl",
            "@org_golang_x_sys//unix",
        ],
        "@rules_go//go/platform:linux": [
            "@com_github_vishvananda_netlink//nl",
            "@org_golang_x_sys//unix",
        ],
        "//conditions:default": [],
    }),
)
