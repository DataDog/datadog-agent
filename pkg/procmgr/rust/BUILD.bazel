load("@rules_pkg//pkg:install.bzl", "pkg_install")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes", "pkg_files")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

_LINUX_OR_WINDOWS = select({
    "@platforms//os:linux": [],
    "@platforms//os:windows": [],
    "//conditions:default": ["@platforms//:incompatible"],
})

# ============================================================================
# Library
# ============================================================================

_LIB_SRCS = glob(
    ["src/**/*.rs"],
    exclude = ["src/bins/**"],
)

_LIB_DEPS = [
    "//pkg/procmgr/rust/client:dd-procmgr-client",
    "@crates//:anyhow",
    "@crates//:log",
    "@crates//:saphyr-parser",
    "@crates//:serde",
    "@crates//:serde_json",
    "@crates//:serde_yaml",
    "@crates//:tokio",
    "@crates//:tokio-stream",
    "@crates//:tonic",
    "@crates//:tonic-reflection",
    "@crates//:uuid",
] + select({
    "@platforms//os:linux": [
        "@crates//:nix",
    ],
    "@platforms//os:windows": [
        "//comp/core/log/rust:dd-agent-log",
        "@crates//:windows-registry",
        "@crates//:windows-sys",
    ],
    "//conditions:default": [],
})

rust_library(
    name = "dd-procmgrd-lib",
    srcs = _LIB_SRCS,
    crate_name = "dd_procmgrd",
    edition = "2024",
    rustc_flags = ["--cfg=bazel"],
    target_compatible_with = _LINUX_OR_WINDOWS,
    visibility = ["//visibility:public"],
    deps = _LIB_DEPS,
)

rust_library(
    name = "dd-procmgrd-lib-testhelpers",
    testonly = True,
    srcs = _LIB_SRCS,
    crate_features = ["test-helpers"],
    crate_name = "dd_procmgrd",
    edition = "2024",
    rustc_flags = ["--cfg=bazel"],
    target_compatible_with = _LINUX_OR_WINDOWS,
    deps = _LIB_DEPS,
)

# ============================================================================
# Binaries
# ============================================================================

rust_binary(
    name = "dd-procmgrd",
    srcs = ["src/bins/dd-procmgrd.rs"],
    edition = "2024",
    link_deps = select({
        "@platforms//os:windows": ["//pkg/procmgr/rust/windows_resources:rsrcd"],
        "//conditions:default": [],
    }),
    rustc_flags = ["--cfg=bazel"],
    target_compatible_with = _LINUX_OR_WINDOWS,
    visibility = ["//visibility:public"],
    deps = [
        ":dd-procmgrd-lib",
        "//comp/core/log/rust:dd-agent-log",
        "@crates//:anyhow",
        "@crates//:log",
        "@crates//:tokio",
    ],
)

rust_binary(
    name = "dd-procmgr",
    srcs = ["src/bins/dd-procmgr.rs"],
    edition = "2024",
    link_deps = select({
        "@platforms//os:windows": ["//pkg/procmgr/rust/windows_resources:rsrc"],
        "//conditions:default": [],
    }),
    rustc_flags = ["--cfg=bazel"],
    target_compatible_with = _LINUX_OR_WINDOWS,
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/procmgr/rust/client:dd-procmgr-client",
        "@crates//:clap",
        "@crates//:serde_json",
        "@crates//:tokio",
        "@crates//:tonic",
    ],
)

pkg_files(
    name = "all_files_linux",
    srcs = [
        ":dd-procmgr",
        ":dd-procmgrd",
    ],
    attributes = pkg_attributes(
        mode = "0755",
    ),
    prefix = "embedded/bin",
    target_compatible_with = ["@platforms//os:linux"],
    visibility = ["//packages:__subpackages__"],
)

pkg_files(
    name = "all_files_windows",
    srcs = [
        ":dd-procmgr",
        ":dd-procmgrd",
    ],
    prefix = "bin/agent",
    target_compatible_with = ["@platforms//os:windows"],
    visibility = ["//packages:__subpackages__"],
)

pkg_install(
    name = "install",
    srcs = select({
        "@platforms//os:linux": [":all_files_linux"],
        "@platforms//os:windows": [":all_files_windows"],
        "//conditions:default": [],
    }),
    target_compatible_with = _LINUX_OR_WINDOWS,
)

# ============================================================================
# Tests
# ============================================================================

# PR-added unit tests (vs jose/procmgr-config-gates) are gated in source with
# #[cfg(any(procmgr_pr_all, procmgr_pr_<batch>))]. Default: none enabled, so
# dd-procmgrd_test matches the base branch. Uncomment entries below to enable
# batches incrementally and bisect CI failures.
_PROCMGR_PR_TEST_CFGS = [
    "procmgr_pr_config_gate_secrets",
    # "procmgr_pr_config_gate_core",
    # "procmgr_pr_secret_backend_exec",
    # "procmgr_pr_platform_unix_secret_backend",
    # "procmgr_pr_platform_windows_resolve_executable",
    # "procmgr_pr_platform_windows_secret_backend",
    # "procmgr_pr_platform_windows_legacy_scm_env",
    # "procmgr_pr_platform_windows_secret_backend_rights",
    # Or enable everything: "procmgr_pr_all",
]

_PROCMGR_PR_TEST_RUSTC_FLAGS = ["--cfg=" + cfg for cfg in _PROCMGR_PR_TEST_CFGS]

rust_test(
    name = "dd-procmgrd_test",
    size = "large",
    crate = ":dd-procmgrd-lib",
    edition = "2024",
    rustc_flags = ["--cfg=bazel"] + _PROCMGR_PR_TEST_RUSTC_FLAGS,
    target_compatible_with = _LINUX_OR_WINDOWS,
    deps = ["@crates//:tempfile"],
)

rust_test(
    name = "dd-procmgr_test",
    crate = ":dd-procmgr",
    edition = "2024",
    rustc_flags = ["--cfg=bazel"],
    target_compatible_with = _LINUX_OR_WINDOWS,
)

rust_test(
    name = "e2e_test",
    srcs = [
        "tests/e2e.rs",
        "tests/helpers/mod.rs",
    ],
    crate_root = "tests/e2e.rs",
    data = [
        ":dd-procmgr",
        ":dd-procmgrd",
        "//pkg/fleet/installer/packages/embedded:tmpl/datadog-agent-ddot.yaml.tmpl",
    ],
    edition = "2024",
    rustc_env = {
        "CARGO_BIN_EXE_dd-procmgr": "$(rootpath :dd-procmgr)",
        "CARGO_BIN_EXE_dd-procmgrd": "$(rootpath :dd-procmgrd)",
        "DDOT_TEMPLATE_PATH": "$(rootpath //pkg/fleet/installer/packages/embedded:tmpl/datadog-agent-ddot.yaml.tmpl)",
    },
    # E2E tests use UDS for transport and spawn the Linux daemon binary.
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        ":dd-procmgrd-lib-testhelpers",
        "@crates//:serde_json",
        "@crates//:tempfile",
    ] + select({
        "@platforms//os:linux": [
            "@crates//:nix",
        ],
        "@platforms//os:windows": [
            "@crates//:windows-sys",
        ],
        "//conditions:default": [],
    }),
)
