load("@rules_pkg//pkg:install.bzl", "pkg_install")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes", "pkg_files")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")
load("//pkg/procmgr/rust:procmgr_rust_test.bzl", "dd_procmgrd_isolated_manager_tests", "dd_procmgrd_lib_test", "dd_procmgrd_skip_args_for_isolated")

_LINUX_OR_WINDOWS = select({
    "@platforms//os:linux": [],
    "@platforms//os:windows": [],
    "//conditions:default": ["@platforms//:incompatible"],
})

# ============================================================================
# Library
# ============================================================================

_LIB_SRCS = glob(
    ["src/**/*.rs"],
    exclude = ["src/bins/**"],
)

_LIB_DEPS = [
    "//pkg/procmgr/rust/client:dd-procmgr-client",
    "@crates//:anyhow",
    "@crates//:log",
    "@crates//:serde",
    "@crates//:serde_json",
    "@crates//:serde_yaml",
    "@crates//:tokio",
    "@crates//:tokio-stream",
    "@crates//:tonic",
    "@crates//:tonic-reflection",
    "@crates//:uuid",
] + select({
    "@platforms//os:linux": [
        "@crates//:nix",
    ],
    "@platforms//os:windows": [
        "//comp/core/log/rust:dd-agent-log",
        "@crates//:windows-registry",
        "@crates//:windows-sys",
    ],
    "//conditions:default": [],
})

rust_library(
    name = "dd-procmgrd-lib",
    srcs = _LIB_SRCS,
    crate_name = "dd_procmgrd",
    edition = "2024",
    rustc_flags = ["--cfg=bazel"],
    target_compatible_with = _LINUX_OR_WINDOWS,
    visibility = ["//visibility:public"],
    deps = _LIB_DEPS,
)

rust_library(
    name = "dd-procmgrd-lib-testhelpers",
    testonly = True,
    srcs = _LIB_SRCS,
    crate_features = ["test-helpers"],
    crate_name = "dd_procmgrd",
    edition = "2024",
    rustc_flags = ["--cfg=bazel"],
    target_compatible_with = _LINUX_OR_WINDOWS,
    deps = _LIB_DEPS,
)

# ============================================================================
# Binaries
# ============================================================================

rust_binary(
    name = "dd-procmgrd",
    srcs = ["src/bins/dd-procmgrd.rs"],
    edition = "2024",
    link_deps = select({
        "@platforms//os:windows": ["//pkg/procmgr/rust/windows_resources:rsrcd"],
        "//conditions:default": [],
    }),
    rustc_flags = ["--cfg=bazel"],
    target_compatible_with = _LINUX_OR_WINDOWS,
    visibility = ["//visibility:public"],
    deps = [
        ":dd-procmgrd-lib",
        "//comp/core/log/rust:dd-agent-log",
        "@crates//:anyhow",
        "@crates//:log",
        "@crates//:tokio",
    ],
)

rust_binary(
    name = "dd-procmgr",
    srcs = ["src/bins/dd-procmgr.rs"],
    edition = "2024",
    link_deps = select({
        "@platforms//os:windows": ["//pkg/procmgr/rust/windows_resources:rsrc"],
        "//conditions:default": [],
    }),
    rustc_flags = ["--cfg=bazel"],
    target_compatible_with = _LINUX_OR_WINDOWS,
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/procmgr/rust/client:dd-procmgr-client",
        "@crates//:clap",
        "@crates//:serde_json",
        "@crates//:tokio",
        "@crates//:tonic",
    ],
)

pkg_files(
    name = "all_files_linux",
    srcs = [
        ":dd-procmgr",
        ":dd-procmgrd",
    ],
    attributes = pkg_attributes(
        mode = "0755",
    ),
    prefix = "embedded/bin",
    target_compatible_with = ["@platforms//os:linux"],
    visibility = ["//packages:__subpackages__"],
)

pkg_files(
    name = "all_files_windows",
    srcs = [
        ":dd-procmgr",
        ":dd-procmgrd",
    ],
    prefix = "bin/agent",
    target_compatible_with = ["@platforms//os:windows"],
    visibility = ["//packages:__subpackages__"],
)

pkg_install(
    name = "install",
    srcs = select({
        "@platforms//os:linux": [":all_files_linux"],
        "@platforms//os:windows": [":all_files_windows"],
        "//conditions:default": [],
    }),
    target_compatible_with = _LINUX_OR_WINDOWS,
)

# ============================================================================
# Tests
# ============================================================================

_DD_PROCMGRD_TEST_ENV = select({
    "@platforms//os:windows": {
        "RUST_TEST_THREADS": "1",
        "RUST_TEST_NOCAPTURE": "1",
    },
    "//conditions:default": {},
})

# Spawn-heavy manager::tests run as dedicated targets (one Bazel test per Rust test)
# so CI reports each result separately and failures are easier to reproduce:
#   bazel test //pkg/procmgr/rust:dd-procmgrd_reload_modified_03_restarts_test
# To isolate another test, append (suffix, filter) here.
_DD_PROCMGRD_ISOLATED_MANAGER_TESTS = [
    ("complete_restart", "complete_restart_skips_already_running"),
    ("reload_modified_01_result", "reload_modified_01_result_contains_service"),
    ("reload_modified_02_updates", "reload_modified_02_updates_stored_config"),
    ("reload_modified_03_restarts", "reload_modified_03_restarts_running_process"),
    ("reload_modified_not_running", "reload_modified_not_running_stays_stopped"),
    ("reload_unchanged", "reload_unchanged_config_not_modified"),
    ("reload_preserves_runtime", "reload_preserves_runtime_created_processes"),
    ("reload_recomputes_startup_order", "reload_recomputes_startup_order"),
    ("shutdown_after_reload_adds", "shutdown_after_reload_adds_process"),
    ("shutdown_after_reload_removes", "shutdown_after_reload_removes_process"),
    ("shutdown_after_reload_runtime", "shutdown_after_reload_with_runtime_process"),
    ("create_auto_start_spawns", "create_auto_start_spawns_process"),
    ("create_auto_start_false", "create_auto_start_false_stays_created"),
    ("create_auto_start_bad_command", "create_auto_start_bad_command_still_created"),
    ("create_auto_start_condition", "create_auto_start_condition_not_met"),
    ("create_runtime_startup_order", "create_includes_runtime_process_in_startup_order"),
]

_DD_PROCMGRD_ISOLATED_MANAGER_TEST_NAMES = dd_procmgrd_isolated_manager_tests(
    "dd-procmgrd",
    _DD_PROCMGRD_ISOLATED_MANAGER_TESTS,
    _DD_PROCMGRD_TEST_ENV,
)

# Fast/unit tests plus process, grpc, config, ordering, etc. Isolated manager
# integration tests are skipped here and run via dedicated targets above.
dd_procmgrd_lib_test(
    name = "dd-procmgrd_test",
    args = dd_procmgrd_skip_args_for_isolated(_DD_PROCMGRD_ISOLATED_MANAGER_TESTS),
    env = _DD_PROCMGRD_TEST_ENV,
)

# Run every dd-procmgrd-lib test target:
#   bazel test //pkg/procmgr/rust:dd-procmgrd_all_tests
test_suite(
    name = "dd-procmgrd_all_tests",
    tests = [":dd-procmgrd_test"] + [":{}".format(name) for name in _DD_PROCMGRD_ISOLATED_MANAGER_TEST_NAMES],
)

rust_test(
    name = "dd-procmgr_test",
    crate = ":dd-procmgr",
    edition = "2024",
    rustc_flags = ["--cfg=bazel"],
    target_compatible_with = _LINUX_OR_WINDOWS,
)

rust_test(
    name = "e2e_test",
    srcs = glob([
        "tests/e2e/*.rs",
        "tests/helpers/*.rs",
    ]),
    crate_root = "tests/e2e/main.rs",
    data = [
        ":dd-procmgr",
        ":dd-procmgrd",
        "//pkg/fleet/installer/packages/embedded:tmpl/datadog-agent-ddot.yaml.tmpl",
        "//pkg/procmgr/rust/tests/fixtures:.marker",
        "//pkg/procmgr/rust/tests/fixtures:test_fixtures",
    ],
    edition = "2024",
    rustc_env = {
        "CARGO_BIN_EXE_dd-procmgr": "$(rootpath :dd-procmgr)",
        "CARGO_BIN_EXE_dd-procmgrd": "$(rootpath :dd-procmgrd)",
        "DDOT_TEMPLATE_PATH": "$(rootpath //pkg/fleet/installer/packages/embedded:tmpl/datadog-agent-ddot.yaml.tmpl)",
        "PROCMGR_TEST_FIXTURES_MARKER": "$(rootpath //pkg/procmgr/rust/tests/fixtures:.marker)",
    },
    # E2E tests use UDS for transport and spawn the Linux daemon binary.
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        ":dd-procmgrd-lib-testhelpers",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:tempfile",
    ] + select({
        "@platforms//os:linux": [
            "@crates//:nix",
        ],
        "@platforms//os:windows": [
            "@crates//:windows-sys",
        ],
        "//conditions:default": [],
    }),
)
