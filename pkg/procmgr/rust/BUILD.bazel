load("@rules_pkg//pkg:install.bzl", "pkg_install")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes", "pkg_files")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")
load("//pkg/procmgr/rust:procmgr_rust_test.bzl", "dd_procmgrd_isolated_integration_tests", "dd_procmgrd_lib_test", "dd_procmgrd_skip_args_for_isolated")

_LINUX_OR_WINDOWS = select({
    "@platforms//os:linux": [],
    "@platforms//os:windows": [],
    "//conditions:default": ["@platforms//:incompatible"],
})

# ============================================================================
# Library
# ============================================================================

_LIB_SRCS = glob(
    ["src/**/*.rs"],
    exclude = ["src/bins/**"],
)

_LIB_DEPS = [
    "//pkg/procmgr/rust/client:dd-procmgr-client",
    "@crates//:anyhow",
    "@crates//:log",
    "@crates//:serde",
    "@crates//:serde_json",
    "@crates//:serde_yaml",
    "@crates//:tokio",
    "@crates//:tokio-stream",
    "@crates//:tonic",
    "@crates//:tonic-reflection",
    "@crates//:uuid",
] + select({
    "@platforms//os:linux": [
        "@crates//:nix",
    ],
    "@platforms//os:windows": [
        "//comp/core/log/rust:dd-agent-log",
        "@crates//:windows-registry",
        "@crates//:windows-sys",
    ],
    "//conditions:default": [],
})

rust_library(
    name = "dd-procmgrd-lib",
    srcs = _LIB_SRCS,
    crate_name = "dd_procmgrd",
    edition = "2024",
    rustc_flags = ["--cfg=bazel"],
    target_compatible_with = _LINUX_OR_WINDOWS,
    visibility = ["//visibility:public"],
    deps = _LIB_DEPS,
)

rust_library(
    name = "dd-procmgrd-lib-testhelpers",
    testonly = True,
    srcs = _LIB_SRCS,
    crate_features = ["test-helpers"],
    crate_name = "dd_procmgrd",
    edition = "2024",
    rustc_flags = ["--cfg=bazel"],
    target_compatible_with = _LINUX_OR_WINDOWS,
    deps = _LIB_DEPS,
)

# ============================================================================
# Binaries
# ============================================================================

rust_binary(
    name = "dd-procmgrd",
    srcs = ["src/bins/dd-procmgrd.rs"],
    edition = "2024",
    link_deps = select({
        "@platforms//os:windows": ["//pkg/procmgr/rust/windows_resources:rsrcd"],
        "//conditions:default": [],
    }),
    rustc_flags = ["--cfg=bazel"],
    target_compatible_with = _LINUX_OR_WINDOWS,
    visibility = ["//visibility:public"],
    deps = [
        ":dd-procmgrd-lib",
        "//comp/core/log/rust:dd-agent-log",
        "@crates//:anyhow",
        "@crates//:log",
        "@crates//:tokio",
    ],
)

rust_binary(
    name = "dd-procmgr",
    srcs = ["src/bins/dd-procmgr.rs"],
    edition = "2024",
    link_deps = select({
        "@platforms//os:windows": ["//pkg/procmgr/rust/windows_resources:rsrc"],
        "//conditions:default": [],
    }),
    rustc_flags = ["--cfg=bazel"],
    target_compatible_with = _LINUX_OR_WINDOWS,
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/procmgr/rust/client:dd-procmgr-client",
        "@crates//:clap",
        "@crates//:serde_json",
        "@crates//:tokio",
        "@crates//:tonic",
    ],
)

pkg_files(
    name = "all_files_linux",
    srcs = [
        ":dd-procmgr",
        ":dd-procmgrd",
    ],
    attributes = pkg_attributes(
        mode = "0755",
    ),
    prefix = "embedded/bin",
    target_compatible_with = ["@platforms//os:linux"],
    visibility = ["//packages:__subpackages__"],
)

pkg_files(
    name = "all_files_windows",
    srcs = [
        ":dd-procmgr",
        ":dd-procmgrd",
    ],
    prefix = "bin/agent",
    target_compatible_with = ["@platforms//os:windows"],
    visibility = ["//packages:__subpackages__"],
)

pkg_install(
    name = "install",
    srcs = select({
        "@platforms//os:linux": [":all_files_linux"],
        "@platforms//os:windows": [":all_files_windows"],
        "//conditions:default": [],
    }),
    target_compatible_with = _LINUX_OR_WINDOWS,
)

# ============================================================================
# Tests
# ============================================================================

_DD_PROCMGRD_TEST_ENV = select({
    "@platforms//os:windows": {
        "RUST_TEST_THREADS": "1",
        "RUST_TEST_NOCAPTURE": "1",
    },
    "//conditions:default": {},
})

# Spawn-heavy integration tests run as dedicated targets (one Bazel test per Rust
# test) so CI reports each result separately and Windows avoids cross-test
# pollution in the monolithic dd-procmgrd_test process. To isolate another test,
# append (suffix, filter) here.
_DD_PROCMGRD_ISOLATED_INTEGRATION_TESTS = [
    # manager::tests
    ("complete_restart", "test_complete_restart_skips_already_running"),
    ("reload_modified_01_result", "test_reload_modified_01_result_contains_service"),
    ("reload_modified_02_updates", "test_reload_modified_02_updates_stored_config"),
    ("reload_modified_03_restarts", "test_reload_modified_03_restarts_running_process"),
    ("reload_modified_not_running", "test_reload_modified_not_running_stays_stopped"),
    ("reload_unchanged", "test_reload_unchanged_config_not_modified"),
    ("reload_preserves_runtime", "test_reload_preserves_runtime_created_processes"),
    ("reload_recomputes_startup_order", "test_reload_recomputes_startup_order"),
    ("shutdown_after_reload_adds", "test_shutdown_after_reload_adds_process"),
    ("shutdown_after_reload_removes", "test_shutdown_after_reload_removes_process"),
    ("shutdown_after_reload_runtime", "test_shutdown_after_reload_with_runtime_process"),
    ("create_auto_start_spawns", "test_create_auto_start_spawns_process"),
    ("create_auto_start_false", "test_create_auto_start_false_stays_created"),
    ("create_auto_start_bad_command", "test_create_auto_start_bad_command_still_created"),
    ("create_auto_start_condition", "test_create_auto_start_condition_not_met"),
    ("create_runtime_startup_order", "test_create_includes_runtime_process_in_startup_order"),
    # grpc::service::tests (spawn before process::tests alphabetically)
    ("grpc_proto_running_pid", "test_process_to_proto_running_with_pid"),
    ("grpc_proto_failed", "test_process_to_proto_failed"),
    # process::tests
    ("process_state_exit_success", "test_state_transitions_spawn_exit_success"),
    ("process_state_exit_failure", "test_state_transitions_spawn_exit_failure"),
    ("process_state_after_spawn", "test_state_after_spawn_watcher_owns_handle"),
    ("process_spawn_and_is_running", "test_spawn_and_is_running"),
    ("process_spawn_nonexistent", "test_spawn_nonexistent_binary"),
    ("process_spawn_failure_after_stop", "test_spawn_failure_after_stop_goes_through_starting_to_failed"),
    ("process_spawn_with_env", "test_spawn_with_env"),
    ("process_spawn_with_args", "test_spawn_with_args"),
    ("process_spawn_no_inherit_env", "test_spawn_does_not_inherit_parent_env"),
    ("process_spawn_environment_file", "test_spawn_with_environment_file"),
    ("process_env_overrides_file", "test_env_overrides_environment_file"),
    ("process_spawn_missing_envfile", "test_spawn_fails_on_missing_environment_file"),
    ("process_spawn_optional_envfile", "test_spawn_skips_missing_optional_environment_file"),
    ("process_stop_requested", "test_stop_requested_transitions_to_stopped"),
    ("process_stop_crash_restart", "test_stop_start_then_crash_restarts_on_failure"),
    ("process_stop_skips_restart", "test_stop_requested_skips_restart"),
    ("process_normal_exit_stop_flag", "test_normal_exit_not_affected_by_stop_flag"),
    # shutdown::tests
    ("shutdown_all_graceful", "test_shutdown_all_graceful"),
    ("shutdown_sigkill_timeout", "test_shutdown_all_sigkill_on_timeout"),
    ("shutdown_after_spawn", "test_shutdown_all_after_spawn_watcher_owns_handle"),
    ("shutdown_ordered_reverse", "test_shutdown_ordered_reverse"),
]

_DD_PROCMGRD_ISOLATED_INTEGRATION_TEST_NAMES = dd_procmgrd_isolated_integration_tests(
    "dd-procmgrd",
    _DD_PROCMGRD_ISOLATED_INTEGRATION_TESTS,
    _DD_PROCMGRD_TEST_ENV,
)

# Fast/unit tests only. Spawn-heavy integration tests are skipped here and run via
# dedicated targets above.
dd_procmgrd_lib_test(
    name = "dd-procmgrd_test",
    args = dd_procmgrd_skip_args_for_isolated(_DD_PROCMGRD_ISOLATED_INTEGRATION_TESTS),
    env = _DD_PROCMGRD_TEST_ENV,
)

# Run every dd-procmgrd-lib test target:
#   bazel test //pkg/procmgr/rust:dd-procmgrd_all_tests
test_suite(
    name = "dd-procmgrd_all_tests",
    tests = [":dd-procmgrd_test"] + [":{}".format(name) for name in _DD_PROCMGRD_ISOLATED_INTEGRATION_TEST_NAMES],
)

rust_test(
    name = "dd-procmgr_test",
    crate = ":dd-procmgr",
    edition = "2024",
    rustc_flags = ["--cfg=bazel"],
    target_compatible_with = _LINUX_OR_WINDOWS,
)

rust_test(
    name = "e2e_test",
    srcs = glob([
        "tests/e2e/*.rs",
        "tests/helpers/*.rs",
    ]),
    crate_root = "tests/e2e/main.rs",
    data = [
        ":dd-procmgr",
        ":dd-procmgrd",
        "//pkg/fleet/installer/packages/embedded:tmpl/datadog-agent-ddot.yaml.tmpl",
        "//pkg/procmgr/rust/tests/fixtures:.marker",
        "//pkg/procmgr/rust/tests/fixtures:test_fixtures",
    ],
    edition = "2024",
    rustc_env = {
        "CARGO_BIN_EXE_dd-procmgr": "$(rootpath :dd-procmgr)",
        "CARGO_BIN_EXE_dd-procmgrd": "$(rootpath :dd-procmgrd)",
        "DDOT_TEMPLATE_PATH": "$(rootpath //pkg/fleet/installer/packages/embedded:tmpl/datadog-agent-ddot.yaml.tmpl)",
        "PROCMGR_TEST_FIXTURES_MARKER": "$(rootpath //pkg/procmgr/rust/tests/fixtures:.marker)",
    },
    # E2E tests use UDS for transport and spawn the Linux daemon binary.
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        ":dd-procmgrd-lib-testhelpers",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:tempfile",
    ] + select({
        "@platforms//os:linux": [
            "@crates//:nix",
        ],
        "@platforms//os:windows": [
            "@crates//:windows-sys",
        ],
        "//conditions:default": [],
    }),
)
