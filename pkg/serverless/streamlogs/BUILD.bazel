load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "streamlogs",
    srcs = ["streamlogs.go"],
    importpath = "github.com/DataDog/datadog-agent/pkg/serverless/streamlogs",
    visibility = ["//visibility:public"],
    deps = ["//pkg/logs/message"],
)

dd_agent_go_test(
    name = "streamlogs_test",
    srcs = ["streamlogs_test.go"],
    embed = [":streamlogs"],
    deps = [
        "//comp/logs/agent/config",
        "//pkg/logs/message",
        "//pkg/logs/sources",
        "@com_github_stretchr_testify//assert",
    ],
)
