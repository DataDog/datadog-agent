load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")
load("//bazel/rules/go_package_metadata:defs.bzl", "go_package_metadata")

package(default_package_metadata = [":go_package_metadata"])

go_package_metadata(
    name = "go_package_metadata",
    module = "github.com/DataDog/datadog-agent/pkg/aggregator/ckey",
)

go_library(
    name = "ckey",
    srcs = ["key.go"],
    importpath = "github.com/DataDog/datadog-agent/pkg/aggregator/ckey",
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/tagset",
        "@com_github_twmb_murmur3//:murmur3",
    ],
)

dd_agent_go_test(
    name = "ckey_test",
    srcs = [
        "key_test.go",
        "sort_test.go",
    ],
    embed = [":ckey"],
    deps = [
        "//pkg/tagset",
        "//pkg/util/sort",
        "@com_github_stretchr_testify//assert",
    ],
)
