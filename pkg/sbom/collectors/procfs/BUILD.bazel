load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "procfs",
    srcs = [
        "collector.go",
        "doc.go",
        "errors.go",
        "procfs.go",
        "procfs_linux.go",
        "procfs_other.go",
        "request.go",
        "utils_linux.go",
        "utils_other.go",
    ],
    importpath = "github.com/DataDog/datadog-agent/pkg/sbom/collectors/procfs",
    visibility = ["//visibility:public"],
    deps = [
        "//comp/core/config",
        "//comp/core/workloadmeta/def",
        "//pkg/sbom",
        "//pkg/sbom/collectors",
        "//pkg/sbom/types",
        "//pkg/util/log",
        "//pkg/util/option",
        "//pkg/util/trivy",
    ] + select({
        "@rules_go//go/platform:android": [
            "//pkg/util/kernel",
            "@com_github_shirou_gopsutil_v4//process",
        ],
        "@rules_go//go/platform:linux": [
            "//pkg/util/kernel",
            "@com_github_shirou_gopsutil_v4//process",
        ],
        "//conditions:default": [],
    }),
)

dd_agent_go_test(
    name = "procfs_test",
    srcs = ["procfs_test.go"],
    embed = [":procfs"],
    gotags_sets = [["trivy"]],
    include_default = False,
    deps = select({
        "@rules_go//go/platform:android": [
            "//pkg/sbom",
            "//pkg/util/trivy",
            "@com_github_stretchr_testify//assert",
            "@com_github_stretchr_testify//require",
        ],
        "@rules_go//go/platform:linux": [
            "//pkg/sbom",
            "//pkg/util/trivy",
            "@com_github_stretchr_testify//assert",
            "@com_github_stretchr_testify//require",
        ],
        "//conditions:default": [],
    }),
)
