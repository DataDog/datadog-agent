load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "endpoint",
    srcs = ["endpoints.go"],
    importpath = "github.com/DataDog/datadog-agent/pkg/process/runner/endpoint",
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/config/model",
        "//pkg/config/utils",
        "//pkg/process/util/api/config",
        "//pkg/util/scrubber",
