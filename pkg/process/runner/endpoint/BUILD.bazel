dd_agent_go_test(
    name = "endpoint_test",
    srcs = ["endpoints_test.go"],
    embed = [":endpoint"],
    deps = [
        "//pkg/process/util/api/config",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
