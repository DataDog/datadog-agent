load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")
load("//bazel/rules/go_package_metadata:defs.bzl", "go_package_metadata")

package(default_package_metadata = [":go_package_metadata"])

go_package_metadata(
    name = "go_package_metadata",
    module = "github.com/DataDog/datadog-agent/pkg/process/util/api",
)

go_library(
    name = "api",
    srcs = [
        "payload.go",
        "weighted_queue.go",
    ],
    importpath = "github.com/DataDog/datadog-agent/pkg/process/util/api",
    visibility = ["//visibility:public"],
    deps = [
        "//comp/core/telemetry/impl",
        "@com_github_datadog_agent_payload_v5//process",
        "@com_github_gogo_protobuf//proto",
    ],
)

dd_agent_go_test(
    name = "api_test",
    srcs = [
        "payload_test.go",
        "weighted_queue_test.go",
    ],
    embed = [":api"],
    deps = [
        "@com_github_datadog_agent_payload_v5//process",
        "@com_github_stretchr_testify//assert",
    ],
)
