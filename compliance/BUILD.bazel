load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_python//python:py_library.bzl", "py_library")
load("@rules_python//python:py_test.bzl", "py_test")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "gather_licenses_lib",
    srcs = ["gather_licenses.py"],
    deps = ["//tasks:licenses"],
)

py_binary(
    name = "gather_licenses",
    srcs = ["gather_licenses.py"],
    visibility = ["//visibility:private"],
    deps = ["//tasks:licenses"],
)

py_test(
    name = "gather_licenses_test",
    srcs = ["gather_licenses_test.py"],
    deps = [
        ":gather_licenses_lib",
    ],
)

py_library(
    name = "go_licenses_lib",
    srcs = ["go_licenses.py"],
    deps = ["@py_dev_requirements//pyyaml"],
)

py_binary(
    name = "go_licenses",
    srcs = ["go_licenses.py"],
    visibility = ["//visibility:private"],
    deps = ["@py_dev_requirements//pyyaml"],
)

py_test(
    name = "go_licenses_test",
    srcs = ["go_licenses_test.py"],
    deps = [":go_licenses_lib"],
)

py_binary(
    name = "write_version_manifest",
    srcs = ["write_version_manifest.py"],
    visibility = ["//compliance/rules:__pkg__"],
)
