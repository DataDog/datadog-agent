load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "api",
    srcs = [
        "check.go",
        "pid_windows.go",
        "secrets.go",
        "server.go",
        "server_other.go",
        "server_windows.go",
        "status.go",
        "tagger_list.go",
        "util.go",
        "workload_list.go",
    ],
    importpath = "github.com/DataDog/datadog-agent/cmd/process-agent/api",
    visibility = ["//visibility:public"],
    deps = [
        "//comp/core/config",
        "//comp/core/log/def",
        "//comp/core/secrets/def",
        "//comp/core/settings/def",
        "//comp/core/status",
        "//comp/core/tagger/def",
        "//comp/core/workloadmeta/def",
        "//pkg/api/coverage",
        "//pkg/process/checks",
        "//pkg/util/http",
        "//pkg/util/log",
        "@org_uber_go_fx//:fx",
    ] + select({
        "@rules_go//go/platform:windows": [
            "//pkg/process/procutil",
            "@org_golang_x_sys//windows",
        ],
        "//conditions:default": [],
    }),
)

dd_agent_go_test(
    name = "api_test",
    srcs = ["pid_windows_test.go"],
    embed = [":api"],
    target_compatible_with = ["@platforms//os:windows"],
    deps = select({
        "@rules_go//go/platform:windows": [
            "@com_github_stretchr_testify//assert",
            "@com_github_stretchr_testify//require",
            "@org_golang_x_sys//windows",
        ],
        "//conditions:default": [],
    }),
)
