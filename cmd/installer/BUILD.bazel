load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/check_for_symbols:check_for_symbols.bzl", "check_for_symbols_test")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")
load("//bazel/rules/go:go_binary.bzl", "dd_agent_go_binary")
load("//tasks:build_tags.bzl", "INSTALLER_TAGS")

# Symbol that Go's FIPS-mode cgo shim injects when linked against the FIPS
# OpenSSL provider (see omnibus/lib/fips.rb's legacy
# fips_check_binary_for_expected_symbol, which this check_for_symbols_test
# usage generalizes). A successful build is not sufficient proof that the
# FIPS code path was actually compiled in -- this checks the binary's symbol
# table via `nm`, mirroring the omnibus-era check.
_FIPS_SYMBOL = "_Cfunc__mkcgo_OPENSSL"

go_library(
    name = "installer_lib",
    srcs = ["main.go"],
    importpath = "github.com/DataDog/datadog-agent/cmd/installer",
    visibility = ["//visibility:private"],
    deps = [
        "//cmd/installer/command",
        "//cmd/installer/subcommands",
        "//pkg/fleet/installer/commands",
        "//pkg/fleet/installer/errors",
        "@com_github_spf13_cobra//:cobra",
        "@org_uber_go_dig//:dig",
    ],
)

dd_agent_go_binary(
    name = "installer",
    # keep
    srcs = select({
        "@platforms//os:windows": ["//cmd/installer/windows_resources:rsrc"],
        "//conditions:default": [],
    }),
    # FIPS requires cgo; Windows cgo is provided by dd_agent_go_binary default.
    cgo = select({
        "//packages/agent:fips_flavor": True,
        "@platforms//os:windows": True,
        "//conditions:default": False,
    }),
    embed = [":installer_lib"],
    gc_linkopts = select({
        "@platforms//os:linux": [
            "-X",
            "github.com/DataDog/datadog-agent/pkg/util/defaultpaths.runPath=/opt/datadog-packages/run",
        ],
        "//conditions:default": [],
    }),
    gotags = INSTALLER_TAGS,
    visibility = ["//visibility:public"],
)

check_for_symbols_test(
    name = "installer_fips_symbols_test",
    binary = ":installer",
    must_include = select({
        "//packages/agent:linux_fips": [_FIPS_SYMBOL],
        "//conditions:default": [],
    }),
    must_not_include = select({
        "//packages/agent:linux_fips": [],
        "//conditions:default": [_FIPS_SYMBOL],
    }),
    target_compatible_with = select({
        "@platforms//os:windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
)

dd_agent_go_test(
    name = "installer_test",
    srcs = ["main_test.go"],
    embed = [":installer_lib"],
    deps = [
        "//pkg/fleet/installer/commands",
        "@com_github_spf13_cobra//:cobra",
        "@com_github_stretchr_testify//assert",
    ],
)
