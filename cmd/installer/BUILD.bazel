load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/check_for_symbols:check_for_symbols.bzl", "check_for_symbols_test")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")
load("//bazel/rules/go:go_binary.bzl", "dd_agent_go_binary")
load("//tasks:build_tags.bzl", "INSTALLER_TAGS")

package(default_package_metadata = ["//:package_metadata"])

go_library(
    name = "installer_lib",
    srcs = ["main.go"],
    importpath = "github.com/DataDog/datadog-agent/cmd/installer",
    visibility = ["//visibility:private"],
    deps = [
        "//cmd/installer/command",
        "//cmd/installer/subcommands",
        "//pkg/fleet/installer/commands",
        "//pkg/fleet/installer/errors",
        "@com_github_spf13_cobra//:cobra",
        "@org_uber_go_dig//:dig",
    ],
)

dd_agent_go_binary(
    name = "installer",
    srcs = select({
        "@platforms//os:windows": ["//cmd/installer/windows_resources:rsrc"],
        "//conditions:default": [],
    }),
    basename = select({
        "@platforms//os:windows": "datadog-installer",
        "//conditions:default": "",
    }),
    embed = [":installer_lib"],
    gc_linkopts = select({
        "@platforms//os:linux": [
            "-X",
            "github.com/DataDog/datadog-agent/pkg/util/defaultpaths.runPath=/opt/datadog-packages/run",
        ],
        "//conditions:default": [],
    }),
    gotags = INSTALLER_TAGS,
    pure = select({
        "@platforms//os:linux": "on",
        "//conditions:default": "auto",
    }),
    visibility = ["//visibility:public"],
)

# The packages of msgo's Linux (OpenSSL) and Windows (CNG) crypto backends, which FIPS builds link.
# A successful build is not sufficient proof that the FIPS code path was actually compiled
# in -- this checks the binary's symbol table.
_LINUX_FIPS_PACKAGE = "vendor/github.com/microsoft/go-crypto-openssl/openssl"

_WINDOWS_FIPS_PACKAGE = "github.com/microsoft/go-crypto-winnative"

check_for_symbols_test(
    name = "installer_fips_symbols_test",
    binary = ":installer",
    must_include = select({
        "//packages/agent:linux_fips": [_LINUX_FIPS_PACKAGE],
        "//packages/agent:windows_x86_64_fips": [_WINDOWS_FIPS_PACKAGE],
        "//conditions:default": [],
    }),
    must_not_include = select({
        "//packages/agent:linux_fips": [_WINDOWS_FIPS_PACKAGE],
        "//packages/agent:windows_x86_64_fips": [_LINUX_FIPS_PACKAGE],
        "//conditions:default": [
            _LINUX_FIPS_PACKAGE,
            _WINDOWS_FIPS_PACKAGE,
        ],
    }),
)

dd_agent_go_test(
    name = "installer_test",
    srcs = ["main_test.go"],
    embed = [":installer_lib"],
    deps = [
        "//pkg/fleet/installer/commands",
        "@com_github_spf13_cobra//:cobra",
        "@com_github_stretchr_testify//assert",
    ],
)
