## This file is overwritten upon Agent upgrade.
## To make modifications to the check configuration, copy this file
## to `telemetry.yaml` and make your changes on that file.

init_config:

instances:
  -

    ## @param internal_telemetry - mapping - optional
    ## Report the Agent's own internal telemetry as `datadog.agent.*` metrics, read directly
    ## from the in-process telemetry registry.
    ##
    ## This is the replacement for the `go_expvar` check instance described in
    ## `conf.d/go_expvar.d/agent_stats.yaml.example`: it covers the same signals without
    ## scraping the expvar HTTP endpoint. Unlike the metrics this check always reports, these
    ## are indexed custom metrics.
    #
    # internal_telemetry:

      ## @param enabled - boolean - optional - default: false
      ## Report the curated set of internal telemetry metrics covering the forwarder,
      ## DogStatsD, the aggregator, the check scheduler, and the logs agent.
      #
      # enabled: false

      ## @param advanced - boolean - optional - default: false
      ## Report every metric registered in the internal telemetry registry instead of the
      ## curated set. Implies `enabled`.
      ##
      ## The registry is large and its contents change between Agent versions, so this emits
      ## an unbounded number of custom metrics. Intended for debugging, not steady-state use.
      #
      # advanced: false
