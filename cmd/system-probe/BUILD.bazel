load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:go_binary.bzl", "dd_agent_go_binary")
load("//tasks:build_tags.bzl", "SYSTEM_PROBE_TAGS")

go_library(
    name = "system-probe_lib",
    srcs = [
        "main.go",
        "main_windows.go",
    ],
    importpath = "github.com/DataDog/datadog-agent/cmd/system-probe",
    visibility = ["//visibility:private"],
    deps = select({
        "@rules_go//go/platform:aix": [
            "//cmd/internal/runcmd",
            "//cmd/system-probe/command",
            "//cmd/system-probe/subcommands",
            "//pkg/util/flavor",
        ],
        "@rules_go//go/platform:android": [
            "//cmd/internal/runcmd",
            "//cmd/system-probe/command",
            "//cmd/system-probe/subcommands",
            "//pkg/util/flavor",
        ],
        "@rules_go//go/platform:darwin": [
            "//cmd/internal/runcmd",
            "//cmd/system-probe/command",
            "//cmd/system-probe/subcommands",
            "//pkg/util/flavor",
        ],
        "@rules_go//go/platform:dragonfly": [
            "//cmd/internal/runcmd",
            "//cmd/system-probe/command",
            "//cmd/system-probe/subcommands",
            "//pkg/util/flavor",
        ],
        "@rules_go//go/platform:freebsd": [
            "//cmd/internal/runcmd",
            "//cmd/system-probe/command",
            "//cmd/system-probe/subcommands",
            "//pkg/util/flavor",
        ],
        "@rules_go//go/platform:illumos": [
            "//cmd/internal/runcmd",
            "//cmd/system-probe/command",
            "//cmd/system-probe/subcommands",
            "//pkg/util/flavor",
        ],
        "@rules_go//go/platform:ios": [
            "//cmd/internal/runcmd",
            "//cmd/system-probe/command",
            "//cmd/system-probe/subcommands",
            "//pkg/util/flavor",
        ],
        "@rules_go//go/platform:linux": [
            "//cmd/internal/runcmd",
            "//cmd/system-probe/command",
            "//cmd/system-probe/subcommands",
            "//pkg/util/flavor",
        ],
        "@rules_go//go/platform:netbsd": [
            "//cmd/internal/runcmd",
            "//cmd/system-probe/command",
            "//cmd/system-probe/subcommands",
            "//pkg/util/flavor",
        ],
        "@rules_go//go/platform:openbsd": [
            "//cmd/internal/runcmd",
            "//cmd/system-probe/command",
            "//cmd/system-probe/subcommands",
            "//pkg/util/flavor",
        ],
        "@rules_go//go/platform:solaris": [
            "//cmd/internal/runcmd",
            "//cmd/system-probe/command",
            "//cmd/system-probe/subcommands",
            "//pkg/util/flavor",
        ],
        "@rules_go//go/platform:windows": [
            "//cmd/internal/runcmd",
            "//cmd/system-probe/command",
            "//cmd/system-probe/subcommands",
            "//cmd/system-probe/windows/service",
            "//pkg/util/flavor",
            "//pkg/util/log",
            "//pkg/util/winutil/servicemain",
        ],
        "//conditions:default": [],
    }),
)

dd_agent_go_binary(
    name = "system-probe",
    # keep
    srcs = select({
        "@platforms//os:windows": ["//cmd/system-probe/windows_resources:rsrc"],
        "//conditions:default": [],
    }),
    # keep
    cdeps = select({
        "@platforms//os:linux": ["//:datadog_agent_map"],
        "//conditions:default": [],
    }),
    # keep
    cgo = select({
        "@platforms//os:linux": True,
        "@platforms//os:windows": True,
        "//conditions:default": False,
    }),
    embed = [":system-probe_lib"],
    # go-nvml forces --export-dynamic: only export nvml* symbols. Lazy binding
    # keeps NVML loadable on distributions that link with bind-now.
    gc_linkopts = select({
        "@platforms//os:linux": [
            "-extldflags",
            "-Wl,--version-script=datadog-agent.map -Wl,-z,lazy",
        ],
        "//conditions:default": [],
    }),
    gotags = SYSTEM_PROBE_TAGS,
    visibility = ["//visibility:public"],
)
