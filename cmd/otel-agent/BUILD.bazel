load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:go_binary.bzl", "dd_agent_go_binary")
load("//tasks:build_tags.bzl", "OTEL_AGENT_TAGS")

# gazelle:dd_agent_go_test on

go_library(
    name = "otel-agent_lib",
    srcs = ["main.go"],
    importpath = "github.com/DataDog/datadog-agent/cmd/otel-agent",
    visibility = ["//visibility:private"],
    deps = [
        "//cmd/internal/runcmd",
        "//cmd/otel-agent/command",
        "//comp/logs-library/metrics",
        "//pkg/util/flavor",
        "//pkg/version",
    ],
)

dd_agent_go_binary(
    name = "otel-agent",
    embed = [":otel-agent_lib"],
    gotags = OTEL_AGENT_TAGS,
    visibility = ["//visibility:public"],
)
