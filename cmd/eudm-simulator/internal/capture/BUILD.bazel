        "//pkg/tagset",
        "//pkg/telemetrycapture",
        "@com_github_datadog_agent_payload_v5//process",
        "@com_github_gogo_protobuf//proto",
    ],
)

dd_agent_go_test(
    name = "capture_test",
    srcs = [
        "inventory_test.go",
        "normalize_test.go",
        "software_test.go",
    ],
    embed = [":capture"],
    deps = [
        "//pkg/inventory/software",
        "//pkg/metrics",
        "//pkg/tagset",
        "//pkg/telemetrycapture",
        "@com_github_datadog_agent_payload_v5//process",
        "@com_github_gogo_protobuf//proto",
    ],
)
