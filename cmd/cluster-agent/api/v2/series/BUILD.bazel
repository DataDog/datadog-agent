load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "series",
    srcs = [
        "doc.go",
        "job.go",
        "series.go",
        "series_nocompile.go",
    ],
    importpath = "github.com/DataDog/datadog-agent/cmd/cluster-agent/api/v2/series",
    visibility = ["//visibility:public"],
    deps = [
        "//comp/core/config",
        "//comp/core/telemetry/def",
        "//comp/core/telemetry/impl",
        "//pkg/clusteragent/api",
        "//pkg/clusteragent/autoscaling/workload/loadstore",
        "//pkg/util/log",
        "//pkg/zstd",
        "@com_github_datadog_agent_payload_v5//gogen",
        "@io_k8s_client_go//util/workqueue",
        "@org_golang_x_time//rate",
    ],
)

dd_agent_go_test(
    name = "series_test",
    srcs = ["job_test.go"],
    embed = [":series"],
    gotags_sets = [[
        "cel",
        "clusterchecks",
        "kubeapiserver",
        "kubelet",
    ]],
    include_default = False,
    deps = [
        "@com_github_datadog_agent_payload_v5//gogen",
        "@io_k8s_client_go//util/workqueue",
    ],
)
