load("@package_metadata//rules:package_metadata.bzl", "package_metadata")
load("@rules_go//go:def.bzl", "go_library")
load("@rules_license//rules:license.bzl", "license")
load("//bazel/rules/go:go_binary.bzl", "dd_agent_go_binary")
load("//compliance/rules:purl.bzl", "purl_for_golang")

# The connector carries its own BSD-3-Clause license (RapDev.IO), shipped as
# LICENSES/secret-generic-connector-LICENSE.
package(default_package_metadata = [":package_metadata"])

package_metadata(
    name = "package_metadata",
    attributes = [":license"],
    purl = purl_for_golang("github.com/DataDog/datadog-agent", subpath = "cmd/secret-generic-connector"),
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
    license_text = "LICENSE",
)

go_library(
    name = "secret-generic-connector_lib",
    srcs = ["main.go"],
    importpath = "github.com/DataDog/datadog-agent/cmd/secret-generic-connector",
    visibility = ["//visibility:private"],
    deps = [
        "//cmd/secret-generic-connector/backend",
        "//cmd/secret-generic-connector/secret",
        "//pkg/fips",
    ],
)

dd_agent_go_binary(
    name = "secret-generic-connector",
    srcs = select({
        "@platforms//os:windows": ["//cmd/secret-generic-connector/windows_resources:rsrc"],
        "//conditions:default": [],
    }),
    embed = [":secret-generic-connector_lib"],
    pure = select({
        "//packages/agent:linux_default": "on",
        "//conditions:default": "auto",
    }),
    visibility = ["//visibility:public"],
    x_defs = {"github.com/DataDog/datadog-agent/cmd/secret-generic-connector.appVersion": "{agent_version}"},
)
