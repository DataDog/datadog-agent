load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:go_binary.bzl", "dd_agent_go_binary")

go_library(
    name = "cws-instrumentation_lib",
    srcs = [
        "main_linux.go",
        "main_windows.go",
    ],
    importpath = "github.com/DataDog/datadog-agent/cmd/cws-instrumentation",
    visibility = ["//visibility:private"],
    deps = select({
        "@rules_go//go/platform:android": [
            "//cmd/cws-instrumentation/command",
            "//cmd/cws-instrumentation/subcommands",
        ],
        "@rules_go//go/platform:linux": [
            "//cmd/cws-instrumentation/command",
            "//cmd/cws-instrumentation/subcommands",
        ],
        "//conditions:default": [],
    }),
)

dd_agent_go_binary(
    name = "cws-instrumentation",
    embed = [":cws-instrumentation_lib"],
    # keep - This has a main_windows, but is really not implemented.
    target_compatible_with = ["@platforms//os:linux"],
    visibility = ["//visibility:public"],
)

# Matches `dda inv cws-instrumentation.build --injector-only`: adds the
# cws_instrumentation_injector_only gotag to strip everything but the
# injector subcommand.
dd_agent_go_binary(
    name = "cws-instrumentation-injector-only",
    embed = [":cws-instrumentation_lib"],
    gotags = set(["cws_instrumentation_injector_only"]),
    # keep - This has a main_windows, but is really not implemented.
    target_compatible_with = ["@platforms//os:linux"],
    visibility = ["//visibility:public"],
)
