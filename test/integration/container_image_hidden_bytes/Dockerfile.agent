# ARM64 QA base: supplies the shared libraries needed by the locally built Agent.
FROM public.ecr.aws/datadog/agent@sha256:cd0ba1ba6c8c1afccb274eb80f4d4db50d2b664f965ef25c5141b1cf5777fd9a
USER root
COPY bin/agent/agent /opt/hidden-bytes/agent
ENTRYPOINT ["/opt/hidden-bytes/agent"]
CMD ["run", "-c", "/etc/hidden-bytes/datadog.yaml"]
