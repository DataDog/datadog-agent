    name = "connector",
    embed = [":connector_lib"],
    # keep
    target_compatible_with = select({
        "@platforms//os:windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
)

platform_transition_filegroup(
    name = "connector_linux_arm64",
    srcs = [":connector"],
    tags = ["manual"],
    target_platform = "//bazel/platforms:linux_arm64",
)

pkg_files(
    name = "connector_linux_arm64_exe",
    srcs = [":connector_linux_arm64"],
    attributes = pkg_attributes(mode = "0755"),
    renames = {":connector_linux_arm64": "connector-arm64"},
    tags = ["manual"],
)

pkg_install(
    name = "install_linux_arm64",
    srcs = [":connector_linux_arm64_exe"],
    tags = ["manual"],
)

