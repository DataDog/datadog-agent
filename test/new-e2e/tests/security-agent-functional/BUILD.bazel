load("@rules_pkg//pkg:install.bzl", "pkg_install")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")
load("//bazel/rules/windows_testsuites:defs.bzl", "windows_testsuites")

dd_agent_go_test(
    name = "security-agent-functional_test",
    srcs = ["security_agent_test.go"],
    tags = ["manual"],
    deps = [
        "//pkg/util/testutil/flake",
        "//test/e2e-framework/components/os",
        "//test/e2e-framework/scenarios/aws/ec2",
        "//test/e2e-framework/testing/e2e",
        "//test/e2e-framework/testing/environments",
        "//test/e2e-framework/testing/provisioners/aws/host",
        "//test/new-e2e/tests/windows",
        "//test/new-e2e/tests/windows/common/agent",
        "@com_github_stretchr_testify//require",
    ],
)

windows_testsuites(
    name = "windows_testsuites",
    testonly = True,
    tests = {
        "//pkg/security/probe:probe_test_functionaltests": "etw/testsuite.exe",
        "//pkg/security/tests:tests_test_bpf_functionaltests": "testsuite.exe",
    },
)

pkg_install(
    name = "install_windows_testsuites",
    testonly = True,
    srcs = [":windows_testsuites"],
)
