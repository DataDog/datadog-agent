{
  "/etc/datadog-agent/datadog.yaml": {
    "api_key": "set-by-test",
    "secret_backend_command": "/tmp/fa-metadata-secrets.py",
    "enable_metadata_collection": true,
    "inventories_enabled": true,
    "inventories_configuration_enabled": true,
    "inventories_checks_configuration_enabled": true,
    "remote_configuration": {
      "enabled": false
    },
    "proxy": {
      "http": "set-by-test",
      "no_proxy": [
        "*"
      ]
    },
    "logs_enabled": false,
    "logs_config": {
      "api_key": "set-by-test",
      "logs_dd_url": "127.0.0.1:18081",
      "use_http": true,
      "logs_no_ssl": true
    },
    "apm_config": {
      "enabled": false,
      "apm_dd_url": "http://127.0.0.1:18081",
      "debugger_api_key": "set-by-test"
    },
    "process_config": {
      "process_collection": {
        "enabled": false
      }
    },
    "no_proxy_nonexact_match": true,
    "inventories_first_run_delay": 5,
    "inventories_min_interval": 10,
    "inventories_max_interval": 20
  },
  "/etc/datadog-agent/system-probe.yaml": {
    "system_probe_config": {
      "enabled": true,
      "internal_profiling": {
        "enabled": false,
        "api_key": "set-by-test"
      }
    },
    "network_config": {
      "enabled": true
    }
  },
  "/etc/datadog-agent/security-agent.yaml": {
    "security_agent": {
      "internal_profiling": {
        "enabled": false,
        "api_key": "set-by-test"
      }
    },
    "compliance_config": {
      "enabled": true,
      "run_in_system_probe": false
    },
    "runtime_security_config": {
      "enabled": false
    }
  },
  "/etc/datadog-agent/conf.d/http_check.d/fa-secrets.yaml": {
    "init_config": {},
    "instances": [
      {
        "name": "fa-secret-http",
        "url": "http://127.0.0.1:9",
        "username": "fixture",
        "password": "set-by-test",
        "headers": {
          "Authorization": "set-by-test"
        },
        "timeout": 2,
        "min_collection_interval": 30
      },
      {
        "name": "fa-secret-http-second-instance",
        "url": "http://127.0.0.1:9",
        "username": "fixture",
        "password": "set-by-test",
        "timeout": 2,
        "min_collection_interval": 30
      }
    ]
  },
  "/etc/datadog-agent/conf.d/postgres.d/fa-secrets.yaml": {
    "init_config": {},
    "instances": [
      {
        "host": "127.0.0.1",
        "port": 15432,
        "username": "fixture",
        "password": "set-by-test",
        "dbname": "postgres",
        "connect_timeout": 2,
        "min_collection_interval": 30
      }
    ]
  },
  "/etc/datadog-agent/conf.d/mysql.d/fa-secrets.yaml": {
    "init_config": {},
    "instances": [
      {
        "host": "127.0.0.1",
        "port": 13306,
        "username": "fixture",
        "password": "set-by-test",
        "connect_timeout": 2,
        "min_collection_interval": 30
      }
    ]
  },
  "/etc/datadog-agent/conf.d/redisdb.d/fa-secrets.yaml": {
    "init_config": {},
    "instances": [
      {
        "host": "127.0.0.1",
        "port": 16379,
        "password": "set-by-test",
        "socket_timeout": 2,
        "min_collection_interval": 30
      }
    ]
  },
  "/etc/datadog-agent/conf.d/rabbitmq.d/fa-secrets.yaml": {
    "init_config": {},
    "instances": [
      {
        "rabbitmq_api_url": "http://127.0.0.1:9/api/",
        "username": "fixture",
        "password": "set-by-test",
        "timeout": 2,
        "min_collection_interval": 30
      }
    ]
  },
  "/etc/datadog-agent/conf.d/mongo.d/fa-secrets.yaml": {
    "init_config": {},
    "instances": [
      {
        "hosts": [
          "127.0.0.1:17017"
        ],
        "username": "fixture",
        "password": "set-by-test",
        "database": "admin",
        "timeout": 2,
        "min_collection_interval": 30
      }
    ]
  },
  "/etc/datadog-agent/conf.d/elastic.d/fa-secrets.yaml": {
    "init_config": {},
    "instances": [
      {
        "url": "http://127.0.0.1:18081/elastic",
        "username": "fixture",
        "password": "set-by-test",
        "timeout": 2,
        "min_collection_interval": 30
      }
    ]
  },
  "/etc/datadog-agent/conf.d/openmetrics.d/fa-secrets.yaml": {
    "init_config": {},
    "instances": [
      {
        "openmetrics_endpoint": "http://127.0.0.1:18081/metrics",
        "namespace": "fa_secret_fixture",
        "metrics": [
          "fixture_requests_total"
        ],
        "headers": {
          "Authorization": "set-by-test"
        },
        "timeout": 2,
        "min_collection_interval": 30
      }
    ]
  },
  "/etc/datadog-agent/conf.d/http_check.d/fa-secrets-second.yaml": {
    "init_config": {},
    "instances": [
      {
        "name": "fa-secret-http-second-file",
        "url": "http://127.0.0.1:9",
        "username": "fixture",
        "password": "set-by-test",
        "timeout": 2,
        "min_collection_interval": 30
      }
    ]
  }
}
