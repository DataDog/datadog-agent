{
  "/etc/datadog-agent/datadog.yaml": {
    "api_key": "ENC[metadata_core]",
    "secret_backend_command": "/tmp/fa-metadata-secrets.py",
    "enable_metadata_collection": true,
    "inventories_enabled": true,
    "inventories_configuration_enabled": true,
    "inventories_checks_configuration_enabled": true,
    "remote_configuration": {
      "enabled": false
    },
    "logs_enabled": false,
    "logs_config": {
      "api_key": "fixture-raw-secret-value",
      "logs_dd_url": "127.0.0.1:18081",
      "use_http": true,
      "logs_no_ssl": true
    },
    "apm_config": {
      "enabled": false,
      "apm_dd_url": "http://127.0.0.1:18081",
      "debugger_api_key": "fixture-raw-secret-value"
    },
    "process_config": {
      "process_collection": {
        "enabled": false
      }
    },
    "no_proxy_nonexact_match": true,
    "inventories_first_run_delay": 5,
    "inventories_min_interval": 10,
    "inventories_max_interval": 20,
    "additional_endpoints": {
      "http://127.0.0.1:18081": [
        "fixture-raw-secret-value",
        "ENC[metadata_core]"
      ]
    },
    "snmp_traps": {
      "enabled": false,
      "community_strings": [
        "fixture-raw-secret-value",
        "ENC[metadata_community]"
      ]
    }
  },
  "/etc/datadog-agent/system-probe.yaml": {
    "system_probe_config": {
      "enabled": true,
      "internal_profiling": {
        "enabled": false,
        "api_key": "fixture-raw-secret-value"
      }
    },
    "network_config": {
      "enabled": true
    }
  },
  "/etc/datadog-agent/security-agent.yaml": {
    "security_agent": {
      "internal_profiling": {
        "enabled": false,
        "api_key": "ENC[metadata_security]"
      }
    },
    "compliance_config": {
      "enabled": true,
      "run_in_system_probe": false
    },
    "runtime_security_config": {
      "enabled": false
    }
  },
  "/etc/datadog-agent/application_monitoring.yaml": {
    "api_key": "fixture-raw-secret-value"
  },
  "/etc/datadog-agent/conf.d/http_check.d/fa-secrets.yaml": {
    "init_config": {
      "password": "ENC[metadata_http_shared]"
    },
    "instances": [
      {
        "name": "fa-secret-http",
        "url": "http://127.0.0.1:9",
        "username": "fixture",
        "password": "ENC[metadata_http_shared]",
        "timeout": 2,
        "min_collection_interval": 30,
        "headers": {
          "Authorization": "fixture-raw-secret-value"
        }
      },
      {
        "name": "fa-secret-http-second-instance",
        "url": "http://127.0.0.1:9",
        "username": "fixture",
        "password": "ENC[metadata_http_shared]",
        "timeout": 2,
        "min_collection_interval": 30
      }
    ]
  },
  "/etc/datadog-agent/conf.d/http_check.d/fa-secrets-second.yaml": {
    "init_config": {},
    "instances": [
      {
        "name": "fa-secret-http-second-file",
        "url": "http://127.0.0.1:9",
        "username": "fixture",
        "password": "ENC[metadata_http_shared]",
        "timeout": 2,
        "min_collection_interval": 30
      }
    ]
  }
}
