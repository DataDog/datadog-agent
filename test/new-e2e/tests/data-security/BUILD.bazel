load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

# gazelle:exclude parse.go
# gazelle:exclude postgres_provisioner.go

# parse.go and postgres_provisioner.go are excluded above (they use test-only
# symbols), so they are listed in the go_test srcs and their deps kept by hand.
