load("@rules_go//go:def.bzl", "go_test")

# gazelle:exclude provisioner.go

# NOTE: provisioner.go references dockerPermissionEnv, which is only defined in
# docker_permission_test.go. It cannot compile as a standalone (non-test)
# go_library, so it is built solely as part of the go_test target below.
go_test(
    name = "agent-health_test",
    srcs = [
        "admission_probe_test.go",
        "docker_permission_test.go",
        "helpers_test.go",
        "provisioner.go",  # keep
        "resilience_test.go",
    ],
    # keep
    data = [
        "fixtures/admission_probe_helm_values.yaml",
        "fixtures/docker-compose.busybox.yaml",
        "fixtures/docker_permission_agent_config.yaml",
        "fixtures/resilience_agent_config.yaml",
    ],
    embedsrcs = [
        "fixtures/admission_probe_helm_values.yaml",
        "fixtures/resilience_agent_config.yaml",
    ],
    gotags = ["test"],
    importpath = "github.com/DataDog/datadog-agent/test/new-e2e/tests/agent-health",
    tags = ["manual"],  # need pulumi installed.
    # keep
    deps = [
        "//test/e2e-framework/components/datadog/agent",
        "//test/e2e-framework/components/datadog/agentparams",
        "//test/e2e-framework/components/datadog/kubernetesagentparams",
        "//test/e2e-framework/components/docker",
        "//test/e2e-framework/resources/aws",
        "//test/e2e-framework/scenarios/aws/ec2",
        "//test/e2e-framework/scenarios/aws/fakeintake",
        "//test/e2e-framework/scenarios/aws/kindvm",
        "//test/e2e-framework/testing/components",
        "//test/e2e-framework/testing/e2e",
        "//test/e2e-framework/testing/environments",
        "//test/e2e-framework/testing/provisioners",
        "//test/e2e-framework/testing/provisioners/aws/host",
        "//test/e2e-framework/testing/provisioners/aws/kubernetes/kindvm",
        "//test/fakeintake/aggregator",
        "@com_github_datadog_agent_payload_v5//healthplatform",
        "@com_github_pulumi_pulumi_sdk_v3//go/pulumi",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
        "@io_k8s_api//core/v1:core",
        "@io_k8s_apimachinery//pkg/apis/meta/v1:meta",
    ],
)
