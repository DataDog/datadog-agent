# Guest role: a system-probe standing in for one inside a micro VM. Its only
# channel is vsock to the forwarder. Mirrors what datadog-operator sets with
# global.useVSock (datadog-operator#3186): DD_SYSTEM_PROBE_CONFIG_CORE_AGENT_IPC_ENABLED
# alone has to cut every path to the core agent, so nothing else here (remote
# configuration, remote agent registry, config stream) is turned off separately.
#
# Every socket, the log file and the policies are moved under /tmp so the two
# system-probe processes on this host cannot collide.
DD_HOSTNAME=terrapin
DD_LOG_LEVEL=debug
DD_SYSTEM_PROBE_ORIGIN=kata-containers
DD_SYSTEM_PROBE_CONFIG_LOG_FILE=/tmp/system-probe.log
DD_SYSTEM_PROBE_CONFIG_SYSPROBE_SOCKET=/tmp/sysprobe.sock
DD_SYSPROBE_SOCKET=/tmp/sysprobe.sock
DD_EVENT_MONITORING_CONFIG_SOCKET=/tmp/evt.sock
DD_VSOCK_ADDR=host
DD_RUNTIME_SECURITY_CONFIG_ENABLED=true
DD_RUNTIME_SECURITY_CONFIG_SOCKET=vsock:5020
DD_RUNTIME_SECURITY_CONFIG_EVENT_GRPC_SERVER=security-agent
DD_RUNTIME_SECURITY_CONFIG_CMD_SOCKET=/tmp/wp-cmd.sock
DD_RUNTIME_SECURITY_CONFIG_POLICIES_DIR=/tmp/sysprobe-guest-policies
DD_RUNTIME_SECURITY_CONFIG_ENV_AS_TAGS=DD_SYSTEM_PROBE_ORIGIN
DD_RUNTIME_SECURITY_CONFIG_ACTIVITY_DUMP_ENABLED=false
DD_RUNTIME_SECURITY_CONFIG_ACTIVITY_DUMP_LOCAL_STORAGE_OUTPUT_DIRECTORY=/tmp
DD_RUNTIME_SECURITY_CONFIG_SECURITY_PROFILE_ENABLED=false
DD_SYSTEM_PROBE_CONFIG_CORE_AGENT_IPC_ENABLED=false
