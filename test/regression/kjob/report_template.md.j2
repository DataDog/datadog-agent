{#- PR comment for the single_machine_performance-kjob CI job, rendered by `smp kjob report --template-file`.
    The pr-commenter service adds the "K8s Regression Detector Results" header, so this template has no header line.
    GitHub renders Markdown after an HTML block only after a blank line, so keep a blank line around each <details> block. -#}
{#- Show the error of a failed replicate on its failure line when the report has no more than this number of errors. -#}
{% set inline_error_limit = 3 %}
{#- Cut an error on a failure line after this number of characters. "Run errors" then shows the full text. -#}
{% set error_length_limit = 200 %}
{#- When all checks use memory series, the column headers show the unit and the cells show only numbers. -#}
{% set units = namespace(memory_only=true) %}
{% if report is not none %}
{% for experiment in report.experiments %}
{% for check in experiment.checks %}
{% if not ("target.memory." in check.series and "_bytes" in check.series) %}
{% set units.memory_only = false %}
{% endif %}
{% endfor %}
{% endfor %}
{% endif %}
{% macro number(value, series, whole) -%}
{% if whole and "target.memory." in series and "_bytes" in series and value % 1048576 == 0 -%}
{{ (value // 1048576) | int }}{% if not units.memory_only %} MiB{% endif %}
{%- elif units.memory_only -%}
{{ value | kjob_value(series) | replace(" MiB", "") }}
{%- else -%}
{{ value | kjob_value(series) }}
{%- endif %}
{%- endmacro %}
{% macro bound(check) -%}
{% if check.lower_bound is not none and check.upper_bound is not none -%}
{{ number(check.lower_bound, check.series, true) }} – {{ number(check.upper_bound, check.series, true) }}
{%- elif check.upper_bound is not none -%}
≤ {{ number(check.upper_bound, check.series, true) }}
{%- elif check.lower_bound is not none -%}
≥ {{ number(check.lower_bound, check.series, true) }}
{%- else -%}
unavailable
{%- endif %}
{%- endmacro %}
{% macro observed(check, value) -%}
{% if value is not none -%}
{{ number(value, check.series, false) }}
{%- elif "no_data" in check.reasons -%}
no data
{%- else -%}
unavailable
{%- endif %}
{%- endmacro %}
{% macro hidden_checks(experiment) -%}
{% set hidden = namespace(count=0) %}
{% for check in experiment.checks if not check.passed and check.reasons == ["evaluation_unavailable"] and check.expected_replicates - check.passed_replicates <= experiment.replicates_failed %}
{% set hidden.count = hidden.count + 1 %}
{% endfor %}
{% if hidden.count == 1 %} (1 check has no result){% elif hidden.count > 1 %} ({{ hidden.count }} checks have no result){% endif %}
{%- endmacro %}
{#- The cell shows the series without the target.memory. prefix. A tooltip shows the full series. -#}
{% macro metric(series) -%}
{% if series is startingwith("target.memory.") -%}
<abbr title="{{ series | e }}">`{{ series[14:] }}`</abbr>
{%- else -%}
`{{ series }}`
{%- endif %}
{%- endmacro %}
{{ summary }}
{% if report is not none %}
{% set errors = namespace(count=0, collapsed=false) %}
{#- "Run errors" shows when the failure lines show only counts, or when they cut an error. -#}
{% for experiment in report.experiments %}
{% set errors.count = errors.count + experiment.failures | length %}
{% endfor %}
{% set failures = namespace(lines=[]) %}
{% for experiment in report.experiments %}
{% if experiment.replicates_failed > 0 %}
{% if errors.count <= inline_error_limit and experiment.failures | length == experiment.replicates_failed %}
{% for failure in experiment.failures %}
{% set error = (failure.error or "no execution error detail is available") | replace("\n", " ") %}
{% if error | length > error_length_limit %}
{#- A tooltip shows the full error. "Run errors" also shows it, for readers without tooltips. -#}
{% set errors.collapsed = true %}
{% set error_html = "<abbr title=\"" ~ (error | e) ~ "\"><code>" ~ (error[:error_length_limit] | e) ~ "…</code></abbr>" %}
{% else %}
{% set error_html = "<code>" ~ (error | e) ~ "</code>" %}
{% endif %}
{% set failures.lines = failures.lines + ["- ❌ `" ~ experiment.name ~ "` replicate " ~ failure.replicate_index ~ " did not complete" ~ hidden_checks(experiment) ~ ": " ~ error_html] %}
{% endfor %}
{% else %}
{% set errors.collapsed = true %}
{% set failures.lines = failures.lines + ["- ❌ `" ~ experiment.name ~ "`: " ~ experiment.replicates_failed ~ " of " ~ experiment.replicates_expected ~ " replicates did not complete" ~ hidden_checks(experiment)] %}
{% endif %}
{% endif %}
{% for check in experiment.checks if not check.passed %}
{#- The replicate line above covers a check that has no result only because its replicates did not complete. -#}
{% if not (check.reasons == ["evaluation_unavailable"] and check.expected_replicates - check.passed_replicates <= experiment.replicates_failed) %}
{% set failures.lines = failures.lines + ["- ❌ `" ~ experiment.name ~ "`: `" ~ check.name ~ "` failed in " ~ (check.expected_replicates - check.passed_replicates) ~ " of " ~ check.expected_replicates ~ " replicates, " ~ (check | kjob_relation)] %}
{% endif %}
{% endfor %}
{% endfor %}
{% if failures.lines %}

{% for line in failures.lines %}
{{ line }}
{% endfor %}
{% endif %}
{% if errors.collapsed and errors.count > 0 %}

<details>
<summary>Run errors ({{ errors.count }})</summary>

{% for experiment in report.experiments %}
{% for failure in experiment.failures %}
- `{{ experiment.name }}` replicate {{ failure.replicate_index }}: <code>{{ (failure.error or "no execution error detail is available") | replace("\n", " ") | e }}</code>
{% endfor %}
{% endfor %}

</details>
{% endif %}

<details>
<summary>Detailed Bounds Checks ({{ report.experiments | length }} experiment{% if report.experiments | length != 1 %}s{% endif %})</summary>

{% if rows %}
{% set unit = " (MiB)" if units.memory_only else "" %}
{#- Failed rows come first. Inside each group, the rows keep the order of the report. -#}
{% set table = namespace(rows=[]) %}
{% for passed in [false, true] %}
{% for experiment in report.experiments %}
{% for check in experiment.checks if check.passed == passed %}
{% set table.rows = table.rows + [{
    "result": ("✅ " if check.passed else "❌ ") ~ check.passed_replicates ~ "/" ~ check.expected_replicates,
    "experiment": "`" ~ experiment.name ~ "`",
    "check": "`" ~ check.name ~ "`",
    "metric": metric(check.series) | replace("|", "\\|"),
    "bound": bound(check),
    "min_observed": observed(check, check.min_observed),
    "max_observed": observed(check, check.max_observed),
}] %}
{% endfor %}
{% endfor %}
{% endfor %}
{{ table.rows | table([["result", "result"], ["experiment", "experiment"], ["check", "check"], ["metric", "metric"], ["bound" ~ unit, "bound"], ["min observed" ~ unit, "min_observed"], ["max observed" ~ unit, "max_observed"]]) }}
{% if experiments_without_checks %}

Experiments without bounds checks: {% for name in experiments_without_checks %}`{{ name }}`{% if not loop.last %}, {% endif %}{% endfor %}

{% endif %}
{% else %}
There are no bounds checks in the experiments run.
{% endif %}

</details>
{% endif %}

