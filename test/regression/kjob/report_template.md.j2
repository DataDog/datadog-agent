{#- PR comment of the KJob CI jobs, rendered by `smp kjob report --template-file`.
    The pr-commenter service adds the "K8s Regression Detector Results" header, so this template has no header line.
    GitHub renders Markdown after an HTML block only after a blank line, so keep a blank line around each <details> block. -#}
{#- Show the error of a failed replicate on its failure line when the report has no more than this number of errors. -#}
{% set inline_error_limit = 3 %}
{#- Cut an error on a failure line after this number of characters. "Run errors" then shows the full text. -#}
{% set error_length_limit = 200 %}
{#- Each cell shows its unit, because checks can use different units. A whole MiB bound has no decimals. -#}
{% macro number(value, series, whole) -%}
{% if whole and "target.memory." in series and "_bytes" in series and value % 1048576 == 0 -%}
{{ (value // 1048576) | int }} MiB
{%- else -%}
{{ value | kjob_value(series) }}
{%- endif %}
{%- endmacro %}
{% macro bound(check) -%}
{% if check.lower_bound is not none and check.upper_bound is not none -%}
{{ number(check.lower_bound, check.series, true) }} – {{ number(check.upper_bound, check.series, true) }}
{%- elif check.upper_bound is not none -%}
≤ {{ number(check.upper_bound, check.series, true) }}
{%- elif check.lower_bound is not none -%}
≥ {{ number(check.lower_bound, check.series, true) }}
{%- else -%}
unavailable
{%- endif %}
{%- endmacro %}
{% macro observed(check, value) -%}
{% if value is not none -%}
{{ number(value, check.series, false) }}
{%- elif "no_data" in check.reasons -%}
no data
{%- else -%}
unavailable
{%- endif %}
{%- endmacro %}
{{ summary }}
{% if report is not none %}
{% set inline = execution_failures | length <= inline_error_limit %}
{% set errors = namespace(cut=false) %}
{% if failure_lines %}

{% endif %}
{% for experiment in report.experiments %}
{#- A check that has no result only because its replicates did not complete gets no line of its own. -#}
{% set hidden = namespace(names=[]) %}
{% for check in experiment.checks if not check.passed and check.reasons == ["evaluation_unavailable"] and check.expected_replicates - check.passed_replicates <= experiment.replicates_failed %}
{% set hidden.names = hidden.names + [check.name] %}
{% endfor %}
{% set hidden_text %}{% if hidden.names | length == 1 %} (1 check has no result){% elif hidden.names %} ({{ hidden.names | length }} checks have no result){% endif %}{% endset %}
{% if inline %}
{% for failure in execution_failures if failure.experiment == experiment.name %}
{% set error = failure.error | replace("\n", " ") %}
{% if error | length > error_length_limit %}{% set errors.cut = true %}{% endif %}
- ❌ `{{ experiment.name }}` replicate {{ failure.replicate_index }} did not complete{{ hidden_text }}: <code>{{ error[:error_length_limit] | e }}{% if error | length > error_length_limit %}…{% endif %}</code>
{% endfor %}
{% elif experiment.replicates_failed > 0 %}
- ❌ `{{ experiment.name }}`: {{ experiment.replicates_failed }} of {{ experiment.replicates_expected }} replicates did not complete{{ hidden_text }}
{% endif %}
{% for check in experiment.checks if not check.passed and check.name not in hidden.names %}
- ❌ `{{ experiment.name }}`: `{{ check.name }}` failed in {{ check.expected_replicates - check.passed_replicates }} of {{ check.expected_replicates }} replicates, {{ check | kjob_relation }}
{% endfor %}
{% endfor %}
{#- "Run errors" shows the full errors when the failure lines show only counts, or when they cut an error. -#}
{% if execution_failures and (not inline or errors.cut) %}

<details>
<summary>Run errors ({{ execution_failures | length }})</summary>

{% for failure in execution_failures %}
- `{{ failure.experiment }}` replicate {{ failure.replicate_index }}: <code>{{ failure.error | replace("\n", " ") | e }}</code>
{% endfor %}

</details>
{% endif %}

<details>
<summary>Detailed Bounds Checks ({{ report.experiments | length }} experiment{% if report.experiments | length != 1 %}s{% endif %})</summary>

{% if rows %}
{#- The cells have no code spans, because a code span makes a column wider. Failed rows come first. -#}
{% set table = namespace(rows=[]) %}
{% for passed in [false, true] %}
{% for experiment in report.experiments %}
{% for check in experiment.checks if check.passed == passed %}
{% set table.rows = table.rows + [{
    "result": ("✅ " if check.passed else "❌ ") ~ check.passed_replicates ~ "/" ~ check.expected_replicates,
    "experiment": experiment.name,
    "check": check.name,
    "metric": check.series | replace("target.", "") | replace("|", "\\|"),
    "bound": bound(check),
    "max_observed": ("**" ~ observed(check, check.max_observed) ~ "**") if (check.upper_bound is not none and check.max_observed is not none and check.max_observed > check.upper_bound) else observed(check, check.max_observed),
}] %}
{% endfor %}
{% endfor %}
{% endfor %}
{{ table.rows | table([["result", "result"], ["experiment", "experiment"], ["check", "check"], ["metric", "metric"], ["max", "max_observed"], ["bound", "bound"]]) }}
{% if experiments_without_checks %}

Experiments without bounds checks: {% for name in experiments_without_checks %}`{{ name }}`{% if not loop.last %}, {% endif %}{% endfor %}

{% endif %}
{% else %}
There are no bounds checks in the experiments run.
{% endif %}

</details>
{% endif %}

