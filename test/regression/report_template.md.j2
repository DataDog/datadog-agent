{#- smp-report-schema: 1 -#}
{#- Builtin template for markdown reports, matching the previous server-rendered version -#}
{#- For readability, sections are separated with '## <sectionTitle>' comments -#}
{%- set job = report.job -%}
{%- set start_ms = job.metrics_query_start * 1000 -%}
{%- set end_ms = job.metrics_query_end * 1000 -%}
{%- set filter_start = (job.metrics_query_start - 7200) * 1000 -%}
{%- set filter_end = (job.metrics_query_end + 3600) * 1000 -%}
{#- Experiments goals -#}
{%- set goals = report.experiments
    | selectattr("optimization_goal.result")
    | sort(attribute="optimization_goal.result.percent_change", reverse=true) -%}
{%- set xps_with_significant_changes = goals | selectattr("optimization_goal.result.is_significant_change") | rejectattr("erratic") | list -%}
{%- set regressions = xps_with_significant_changes | rejectattr("optimization_goal.result.is_improvement") | list -%}
{%- set xps_with_missing_results = report.experiments
    | selectattr("optimization_goal") | rejectattr("optimization_goal.result")
    | map(attribute="name") | sort | list -%}
{#- Bounds checks -#}
{%- set checks = report.experiments | build_unified_check_rows -%}
{%- set xps_with_crashed_replicates = report.failed_replicates
    | selectattr("replicate_type", "equalto", "non_profiling") | selectattr("is_dead")
    | map(attribute="experiment") | unique | sort | list -%}
{%- set xps_with_retried_replicates = report.failed_replicates
    | selectattr("replicate_type", "equalto", "non_profiling") | rejectattr("is_dead")
    | map(attribute="experiment") | unique | sort | list -%}
{%- set failed_replicates_grouped = report.failed_replicates | group_failed_executions_by_categories -%}

{#- Agent URL templates. Python selects names; Jinja resolves report values. -#}
{%- macro metrics_dashboard_link() -%}
[Metrics dashboard](https://app.datadoghq.com/dashboard/ykh-ua8-vcu/SMP-Regression-Detector-Metrics?fromUser=true&refresh_mode=paused&tpl_var_run-id%5B0%5D={{ job.id }}&view=spans&from_ts={{ start_ms }}&to_ts={{ end_ms }}&live=false)
