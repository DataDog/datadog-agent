{%- endmacro -%}
{%- macro debug_dashboard_link(rep) -%}
[Debug Dashboard](https://app.datadoghq.com/dashboard/zv5-qgi-m66/smp-failed-replicates?fromUser=true&refresh_mode=paused&tpl_var_experiment%5B0%5D={{ rep.experiment | urlencode }}&tpl_var_job_id%5B0%5D={{ job.id }}&tpl_var_replicate_type%5B0%5D={{ rep.replicate_type }}&tpl_var_variant%5B0%5D={{ rep.variant }}&from_ts={{ filter_start }}&to_ts={{ filter_end }}&live=false)
{%- endmacro -%}
{%- macro header_link(template_name) -%}
{%- if template_name == "metrics_dashboard" -%}{{ metrics_dashboard_link() }}
{%- elif template_name == "profiles" -%}{{ profiles_link() }}
{%- endif -%}
{%- endmacro -%}
{%- macro experiment_links(name, templates) -%}
{%- for template_name in templates -%}
{%- if not loop.first %} {% endif -%}
{%- if template_name == "logs" -%}{{ logs_link(name) }}
{%- elif template_name == "bounds_dashboard" -%}{{ bounds_dashboard_link(name) }}
{%- endif -%}
{%- endfor -%}
{%- endmacro -%}
{%- macro default_experiment_links(name) -%}
{{ experiment_links(name, extra.links.experiments[name].default) }}
{%- endmacro -%}
{%- macro debug_link(rep) -%}
{%- for template_name in extra.links.failed_replicates -%}
{%- if not loop.first %} {% endif -%}
{%- if template_name == "debug_dashboard" -%}{{ debug_dashboard_link(rep) }}{% endif -%}
