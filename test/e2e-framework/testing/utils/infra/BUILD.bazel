load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "infra",
    srcs = [
        "datadog_event_sender.go",
        "retriable_errors.go",
        "stack_manager.go",
    ],
    importpath = "github.com/DataDog/datadog-agent/test/e2e-framework/testing/utils/infra",
    visibility = ["//visibility:public"],
    deps = [
        "//test/e2e-framework/testing/runner",
        "//test/e2e-framework/testing/runner/parameters",
        "//test/e2e-framework/testing/utils/common",
        "@com_github_datadog_datadog_api_client_go_v2//api/datadog",
        "@com_github_datadog_datadog_api_client_go_v2//api/datadogV1",
        "@com_github_pulumi_pulumi_sdk_v3//go/auto",
        "@com_github_pulumi_pulumi_sdk_v3//go/auto/debug",
        "@com_github_pulumi_pulumi_sdk_v3//go/auto/optdestroy",
        "@com_github_pulumi_pulumi_sdk_v3//go/auto/optremove",
        "@com_github_pulumi_pulumi_sdk_v3//go/auto/optup",
        "@com_github_pulumi_pulumi_sdk_v3//go/common/tokens",
        "@com_github_pulumi_pulumi_sdk_v3//go/common/workspace",
        "@com_github_pulumi_pulumi_sdk_v3//go/pulumi",
    ],
)

dd_agent_go_test(
    name = "infra_test",
    size = "medium",
    srcs = ["stack_manager_test.go"],
    data = ["@pulumi//:cli"],
    embed = [":infra"],
    env = {"PULUMI_CLI": "$(rlocationpath @pulumi//:cli)"},
    deps = [
        "//test/e2e-framework/testing/utils/common",
        "@com_github_datadog_datadog_api_client_go_v2//api/datadogV1",
        "@com_github_pulumi_pulumi_sdk_v3//go/auto",
        "@com_github_pulumi_pulumi_sdk_v3//go/common/workspace",
        "@com_github_pulumi_pulumi_sdk_v3//go/pulumi",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
