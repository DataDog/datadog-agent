load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "binary",
    srcs = ["config.go"],
    importpath = "github.com/DataDog/datadog-agent/test/e2e-framework/cmd/internal/envconfig/binary",
    visibility = ["//test/e2e-framework/cmd:__subpackages__"],
    deps = [
        "//test/e2e-framework/cmd/internal/configschema",
        "@in_yaml_go_yaml_v3//:yaml",
    ],
)

dd_agent_go_test(
    name = "binary_test",
    srcs = ["config_test.go"],
    embed = [":binary"],
    deps = ["//test/e2e-framework/cmd/internal/configschema"],
)
