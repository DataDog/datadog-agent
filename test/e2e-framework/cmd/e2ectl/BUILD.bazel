load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "e2ectl_lib",
    srcs = [
        "commands.go",
        "discovery.go",
        "main.go",
    ],
    importpath = "github.com/DataDog/datadog-agent/test/e2e-framework/cmd/e2ectl",
    visibility = ["//visibility:private"],
    deps = [
        "//test/e2e-framework/cmd/e2ectl/internal/config",
        "//test/e2e-framework/cmd/e2ectl/internal/driver",
        "//test/e2e-framework/cmd/e2ectl/internal/envstore",
        "//test/e2e-framework/cmd/e2ectl/internal/fakeintakecmd",
        "//test/e2e-framework/cmd/e2ectl/internal/installer",
    ],
)

go_binary(
    name = "e2ectl",
    embed = [":e2ectl_lib"],
    visibility = ["//visibility:public"],
)

dd_agent_go_test(
    name = "e2ectl_test",
    srcs = [
        "config_test.go",
        "discovery_test.go",
    ],
    embed = [":e2ectl_lib"],
    deps = [
        "//test/e2e-framework/cmd/e2ectl/internal/config",
        "//test/e2e-framework/cmd/e2ectl/internal/driver",
        "//test/e2e-framework/cmd/e2ectl/internal/envstore",
        "//test/e2e-framework/cmd/e2ectl/internal/installer",
    ],
)
