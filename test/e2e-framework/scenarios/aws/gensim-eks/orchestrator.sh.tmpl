set -euo pipefail
if command -v apk >/dev/null 2>&1 && ! command -v aws >/dev/null 2>&1; then
  apk add --no-cache aws-cli 2>/dev/null || true
fi
helm repo add datadog https://helm.datadoghq.com && helm repo update

WORKSPACE_ROOT="${GENSIM_WORKSPACE_ROOT:-/workspace}"
EPISODES_MOUNT="${GENSIM_EPISODES_MOUNT:-/episodes}"
CONFIG_MOUNT="${GENSIM_CONFIG_MOUNT:-/config}"
EPISODES="${EPISODES:?EPISODES is required}"
AGENT_IMAGE="${AGENT_IMAGE:?AGENT_IMAGE is required}"
GENSIM_SHA="${GENSIM_SHA:?GENSIM_SHA is required}"
S3_BUCKET="${S3_BUCKET:-}"
KUBE_NAMESPACE="${KUBE_NAMESPACE:-default}"
IMAGE_REGISTRY="${IMAGE_REGISTRY:-}"
GENSIM_MODE="${GENSIM_MODE:-record-parquet}"
DD_API_KEY="${DD_API_KEY:-}"
DD_APP_KEY="${DD_APP_KEY:-}"
DD_SITE="${DD_SITE:-datadoghq.com}"
RECORDING_OUTPUT_DIR="${RECORDING_OUTPUT_DIR:-/tmp/observer-metrics}"
RECORDING_FLUSH_INTERVAL="${RECORDING_FLUSH_INTERVAL:-1m}"
RECORDING_FLUSH_SECONDS="${RECORDING_FLUSH_SECONDS:-60}"
RECORDING_RETENTION="${RECORDING_RETENTION:-90m}"
RECORDING_ONLY="${RECORDING_ONLY:-false}"
CLUSTER_NAME="${CLUSTER_NAME:-gensim}"
mkdir -p "$WORKSPACE_ROOT"

# ── Parse image tag and run ID ───────────────────────────────────────────
IMAGE_TAG="${AGENT_IMAGE##*:}"
RUN_ID="${RUN_ID:-eval-$(date -u +%Y%m%dT%H%M%SZ)-${GENSIM_SHA:0:7}}"

echo "Orchestrator starting"
echo "  Run ID:     $RUN_ID"
echo "  Episodes:   $EPISODES"
echo "  Image:      $AGENT_IMAGE"
echo "  Gensim SHA: $GENSIM_SHA"
echo "  S3 Bucket:  $S3_BUCKET"
echo "  Namespace:  $KUBE_NAMESPACE"
echo "  Mode:       $GENSIM_MODE"
echo "  Flush:      $RECORDING_FLUSH_INTERVAL (${RECORDING_FLUSH_SECONDS}s)"
echo "  Retention:  $RECORDING_RETENTION"

# ── Status ConfigMap helpers ────────────────────────────────────────────
init_status() {
  local episodes_json="[]"
  IFS=',' read -ra _EP_INIT <<< "$EPISODES"
  for _EP in "${_EP_INIT[@]}"; do
    local _episode="${_EP%%:*}"
    local _scenario="${_EP##*:}"
    episodes_json=$(printf '%s' "$episodes_json" | jq -c \
      --arg ep "$_episode" --arg sc "$_scenario" \
      '. + [{"episode":$ep,"scenario":$sc,"status":"queued","episodeOutcome":"pending","collectionStatus":"pending","uploadStatus":"pending","validationStatus":"pending"}]')
  done
  local status_json
  status_json=$(jq -n -c \
    --arg runId "$RUN_ID" \
    --arg image "$AGENT_IMAGE" \
    --arg sha "$GENSIM_SHA" \
    --arg started "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    --argjson eps "$episodes_json" \
    '{runId:$runId,image:$image,gensimSha:$sha,startedAt:$started,overallStatus:"running",episodes:$eps}')
  kubectl create configmap gensim-run-status \
    --from-literal=status="$status_json" \
    -n "$KUBE_NAMESPACE" \
    --dry-run=client -o yaml | kubectl apply -f -
}

update_episode_status() {
  local ep_spec="$1" new_status="$2" extra="${3}"
  [ -z "$extra" ] && extra='{}'
  local ep="${ep_spec%%:*}"
  local sc="${ep_spec##*:}"
  local current
  current=$(kubectl get configmap gensim-run-status -n "$KUBE_NAMESPACE" -o jsonpath='{.data.status}')
  local updated
  updated=$(printf '%s' "$current" | jq -c \
    --arg ep "$ep" --arg sc "$sc" --arg st "$new_status" --argjson ex "$extra" \
    '(.episodes[] | select(.episode==$ep and .scenario==$sc)) |= (. + $ex + {status:$st})')
  kubectl create configmap gensim-run-status \
    --from-literal=status="$updated" \
    -n "$KUBE_NAMESPACE" \
    --dry-run=client -o yaml | kubectl apply -f -
}

set_run_complete() {
  local overall_status="$1"
  local current
  current=$(kubectl get configmap gensim-run-status -n "$KUBE_NAMESPACE" -o jsonpath='{.data.status}')
  local updated
  updated=$(printf '%s' "$current" | jq -c \
    --arg t "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    --arg st "$overall_status" \
    '. + {completedAt:$t,overallStatus:$st}')
  kubectl create configmap gensim-run-status \
    --from-literal=status="$updated" \
    -n "$KUBE_NAMESPACE" \
    --dry-run=client -o yaml | kubectl apply -f -
}

list_recorder_pods_json() {
  local raw
  raw=$(kubectl get pods -n "$KUBE_NAMESPACE" -l app.kubernetes.io/component=agent -o json 2>/dev/null || echo '{"items":[]}')
  if [ "$(printf '%s' "$raw" | jq '.items | length')" -eq 0 ]; then
    raw=$(kubectl get pods -n "$KUBE_NAMESPACE" -l app=datadog-agent -o json 2>/dev/null || echo '{"items":[]}')
  fi
  printf '%s' "$raw" | jq -c '{items: [.items[] | select(any(.spec.containers[]?; .name == "agent") or any(.status.containerStatuses[]?; .name == "agent"))]}'
}

check_pod_snapshot_health() {
  local snapshot_file="$1"
  jq -e '
    (.items | length) > 0 and
    all(.items[];
      (.status.containerStatuses // [] | length) > 0 and
      any(.status.containerStatuses[]; .name == "agent" and .ready == true and (.restartCount // 0) == 0) and
      all(.status.containerStatuses[]; .ready == true and (.restartCount // 0) == 0)
    )
  ' "$snapshot_file" >/dev/null
}

pod_snapshot_signature() {
  local snapshot_file="$1"
  jq -c '
    [.items | sort_by(.metadata.name)[] | {
      name: .metadata.name,
      uid: .metadata.uid,
      node: (.spec.nodeName // ""),
      containers: ([.status.containerStatuses[] | {name: .name, id: .containerID, restarts: (.restartCount // 0), ready: .ready}] | sort_by(.name))
    }]
  ' "$snapshot_file"
}

verify_clean_namespace() {
  local existing_releases
  existing_releases=$(helm ls -n "$KUBE_NAMESPACE" -q 2>/dev/null || true)
  if [ -n "$existing_releases" ]; then
    for rel in $existing_releases; do
      case "$rel" in
        gensim-*|datadog-agent)
          echo "Cleaning up leftover Helm release $rel before starting episode..."
          helm uninstall "$rel" -n "$KUBE_NAMESPACE" --wait 2>/dev/null || true
          ;;
      esac
    done
  fi
  kubectl wait --for=delete pod -l app.kubernetes.io/component=agent -n "$KUBE_NAMESPACE" --timeout=120s 2>/dev/null || true
  kubectl wait --for=delete pod -l app=datadog-agent -n "$KUBE_NAMESPACE" --timeout=120s 2>/dev/null || true
}

capture_diagnostics() {
  local diag_dir="$1"
  mkdir -p "$diag_dir"
  kubectl get pods -n "$KUBE_NAMESPACE" -o wide > "$diag_dir/pods.txt" 2>&1 || true
  kubectl describe pods -n "$KUBE_NAMESPACE" -l app.kubernetes.io/component=agent > "$diag_dir/agent-describe.txt" 2>&1 || true
}

# ── DD event + metrics helpers ───────────────────────────────────────────
emit_dd_event() {
  local episode=$1 scenario=$2 duration=$3 parquet_count=$4 outcome=$5
  local title="gensim: ${episode}/${scenario} ${outcome}"
  local text="Duration: ${duration}s, Parquet files: ${parquet_count}, Image: ${AGENT_IMAGE}, SHA: ${GENSIM_SHA}"
  local alert_type="success"
  [ "$outcome" != "success" ] && alert_type="error"
  printf 'header = "DD-API-KEY: %s"\n' "${DD_API_KEY}" | curl -s -K - -X POST "https://api.${DD_SITE}/api/v1/events" \
    -H "Content-Type: application/json" \
    -d "{ \
      \"title\": \"${title}\", \
      \"text\": \"${text}\", \
      \"alert_type\": \"${alert_type}\", \
      \"tags\": [ \
        \"episode:${episode}\", \
        \"scenario:${scenario}\", \
        \"image:${IMAGE_TAG}\", \
        \"gensim_sha:${GENSIM_SHA}\", \
        \"run_id:${RUN_ID}\" \
      ] \
    }" || echo "WARN: Failed to emit DD event" >&2
}

emit_dd_metrics() {
  local episode=$1 scenario=$2 duration=$3 parquet_count=$4
  local now
  now=$(date +%s)
  local tags="[\"episode:${episode}\",\"scenario:${scenario}\",\"image:${IMAGE_TAG}\",\"gensim_sha:${GENSIM_SHA}\",\"run_id:${RUN_ID}\"]"
  printf 'header = "DD-API-KEY: %s"\n' "${DD_API_KEY}" | curl -s -K - -X POST "https://api.${DD_SITE}/api/v1/series" \
    -H "Content-Type: application/json" \
    -d "{ \
      \"series\": [ \
        {\"metric\":\"gensim.episode.duration_seconds\",\"type\":\"gauge\",\"points\":[[${now},${duration}]],\"tags\":${tags}}, \
        {\"metric\":\"gensim.episode.parquet_files\",\"type\":\"gauge\",\"points\":[[${now},${parquet_count}]],\"tags\":${tags}} \
      ] \
    }" || echo "WARN: Failed to emit DD metrics" >&2
}

# ── Post-renderer: fix imagePullPolicy: Never -> Always ──────────────────
# Some episodes (e.g. 678_heroku) set imagePullPolicy: Never for local dev.
# This post-renderer patches it to Always for EKS.
cat > "$WORKSPACE_ROOT/fix-pull-policy.sh" <<'FIXEOF'
#!/bin/sh
sed 's/imagePullPolicy: Never/imagePullPolicy: Always/g'
FIXEOF
chmod +x "$WORKSPACE_ROOT/fix-pull-policy.sh"

# ── Main loop ───────────────────────────────────────────────────────────
IFS=',' read -ra EP_LIST <<< "$EPISODES"

init_status
FAILED_EPISODES=0

for EP_SPEC in "${EP_LIST[@]}"; do
  EPISODE="${EP_SPEC%%:*}"
  SCENARIO="${EP_SPEC##*:}"
  EP_START=$(date +%s)
  COLLECTION_ERRORS="[]"
  COLLECTION_STATUS="skipped"
  UPLOAD_STATUS="skipped"
  VALIDATION_STATUS="not_applicable"
  ZIP_NAME=""
  PARQUET_COUNT=0
  EXPECTED_POD_COUNT=0

  echo "=== Episode: $EPISODE / $SCENARIO ==="
  verify_clean_namespace

  update_episode_status "$EP_SPEC" "running" '{"phase":"episode-install"}'

  # 1. Install episode chart with agent resources disabled
  EP_RELEASE=""
  if [ -f "$EPISODES_MOUNT/$EPISODE/chart.tar.gz" ]; then
    mkdir -p "$WORKSPACE_ROOT/chart-$EPISODE"
    tar xzf "$EPISODES_MOUNT/$EPISODE/chart.tar.gz" -C "$WORKSPACE_ROOT/chart-$EPISODE"
    CHART_DIR=$(find "$WORKSPACE_ROOT/chart-$EPISODE" -maxdepth 1 -mindepth 1 -type d | head -1)
    if [ -z "$CHART_DIR" ]; then
      CHART_DIR="$WORKSPACE_ROOT/chart-$EPISODE"
    fi

    EP_RELEASE="gensim-$(echo "$EPISODE" | tr '_' '-' | tr '[:upper:]' '[:lower:]')"

    EP_VALUES_FILE="$WORKSPACE_ROOT/ep-values.yaml"
    umask 077
    cat > "$EP_VALUES_FILE" <<EOF
agent:
  enabled: false
imageRegistry: "${IMAGE_REGISTRY}"
namespace: "${KUBE_NAMESPACE}"
datadog:
  apiKey: "${DD_API_KEY}"
  appKey: "${DD_APP_KEY}"
  site: "${DD_SITE}"
  env: "${EP_RELEASE}"
EOF
    umask 022
    helm install "$EP_RELEASE" "$CHART_DIR" \
      -f "$EP_VALUES_FILE" \
      -n "$KUBE_NAMESPACE" \
      --post-renderer "$WORKSPACE_ROOT/fix-pull-policy.sh" \
      --wait --timeout 3m
    rm -f "$EP_VALUES_FILE"
  fi

  update_episode_status "$EP_SPEC" "running" '{"phase":"agent-install"}'

  # 2. Install agent (autodiscovery handles check configs)
  cp "$CONFIG_MOUNT/agent-values.yaml" "$WORKSPACE_ROOT/agent-values.yaml"
  helm upgrade --install datadog-agent datadog/datadog \
    -f "$WORKSPACE_ROOT/agent-values.yaml" \
    -n "$KUBE_NAMESPACE" \
    --wait --timeout 5m
  kubectl rollout status daemonset/datadog-agent -n "$KUBE_NAMESPACE" --timeout=180s

  mkdir -p "$WORKSPACE_ROOT/results"
  list_recorder_pods_json > "$WORKSPACE_ROOT/results/agent-before.json"
  EXPECTED_POD_COUNT=$(jq '.items | length' "$WORKSPACE_ROOT/results/agent-before.json")
  PRECHECK_OK=true
  if ! check_pod_snapshot_health "$WORKSPACE_ROOT/results/agent-before.json"; then
    PRECHECK_OK=false
    COLLECTION_ERRORS=$(printf '%s' "$COLLECTION_ERRORS" | jq -c '. + ["recorder Agent pods are missing, unready, or already restarted before episode start"]')
  fi
  if [ "$GENSIM_MODE" = "record-parquet" ] || [ "$GENSIM_MODE" = "live-and-record" ]; then
    VALIDATION_STATUS="pending"
    while IFS= read -r POD_NAME; do
      [ -z "$POD_NAME" ] && continue
      if ! kubectl exec -n "$KUBE_NAMESPACE" "$POD_NAME" -c agent -- test -d "$RECORDING_OUTPUT_DIR"; then
        PRECHECK_OK=false
        COLLECTION_ERRORS=$(printf '%s' "$COLLECTION_ERRORS" | jq -c --arg pod "$POD_NAME" --arg dir "$RECORDING_OUTPUT_DIR" '. + ["recorder output directory " + $dir + " missing on pod " + $pod + " (image may lack anomalydetection_recorder)"]')
      fi
    done < <(jq -r '.items[].metadata.name' "$WORKSPACE_ROOT/results/agent-before.json")
  fi

  update_episode_status "$EP_SPEC" "running" '{"phase":"episode-running"}'

  # 3. Run play-episode.sh
  EP_OUTCOME="failure"
  if [ "$PRECHECK_OK" = true ]; then
    cp "$EPISODES_MOUNT/$EPISODE/play-episode.sh" "$WORKSPACE_ROOT/play-episode.sh"
    chmod +x "$WORKSPACE_ROOT/play-episode.sh"
    mkdir -p "$WORKSPACE_ROOT/episodes"
    cp "$EPISODES_MOUNT/$EPISODE/$SCENARIO.yaml" "$WORKSPACE_ROOT/episodes/$SCENARIO.yaml"
    (
      cd "$WORKSPACE_ROOT"
      DD_ENV="gensim-$(echo "$EPISODE" | tr '_' '-' | tr '[:upper:]' '[:lower:]')"
      export DD_ENV
      bash "$WORKSPACE_ROOT/play-episode.sh" run-episode "$SCENARIO"
    ) && EP_OUTCOME="success" || EP_OUTCOME="failure"
  fi

  EPISODE_RESULT_FILE=""
  if [ -s "$WORKSPACE_ROOT/results/${SCENARIO}-1.json" ]; then
    EPISODE_RESULT_FILE="$WORKSPACE_ROOT/results/${SCENARIO}-1.json"
  else
    EPISODE_RESULT_FILE=$(find "$WORKSPACE_ROOT/results" -maxdepth 1 -type f -name "${SCENARIO}-*.json" ! -name "*-agent-*.json" | sort | head -1)
  fi
  if [ -n "$EPISODE_RESULT_FILE" ] && [ -s "$EPISODE_RESULT_FILE" ]; then
    RESULT_SUCCESS=$(jq -r 'if has("success") then (.success | tostring) else "" end' "$EPISODE_RESULT_FILE" 2>/dev/null || echo "")
    if [ "$RESULT_SUCCESS" = "false" ]; then
      EP_OUTCOME="failure"
    elif [ "$RESULT_SUCCESS" = "true" ]; then
      EP_OUTCOME="success"
    fi
  fi

  # 4. Collect results (mode-dependent)
  if [ "$GENSIM_MODE" = "record-parquet" ] || [ "$GENSIM_MODE" = "live-and-record" ]; then
    update_episode_status "$EP_SPEC" "running" '{"phase":"collecting-parquet"}'
    COLLECTION_STARTED_AT=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    COLLECTION_STATUS="succeeded"
    if [ "$PRECHECK_OK" != true ]; then
      COLLECTION_STATUS="failed"
    fi
    if [ -z "$EPISODE_RESULT_FILE" ] || [ ! -s "$EPISODE_RESULT_FILE" ]; then
      COLLECTION_STATUS="failed"
      COLLECTION_ERRORS=$(printf '%s' "$COLLECTION_ERRORS" | jq -c --arg sc "$SCENARIO" '. + ["missing episode result JSON for scenario " + $sc]')
    else
      END_EPOCH=$(jq -r '(.end_time // "") | sub("\\.[0-9]+Z$"; "Z") | fromdateiso8601' "$EPISODE_RESULT_FILE" 2>/dev/null || echo "")
      START_EPOCH=$(jq -r '(.start_time // "") | sub("\\.[0-9]+Z$"; "Z") | fromdateiso8601' "$EPISODE_RESULT_FILE" 2>/dev/null || echo "")
      if [ -z "$END_EPOCH" ] || [ -z "$START_EPOCH" ] || [ "$START_EPOCH" -ge "$END_EPOCH" ]; then
        COLLECTION_STATUS="failed"
        COLLECTION_ERRORS=$(printf '%s' "$COLLECTION_ERRORS" | jq -c '. + ["episode result JSON has invalid start_time or end_time"]')
      else
        NOW_EPOCH=$(date -u +%s)
        WAIT_SECONDS=$((END_EPOCH + RECORDING_FLUSH_SECONDS - NOW_EPOCH))
        if [ "$WAIT_SECONDS" -gt 0 ]; then
          echo "Waiting ${WAIT_SECONDS}s for final recorder flush after episode end..."
          sleep "$WAIT_SECONDS"
        fi
      fi
    fi

    list_recorder_pods_json > "$WORKSPACE_ROOT/results/agent-after.json"
    if ! check_pod_snapshot_health "$WORKSPACE_ROOT/results/agent-after.json"; then
      COLLECTION_STATUS="failed"
      COLLECTION_ERRORS=$(printf '%s' "$COLLECTION_ERRORS" | jq -c '. + ["recorder Agent pods are unready or restarted after episode"]')
    fi
    BEFORE_SIG=$(pod_snapshot_signature "$WORKSPACE_ROOT/results/agent-before.json")
    AFTER_SIG=$(pod_snapshot_signature "$WORKSPACE_ROOT/results/agent-after.json")
    if [ "$BEFORE_SIG" != "$AFTER_SIG" ]; then
      COLLECTION_STATUS="failed"
      COLLECTION_ERRORS=$(printf '%s' "$COLLECTION_ERRORS" | jq -c '. + ["recorder Agent pod or node topology changed during episode"]')
    fi

    mkdir -p "$WORKSPACE_ROOT/results/parquet" "$WORKSPACE_ROOT/results/pods"
    FILES_MANIFEST="[]"
    while IFS= read -r POD_NAME; do
      [ -z "$POD_NAME" ] && continue
      SANITIZED_POD=$(printf '%s' "$POD_NAME" | tr -c 'a-zA-Z0-9_.-' '-')
      POD_DIR="$WORKSPACE_ROOT/results/pods/$POD_NAME"
      mkdir -p "$POD_DIR"
      echo "Collecting recorder output from pod $POD_NAME (container agent)..."
      if ! (kubectl exec -n "$KUBE_NAMESPACE" "$POD_NAME" -c agent -- tar cf - -C "$RECORDING_OUTPUT_DIR" . | tar xf - -C "$POD_DIR"); then
        COLLECTION_STATUS="failed"
        COLLECTION_ERRORS=$(printf '%s' "$COLLECTION_ERRORS" | jq -c --arg pod "$POD_NAME" '. + ["failed to copy recorder directory from pod " + $pod]')
        continue
      fi
      POD_METRICS_COUNT=$(find "$POD_DIR" -maxdepth 1 -type f -name 'observer-metrics-*.parquet' | wc -l | tr -d ' ')
      POD_LOGS_COUNT=$(find "$POD_DIR" -maxdepth 1 -type f -name 'observer-logs-*.parquet' | wc -l | tr -d ' ')
      if [ "$POD_METRICS_COUNT" -eq 0 ] || [ "$POD_LOGS_COUNT" -eq 0 ]; then
        COLLECTION_STATUS="failed"
        COLLECTION_ERRORS=$(printf '%s' "$COLLECTION_ERRORS" | jq -c \
          --arg pod "$POD_NAME" --argjson m "$POD_METRICS_COUNT" --argjson l "$POD_LOGS_COUNT" \
          '. + ["pod " + $pod + " missing recorder parquet files (metrics=" + ($m|tostring) + ", logs=" + ($l|tostring) + ")"]')
      fi
      while IFS= read -r SRC_FILE; do
        [ -z "$SRC_FILE" ] && continue
        ORIG_NAME=$(basename "$SRC_FILE")
        FAMILY="sidecar"
        case "$ORIG_NAME" in
          observer-metrics-*.parquet)
            FAMILY="metrics"
            STEM="${ORIG_NAME%.parquet}"
            DEST_NAME="${STEM}-${SANITIZED_POD}.parquet"
            ;;
          observer-logs-*.parquet)
            FAMILY="logs"
            STEM="${ORIG_NAME%.parquet}"
            DEST_NAME="${STEM}-${SANITIZED_POD}.parquet"
            ;;
          *.parquet)
            COLLECTION_STATUS="failed"
            COLLECTION_ERRORS=$(printf '%s' "$COLLECTION_ERRORS" | jq -c --arg f "$ORIG_NAME" --arg pod "$POD_NAME" '. + ["unexpected parquet file " + $f + " on pod " + $pod]')
            continue
            ;;
          *)
            DEST_NAME="${SANITIZED_POD}-${ORIG_NAME}"
            ;;
        esac
        DEST_PATH="$WORKSPACE_ROOT/results/parquet/$DEST_NAME"
        cp "$SRC_FILE" "$DEST_PATH"
        FILE_SIZE=$(wc -c < "$DEST_PATH" | tr -d ' ')
        FILE_SHA=$(sha256sum "$DEST_PATH" | awk '{print $1}')
        FILES_MANIFEST=$(printf '%s' "$FILES_MANIFEST" | jq -c \
          --arg fn "$DEST_NAME" \
          --arg orig "$ORIG_NAME" \
          --arg pod "$POD_NAME" \
          --arg fam "$FAMILY" \
          --argjson sz "$FILE_SIZE" \
          --arg sha "$FILE_SHA" \
          '. + [{filename:$fn,original_filename:$orig,source_pod:$pod,family:$fam,size_bytes:$sz,sha256:$sha,retained:null}]')
      done < <(find "$POD_DIR" -maxdepth 1 -type f | sort)
    done < <(jq -r '.items[].metadata.name' "$WORKSPACE_ROOT/results/agent-before.json")

    PARQUET_COUNT=$(find "$WORKSPACE_ROOT/results/parquet" -maxdepth 1 -type f -name '*.parquet' | wc -l | tr -d ' ')
    COLLECTION_COMPLETED_AT=$(date -u +%Y-%m-%dT%H:%M:%SZ)

    # 5. Zip and upload to S3 when collection succeeded
    if [ -n "$S3_BUCKET" ]; then
      if [ "$COLLECTION_STATUS" != "succeeded" ]; then
        UPLOAD_STATUS="skipped"
      else
        if ! command -v zip >/dev/null 2>&1; then
          apk add --no-cache zip || { echo "ERROR: failed to install zip" >&2; }
        fi
        ZIP_NAME="gensim-results-${RUN_ID}-${EPISODE}-${SCENARIO}.zip"
        ZIP_PATH="$WORKSPACE_ROOT/${ZIP_NAME}"
        DEST="s3://${S3_BUCKET}/${ZIP_NAME}"
        UPLOAD_STATUS="succeeded"
      fi
    fi

    PODS_MANIFEST=$(jq -c '
      [.items | sort_by(.metadata.name)[] |
        ((.status.containerStatuses // []) | map(select(.name == "agent")) | .[0] // {}) as $agent |
        {
          name: .metadata.name,
          uid: .metadata.uid,
          node_name: (.spec.nodeName // "unknown"),
          container_name: ($agent.name // "agent"),
          container_id: ($agent.containerID // "unknown"),
          image: ($agent.image // "unknown"),
          image_id: ($agent.imageID // "unknown"),
          ready: ($agent.ready // false),
          restart_count: ($agent.restartCount // 0)
        }
      ]
    ' "$WORKSPACE_ROOT/results/agent-after.json")
    OBSERVED_IMAGE_IDS=$(printf '%s' "$PODS_MANIFEST" | jq -c '[.[].image_id | select(. != "unknown")] | unique')
    START_TIME_STR=$(jq -r '.start_time // "unknown"' "$EPISODE_RESULT_FILE" 2>/dev/null || echo "unknown")
    END_TIME_STR=$(jq -r '.end_time // "unknown"' "$EPISODE_RESULT_FILE" 2>/dev/null || echo "unknown")
    RECORDING_ONLY_BOOL=false
    [ "$RECORDING_ONLY" = "true" ] && RECORDING_ONLY_BOOL=true

    jq -n \
      --arg runId "$RUN_ID" \
      --arg ep "$EPISODE" \
      --arg sc "$SCENARIO" \
      --arg sha "$GENSIM_SHA" \
      --arg img "$AGENT_IMAGE" \
      --argjson imgIds "$OBSERVED_IMAGE_IDS" \
      --arg outDir "$RECORDING_OUTPUT_DIR" \
      --arg flushInt "$RECORDING_FLUSH_INTERVAL" \
      --argjson flushSec "$RECORDING_FLUSH_SECONDS" \
      --arg retention "$RECORDING_RETENTION" \
      --argjson recOnly "$RECORDING_ONLY_BOOL" \
      --arg mode "$GENSIM_MODE" \
      --arg cluster "$CLUSTER_NAME" \
      --arg ns "$KUBE_NAMESPACE" \
      --arg startT "$START_TIME_STR" \
      --arg endT "$END_TIME_STR" \
      --argjson pods "$PODS_MANIFEST" \
      --arg colStart "$COLLECTION_STARTED_AT" \
      --arg colEnd "$COLLECTION_COMPLETED_AT" \
      --argjson files "$FILES_MANIFEST" \
      --arg epOutcome "$EP_OUTCOME" \
      --arg colStatus "$COLLECTION_STATUS" \
      --arg upStatus "$UPLOAD_STATUS" \
      --arg valStatus "$VALIDATION_STATUS" \
      --arg artifactKey "$ZIP_NAME" \
      --argjson errs "$COLLECTION_ERRORS" \
      '{
        schema_version: 1,
        run_id: $runId,
        backend: "eks",
        scenario_dir: $ep,
        episode: $sc,
        cycle: 1,
        gensim_sha: $sha,
        episode_sha: "unknown",
        requested_agent_image: $img,
        observed_agent_image_ids: $imgIds,
        recording_format: "parquet-v1",
        recorder_settings: {
          enabled: true,
          output_dir: $outDir,
          flush_interval: $flushInt,
          flush_seconds: $flushSec,
          retention: $retention,
          recording_only: $recOnly,
          mode: $mode
        },
        cluster_name: $cluster,
        namespace: $ns,
        window: {start_time: $startT, end_time: $endT},
        pods: $pods,
        agent_history_verified: ($colStatus == "succeeded"),
        collection_started_at: $colStart,
        collection_completed_at: $colEnd,
        artifact_key: $artifactKey,
        files: $files,
        states: {
          episode_outcome: $epOutcome,
          collection: $colStatus,
          upload: $upStatus,
          validation: $valStatus
        },
        errors: $errs
      }' > "$WORKSPACE_ROOT/results/recording-manifest.json"

    if [ -n "$S3_BUCKET" ] && [ "$COLLECTION_STATUS" = "succeeded" ]; then
      echo "Creating ${ZIP_NAME}..."
      mkdir -p "$WORKSPACE_ROOT/zip-staging/tmp/gensim-archive/parquet"
      mkdir -p "$WORKSPACE_ROOT/zip-staging/tmp/gensim-archive/results"
      mkdir -p "$WORKSPACE_ROOT/zip-staging/tmp/gensim-archive/metadata"
      cp "$WORKSPACE_ROOT/results/parquet/"* "$WORKSPACE_ROOT/zip-staging/tmp/gensim-archive/parquet/"
      cp "$EPISODE_RESULT_FILE" "$WORKSPACE_ROOT/zip-staging/tmp/gensim-archive/results/$(basename "$EPISODE_RESULT_FILE")"
      cp "$WORKSPACE_ROOT/results/recording-manifest.json" "$WORKSPACE_ROOT/zip-staging/tmp/gensim-archive/recording-manifest.json"
      cp "$WORKSPACE_ROOT/results/agent-before.json" "$WORKSPACE_ROOT/zip-staging/tmp/gensim-archive/metadata/agent-before.json"
      cp "$WORKSPACE_ROOT/results/agent-after.json" "$WORKSPACE_ROOT/zip-staging/tmp/gensim-archive/metadata/agent-after.json"

      (
        cd "$WORKSPACE_ROOT/zip-staging"
        zip -r "${ZIP_PATH}" tmp/gensim-archive/ -q
      )

      echo "Uploading ${ZIP_NAME} to ${DEST}..."
      if aws s3 cp "${ZIP_PATH}" "${DEST}"; then
        echo "Uploaded to ${DEST}"
        EP_END_TS=$(date +%s)
        EP_DUR=$((EP_END_TS - EP_START))
        RUNS_FILE="$WORKSPACE_ROOT/runs.jsonl"
        aws s3 cp "s3://${S3_BUCKET}/runs.jsonl" "${RUNS_FILE}" 2>/dev/null || true
        jq -n -c \
          --arg ts "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
          --arg runId "$RUN_ID" \
          --arg ep "$EPISODE" \
          --arg sc "$SCENARIO" \
          --arg img "$AGENT_IMAGE" \
          --arg sha "$GENSIM_SHA" \
          --arg zip "$ZIP_NAME" \
          --arg mode "$GENSIM_MODE" \
          --argjson pq "$PARQUET_COUNT" \
          --argjson dur "$EP_DUR" \
          --arg epOut "$EP_OUTCOME" \
          --arg colSt "$COLLECTION_STATUS" \
          --arg upSt "$UPLOAD_STATUS" \
          --arg valSt "$VALIDATION_STATUS" \
          --argjson pods "$EXPECTED_POD_COUNT" \
          '{
            timestamp:$ts,
            run_id:$runId,
            episode:$ep,
            scenario:$sc,
            image:$img,
            gensim_sha:$sha,
            zip:$zip,
            mode:$mode,
            parquet_count:$pq,
            duration_seconds:$dur,
            episode_outcome:$epOut,
            collection_status:$colSt,
            upload_status:$upSt,
            validation_status:$valSt,
            recorder_pods:$pods
          }' >> "${RUNS_FILE}"
        if ! aws s3 cp "${RUNS_FILE}" "s3://${S3_BUCKET}/runs.jsonl"; then
          echo "WARN: failed to update runs.jsonl" >&2
        fi
        rm -f "${RUNS_FILE}"
      else
        echo "ERROR: S3 upload failed for ${ZIP_NAME}" >&2
        UPLOAD_STATUS="failed"
        COLLECTION_ERRORS=$(printf '%s' "$COLLECTION_ERRORS" | jq -c --arg z "$ZIP_NAME" '. + ["S3 upload failed for " + $z]')
      fi
      rm -rf "$WORKSPACE_ROOT/zip-staging" "${ZIP_PATH}"
    fi
  else
    echo "Mode: $GENSIM_MODE -- skipping parquet collection and S3 upload"
  fi

  EP_END=$(date +%s)
  EP_DURATION=$((EP_END - EP_START))

  FINAL_EP_STATUS="done"
  if [ "$GENSIM_MODE" = "record-parquet" ] || [ "$GENSIM_MODE" = "live-and-record" ]; then
    if [ "$COLLECTION_STATUS" != "succeeded" ]; then
      FINAL_EP_STATUS="failed"
    elif [ -n "$S3_BUCKET" ] && [ "$UPLOAD_STATUS" != "succeeded" ]; then
      FINAL_EP_STATUS="failed"
    fi
  else
    if [ "$EP_OUTCOME" != "success" ]; then
      FINAL_EP_STATUS="failed"
    fi
  fi

  if [ "$FINAL_EP_STATUS" != "done" ]; then
    FAILED_EPISODES=$((FAILED_EPISODES + 1))
    capture_diagnostics "$WORKSPACE_ROOT/diagnostics-${EPISODE}-${SCENARIO}"
  fi

  # 6. Emit DD event + metrics
  emit_dd_event "$EPISODE" "$SCENARIO" "$EP_DURATION" "$PARQUET_COUNT" "$FINAL_EP_STATUS"
  emit_dd_metrics "$EPISODE" "$SCENARIO" "$EP_DURATION" "$PARQUET_COUNT"

  # 7. Update status
  FIRST_ERROR=$(printf '%s' "$COLLECTION_ERRORS" | jq -r '.[0] // ""')
  STATUS_EXTRA=$(jq -n -c \
    --argjson pq "$PARQUET_COUNT" \
    --argjson dur "$EP_DURATION" \
    --argjson pods "$EXPECTED_POD_COUNT" \
    --arg epOut "$EP_OUTCOME" \
    --arg colSt "$COLLECTION_STATUS" \
    --arg upSt "$UPLOAD_STATUS" \
    --arg valSt "$VALIDATION_STATUS" \
    --arg key "$ZIP_NAME" \
    --arg err "$FIRST_ERROR" \
    '{
      parquetFiles:$pq,
      durationSeconds:$dur,
      recorderPods:$pods,
      episodeOutcome:$epOut,
      collectionStatus:$colSt,
      uploadStatus:$upSt,
      validationStatus:$valSt,
      artifactKey:$key,
      error:$err
    }')
  update_episode_status "$EP_SPEC" "$FINAL_EP_STATUS" "$STATUS_EXTRA"

  # 8. Teardown episode + agent
  echo "Tearing down episode and agent..."
  if [ -n "$EP_RELEASE" ]; then
    helm uninstall "$EP_RELEASE" -n "$KUBE_NAMESPACE" --wait 2>/dev/null || true
  fi
  helm uninstall datadog-agent -n "$KUBE_NAMESPACE" --wait 2>/dev/null || true

  # Wait for pods to terminate
  echo "Waiting for agent pods to terminate..."
  kubectl wait --for=delete pod -l app.kubernetes.io/component=agent -n "$KUBE_NAMESPACE" --timeout=120s 2>/dev/null || true
  kubectl wait --for=delete pod -l app=datadog-agent -n "$KUBE_NAMESPACE" --timeout=120s 2>/dev/null || true

  # Clean workspace for next episode
  rm -rf "$WORKSPACE_ROOT/results" "$WORKSPACE_ROOT"/chart-* "$WORKSPACE_ROOT/agent-values.yaml" "$WORKSPACE_ROOT/play-episode.sh" "$WORKSPACE_ROOT/episodes"

  echo "=== Episode $EPISODE / $SCENARIO complete (${EP_DURATION}s, status=${FINAL_EP_STATUS}) ==="
done

if [ "$FAILED_EPISODES" -gt 0 ]; then
  set_run_complete "failed"
  echo "Orchestrator completed with $FAILED_EPISODES failed episode(s)." >&2
  exit 1
fi
set_run_complete "succeeded"
echo "All episodes complete."
