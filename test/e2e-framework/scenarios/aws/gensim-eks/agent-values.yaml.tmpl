fullnameOverride: datadog-agent

datadog:
  apiKeyExistingSecret: gensim-secrets
  appKeyExistingSecret: gensim-secrets
  logLevel: INFO
  apm:
    portEnabled: true
    instrumentation:
      enabled: true
  logs:
    enabled: true
    containerCollectAll: true
  processAgent:
    enabled: true
    processCollection: true
  dogstatsd:
    useHostPort: true
  kubelet:
    tlsVerify: false
  clusterName: "{{.ClusterName}}"
  clusterChecks:
    enabled: true
  env:
{{- if eq .Mode "record-parquet"}}
    - name: DD_ANOMALY_DETECTION_RECORDING_ENABLED
      value: "true"
    - name: DD_ANOMALY_DETECTION_RECORDING_OUTPUT_DIR
      value: /tmp/observer-metrics
    - name: DD_ANOMALY_DETECTION_RECORDING_FLUSH_INTERVAL
      value: "{{.FlushInterval}}"
    - name: DD_ANOMALY_DETECTION_RECORDING_RETENTION
      value: "{{.Retention}}"
    - name: DD_ANOMALY_DETECTION_RECORDING_ONLY
      value: "{{.RecordingOnly}}"
    - name: DD_ANOMALY_DETECTION_REPORTING_EVENTS_ENABLED
      value: "false"
{{- end}}
{{- if eq .Mode "live-anomaly-detection"}}
    - name: DD_ANOMALY_DETECTION_RECORDING_ENABLED
      value: "false"
    - name: DD_ANOMALY_DETECTION_REPORTING_EVENTS_ENABLED
      value: "true"
{{- end}}
{{- if eq .Mode "live-and-record"}}
    - name: DD_ANOMALY_DETECTION_RECORDING_ENABLED
      value: "true"
    - name: DD_ANOMALY_DETECTION_RECORDING_OUTPUT_DIR
      value: /tmp/observer-metrics
    - name: DD_ANOMALY_DETECTION_RECORDING_FLUSH_INTERVAL
      value: "{{.FlushInterval}}"
    - name: DD_ANOMALY_DETECTION_RECORDING_RETENTION
      value: "{{.Retention}}"
    - name: DD_ANOMALY_DETECTION_RECORDING_ONLY
      value: "false"
    - name: DD_ANOMALY_DETECTION_REPORTING_EVENTS_ENABLED
      value: "true"
{{- end}}

agents:
  enabled: true
  image:
    repository: {{.ImageRepo}}
    tag: {{.ImageTag}}
    doNotCheckTag: true
    pullPolicy: Always
  useConfigMap: true
  customAgentConfig:
    anomaly_detection:
{{- if eq .Mode "record-parquet"}}
      recording:
        enabled: true
        output_dir: /tmp/observer-metrics
        flush_interval: "{{.FlushInterval}}"
        retention: "{{.Retention}}"
      reporting:
        events:
          enabled: false
{{- end}}
{{- if eq .Mode "live-anomaly-detection"}}
      recording:
        enabled: false
      reporting:
        events:
          enabled: true
{{- end}}
{{- if eq .Mode "live-and-record"}}
      recording:
        enabled: true
        output_dir: /tmp/observer-metrics
        flush_interval: "{{.FlushInterval}}"
        retention: "{{.Retention}}"
      reporting:
        events:
          enabled: true
{{- end}}
  containers:
    agent:
      resources:
        requests:
          memory: 1500Mi
          cpu: 500m
        limits:
          memory: 3000Mi

clusterAgent:
  enabled: true
  replicas: 1
  admissionController:
    enabled: true
    mutateUnlabelled: true

clusterChecksRunner:
  enabled: false
