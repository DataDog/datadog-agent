load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "aws",
    srcs = [
        "const.go",
        "environment.go",
        "environmentDefaults.go",
        "platforms.go",
    ],
    embedsrcs = ["platforms.json"],
    importpath = "github.com/DataDog/datadog-agent/test/e2e-framework/resources/aws",
    visibility = ["//visibility:public"],
    deps = [
        "//test/e2e-framework/common/config",
        "//test/e2e-framework/common/namer",
        "//test/e2e-framework/common/utils",
        "//test/e2e-framework/components/os",
        "@com_github_aws_aws_sdk_go_v2_config//:config",
        "@com_github_aws_aws_sdk_go_v2_service_ecr//:ecr",
        "@com_github_aws_aws_sdk_go_v2_service_ecr//types",
        "@com_github_pulumi_pulumi_aws_sdk_v7//go/aws",
        "@com_github_pulumi_pulumi_random_sdk_v4//go/random",
        "@com_github_pulumi_pulumi_sdk_v3//go/pulumi",
        "@com_github_pulumi_pulumi_sdk_v3//go/pulumi/config",
    ],
)

dd_agent_go_test(
    name = "aws_test",
    srcs = [
        "environmentDefaults_test.go",
        "environment_test.go",
    ],
    embed = [":aws"],
    deps = [
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
