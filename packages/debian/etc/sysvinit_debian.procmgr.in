#!/bin/sh

### BEGIN INIT INFO
# Provides: datadog-agent-procmgr
# Short-Description: Start and stop the Datadog process manager
# Description: Datadog Process Manager, supervises the processes defined in processes.d
# Required-Start: $remote_fs
# Required-Stop: $remote_fs
# Default-Start: 2 3 4 5
# Default-Stop: 0 1 6
### END INIT INFO

. /lib/lsb/init-functions

ETC_DIR="{etc_dir}"
INSTALL_DIR="{install_dir}"
AGENTPATH="$INSTALL_DIR/embedded/bin/dd-procmgrd"
# dd-procmgrd does not write a pid file itself, so start-stop-daemon creates one.
PIDFILE="$INSTALL_DIR/run/dd-procmgrd.pid"
AGENT_USER="dd-agent"
NAME="datadog-agent-procmgr"
DESC="Datadog Process Manager"



if [ ! -x $AGENTPATH ]; then
	echo "$AGENTPATH not found. Exiting $NAME"
	exit 0
fi

if [ -r "/etc/default/${NAME}" ]; then
	. "/etc/default/${NAME}"
fi

# Mirrors the systemd unit: the environment file, then the Environment= values.
# DD_PID_DIR is the install directory because process definitions append /run to it.
if [ -r "$ETC_DIR/environment" ]; then
	set -a
	. "$ETC_DIR/environment"
	set +a
fi
export DD_PM_CONFIG_DIR="$INSTALL_DIR/processes.d"
export DD_CONF_DIR="$ETC_DIR"
export DD_PID_DIR="$INSTALL_DIR"
export DD_INSTALL_DIR="$INSTALL_DIR"


#
# Function that starts the daemon/service
#
do_start()
{
	# Return
	#   0 if daemon has been started
	#   1 if daemon was already running
	#   2 if daemon could not be started
	start-stop-daemon --start --test --quiet --pidfile $PIDFILE --user $AGENT_USER --startas $AGENTPATH > /dev/null \
		|| return 1
	start-stop-daemon --start --background --make-pidfile --chuid $AGENT_USER --quiet --pidfile $PIDFILE --user $AGENT_USER --startas $AGENTPATH \
		|| return 2
}


#
# Start the process manager and wait for it to be up
#
start_and_wait()
{
	log_daemon_msg "Starting $DESC" "$NAME"
	do_start
	case "$?" in
		1) log_end_msg 0 ;;
		2) log_end_msg 1 ;;
		*)
			# check if the process manager is running once per second for 5 seconds
			retries=5
			while [ $retries -gt 1 ]; do
				start-stop-daemon --start --test --quiet --pidfile $PIDFILE --user $AGENT_USER --startas $AGENTPATH
				if [ "$?" -eq "1" ]; then
					log_end_msg 0
					return 0
				else
					retries=$(($retries - 1))
					sleep 1
				fi
			done
			log_end_msg 1

		;;
	esac
}

#
# Function that stops the daemon/service
#
do_stop()
{
	# Return
	#   0 if daemon has been stopped
	#   1 if daemon was already stopped
	#   2 if daemon could not be stopped
	#   other if a failure occurred
	start-stop-daemon --stop --quiet --retry=30 --pidfile $PIDFILE --user $AGENT_USER --exec $AGENTPATH
	RETVAL="$?"
	rm -f $PIDFILE
	return $RETVAL
}

#
# Stop the process manager and wait for it to be down
#
stop_and_wait()
{
	log_daemon_msg "Stopping $DESC" "$NAME"
	do_stop
	case "$?" in
		0|1) log_end_msg 0 ;;
		*) log_end_msg 1 ;; # Failed to stop
	esac
}

# Action to take
case "$1" in
	start)
		if init_is_upstart; then
			exit 1
		fi
		if [ "$DATADOG_ENABLED" = "no" ]; then
			echo "Disabled via /etc/default/$NAME. Exiting."
			exit 0
		fi

		start_and_wait

		;;

	stop)
		if init_is_upstart; then
			exit 0
		fi

		stop_and_wait

		;;

	status)
		status_of_proc -p $PIDFILE $AGENTPATH $NAME && exit 0 || exit $?
		;;

	restart|force-reload)
		if init_is_upstart; then
			exit 1
		fi

		echo "Restarting $DESC"

		stop_and_wait
		start_and_wait

		;;

	*)
		N=/etc/init.d/$NAME
		echo "Usage: $N {start|stop|restart|status}"
		exit 1
		;;
esac

exit $?
