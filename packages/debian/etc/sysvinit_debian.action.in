#!/bin/sh

### BEGIN INIT INFO
# Provides: datadog-agent-action
# Short-Description: Start and stop datadog private action runner
# Description: Datadog Private Action Runner
# Required-Start: $remote_fs
# Required-Stop: $remote_fs
# Default-Start: 2 3 4 5
# Default-Stop: 0 1 6
### END INIT INFO

. /lib/lsb/init-functions

ETC_DIR="{etc_dir}"
INSTALL_DIR="{install_dir}"
AGENTPATH="$INSTALL_DIR/embedded/bin/privateactionrunner"
PIDFILE="$INSTALL_DIR/run/privateactionrunner.pid"
AGENT_ARGS="run --cfgpath=$ETC_DIR/datadog.yaml"
AGENT_USER="dd-agent"
NAME="datadog-agent-action"
DESC="Datadog Private Action Runner"



if [ ! -x $AGENTPATH ]; then
	echo "$AGENTPATH not found. Exiting $NAME"
	exit 0
fi

if [ -r "/etc/default/${NAME}" ]; then
	. "/etc/default/${NAME}"
fi


# Container root may not read another user's /proc/PID/exe without CAP_SYS_PTRACE.
agent_start_stop_daemon()
{
	if command -v setpriv > /dev/null 2>&1; then
		agent_gid=$(id -g "$AGENT_USER") || return 4
		setpriv --reuid "$AGENT_USER" --regid "$agent_gid" --init-groups /sbin/start-stop-daemon "$@"
	else
		# Older util-linux lacks setpriv; keep all su options before the username.
		su -s /bin/sh -c 'exec "$@"' -- "$AGENT_USER" sh /sbin/start-stop-daemon "$@"
	fi
}

runner_status()
{
	agent_start_stop_daemon --status --quiet --pidfile "$PIDFILE" --user "$AGENT_USER" --exec "$AGENTPATH"
}

#
# Function that starts the daemon/service
#
do_start()
{
	# Return
	#   0 if daemon has been started
	#   1 if daemon was already running
	#   2 if daemon could not be started
	runner_status
	case "$?" in
		0) return 1 ;;
		1|3) ;;
		*) return 2 ;;
	esac
	# SysV does not start the process manager required by split mode.
	export DD_PRIVATE_ACTION_RUNNER_SPLIT_ENABLED=false
	# Disable job control so setsid execs, rather than forking away our waitable child.
	set +m
	# Preserve --background's descriptor cleanup; bash can close descriptors above 9.
	/bin/bash -p -c '
		for fd in /dev/fd/*; do
			fd=${fd##*/}
			case "$fd" in ""|*[!0-9]*) exit 1 ;; esac
			if [ "$fd" -gt 2 ]; then eval "exec $fd>&-"; fi
		done
		exec setsid "$@"
	' sh /sbin/start-stop-daemon --start --make-pidfile --chuid "$AGENT_USER" --quiet --pidfile "$PIDFILE" --user "$AGENT_USER" --exec "$AGENTPATH" -- \
		$AGENT_ARGS </dev/null >/dev/null 2>&1 &
	START_PID=$!
}


#
# Start the agent and wait for it to be up
#
start_and_wait()
{
	log_daemon_msg "Starting $DESC (monolithic mode)" "$NAME"
	do_start
	case "$?" in
		1) log_end_msg 0 ;;
		2) log_end_msg 1 ;;
		*)
			# Two consecutive live samples catch immediate exits, not application readiness.
			live_checks=0
			attempt=0
			while [ "$attempt" -lt 5 ]; do
				attempt=$((attempt + 1))
				sleep 1
				runner_status
				case "$?" in
					0) live_checks=$((live_checks + 1)) ;;
					1|3) live_checks=0 ;;
					*) break ;;
				esac
				if ! kill -0 "$START_PID" 2>/dev/null; then
					if wait "$START_PID"; then
						# Only remove the PID file belonging to this launch.
						if read -r pid 2>/dev/null < "$PIDFILE" && [ "$pid" = "$START_PID" ]; then
							rm -f "$PIDFILE" || break
						fi
						log_end_msg 0
						log_success_msg "$DESC exited cleanly; not running."
						return 0
					fi
					break
				fi
				if [ "$live_checks" -ge 2 ]; then
					log_end_msg 0
					return 0
				fi
			done
			log_end_msg 1

		;;
	esac
}

#
# Function that stops the daemon/service
#
do_stop()
{
	# Return
	#   0 if daemon has been stopped
	#   1 if daemon was already stopped
	#   2 if daemon could not be stopped
	#   other if a failure occurred
	agent_start_stop_daemon --stop --quiet --retry=30 --pidfile "$PIDFILE" --user "$AGENT_USER" --exec "$AGENTPATH"
	RETVAL="$?"
	rm -f $PIDFILE
	return $RETVAL
}

#
# Stop the agent and wait for it to be down
#
stop_and_wait()
{
	log_daemon_msg "Stopping $DESC" "$NAME"
	do_stop
	case "$?" in
		0|1) log_end_msg 0 ;;
		*) log_end_msg 1 ;; # Failed to stop
	esac
}

# Action to take
case "$1" in
	start)
		if init_is_upstart; then
			exit 1
		fi
		if [ "$DATADOG_ENABLED" = "no" ]; then
			echo "Disabled via /etc/default/$NAME. Exiting."
			exit 0
		fi

		start_and_wait

			;;

	stop)
		if init_is_upstart; then
			exit 0
		fi

		stop_and_wait

		;;

	status)
		runner_status
		RETVAL="$?"
		case "$RETVAL" in
			0) log_success_msg "$NAME is running" ;;
			1|3) log_failure_msg "$NAME is not running" ;;
			*) log_failure_msg "Could not determine $NAME status"; RETVAL=4 ;;
		esac
		exit "$RETVAL"
		;;

	restart|force-reload)
		if init_is_upstart; then
			exit 1
		fi

		echo "Restarting $DESC"

		stop_and_wait
		start_and_wait

		;;

	*)
		N=/etc/init.d/$NAME
		echo "Usage: $N {start|stop|restart|status}"
		exit 1
		;;
esac

exit $?
