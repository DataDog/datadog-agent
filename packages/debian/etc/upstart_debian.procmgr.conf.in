description "Datadog Process Manager Daemon"

start on started datadog-agent
stop on (runlevel [!2345] or stopping datadog-agent)

respawn
respawn limit 4 25
normal exit 0

console log
env DD_LOG_TO_CONSOLE=false

setuid dd-agent

script
  if [ ! -x {install_dir}/embedded/bin/dd-procmgrd ]; then
    exit 0
  fi
  # Mirrors the systemd unit. setuid applies to the whole script, so these reach the exec.
  if [ -r {etc_dir}/environment ]; then
    set -a
    . {etc_dir}/environment
    set +a
  fi
  export DD_PM_CONFIG_DIR={install_dir}/processes.d
  export DD_CONF_DIR={etc_dir}
  export DD_PID_DIR={install_dir}
  export DD_INSTALL_DIR={install_dir}
  exec {install_dir}/embedded/bin/dd-procmgrd
end script
