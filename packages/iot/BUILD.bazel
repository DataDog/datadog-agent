"""IoT Agent package components specific to linux."""

load("@rules_pkg//pkg:deb.bzl", "pkg_deb")
load("@rules_pkg//pkg:install.bzl", "pkg_install")
load(
    "@rules_pkg//pkg:mappings.bzl",
    "pkg_attributes",
    "pkg_filegroup",
    "pkg_files",
    "pkg_mkdirs",
)
load("@rules_pkg//pkg:rpm.bzl", "pkg_rpm")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//bazel/rules:compression.bzl", "get_compression_level")
load("//compliance:package_licenses.bzl", "package_licenses")
load("//packages/agent:defs.bzl", "ETC_DIR_SELECTOR")
load("//packages/rules:package_naming.bzl", "make_version", "package_name_variables")

package(default_visibility = ["//packages:__subpackages__"])

package_name_variables(
    name = "variables",
)

# systemd.service.in is shared between the debian/ and redhat/ subpackages.
# Debian installs it to lib/systemd/system/; RedHat/SUSE to usr/lib/systemd/system/.
exports_files(
    ["systemd.service.in"],
    visibility = ["//packages/iot:__subpackages__"],
)

# IoT agent binary, installed to bin/agent/agent (same as the standard agent binary).
pkg_files(
    name = "iot_agent_binary",
    srcs = ["//cmd/iot-agent"],
    attributes = pkg_attributes(mode = "755"),
    prefix = "bin/agent",
    renames = {"//cmd/iot-agent": "agent"},
)

# Everything that lands under /opt/datadog-agent.
pkg_filegroup(
    name = "all_files",
    srcs = [
        ":dirs",
        ":iot_agent_binary",
    ] + select({
        # When we can build the iot-agent binary with bazel, replace that
        # target with this.
        "@platforms//os:linux": [
            "@systemd//:all_files",
        ],
        "//conditions:default": [],
    }),
)

# Everything here lands under /opt/datadog-agent.
pkg_filegroup(
    name = "everything",
    srcs = [
        ":all_files",
    ],
    prefix = "/opt/datadog-agent",
)

# Gather licenses for all pieces of the distribution.
package_licenses(
    name = "license_files",
    src = ":all_files",
)

# license_files has no prefix of its own; it belongs under /opt/datadog-agent
# alongside everything.
pkg_filegroup(
    name = "prefixed_license_files",
    srcs = [
        ":license_files",
    ],
    prefix = "/opt/datadog-agent",
)

# iot_files, example_config, and system_dirs already carry their own
# absolute-style prefix (etc/datadog-agent, var/log/datadog), so they must
# stay outside of the /opt/datadog-agent prefix applied above.
pkg_filegroup(
    name = "whole_distro",
    srcs = [
        ":everything",
        ":example_config",
        ":prefixed_license_files",
        ":system_dirs",
        "//cmd/agent/dist/conf.d:iot_files",
    ],
)

# Only a source for the debian package, which requires a single tar as input.
pkg_tar(
    name = "whole_distro_deb_tar",
    srcs = [
        ":whole_distro",
        "//packages/iot/debian:all_files",
    ],
    compression_level = get_compression_level(),
    extension = "tar.xz",
    owner = "0.0",
    visibility = ["//visibility:private"],
)

_DESCRIPTION = """Datadog IoT Agent
The Datadog IoT Agent is a lightweight process that monitors system
processes and services, and sends information back to your Datadog account.
.
This package installs and runs the advanced Agent daemon, which queues and
forwards metrics from your applications as well as system services.
.
See http://www.datadoghq.com/ for more information
"""

pkg_deb(
    name = "debian",
    conflicts = ["datadog-agent"],
    data = ":whole_distro_deb_tar",
    description = _DESCRIPTION,
    homepage = "http://www.datadoghq.com",
    # epoch 1
    license = "Apache License Version 2.0",
    maintainer = "Datadog Packages <package@datadoghq.com>",
    package = "datadog-iot-agent",
    package_file_name = "datadog-iot-agent_{version}-1_{arch_deb}.deb",
    package_variables = ":variables",
    postinst = "//omnibus:package-scripts/iot-agent-deb/postinst",
    postrm = "//omnibus:package-scripts/iot-agent-deb/postrm",
    preinst = "//omnibus:package-scripts/iot-agent-deb/preinst",
    prerm = "//omnibus:package-scripts/iot-agent-deb/prerm",
    priority = "extra",
    recommends = ["datadog-signing-keys (>= 1:1.4.0)"],
    section = "utils",
    version = "1:" + make_version() + "-1",
)

pkg_rpm(
    name = "rpm",
    package_name = "datadog-iot-agent",
    srcs = [
        ":whole_distro",
        "//packages/iot/redhat:all_files",
    ],
    conflicts = ["datadog-agent"],
    description = _DESCRIPTION,
    epoch = "1",
    group = "System Environment/Daemons",
    license = "Apache License Version 2.0",
    package_file_name = "datadog-iot-agent-{version}-1.{arch_rpm}.rpm",
    package_variables = ":variables",
    post_scriptlet_file = "//omnibus:package-scripts/iot-agent-rpm/postinst",
    posttrans_scriptlet_file = "//omnibus:package-scripts/iot-agent-rpm/posttrans",
    postun_scriptlet_file = "//omnibus:package-scripts/iot-agent-rpm/postrm",
    pre_scriptlet_file = "//omnibus:package-scripts/iot-agent-rpm/preinst",
    preun_scriptlet_file = "//omnibus:package-scripts/iot-agent-rpm/prerm",
    release = "1",
    # Packages needed during %pre scriptlet execution (from iot-agent.rb runtime_script_dependency).
    # coreutils and grep are common to RHEL and SUSE.
    # glibc-common and shadow-utils are RHEL-specific; SUSE uses glibc and shadow.
    # TODO: use select() when a RHEL vs SUSE constraint is defined.
    requires_contextual = {
        "pre": [
            "coreutils",
            "glibc-common",
            "grep",
            "shadow-utils",
        ],
    },
    summary = "Datadog IoT Agent",
    url = "http://www.datadoghq.com",
    version = make_version(),
)

# Called from omnibus datadog-iot-agent.rb (Linux only) after dda builds the binary:
#
#   command "bazel run //packages/iot:install \
#     --//:install_dir=#{install_dir} \
#     --//packages/agent:flavor=iot \
#     -- --destdir=#{install_dir}"
#
# This replaces the following explicit steps in datadog-iot-agent.rb:
#   mkdir "#{install_dir}/bin"
#   mkdir "#{install_dir}/run/"
#
# The binary and example config are still copied into install_dir by hand in the
# rb file (see the "Next steps" comment there), so this stays scoped to :dirs
# until that transitional step is dropped.
pkg_install(
    name = "install",
    srcs = [":dirs"],
    destdir_flag = "//:install_dir",
)

# Directories required under {install_dir}.
pkg_mkdirs(
    name = "dirs",
    attributes = pkg_attributes(mode = "755"),
    dirs = [
        "bin",
        "embedded/bin",
        "embedded/lib",
        "run",
    ],
)

# IoT agent example config installed as datadog.yaml.example.
#
# Source: //pkg/config:iot_agent_config builds iot-agent.yaml from the schema
# (build_type = "iot-agent").  The corresponding dda step is:
#   generate_template(CORE_SCHEMA_FILE, "bin/agent/dist/datadog.yaml", "iot-agent", ...)
# which is part of: dda inv agent.build --flavor iot --no-development
#
# In the rb file this was:
#   move 'bin/agent/dist/datadog.yaml', '/etc/datadog-agent/datadog.yaml.example'
pkg_files(
    name = "example_config",
    srcs = ["//pkg/config:iot_agent_config"],
    attributes = pkg_attributes(mode = "0644"),
    prefix = select(ETC_DIR_SELECTOR),
    renames = {"//pkg/config:iot_agent_config": "datadog.yaml.example"},
)

pkg_install(
    name = "install_example_config",
    srcs = [
        ":example_config",
        "//cmd/agent/dist/conf.d:iot_files",
    ],
)

# System directories required by the iot-agent but outside the install prefix.
pkg_mkdirs(
    name = "system_dirs",
    attributes = pkg_attributes(mode = "0775"),
    dirs = ["var/log/datadog"],
)
