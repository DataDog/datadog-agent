"""IoT Agent package components specific to linux."""

load("@rules_pkg//pkg:deb.bzl", "pkg_deb")
load(
    "@rules_pkg//pkg:mappings.bzl",
    "pkg_filegroup",
)
load("@rules_pkg//pkg:rpm.bzl", "pkg_rpm")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//bazel/rules:compression.bzl", "get_compression_level")
load("//compliance:package_licenses.bzl", "package_licenses")
load("//packages/rules:package_naming.bzl", "make_version", "package_name_variables")

package(default_visibility = ["//packages:__subpackages__"])

package_name_variables(
    name = "variables",
)

# The main build dependency from iot-agent.rb is 'datadog-iot-agent'.
pkg_filegroup(
    name = "iot_components",
    srcs = [
        "//packages/agent/iot:all_files",
    ],
)

# Everything here lands under /opt/datadog-agent.
pkg_filegroup(
    name = "everything",
    srcs = [
        ":iot_components",
    ],
    prefix = "/opt/datadog-agent",
)

# Gather licenses for all pieces of the distribution.
package_licenses(
    name = "license_files",
    src = ":iot_components",
)

# license_files has no prefix of its own; it belongs under /opt/datadog-agent
# alongside everything.
pkg_filegroup(
    name = "prefixed_license_files",
    srcs = [
        ":license_files",
    ],
    prefix = "/opt/datadog-agent",
)

# iot_files, example_config, and system_dirs already carry their own
# absolute-style prefix (etc/datadog-agent, var/log/datadog), so they must
# stay outside of the /opt/datadog-agent prefix applied above.
pkg_filegroup(
    name = "whole_distro",
    srcs = [
        ":everything",
        ":prefixed_license_files",
        "//cmd/agent/dist/conf.d:iot_files",
        "//packages/agent/iot:example_config",
        "//packages/agent/iot:system_dirs",
    ],
)

# Only a source for the debian package, which requires a single tar as input.
pkg_tar(
    name = "whole_distro_deb_tar",
    srcs = [
        ":whole_distro",
        "//packages/agent/iot/debian:all_files",
    ],
    compression_level = get_compression_level(),
    extension = "tar.xz",
    owner = "0.0",
    visibility = ["//visibility:private"],
)

# Packages needed during the rpm's %pre scriptlet (from iot-agent.rb
# runtime_script_dependency), common to RHEL and SUSE.
_RPM_PRE_DEPS_COMMON = [
    "coreutils",
    "grep",
]

_DESCRIPTION = """Datadog IoT Agent
The Datadog IoT Agent is a lightweight process that monitors system
processes and services, and sends information back to your Datadog account.
.
This package installs and runs the advanced Agent daemon, which queues and
forwards metrics from your applications as well as system services.
.
See http://www.datadoghq.com/ for more information
"""

pkg_deb(
    name = "debian",
    conflicts = ["datadog-agent"],
    data = ":whole_distro_deb_tar",
    description = _DESCRIPTION,
    homepage = "http://www.datadoghq.com",
    # epoch 1
    license = "Apache License Version 2.0",
    maintainer = "Datadog Packages <package@datadoghq.com>",
    package = "datadog-iot-agent",
    package_file_name = "datadog-iot-agent_{version}-1_{arch_deb}.deb",
    package_variables = ":variables",
    postinst = "//omnibus:package-scripts/iot-agent-deb/postinst",
    postrm = "//omnibus:package-scripts/iot-agent-deb/postrm",
    preinst = "//omnibus:package-scripts/iot-agent-deb/preinst",
    prerm = "//omnibus:package-scripts/iot-agent-deb/prerm",
    priority = "extra",
    recommends = ["datadog-signing-keys (>= 1:1.4.0)"],
    section = "utils",
    version = "1:" + make_version() + "-1",
)

pkg_rpm(
    name = "rpm",
    package_name = "datadog-iot-agent",
    srcs = [
        ":whole_distro",
    ] + select({
        "//packages/rules:suse": ["//packages/agent/iot/redhat:systemd_gen"],
        "//conditions:default": ["//packages/agent/iot/redhat:all_files"],
    }),
    conflicts = ["datadog-agent"],
    description = _DESCRIPTION,
    epoch = "1",
    group = "System Environment/Daemons",
    license = "Apache License Version 2.0",
    package_file_name = "datadog-iot-agent-{version}-1.{arch_rpm}.rpm",
    package_variables = ":variables",
    post_scriptlet_file = "//omnibus:package-scripts/iot-agent-rpm/postinst",
    posttrans_scriptlet_file = "//omnibus:package-scripts/iot-agent-rpm/posttrans",
    postun_scriptlet_file = "//omnibus:package-scripts/iot-agent-rpm/postrm",
    pre_scriptlet_file = "//omnibus:package-scripts/iot-agent-rpm/preinst",
    preun_scriptlet_file = "//omnibus:package-scripts/iot-agent-rpm/prerm",
    release = "1",
    # requires_contextual can't select() a single dict value, so the whole dict
    # is select()ed, with _RPM_PRE_DEPS_COMMON factored out of each branch.
    requires_contextual = select({
        "//packages/rules:suse": {"pre": _RPM_PRE_DEPS_COMMON + [
            "glibc",
            "shadow",
        ]},
        "//conditions:default": {"pre": _RPM_PRE_DEPS_COMMON + [
            "glibc-common",
            "shadow-utils",
        ]},
    }),
    summary = "Datadog IoT Agent",
    url = "http://www.datadoghq.com",
    version = make_version(),
)
