# Agent packages

load("@bazel_skylib//lib:selects.bzl", "selects")
load("@bazel_skylib//rules:common_settings.bzl", "string_flag")

package(default_visibility = ["//visibility:public"])

string_flag(
    name = "flavor",
    build_setting_default = "base",
    # These values match omnibus, minus "fips": unlike omnibus, fips is not a
    # flavor here, but orthogonal to it (see //bazel/platforms:crypto),
    # selected via --platforms rather than this flag.
    values = [
        "base",
        "heroku",
        "iot",
    ],
)

alias(
    name = "default_flavor",
    actual = ":base_flavor",
)

config_setting(
    name = "base_flavor",
    flag_values = {"//packages/agent:flavor": "base"},
)

# fips is orthogonal to flavor: selected via --platforms (see
# //bazel/platforms:crypto), not via this flag.
config_setting(
    name = "fips_flavor",
    constraint_values = ["//bazel/platforms:fips"],
)

config_setting(
    name = "heroku_flavor",
    flag_values = {"//packages/agent:flavor": "heroku"},
)

config_setting(
    name = "iot_flavor",
    flag_values = {"//packages/agent:flavor": "iot"},
)

# linux_default and linux_fips are plain config_setting()s, not
# selects.config_setting_group()s: Bazel's select() specialization rule
# (one match wins if its criteria are a strict superset of another match's)
# only compares the flag_values/constraint_values declared directly on a
# config_setting, not what a config_setting_group's alias chain resolves to.
# linux_fips repeats linux_default's criteria plus fips_flavor so it is
# recognized as more specialized, with no separate exclusion needed.
config_setting(
    name = "linux_default",
    constraint_values = ["@platforms//os:linux"],
    flag_values = {"//packages/agent:flavor": "base"},
)

config_setting(
    name = "linux_fips",
    constraint_values = [
        "@platforms//os:linux",
        "//bazel/platforms:fips",
    ],
    flag_values = {"//packages/agent:flavor": "base"},
)

selects.config_setting_group(
    name = "linux_heroku",
    match_all = [
        ":heroku_flavor",
        "@platforms//os:linux",
    ],
)

selects.config_setting_group(
    name = "macos_x86_64_base",
    match_all = [
        ":base_flavor",
        "//:macos_x86_64",
    ],
)

selects.config_setting_group(
    name = "macos_arm64_base",
    match_all = [
        ":base_flavor",
        "//:macos_arm64",
    ],
)

config_setting(
    name = "linux_x86_64_fips",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
        "//bazel/platforms:fips",
    ],
)

config_setting(
    name = "linux_arm64_fips",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:arm64",
        "//bazel/platforms:fips",
    ],
)

config_setting(
    name = "windows_x86_64_fips",
    constraint_values = [
        "@platforms//os:windows",
        "@platforms//cpu:x86_64",
        "//bazel/platforms:fips",
    ],
)

string_flag(
    name = "host_distribution",
    build_setting_default = "debian",
)

config_setting(
    name = "distribution_debian",
    flag_values = {"//packages/agent:host_distribution": "debian"},
)

config_setting(
    name = "distribution_redhat",
    flag_values = {"//packages/agent:host_distribution": "redhat"},
)

config_setting(
    name = "distribution_suse",
    flag_values = {"//packages/agent:host_distribution": "suse"},
)
