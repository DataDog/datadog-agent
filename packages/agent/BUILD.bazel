# Agent packages

load("@bazel_skylib//lib:selects.bzl", "selects")
load("@bazel_skylib//rules:common_settings.bzl", "string_flag")

package(default_visibility = ["//visibility:public"])

string_flag(
    name = "flavor",
    build_setting_default = "base",
    # These values match omnibus, minus fips.
    values = [
        "base",
        "heroku",
        "iot",
        "recorder",
    ],
)

alias(
    name = "default_flavor",
    actual = ":base_flavor",
)

config_setting(
    name = "base_flavor",
    flag_values = {"//packages/agent:flavor": "base"},
)

config_setting(
    name = "iot_flavor",
    flag_values = {"//packages/agent:flavor": "iot"},
)

config_setting(
    name = "linux_fips",
    constraint_values = [
        "@platforms//os:linux",
        "//bazel/platforms:fips",
    ],
)

selects.config_setting_group(
    name = "macos_x86_64_base",
    match_all = [
        ":base_flavor",
        "//:macos_x86_64",
    ],
)

selects.config_setting_group(
    name = "macos_arm64_base",
    match_all = [
        ":base_flavor",
        "//:macos_arm64",
    ],
)

config_setting(
    name = "linux_x86_64_fips",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
        "//bazel/platforms:fips",
    ],
)

config_setting(
    name = "linux_arm64_fips",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:arm64",
        "//bazel/platforms:fips",
    ],
)

config_setting(
    name = "windows_x86_64_fips",
    constraint_values = [
        "@platforms//os:windows",
        "@platforms//cpu:x86_64",
        "//bazel/platforms:fips",
    ],
)

string_flag(
    name = "host_distribution",
    build_setting_default = "debian",
)

config_setting(
    name = "distribution_debian",
    flag_values = {"//packages/agent:host_distribution": "debian"},
)

config_setting(
    name = "distribution_redhat",
    flag_values = {"//packages/agent:host_distribution": "rhel"},
)

config_setting(
    name = "distribution_suse",
    flag_values = {"//packages/agent:host_distribution": "suse"},
)
