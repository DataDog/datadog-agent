description "Datadog Private Action Runner"

start on started datadog-agent
stop on (runlevel [!2345] or stopping datadog-agent)

respawn
respawn limit 4 25
normal exit 0

console output

script
  # Split mode needs both Private Action Runner definitions, whatever the admin file says.
  # Any other YAML only starts dd-procmgrd.
  procmgr_par_definitions() {
    [ -f "{install_dir}/processes.d/datadog-agent-par-control.yaml" ] || [ -f "{install_dir}/processes.d/datadog-agent-par-control.yml" ] || return 1
    [ -f "{install_dir}/processes.d/datadog-agent-action-executor.yaml" ] || [ -f "{install_dir}/processes.d/datadog-agent-action-executor.yml" ] || return 1
  }
  # The subshell keeps the admin file out of this environment.
  procmgr_enabled() {
    [ -x {install_dir}/embedded/bin/dd-procmgrd ] || return 1
    (
      DATADOG_ENABLED=
      if [ -r /etc/default/datadog-agent-procmgr ]; then
        . /etc/default/datadog-agent-procmgr
      fi
      [ "$DATADOG_ENABLED" != "no" ]
    )
  }
  # One read, no wait: a dd-procmgrd still running after DATADOG_ENABLED=no can start par-control.
  procmgr_listening() {
    # 00010000: listening. 0001: stream socket. 01: listener state.
    awk '
      $4 == "00010000" &&
      $5 == "0001" &&
      $6 == "01" &&
      $NF == "/var/run/datadog-procmgrd/dd-procmgrd.sock" {
        ready = 1
      }
      END { exit !ready }
    ' /proc/net/unix
  }
  if procmgr_par_definitions && { procmgr_enabled || procmgr_listening; }; then
    # The core Agent starts par-control through dd-procmgrd. In split mode this runner stands down.
    echo "Starting Datadog Private Action Runner (split mode from config)"
    runner_env='DD_LOG_TO_CONSOLE=false'
  else
    echo "Starting Datadog Private Action Runner in monolithic mode"
    # su drops the environment, so this flag has to be inside -c.
    runner_env='DD_PRIVATE_ACTION_RUNNER_SPLIT_ENABLED=false DD_LOG_TO_CONSOLE=false'
  fi
  # RHEL6 Upstart has no setuid, so su switches user.
  exec su -s /bin/sh -c "$runner_env"' exec "$0" "$@"' dd-agent -- {install_dir}/embedded/bin/privateactionrunner run --cfgpath={etc_dir}/datadog.yaml &>> /var/log/datadog/privateactionrunner-errors.log
end script

pre-start script
  log_file_size=`du -b /var/log/datadog/privateactionrunner-errors.log | cut -f1`
  if [ -n "$log_file_size" ] && [ $log_file_size -gt 5242880 ]; then
    # Rotate log file if it's larger than 5MB
    mv /var/log/datadog/privateactionrunner-errors.log /var/log/datadog/privateactionrunner-errors.log.1
  fi
end script
