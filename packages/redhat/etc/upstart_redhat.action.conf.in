description "Datadog Private Action Runner"

start on started datadog-agent
stop on (runlevel [!2345] or stopping datadog-agent)

respawn
respawn limit 4 25
normal exit 0

console output

script
  # datadog-agent-procmgr starts on the same event, so wait (bounded) for it. Without it,
  # split mode cannot run par-control, so fall back to the monolithic runner.
  procmgr_running=false
  attempt=0
  while [ "$attempt" -lt 10 ]; do
    if initctl status datadog-agent-procmgr 2>/dev/null | grep -q 'start/running'; then
      procmgr_running=true
      break
    fi
    attempt=$((attempt + 1))
    sleep 1
  done
  if [ "$procmgr_running" = true ]; then
    echo "Starting Datadog Private Action Runner (split mode from config)"
  else
    export DD_PRIVATE_ACTION_RUNNER_SPLIT_ENABLED=false
    echo "Starting Datadog Private Action Runner in monolithic mode"
  fi
  # Logging to console from the agent is disabled since the agent already logs using file or
  # syslog depending on its configuration. We then redirect the stdout/stderr of the agent process
  # to log panic/crashes.
  #
  # setuid is not available in versions of upstart before 1.4. CentOS/RHEL6 use an earlier version of upstart.
  # This is the best way to set the user in the absence of setuid.
  exec su -s /bin/sh -c 'DD_LOG_TO_CONSOLE=false exec "$0" "$@"' dd-agent -- {install_dir}/embedded/bin/privateactionrunner run --cfgpath={etc_dir}/datadog.yaml &>> /var/log/datadog/privateactionrunner-errors.log
end script

pre-start script
  # Manual rotation of errors log
  log_file_size=`du -b /var/log/datadog/privateactionrunner-errors.log | cut -f1`
  if [ -n "$log_file_size" ] && [ $log_file_size -gt 5242880 ]; then
    # Rotate log file if it's larger than 5MB
    mv /var/log/datadog/privateactionrunner-errors.log /var/log/datadog/privateactionrunner-errors.log.1
  fi
end script
