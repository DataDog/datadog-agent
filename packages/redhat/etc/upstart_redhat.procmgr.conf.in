description "Datadog Process Manager Daemon"

start on started datadog-agent
stop on (runlevel [!2345] or stopping datadog-agent)

respawn
respawn limit 4 25
normal exit 0

console output

script
  if [ ! -x {install_dir}/embedded/bin/dd-procmgrd ]; then
    exit 0
  fi
  # Upstart before 1.4 (RHEL6) has no setuid, so su switches user.
  # su drops the environment without -m, so the environment is set inside the -c string.
  exec su -s /bin/sh -c 'if [ -r "{etc_dir}/environment" ]; then set -a; . "{etc_dir}/environment"; set +a; fi; DD_LOG_TO_CONSOLE=false DD_PM_CONFIG_DIR="{install_dir}/processes.d" DD_CONF_DIR="{etc_dir}" DD_PID_DIR="{install_dir}" DD_INSTALL_DIR="{install_dir}" exec "$0" "$@"' dd-agent -- {install_dir}/embedded/bin/dd-procmgrd >> /var/log/datadog/procmgr-errors.log 2>&1
end script

pre-start script
  # Manual rotation of errors log
  log_file_size=`du -b /var/log/datadog/procmgr-errors.log | cut -f1`
  if [ -n "$log_file_size" ] && [ $log_file_size -gt 5242880 ]; then
    mv /var/log/datadog/procmgr-errors.log /var/log/datadog/procmgr-errors.log.1
  fi
end script
