description "Datadog Process Manager Daemon"

start on started datadog-agent
stop on (runlevel [!2345] or stopping datadog-agent)

respawn
respawn limit 4 25
normal exit 0
kill timeout 200

console output

script
  if [ ! -x {install_dir}/embedded/bin/dd-procmgrd ]; then
    exit 0
  fi
  # RHEL 6 Upstart has no setuid stanza, so the daemon drops privileges itself.
  if [ -r "{etc_dir}/environment" ]; then
    while IFS= read -r line || [ -n "$line" ]; do
      case $line in
      ""|"#"*|";"*) continue ;;
      esac
      case $line in
      *=*) ;;
      *) continue ;;
      esac
      key=${line%%=*}
      value=${line#*=}
      case $key in
      *[!A-Za-z0-9_]*|"") continue ;;
      [0-9]*) continue ;;
      esac
      case $value in
      \"*\") value=${value#\"}; value=${value%\"} ;;
      \'*\') value=${value#\'}; value=${value%\'} ;;
      esac
      export "$key=$value"
    done < "{etc_dir}/environment"
  fi
  export DD_LOG_TO_CONSOLE=false
  export DD_PM_CONFIG_DIR="{install_dir}/processes.d"
  export DD_CONF_DIR="{etc_dir}"
  export DD_PID_DIR="{install_dir}"
  export DD_INSTALL_DIR="{install_dir}"
  export DD_PROCMGR_RUN_AS_USER=dd-agent
  exec "{install_dir}/embedded/bin/dd-procmgrd" >> /var/log/datadog/procmgr-errors.log 2>&1
  exit 1
end script

pre-start script
  # dd-agent cannot create this directory under root-owned /var/run.
  /usr/bin/install -d -o dd-agent -g dd-agent -m 0755 /var/run/datadog-procmgrd || exit 1
  # Manual rotation of errors log
  log_file_size=`du -b /var/log/datadog/procmgr-errors.log | cut -f1`
  if [ -n "$log_file_size" ] && [ $log_file_size -gt 5242880 ]; then
    mv /var/log/datadog/procmgr-errors.log /var/log/datadog/procmgr-errors.log.1
  fi
end script
