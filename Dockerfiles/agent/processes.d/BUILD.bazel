# gazelle:ignore

exports_files(
    [
        "aio/datadog-agent-data-plane.yaml",
        "aio/datadog-agent-otel.yaml",
        "aio/datadog-agent-par.yaml",
        "aio/datadog-agent-par-control.yaml",
        "aio/datadog-agent-process.yaml",
        "aio/datadog-agent-security.yaml",
        "aio/datadog-agent-sysprobe.yaml",
        "aio/datadog-agent-trace.yaml",
        "aio/datadog-agent.yaml",
    ],
    visibility = ["//pkg/procmgr/rust:__pkg__"],
)

# Non-recursive: aio/ stays out of the top-level set, so a monolith YAML
# symlinked next to the PAR entries fails the catalog test.
filegroup(
    name = "top_level_yaml",
    srcs = glob(["*.yaml"]),
    visibility = ["//pkg/procmgr/rust:__pkg__"],
)

filegroup(
    name = "aio_yaml",
    srcs = glob(["aio/*.yaml"]),
    visibility = ["//pkg/procmgr/rust:__pkg__"],
)
