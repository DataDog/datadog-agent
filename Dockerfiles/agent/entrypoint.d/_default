#!/usr/bin/env bash
set -euo pipefail

# Only bases whose dd-procmgrd can run the aio catalog ship processes.d/aio. agent-ddot copies
# these entrypoints onto older bases, so it must not copy processes.d/aio. Other bases keep s6.
if [[ -x /opt/datadog-agent/embedded/bin/dd-procmgrd && -d /opt/datadog-agent/processes.d/aio ]]; then
  exec /opt/entrypoints/procmgr-all-in-one
fi
exec /opt/entrypoints/s6-all-in-one
