#!/usr/bin/env bash
set -euo pipefail

# agent-ddot can sit on an older base. Only bases whose dd-procmgrd can run the all-in-one
# catalog ship processes.d/aio, so agent-ddot must not copy it.
if [[ -x /opt/datadog-agent/embedded/bin/dd-procmgrd && -d /opt/datadog-agent/processes.d/aio ]]; then
  exec /opt/entrypoints/procmgr-all-in-one
fi
exec /opt/entrypoints/s6-all-in-one
