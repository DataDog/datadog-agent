#!/usr/bin/env bash
# Runs the cont-init scripts, then execs dd-procmgrd. _default reaches this when ENTRYPOINT is unset.
set -euo pipefail

# Stage executable copies: entries are mode 0644, often symlinks into a read-only ..data
# directory, and executing them fails on a noexec mount. Try /var/run/s6 first. It is a VOLUME
# kept across restarts, so it is wiped and mkdir without -p proves this run created it.
# Otherwise use ${TMPDIR:-/tmp}, then /opt/datadog-agent/run, which may be shared: plain
# --read-only leaves /tmp read-only and --tmpfs /tmp defaults to noexec. /tmp comes first so a
# SIGKILL leftover stays in the container's own /tmp. bash as PID 1 ignores an unhandled
# SIGTERM, so TERM is caught for the whole script. Each cont-init script runs in its own
# session, so that signal reaches children it forked. A fallback directory is removed on the
# way out, including when exec of dd-procmgrd fails. A custom-service fallback that survives
# exec is removed by dd-procmgrd after the children stop.
stage_executes() {
    local probe="$1/.procmgr-exec-probe" status=1
    if printf '#!/bin/sh\nexit 0\n' >"$probe" && chmod 0755 "$probe" && "$probe" 2>/dev/null; then
        status=0
    fi
    rm -f "$probe"
    return "$status"
}

cont_init_pid=
launching=
stop_requested=
cleanup_dir=
on_term() {
    # Bash runs this trap between commands. launching is set only across the background
    # launch and the pid assignment, where the child exists but $! is not stored yet.
    if [[ -n "$launching" ]]; then
        stop_requested=1
        return
    fi
    if [[ -n "$cont_init_pid" ]]; then
        # Once setsid has run, the pid is the session leader and a negative pid signals the
        # whole group. Before that the group does not exist yet, so signal the pid itself.
        kill -TERM -"$cont_init_pid" 2>/dev/null || kill -TERM "$cont_init_pid" 2>/dev/null || true
        wait "$cont_init_pid" 2>/dev/null || true
    fi
    exit 143
}
trap on_term TERM INT
trap 'if [[ -n "$cleanup_dir" ]]; then chmod -R u+w "$cleanup_dir" 2>/dev/null || true; rm -rf "$cleanup_dir" 2>/dev/null || true; fi' EXIT

copy_dir=
primary=/var/run/s6/procmgr-cont-init.d
if rm -rf "$primary" 2>/dev/null && mkdir "$primary" 2>/dev/null && stage_executes "$primary"; then
    copy_dir=$primary
else
    rm -rf "$primary" 2>/dev/null || true
fi
if [[ -z "$copy_dir" ]]; then
    for parent in "${TMPDIR:-/tmp}" /opt/datadog-agent/run; do
        if ! candidate=$(mktemp -d "$parent/procmgr-cont-init.d.XXXXXX" 2>/dev/null); then
            continue
        fi
        # Set the cleanup variable before the probe, so a signal during it removes this directory.
        cleanup_dir=$candidate
        copy_dir=$candidate
        if stage_executes "$candidate"; then
            break
        fi
        rm -rf "$candidate"
        cleanup_dir=""
        copy_dir=""
    done
fi
if [[ -z "$copy_dir" ]]; then
    echo "cannot stage /etc/cont-init.d: no writable executable directory in /var/run/s6, ${TMPDIR:-/tmp}, or /opt/datadog-agent/run" >&2
    exit 1
fi
printf '===== STAGING cont-init in %s =====\n' "$copy_dir"

# C-locale order. LC_ALL=C applies to sort only, so dd-procmgrd does not inherit it.
# pipefail does not cover the process substitution, so wait reaps it: a failed sort
# must not fall through to dd-procmgrd.
mapfile -d '' inits < <(printf '%s\0' /etc/cont-init.d/* | LC_ALL=C sort -z)
wait "$!"
# Stage every file before running any, so a script can see its later siblings.
# [[ -f ]] follows symlinks and skips directories and unmatched globs.
selected=()
for init in "${inits[@]}"; do
    if [[ -f "$init" ]]; then
        copy="$copy_dir/${init##*/}"
        cp -L -- "$init" "$copy"
        chmod 0755 "$copy"
        selected+=("$init")
    fi
done
for init in "${selected[@]}"; do
    printf '===== RUNNING %s =====\n' "$init"
    # setsid makes the script a session leader. Background it so the TERM handler runs
    # while it blocks. <&0 keeps its stdin. Job control stays off, so setsid does not fork.
    # launching stays set until $! is stored, so a TERM in that gap is applied to this pid.
    launching=1
    setsid "$copy_dir/${init##*/}" <&0 &
    cont_init_pid=$!
    launching=
    if [[ -n "$stop_requested" ]]; then
        on_term
    fi
    wait "$cont_init_pid"
    cont_init_pid=
done
# A successful exec does not run the EXIT trap, so remove the cont-init fallback here.
# A custom-service fallback is set afterwards and must survive exec.
if [[ "$copy_dir" != "$primary" ]]; then rm -rf "$copy_dir"; cleanup_dir=""; fi

# Shipped directories are already in the aio catalog, so starting them again would run
# each process twice. Other directories with a run file are custom services. finish is not
# run because it calls s6-svc.
shipped_s6_services=" agent data-plane otel privateactionrunner process security sysprobe trace "
custom_services=()
if [[ -d /etc/services.d ]]; then
    for service_dir in /etc/services.d/*; do
        [[ -d "$service_dir" && -f "$service_dir/run" ]] || continue
        service_name=${service_dir##*/}
        [[ "$shipped_s6_services" == *" $service_name "* ]] && continue
        if [[ ! "$service_name" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]]; then
            echo "skipping /etc/services.d/$service_name: the name cannot be a process name" >&2
            continue
        fi
        custom_services+=("$service_name")
    done
fi

export DD_PM_CONFIG_DIR=/opt/datadog-agent/processes.d/aio
if [[ ${#custom_services[@]} -gt 0 ]]; then
    processes_dir=
    processes_primary=/var/run/s6/procmgr-processes.d
    if rm -rf "$processes_primary" 2>/dev/null && mkdir "$processes_primary" 2>/dev/null && stage_executes "$processes_primary"; then
        processes_dir=$processes_primary
    else
        rm -rf "$processes_primary" 2>/dev/null || true
        for parent in "${TMPDIR:-/tmp}" /opt/datadog-agent/run; do
            if ! candidate=$(mktemp -d "$parent/procmgr-processes.d.XXXXXX" 2>/dev/null); then
                continue
            fi
            cleanup_dir=$candidate
            if stage_executes "$candidate"; then
                processes_dir=$candidate
                break
            fi
            rm -rf "$candidate"
            cleanup_dir=""
        done
    fi
    if [[ -z "$processes_dir" ]]; then
        echo "cannot stage custom /etc/services.d services: no writable executable directory in /var/run/s6, ${TMPDIR:-/tmp}, or /opt/datadog-agent/run" >&2
        exit 1
    fi
    for catalog_yaml in /opt/datadog-agent/processes.d/aio/*.yaml; do
        cp -L -- "$catalog_yaml" "$processes_dir/${catalog_yaml##*/}"
    done
    mkdir "$processes_dir/services"
    for service_name in "${custom_services[@]}"; do
        service_dir=/etc/services.d/$service_name
        if [[ -e "$processes_dir/$service_name.yaml" ]]; then
            echo "skipping /etc/services.d/$service_name: $service_name is already a catalog process" >&2
            continue
        fi
        stage="$processes_dir/services/$service_name"
        if ! cp -RL -- "$service_dir" "$stage"; then
            echo "skipping /etc/services.d/$service_name: copy failed" >&2
            chmod -R u+w "$stage" 2>/dev/null || true
            rm -rf "$stage" 2>/dev/null || true
            continue
        fi
        chmod 0755 "$stage/run"
        # A read-only source can be mode 0555. The owner still has to be able to remove the copy.
        chmod -R u+w "$stage"
        auto_start=true
        if [[ -e "$service_dir/down" ]]; then
            auto_start=false
        fi
        if [[ -f "$service_dir/finish" ]]; then
            echo "/etc/services.d/$service_name/finish is not run. ENTRYPOINT=s6-all-in-one runs it." >&2
        fi
        printf '===== ADDING custom service /etc/services.d/%s =====\n' "$service_name"
        command_path="$processes_dir/services/$service_name/run"
        command_path=${command_path//\'/\'\'}
        workdir_path="$processes_dir/services/$service_name"
        workdir_path=${workdir_path//\'/\'\'}
        cat >"$processes_dir/$service_name.yaml" <<EOF
description: Custom service /etc/services.d/$service_name
command: '$command_path'
working_dir: '$workdir_path'
auto_start: $auto_start
restart: always
restart_sec: 1
restart_max_delay_sec: 1
start_limit_interval_sec: 0
stdout: inherit
stderr: inherit
EOF
    done
    export DD_PM_CONFIG_DIR=$processes_dir
fi
# The image VOLUME keeps this directory writable under Docker --read-only.
export DD_PM_SOCKET_PATH="${DD_PM_SOCKET_PATH:-/opt/datadog-agent/run/dd-procmgrd.sock}"
# Only the fallback directory this start created. Unset a caller-supplied path and token so
# the daemon cannot remove some other directory. The token file is what ties the path to
# this launch. Children do not inherit DD_PM_*.
unset DD_PM_CLEANUP_DIR
unset DD_PM_CLEANUP_TOKEN
if [[ -n "$cleanup_dir" ]]; then
    token=$(cat /proc/sys/kernel/random/uuid)
    printf '%s\n' "$token" >"$cleanup_dir/.dd-procmgr-cleanup"
    chmod 0600 "$cleanup_dir/.dd-procmgr-cleanup"
    export DD_PM_CLEANUP_DIR=$cleanup_dir
    export DD_PM_CLEANUP_TOKEN=$token
fi
printf '===== STARTING dd-procmgrd =====\n'
# set -e skips the EXIT trap when exec fails. execfail makes a failed exec return.
set +e
shopt -s execfail
exec /opt/datadog-agent/embedded/bin/dd-procmgrd
status=$?
exit "$status"
