{
  // Trigger build: 2026-09-22 10:00
  "name": "Datadog Agent Development Container",
  "image": "registry.ddbuild.io/ci/datadog-agent-buildimages/dev-env-workspace:v137515717-cbd951c9",
  "features": {
    "registry.ddbuild.io/workspaces/features/claude-code:0.1.136903543": {},
    "registry.ddbuild.io/workspaces/features/trajectory:0.1.121704661": {},
    "registry.ddbuild.io/workspaces/features/codex:0.1.116595837": {},
    "registry.ddbuild.io/workspaces/features/base:0.4.140255179": {
      "installDeveloperTools": "false"
    },
    "./features/datadog-agent": {}
  },
  "forwardPorts": [22],
  "mounts": [
    {
      // Use the host Docker daemon so containers launched from the workspace
      // share the host PID namespace and can be used for Agent development.
      "source": "/var/run/docker.sock",
      "target": "/var/run/docker.sock",
      "type": "bind"
    }
  ],
  "containerUser": "root",
  "remoteUser": "bits",
  "waitFor": "postStartCommand",
  "securityOpt": ["apparmor:unconfined"],
  "capAdd": [
    "SYS_ADMIN",
    "SYS_RESOURCE",
    "SYS_PTRACE",
    "NET_ADMIN",
    "NET_BROADCAST",
    "NET_RAW",
    "IPC_LOCK",
    "CHOWN",
    "KILL"
  ]
}
