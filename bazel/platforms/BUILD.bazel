# The platforms we build the agent for.

package(default_visibility = ["//visibility:public"])

constraint_setting(name = "crypto")

constraint_value(
    name = "fips",
    constraint_setting = ":crypto",
)

# bazel_tools' own default_test_toolchain requires the execution platform to
# satisfy every constraint of the target platform (use_target_platform_constraints),
# which no real execution platform does for the artificial :fips constraint.
# This toolchain overrides that requirement for fips target platforms only, as
# suggested by the toolchain_type's own no_match_error, without registering
# any new execution platform (see MODULE.bazel for why that is undesirable).
toolchain(
    name = "fips_test_toolchain",
    target_compatible_with = [":fips"],
    toolchain = "@bazel_tools//tools/test:empty_toolchain",
    toolchain_type = "@bazel_tools//tools/test:default_test_toolchain_type",
)

platform(
    name = "linux_x86_64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

platform(
    name = "linux_arm64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:arm64",
    ],
)

platform(
    name = "macos_arm64",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:arm64",
    ],
)

platform(
    name = "macos_x86_64",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:x86_64",
    ],
)

platform(
    name = "windows_x86_64",
    constraint_values = [
        "@platforms//os:windows",
        "@platforms//cpu:x86_64",
    ],
)

platform(
    name = "linux_x86_64_fips",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
        ":fips",
    ],
)

platform(
    name = "linux_arm64_fips",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:arm64",
        ":fips",
    ],
)

platform(
    name = "macos_arm64_fips",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:arm64",
        ":fips",
    ],
)

platform(
    name = "macos_x86_64_fips",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:x86_64",
        ":fips",
    ],
)

platform(
    name = "windows_x86_64_fips",
    constraint_values = [
        "@platforms//os:windows",
        "@platforms//cpu:x86_64",
        ":fips",
    ],
)
