# The platforms we build the agent for.

package(default_visibility = ["//visibility:public"])

constraint_setting(name = "crypto")

constraint_value(
    name = "fips",
    constraint_setting = ":crypto",
)

platform(
    name = "linux_x86_64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
        "@llvm//constraints/cxxstdlib:libstdcxx.11.4.0",
        "@llvm//constraints/kernel/linux:6.4",
        "@llvm//constraints/libc:gnu.2.17",  # RHEL/CentOS 7
    ],
    # Part of every action key, local or remote: Linux hosts and RBE must agree on them to share cache entries.
    exec_properties = {
        "ISA": "x86-64",
        "OSFamily": "Linux",
    },
)

platform(
    name = "linux_arm64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:arm64",
        "@llvm//constraints/cxxstdlib:libstdcxx.12.3.0",
        "@llvm//constraints/kernel/linux:6.4",
        "@llvm//constraints/libc:gnu.2.23",  # Ubuntu 16.04
    ],
)

platform(
    name = "linux_armv7",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:armv7",
    ],
)

platform(
    name = "macos_arm64",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:arm64",
    ],
)

platform(
    name = "macos_x86_64",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:x86_64",
    ],
)

platform(
    name = "windows_x86_64",
    constraint_values = [
        "@platforms//os:windows",
        "@platforms//cpu:x86_64",
        "@llvm//constraints/windows/abi:gnu",
        "@llvm//constraints/windows/crt:msvcrt",
    ],
)

platform(
    name = "linux_x86_64_fips",
    constraint_values = [
        ":fips",
    ],
    parents = [":linux_x86_64"],
)

platform(
    name = "linux_arm64_fips",
    constraint_values = [
        ":fips",
    ],
    parents = [":linux_arm64"],
)

platform(
    name = "macos_arm64_fips",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:arm64",
        ":fips",
    ],
)

platform(
    name = "macos_x86_64_fips",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:x86_64",
        ":fips",
    ],
)

platform(
    name = "windows_x86_64_fips",
    constraint_values = [
        "@platforms//os:windows",
        "@platforms//cpu:x86_64",
        ":fips",
        "@llvm//constraints/windows/abi:gnu",
        "@llvm//constraints/windows/crt:msvcrt",
    ],
)
