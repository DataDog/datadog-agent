# The platforms we build the agent for.

package(default_visibility = ["//visibility:public"])

constraint_setting(name = "crypto")

constraint_value(
    name = "fips",
    constraint_setting = ":crypto",
)

platform(
    name = "linux_x86_64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

platform(
    name = "linux_x86_64_fips",
    constraint_values = [":fips"],
    flags = ["--@rules_go//go/toolchain:sdk_name=msgo"],
    parents = [":linux_x86_64"],
)

platform(
    name = "linux_arm64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:arm64",
    ],
)

platform(
    name = "linux_arm64_fips",
    constraint_values = [":fips"],
    flags = ["--@rules_go//go/toolchain:sdk_name=msgo"],
    parents = [":linux_arm64"],
)

platform(
    name = "linux_armv7",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:armv7",
    ],
)

platform(
    name = "macos_arm64",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:arm64",
    ],
)

platform(
    name = "macos_x86_64",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:x86_64",
    ],
)

platform(
    name = "windows_x86_64",
    constraint_values = [
        "@platforms//os:windows",
        "@platforms//cpu:x86_64",
        "@llvm//constraints/windows/abi:gnu",
        "@llvm//constraints/windows/crt:msvcrt",
    ],
)

platform(
    name = "windows_x86_64_fips",
    constraint_values = [":fips"],
    flags = ["--@rules_go//go/toolchain:sdk_name=msgo"],
    parents = [":windows_x86_64"],
)

platform(
    name = "fips_test_platform",
    testonly = True,
    constraint_values = [":fips"],
    parents = ["@platforms//host"],
)

toolchain(
    name = "fips_test_toolchain",
    testonly = True,
    target_compatible_with = [":fips"],
    toolchain = "@bazel_tools//tools/test:empty_toolchain",
    toolchain_type = "@bazel_tools//tools/test:default_test_toolchain_type",
)
