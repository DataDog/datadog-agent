# The platforms we build the agent for.

load("@bazel_skylib//lib:selects.bzl", "selects")
load("@llvm//constraints/windows/abi:abis.bzl", "WINDOWS_MINGW_COMPATIBLE_ABIS")

package(default_visibility = ["//visibility:public"])

constraint_setting(name = "crypto")

constraint_value(
    name = "fips",
    constraint_setting = ":crypto",
)

[
    config_setting(
        name = "windows_abi_" + abi,
        constraint_values = ["@llvm//constraints/windows/abi:" + abi],
    )
    for abi in WINDOWS_MINGW_COMPATIBLE_ABIS
]

selects.config_setting_group(
    name = "windows_mingw_compatible_abi",
    match_any = [":windows_abi_" + abi for abi in WINDOWS_MINGW_COMPATIBLE_ABIS],
)

platform(
    name = "linux_x86_64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

platform(
    name = "linux_arm64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:arm64",
    ],
)

platform(
    name = "linux_armv7",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:armv7",
    ],
)

platform(
    name = "macos_arm64",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:arm64",
    ],
)

platform(
    name = "macos_x86_64",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:x86_64",
    ],
)

platform(
    name = "windows_x86_64",
    constraint_values = [
        "@platforms//os:windows",
        "@platforms//cpu:x86_64",
    ],
)

platform(
    name = "windows_x86_64_msvc",
    constraint_values = [
        "@platforms//os:windows",
        "@platforms//cpu:x86_64",
        "@llvm//constraints/windows/abi:msvc",
    ],
)

platform(
    name = "linux_x86_64_fips",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
        ":fips",
    ],
)

platform(
    name = "linux_arm64_fips",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:arm64",
        ":fips",
    ],
)

platform(
    name = "macos_arm64_fips",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:arm64",
        ":fips",
    ],
)

platform(
    name = "macos_x86_64_fips",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:x86_64",
        ":fips",
    ],
)

platform(
    name = "windows_x86_64_fips",
    constraint_values = [
        "@platforms//os:windows",
        "@platforms//cpu:x86_64",
        ":fips",
    ],
)
