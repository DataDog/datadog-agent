load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_foreign_cc//toolchains/native_tools:native_tools_toolchain.bzl", "native_tool_toolchain")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load(":windows_gnu.bzl", "windows_gnu_filegroup")

# Windows x86_64 with the MinGW ABI, for deps that only build with a GNU
# toolchain (OpenSSL). Their DLLs are consumed by windows_x86_64_msvc targets,
# hence UCRT, the C runtime of the MSVC ABI.
platform(
    name = "windows_x86_64_gnu",
    constraint_values = [
        "@llvm//constraints/windows/abi:gnu",
        "@llvm//constraints/windows/crt:ucrt",
        "@platforms//cpu:x86_64",
        "@platforms//os:windows",
    ],
)

# rules_foreign_cc's preinstalled make resolves to make.exe whenever the target
# is Windows, even on a Linux exec platform
# (https://github.com/bazel-contrib/rules_foreign_cc/issues/1268).
native_tool_toolchain(
    name = "make",
    path = "make",
)

toolchain(
    name = "linux_make_toolchain",
    exec_compatible_with = ["@platforms//os:linux"],
    target_compatible_with = ["@platforms//os:windows"],
    toolchain = ":make",
    toolchain_type = "@rules_foreign_cc//toolchains:make_toolchain",
)

# Checks that the toolchain's default stack protector, with __stack_chk_* from
# mingwex, aborts on a smashed stack.
cc_binary(
    name = "stack_smash",
    srcs = ["stack_smash.c"],
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:windows"],
)

windows_gnu_filegroup(
    name = "stack_smash_windows",
    srcs = [":stack_smash"],
    tags = ["manual"],
)

sh_test(
    name = "stack_protector_wine_test",
    srcs = ["stack_protector_wine_test.sh"],
    data = [
        ":stack_smash_windows",
        "//bazel/tools/wine:wine_run",
    ],
    env = {
        "STACK_SMASH": "$(rlocationpath :stack_smash_windows)",
        "WINE_RUN": "$(rlocationpath //bazel/tools/wine:wine_run)",
    },
    tags = ["manual"],
    target_compatible_with = select({
        "//:linux_arm64": [],
        "//:linux_x86_64": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = ["@rules_shell//shell/runfiles"],
)
