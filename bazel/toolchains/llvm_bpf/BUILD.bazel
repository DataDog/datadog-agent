"""LLVM/Clang toolchain for eBPF compilation."""

toolchain_type(
    name = "llvm_bpf_toolchain_type",
    visibility = ["//visibility:public"],
)

alias(
    name = "install",
    actual = select({
        "//:linux_x86_64": "@llvm_bpf_amd64//:install",
        "//:linux_arm64": "@llvm_bpf_arm64//:install",
    }),
    tags = ["manual"],
)
