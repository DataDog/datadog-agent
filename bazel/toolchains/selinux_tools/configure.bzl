"""Repository rule to autoonfigure a toolchain wrapping the SELinux userspace
policy tools -- `checkmodule` and `semodule_package` -- found on the exec
host's PATH (package `checkpolicy`/`policycoreutils` on most distros).
"""

_BUILD_TPL = """\
# This content is generated by //bazel/toolchains/selinux_tools:configure.bzl
load(":defs.bzl", "selinux_tools_toolchain")

toolchain_type(
    name = "selinux_tools_toolchain_type",
    visibility = ["//visibility:public"],
)

selinux_tools_toolchain(
    name = "selinux_tools_auto",
    checkmodule_path = "{checkmodule_path}",
    semodule_package_path = "{semodule_package_path}",
)

toolchain(
    name = "selinux_tools_toolchain",
    toolchain = ":selinux_tools_auto",
    toolchain_type = ":selinux_tools_toolchain_type",
    exec_compatible_with = {exec_compatible_with},
)
"""

def _selinux_tools_repo_impl(rctx):
    checkmodule_path = rctx.which("checkmodule")
    semodule_package_path = rctx.which("semodule_package")

    if rctx.attr.verbose:
        for tool_name, path in [("checkmodule", checkmodule_path), ("semodule_package", semodule_package_path)]:
            if path:
                print("Found %s at '%s'" % (tool_name, path))  # buildifier: disable=print
            else:
                print("No system %s found." % tool_name)  # buildifier: disable=print

    rctx.file("BUILD", _BUILD_TPL.format(
        checkmodule_path = str(checkmodule_path) if checkmodule_path else "",
        semodule_package_path = str(semodule_package_path) if semodule_package_path else "",
        exec_compatible_with = repr(rctx.attr.exec_compatible_with),
    ))
    rctx.template(
        "defs.bzl",
        Label("//bazel/toolchains/selinux_tools:defs.bzl.tpl"),
        executable = False,
    )

find_selinux_tools = repository_rule(
    implementation = _selinux_tools_repo_impl,
    doc = "Create a repository that defines a selinux_tools toolchain based on checkmodule/semodule_package found on the default $PATH.",
    local = True,
    environ = ["PATH"],
    attrs = {
        "exec_compatible_with": attr.string_list(
            doc = "exec_compatible_with list to apply to the created toolchain.",
        ),
        "verbose": attr.bool(
            doc = "If true, print status messages.",
        ),
    },
)
