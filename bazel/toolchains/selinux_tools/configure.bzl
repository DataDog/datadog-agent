"""Repository rule to autoconfigure a toolchain wrapping the SELinux userspace
policy tools -- `checkmodule` and `semodule_package` -- found on the exec
host's PATH (package `checkpolicy`/`policycoreutils` on most distros).

These two tools are always invoked together to compile a policy module (see
compile_selinux_policy in bazel/rules/selinux/selinux.bzl) and are Linux-only,
so a single toolchain locates both, unlike
bazel/toolchains/common:defs.bzl's make_toolchain_repository_rule which wraps
exactly one tool per toolchain.
"""

_BUILD_TPL = """\
# This content is generated by //bazel/toolchains/selinux_tools:configure.bzl
load(":defs.bzl", "is_selinux_tools_available", "selinux_tools_toolchain")

toolchain_type(
    name = "selinux_tools_toolchain_type",
    visibility = ["//visibility:public"],
)

selinux_tools_toolchain(
    name = "selinux_tools_auto",
    checkmodule_path = "{checkmodule_path}",
    semodule_package_path = "{semodule_package_path}",
)

toolchain(
    name = "selinux_tools_toolchain",
    toolchain = ":selinux_tools_auto",
    toolchain_type = ":selinux_tools_toolchain_type",
    exec_compatible_with = {exec_compatible_with},
)

# selinux_tools_missing_toolchain provides a fallback toolchain so that
# toolchain resolution can succeed even on exec platforms that do not have
# these tools (e.g. anything but Linux). If this toolchain is selected, a rule
# can examine the valid field of each ToolInfo to determine if the tools are
# really available.
selinux_tools_toolchain(
    name = "no_selinux_tools",
    checkmodule_path = "",
    semodule_package_path = "",
)

toolchain(
    name = "zzz_selinux_tools_missing_toolchain",  # keep name lexicographically last
    toolchain = ":no_selinux_tools",
    toolchain_type = ":selinux_tools_toolchain_type",
)

# Expose the availability of the actual tools as a flag, so we can create a
# config_setting from it.
is_selinux_tools_available(
    name = "is_selinux_tools_available",
    build_setting_default = {available},
)

# Expose the availability of the toolchain as a config_setting, so we can
# select() on it.
config_setting(
    name = "have_selinux_tools",
    flag_values = {{
        ":is_selinux_tools_available": "1",
    }},
    visibility = ["//visibility:public"],
)
"""

def _selinux_tools_repo_impl(rctx):
    checkmodule_path = rctx.which("checkmodule")
    semodule_package_path = rctx.which("semodule_package")
    available = bool(checkmodule_path) and bool(semodule_package_path)

    if rctx.attr.verbose:
        for tool_name, path in [("checkmodule", checkmodule_path), ("semodule_package", semodule_package_path)]:
            if path:
                print("Found %s at '%s'" % (tool_name, path))  # buildifier: disable=print
            else:
                print("No system %s found." % tool_name)  # buildifier: disable=print

    rctx.file("BUILD", _BUILD_TPL.format(
        checkmodule_path = str(checkmodule_path) if checkmodule_path else "",
        semodule_package_path = str(semodule_package_path) if semodule_package_path else "",
        exec_compatible_with = repr(rctx.attr.exec_compatible_with),
        available = "1" if available else "0",
    ))
    rctx.template(
        "defs.bzl",
        Label("//bazel/toolchains/selinux_tools:defs.bzl.tpl"),
        executable = False,
    )

find_selinux_tools = repository_rule(
    implementation = _selinux_tools_repo_impl,
    doc = "Create a repository that defines a selinux_tools toolchain based on checkmodule/semodule_package found on the default $PATH.",
    local = True,
    environ = ["PATH"],
    attrs = {
        "exec_compatible_with": attr.string_list(
            doc = "exec_compatible_with list to apply to the created toolchain.",
        ),
        "verbose": attr.bool(
            doc = "If true, print status messages.",
        ),
    },
)
