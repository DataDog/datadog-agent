"""Incoming go_library transition that keeps only the Go build tags its closure reads.

Wired into rules_go by bazel/patches/rules_go-project-library-tags.patch. Without it, every
distinct root tag set gets its own copy of every go_library below it.

closure_tags.bzl is regenerated by `dda inv tidy` (or `dda inv go.write-tag-manifest`).
"""

load(":closure_tags.bzl", "CLOSURE_TAGS", "TAG_UNIVERSE")

_TAGS = "@rules_go//go/config:tags"
_ORIGINAL_TAGS = "@rules_go//go/private/rules:original_tags"

# rules_go's _TAG_AFFECTS_STDLIB. Dropping one of these would compile a library against a
# different standard library than the one its binary links.
_STDLIB_TAGS = [
    "alpha",
    "appengine",
    "asan",
    "boringcrypto",
    "checknewoldreassignment",
    "cmd_go_bootstrap",
    "compiler_bootstrap",
    "debuglog",
    "debugtrace",
    "faketime",
    "gc",
    "gccgo",
    "generate",
    "gofuzz",
    "icu",
    "ignore",
    "internal",
    "internal_pie",
    "libfuzzer",
    "m68k",
    "math_big_pure_go",
    "msan",
    "netcgo",
    "netgo",
    "nethttpomithttp2",
    "nios2",
    "noopt",
    "osusergo",
    "purego",
    "race",
    "sh",
    "shbe",
    "static",
    "timetzdata",
    "tools",
]

_KEPT = {t: None for t in _STDLIB_TAGS}
_UNIVERSE = {t: None for t in TAG_UNIVERSE}

def _go_library_tags_transition_impl(settings, attr):
    tags = settings[_TAGS]
    original = settings[_ORIGINAL_TAGS]
    relevant = CLOSURE_TAGS.get(attr.importpath)
    if relevant == None:
        return {_TAGS: tags, _ORIGINAL_TAGS: original}

    # Tags outside the manifest's universe were never scanned for, so keep them.
    projected = [t for t in tags if t in relevant or t in _KEPT or t not in _UNIVERSE]
    before = json.decode(original) if original else tags
    return {
        _TAGS: projected,
        # non_go_transition restores `before` on cdeps and data. Leaving it unset when nothing
        # changed lets tag-free libraries share the command-line configuration.
        _ORIGINAL_TAGS: "" if sorted(projected) == sorted(before) else json.encode(before),
    }

go_library_tags_transition = transition(
    implementation = _go_library_tags_transition_impl,
    inputs = [_TAGS, _ORIGINAL_TAGS],
    outputs = [_TAGS, _ORIGINAL_TAGS],
)
