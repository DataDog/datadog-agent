"""Incoming go_library transition that drops the Go build tags of a library whose closure reads none.

Wired into rules_go by bazel/patches/rules_go-project-library-tags.patch. Without it, every
distinct root tag set gets its own copy of every go_library below it.

A library keeps either all of its tags or none, never a subset: a subset would be a configuration
no root has, and each configuration costs its own toolchain resolution.

closure_tags.bzl is regenerated by `dda inv tidy` (or `dda inv go.write-tag-manifest`). It omits import paths
whose closure reads no root tag.
"""

load("@rules_go//go/private/rules:transition.bzl", "TAG_AFFECTS_STDLIB")  # buildifier: disable=bzl-visibility
load(":closure_tags.bzl", "CLOSURE_TAGS", "TAG_UNIVERSE")

_TAGS = "@rules_go//go/config:tags"
_ORIGINAL_TAGS = "@rules_go//go/private/rules:original_tags"

# Dropping one of these would compile a library against a different standard library than the one
# its binary links.
_KEPT = set(TAG_AFFECTS_STDLIB)

_UNIVERSE = set(TAG_UNIVERSE)

def _go_library_tags_transition_impl(settings, attr):
    tags = settings[_TAGS]
    original = settings[_ORIGINAL_TAGS]
    unchanged = {_TAGS: tags, _ORIGINAL_TAGS: original}

    # A package added since the manifest was generated reads no tag until it is regenerated.
    relevant = CLOSURE_TAGS.get(attr.importpath, []) if attr.importpath else None
    if relevant == None:
        return unchanged

    # Tags outside the manifest's universe were never scanned for, so keep them.
    if [t for t in tags if t in relevant or t in _KEPT or t not in _UNIVERSE]:
        return unchanged

    # non_go_transition restores `before` on cdeps and data. Leaving it unset when it is empty lets
    # the library share the configuration of a tag-free root.
    before = json.decode(original) if original else tags
    return {_TAGS: [], _ORIGINAL_TAGS: json.encode(before) if before else ""}

go_library_tags_transition = transition(
    implementation = _go_library_tags_transition_impl,
    inputs = [_TAGS, _ORIGINAL_TAGS],
    outputs = [_TAGS, _ORIGINAL_TAGS],
)
