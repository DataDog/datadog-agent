filegroup(
    name = "runtime",
    srcs = [
        "bin/wine",
        "bin/wineserver",
    ] + glob(
        [
            # Two levels: lib/wine/<arch> and share/wine/<dir>, plus wine.inf.
            "lib/wine/*/*",
            "share/wine/*",
            "share/wine/*/*",
        ],
        # Static import libraries are only needed to build against Wine.
        exclude = ["lib/wine/*/*.a"],
    ),
    visibility = ["@//bazel/tools/wine:__pkg__"],
)

# Wine's message compiler, a Linux program, with the codepage tables it reads.
filegroup(
    name = "wmc",
    srcs = ["bin/wmc"],
    visibility = ["@//bazel/rules:__pkg__"],
)

filegroup(
    name = "nls",
    srcs = glob(["share/wine/nls/*.nls"]),
    visibility = ["@//bazel/rules:__pkg__"],
)
