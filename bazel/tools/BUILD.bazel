load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rules_python//python:py_binary.bzl", "py_binary")

py_binary(
    name = "generate_module_bazel",
    srcs = ["generate_module_bazel.py"],
    visibility = ["//deps:__subpackages__"],
)

# Nothing needs install_name_tool on windows, where this empty replacement avoids fetching LLVM.
write_file(
    name = "_empty_install_name_tool",
    out = "empty_install_name_tool",
    is_executable = True,
)

filegroup(
    name = "install_name_tool",
    srcs = select({
        "@platforms//os:linux": ["@llvm//tools:llvm-install-name-tool"],
        "@platforms//os:macos": ["@llvm//tools:llvm-install-name-tool"],
        "//conditions:default": [":_empty_install_name_tool"],
    }),
    visibility = ["//visibility:public"],
)

# Nothing needs readelf on windows, where this empty replacement avoids fetching LLVM.
write_file(
    name = "_empty_readelf",
    out = "empty_readelf",
    is_executable = True,
)

filegroup(
    name = "readelf",
    srcs = select({
        "@platforms//os:linux": ["@llvm//tools:llvm-readelf"],
        "@platforms//os:macos": ["@llvm//tools:llvm-readelf"],
        "//conditions:default": [":_empty_readelf"],
    }),
    visibility = ["//visibility:public"],
)
