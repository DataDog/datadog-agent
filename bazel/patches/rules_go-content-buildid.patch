+// contentBuildID derives the Go build ID from the link inputs, so distinct
+// binaries get distinct IDs and rebuilds stay reproducible. Since Go 1.24 the
+// linker also derives the ELF GNU build ID and the Mach-O LC_UUID from it.
+func contentBuildID(args []string, main string, archives []archive, stamps []string) (string, error) {
+	h := sha256.New()
+	io.WriteString(h, runtime.Version())
+	for _, a := range args {
+		io.WriteString(h, "\x00"+a)
+	}
+	files := append([]string{main}, stamps...)
+	for _, a := range archives {
+		files = append(files, a.file)
+	}
+	for _, name := range files {
+		f, err := os.Open(name)
+		if err != nil {
+			return "", err
+		}
+		_, err = io.Copy(h, f)
+		f.Close()
+		if err != nil {
+			return "", err
+		}
+	}
+	return hex.EncodeToString(h.Sum(nil)[:20]), nil
+}
