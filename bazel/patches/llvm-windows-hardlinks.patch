         return Label("//toolchain/llvm:llvm_release_windows.BUILD.bazel")
     return Label("//toolchain/llvm:llvm_release.BUILD.bazel")
 
+# Windows containers cannot start executables through symlinks on bind mounts (microsoft/Windows-Containers#634)
+_SYMLINKS_TO_HARDLINKS = " ".join([
+    "$ErrorActionPreference = 'Stop';",
+    "Get-ChildItem -Path bin -Filter *.exe | Where-Object { $_.LinkType -eq 'SymbolicLink' } | ForEach-Object {",
+    "$target = (Resolve-Path -LiteralPath ([IO.Path]::Combine($_.DirectoryName, [string]$_.Target))).Path;",
+    "Remove-Item -LiteralPath $_.FullName;",
+    "New-Item -ItemType HardLink -Path $_.FullName -Target $target | Out-Null",
+    "}",
+])
+
 def _get_index(module_ctx):
     index_file = Label(DEFAULT_LLVM_TOOLCHAIN_MINIMAL_INDEX_FILE)
     dependency_index_file = None
