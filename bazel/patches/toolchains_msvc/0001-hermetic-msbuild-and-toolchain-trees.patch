diff --git a/private/msbuild_repo.bzl b/private/msbuild_repo.bzl
new file mode 100644
index 0000000..1646fdd
--- /dev/null
+++ b/private/msbuild_repo.bzl
@@ -0,0 +1,98 @@
+"""Repository rule for downloading MSBuild and the VC project-system integration.
+
+MSBuild is shipped as VSIX payloads (plain zips) that all unpack into a
+``Contents/`` prefix mirroring the Visual Studio install layout. Overlaying every
+payload onto a single tree reproduces the ``MSBuild/`` directory of a VS install:
+
+    MSBuild/Current/Bin/amd64/MSBuild.exe   <- engine
+    MSBuild/Microsoft/VC/v170/**            <- C++ props/targets (VCTargetsPath)
+"""
+
+def _package_url(package_urls, pkg):
+    sha256 = pkg.get("sha256")
+    url = package_urls.get(sha256)
+    if not url:
+        fail("Missing URL for MSBuild package '{}' ({})".format(pkg.get("filename"), sha256))
+    return url
+
+def _msbuild_repo_impl(ctx):
+    """Implementation of the msbuild_repo rule."""
+    if ctx.attr.error:
+        fail(ctx.attr.error)
+
+    packages = json.decode(ctx.attr.packages)
+    package_urls = json.decode(ctx.attr.package_urls)
+    extracted_package_filenames = []
+
+    # Create the destination with the exact casing the BUILD file refers to:
+    # payloads disagree ("MSBuild" vs "Msbuild") and Bazel labels are
+    # case-sensitive even where the filesystem is not.
+    ctx.file("MSBuild/.keep", "")
+
+    for index, pkg in enumerate(packages):
+        filename = pkg.get("filename")
+        ctx.report_progress("Downloading and Extracting {}".format(filename))
+
+        staging = "tmp/{}".format(index)
+        ctx.download_and_extract(
+            url = _package_url(package_urls, pkg),
+            sha256 = pkg.get("sha256"),
+            output = staging,
+            type = "zip",
+        )
+
+        contents = ctx.path("{}/Contents".format(staging))
+        if not contents.exists:
+            fail("MSBuild payload '{}' has no Contents/ directory".format(filename))
+
+        result = ctx.execute([
+            "cmd",
+            "/c",
+            "xcopy",
+            "/e",
+            "/i",
+            "/y",
+            "/q",
+            "{}\\*".format(str(contents).replace("/", "\\")),
+            ".",
+        ])
+        if result.return_code != 0:
+            fail("Overlaying '{}' failed (exit {}): {}".format(filename, result.return_code, result.stderr))
+
+        extracted_package_filenames.append(filename)
+
+    ctx.delete("tmp")
+    ctx.delete("MSBuild/.keep")
+
+    ctx.file(
+        "package.txt",
+        "\n".join(extracted_package_filenames) + ("\n" if extracted_package_filenames else ""),
+    )
+
+    ctx.template(
+        "BUILD.bazel",
+        ctx.attr.src_build,
+        substitutions = {
+            "{toolset_dir}": ctx.attr.toolset_dir,
+        },
+    )
+
+    return ctx.repo_metadata(reproducible = True)
+
+msbuild_repo = repository_rule(
+    implementation = _msbuild_repo_impl,
+    attrs = {
+        "packages": attr.string(mandatory = True, doc = "JSON string list of package dicts"),
+        "package_urls": attr.string(mandatory = True, doc = "JSON string map from sha256 to URL"),
+        "error": attr.string(mandatory = True),
+        "toolset_dir": attr.string(
+            default = "v170",
+            doc = "VC toolset directory under MSBuild/Microsoft/VC (e.g. v170 for VS 2022).",
+        ),
+        "src_build": attr.label(
+            default = Label("//overlays/msbuild:BUILD.root.tpl"),
+            allow_single_file = True,
+            doc = "Label to BUILD.root.tpl",
+        ),
+    },
+)
