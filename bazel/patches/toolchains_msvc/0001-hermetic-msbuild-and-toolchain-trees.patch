+# The MSBuild engine and the C++ project system are not part of the
+# Microsoft.VC.<version>.* package set, so they are requested by name.
+_MSBUILD_ENGINE_PACKAGE_IDS = [
+    "Microsoft.Build",
+    # Tracker.exe / FileTracker*.dll, required by the VC targets for up-to-date checks.
+    "Microsoft.Build.Dependencies",
+]
+
+def _highest_v_suffix(candidates):
+    """Returns the "v<N>" string with the greatest N, or None when empty."""
+    best = None
+    best_value = -1
+    for candidate in candidates:
+        digits = candidate[1:]
+        if not digits.isdigit():
+            continue
+        value = int(digits)
+        if value > best_value:
+            best = candidate
+            best_value = value
+    return best
+
+def detect_vc_msbuild_toolset(packages_map, targets):
+    """Detects the newest VC project-system toolset available in a manifest.
+
+    Derived from the manifest rather than hardcoded so that a new Visual Studio
+    line (and its PlatformToolset) does not need a code change here.
+
+    Args:
+        packages_map: The map of package IDs to package data.
+        targets: List of target architectures; the first one is probed.
+
+    Returns:
+        A tuple (toolset_dir, platform_toolset), e.g. ("v170", "v143").
+    """
+    prefix = "Microsoft.VisualStudio.VC.MSBuild.".lower()
+    suffix = ".base"
+
+    toolset_dirs = []
+    for pkg_id in packages_map:
+        if pkg_id.startswith(prefix) and pkg_id.endswith(suffix):
+            remainder = pkg_id[len(prefix):-len(suffix)]
+            if remainder.startswith("v") and "." not in remainder:
+                toolset_dirs.append(remainder)
+
+    toolset_dir = _highest_v_suffix(toolset_dirs)
+    if not toolset_dir:
+        fail("Visual Studio manifest has no Microsoft.VisualStudio.VC.MSBuild.<toolset>.Base package")
+
+    target_prefix = "{}{}.{}.".format(prefix, toolset_dir, targets[0].lower())
+    platform_toolsets = []
+    for pkg_id in packages_map:
+        if pkg_id.startswith(target_prefix):
+            platform_toolsets.append(pkg_id[len(target_prefix):])
+
+    platform_toolset = _highest_v_suffix(platform_toolsets)
+    if not platform_toolset:
+        fail("Visual Studio manifest has no PlatformToolset package for {} / {}".format(toolset_dir, targets[0]))
+
+    return toolset_dir, platform_toolset
+
+def get_msbuild_package_ids(packages_map, toolset_dir, platform_toolset, targets):
+    """Returns package IDs providing MSBuild and the VC project-system integration.
+
+    Args:
+        packages_map: The map of package IDs to package data.
+        toolset_dir: VC toolset directory, e.g. "v170" for VS 2022.
+        platform_toolset: PlatformToolset name, e.g. "v143".
+        targets: List of target architectures to include.
+
+    Returns:
+        A list of lowercased package IDs present in ``packages_map``.
+    """
+    wanted = list(_MSBUILD_ENGINE_PACKAGE_IDS)
+    wanted.append("Microsoft.VisualStudio.VC.MSBuild.{}.Base".format(toolset_dir))
+    for target in targets:
+        wanted.append("Microsoft.VisualStudio.VC.MSBuild.{}.{}".format(toolset_dir, target))
+        wanted.append("Microsoft.VisualStudio.VC.MSBuild.{}.{}.{}".format(toolset_dir, target, platform_toolset))
+
+    ids = []
+    missing = []
+    for pkg_id in wanted:
+        key = pkg_id.lower()
+        if key in packages_map:
+            ids.append(key)
+        else:
+            missing.append(pkg_id)
+
+    if missing:
+        fail("Visual Studio manifest has no MSBuild packages: {}".format(", ".join(missing)))
+
+    return ids
+
