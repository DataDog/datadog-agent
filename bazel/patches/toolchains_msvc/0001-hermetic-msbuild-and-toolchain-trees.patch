+
+# Contains the full toolset version (VCToolsVersion), and doubles as the anchor
+# for VCToolsInstallDir.
+alias(
+    name = "version_marker",
+    actual = {marker},
+)
+""".format(
+        tree = _select_list("msvc", msvc_versions, lambda v: "@msvc_{}//:toolchain_tree".format(v)),
+        marker = _select_label("msvc", msvc_versions, lambda v: "@msvc_{}//:vctools_version.txt".format(v)),
+    )
+    ctx.file("msvc/tree/BUILD.bazel", msvc_content)
+
+    winsdk_content = """package(default_visibility = ["//visibility:public"])
+
+filegroup(
+    name = "toolchain_tree",
+    srcs = {tree},
+)
+
+alias(
+    name = "root_marker",
+    actual = {marker},
+)
+""".format(
+        tree = _select_list("winsdk", winsdk_versions, lambda v: "@winsdk_{}//:toolchain_tree".format(v)),
+        marker = _select_label("winsdk", winsdk_versions, lambda v: "@winsdk_{}//:package.txt".format(v)),
+    )
+    ctx.file("winsdk/tree/BUILD.bazel", winsdk_content)
+
+    ctx.file("msbuild/BUILD.bazel", """package(default_visibility = ["//visibility:public"])
+
+alias(
+    name = "msbuild",
+    actual = "@msbuild//:msbuild",
+)
+
+filegroup(
+    name = "toolchain_tree",
+    srcs = ["@msbuild//:toolchain_tree"],
+)
+
+# Anchor for VCTargetsPath.
+alias(
+    name = "vctargets_marker",
+    actual = "@msbuild//:vctargets_marker",
+)
+""")
+
