+package(default_visibility = ["//visibility:public"])
+
+exports_files(
+    glob(["**/*"]),
+    visibility = ["//visibility:public"],
+)
+
+# The amd64 engine, not Bin/MSBuild.exe: the 32-bit engine runs out of address
+# space on large project graphs.
+alias(
+    name = "msbuild",
+    actual = "MSBuild/Current/Bin/amd64/MSBuild.exe",
