diff --git a/toolchain/runtimes/go_settings_reset.bzl b/toolchain/runtimes/go_settings_reset.bzl
new file mode 100644
index 0000000..1831296
--- /dev/null
+++ b/toolchain/runtimes/go_settings_reset.bzl
@@ -0,0 +1,22 @@
+"""rules_go settings that runtimes never read but that fork their configuration.
+
+Mirrors _reset_transition_dict in rules_go's go/private/rules/transition.bzl.
+"""
+
+GO_SETTINGS_RESET = {
+    str(Label("@llvm_rules_go//go/private:bootstrap_nogo")): False,
+    str(Label("@llvm_rules_go//go/config:static")): False,
+    str(Label("@llvm_rules_go//go/config:msan")): False,
+    str(Label("@llvm_rules_go//go/config:race")): False,
+    str(Label("@llvm_rules_go//go/config:pure")): False,
+    str(Label("@llvm_rules_go//go/config:debug")): False,
+    str(Label("@llvm_rules_go//go/config:linkmode")): "auto",
+    str(Label("@llvm_rules_go//go/config:tags")): [],
+    str(Label("@llvm_rules_go//go/config:pgoprofile")): Label("@llvm_rules_go//go/config:empty"),
+    str(Label("@llvm_rules_go//go/private/rules:original_msan")): "",
+    str(Label("@llvm_rules_go//go/private/rules:original_race")): "",
+    str(Label("@llvm_rules_go//go/private/rules:original_pure")): "",
+    str(Label("@llvm_rules_go//go/private/rules:original_linkmode")): "",
+    str(Label("@llvm_rules_go//go/private/rules:original_tags")): "",
+    str(Label("@llvm_rules_go//go/private/rules:original_pgoprofile")): "",
+}
