load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("@rules_python//python:py_binary.bzl", "py_binary")
load(":check_for_symbols_test.bzl", "check_for_symbols_test_suite")

py_binary(
    name = "checker",
    srcs = ["checker.py"],
    visibility = ["//visibility:public"],
)

# Used by the rule's own analysis tests as a stand-in for a real Go binary.
# Not meant to be built/run directly.
go_library(
    name = "test_binary_lib",
    srcs = ["testdata/main.go"],
    importpath = "github.com/DataDog/datadog-agent/bazel/rules/check_for_symbols/testdata",
    tags = ["manual"],
)

go_binary(
    name = "test_binary",
    embed = [":test_binary_lib"],
    tags = ["manual"],
)

check_for_symbols_test_suite(name = "_check_for_symbols_tests")
