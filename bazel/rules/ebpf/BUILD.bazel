load("@bazel_skylib//rules:common_settings.bzl", "string_flag")
load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_python//python:py_test.bzl", "py_test")
load("//bazel/rules/ebpf:cgo_godefs_test.bzl", "cgo_godefs_test_suite")

py_binary(
    name = "clang_with_unused_inputs",
    srcs = ["clang_with_unused_inputs.py"],
    visibility = ["//visibility:private"],
)

py_test(
    name = "clang_with_unused_inputs_test",
    srcs = [
        "clang_with_unused_inputs.py",
        "clang_with_unused_inputs_test.py",
    ],
    main = "clang_with_unused_inputs_test.py",
)

string_flag(
    name = "target_arch",
    build_setting_default = "",
    visibility = ["//visibility:public"],
)

config_setting(
    name = "target_arch_aarch64",
    flag_values = {":target_arch": "aarch64"},
    visibility = ["//pkg/ebpf:__pkg__"],
)

config_setting(
    name = "target_arch_x86_64",
    flag_values = {":target_arch": "x86_64"},
)

cgo_godefs_test_suite(name = "cgo_godefs_tests")

# cgo_godefs uses these from cfg = "exec" attributes. A select() there would
# resolve against the target platform; through an alias it resolves against
# the exec platform, so Windows types can be generated on Linux and macOS.
alias(
    name = "godefs_cc",
    actual = select({
        "@platforms//os:windows": "@winlibs_mingw64//:gcc",
        "//conditions:default": "@llvm//tools:clang",
    }),
    visibility = ["//visibility:public"],
)

alias(
    name = "godefs_cc_data",
    actual = select({
        "@platforms//os:windows": ":empty",
        "//conditions:default": "@llvm//:builtin_resource_dir",
    }),
    visibility = ["//visibility:public"],
)

# Windows headers for clang; the gcc used on Windows exec brings its own.
alias(
    name = "godefs_mingw_sysroot",
    actual = select({
        "@platforms//os:windows": ":empty",
        "//conditions:default": "@winlibs_mingw64//:mingw_headers",
    }),
    visibility = ["//visibility:public"],
)

filegroup(name = "empty")
