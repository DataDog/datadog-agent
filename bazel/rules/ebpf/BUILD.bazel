load("@bazel_skylib//rules:common_settings.bzl", "string_flag")
load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_python//python:py_test.bzl", "py_test")
load("//bazel/rules/ebpf:cgo_godefs_test.bzl", "cgo_godefs_test_suite")

py_binary(
    name = "clang_with_unused_inputs",
    srcs = ["clang_with_unused_inputs.py"],
    visibility = ["//visibility:private"],
)

py_test(
    name = "clang_with_unused_inputs_test",
    srcs = [
        "clang_with_unused_inputs.py",
        "clang_with_unused_inputs_test.py",
    ],
    main = "clang_with_unused_inputs_test.py",
)

py_binary(
    name = "check_unused_inputs",
    srcs = ["check_unused_inputs.py"],
    visibility = ["//visibility:private"],
)

py_test(
    name = "check_unused_inputs_test",
    srcs = [
        "check_unused_inputs.py",
        "check_unused_inputs_test.py",
    ],
    main = "check_unused_inputs_test.py",
)

string_flag(
    name = "target_arch",
    build_setting_default = "",
    visibility = ["//visibility:public"],
)

config_setting(
    name = "target_arch_aarch64",
    flag_values = {":target_arch": "aarch64"},
)

config_setting(
    name = "target_arch_x86_64",
    flag_values = {":target_arch": "x86_64"},
)

cgo_godefs_test_suite(name = "cgo_godefs_tests")
