load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load(":template_expand_test.bzl", "template_test_suite")

sh_binary(
    name = "replace_prefix",
    srcs = ["replace_prefix.sh"],
    args = select({
        "@platforms//os:linux": [
            "--patchelf",
            "$(rootpath @patchelf)",
        ],
        "@platforms//os:macos": [
            "--install-name-tool",
            "$(rootpath @llvm//tools:llvm-install-name-tool)",
        ],
        "//conditions:default": [],
    }),
    data = select({
        "@platforms//os:linux": ["@patchelf"],
        "@platforms//os:macos": ["@llvm//tools:llvm-install-name-tool"],
        "//conditions:default": [],
    }),
    tags = ["manual"],
)

template_test_suite(name = "_dd_agent_expand_template_tests")

# Message compilers for windows_resources.bzl, selected on the exec platform
alias(
    name = "windows_message_compiler",
    actual = select({
        "@platforms//os:linux": "@wine_linux_x86_64//:wmc",
        "@platforms//os:windows": "@winlibs_mingw64//:windmc",
    }),
    tags = ["manual"],
)

filegroup(
    name = "windows_message_compiler_codepages",
    srcs = select({
        "@platforms//os:linux": ["@wine_linux_x86_64//:nls"],
        "//conditions:default": [],
    }),
)
