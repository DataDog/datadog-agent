+// researchTraceAnomalyGate observes existing branch outcomes. It does not call
+// mutating baseline methods, scorer methods, or re-enter scorer locks.
+func (e *engine) researchTraceAnomalyGate(reason string, dataTime int64, detector string, a observerdef.Anomaly) {
+	if !researchTraceActive() {
+		return
+	}
+	fields := map[string]any{
+		"reason": reason, "detector": detector, "anomaly_detector": a.DetectorName,
+		"source": a.Source.DisplayName(), "namespace": a.Source.Namespace,
+		"source_ref": a.SourceRef, "series_id": seriesID(a),
+		"score": a.Score, "anomaly_timestamp": a.Timestamp, "advance_data_time": dataTime,
+		"baseline_enabled": e.baseline != nil, "scorer_present": e.scorer != nil,
+	}
+	if e.scorer != nil {
+		// Config is immutable after scorer construction.
+		level := anomalyLevel(a, e.scorer.config.AnomalyScorerConfig)
+		fields["prospective_level"] = level
+		fields["prospective_weight"] = levelWeights[level]
+	}
+	if e.baseline != nil {
+		fields["baseline_config"] = e.baseline.config
+		fields["baseline_muted_count"] = len(e.baseline.mutedHashes)
+		if state := e.baseline.detectors[detector]; state != nil {
+			fields["baseline_ready"] = state.ready
+			fields["baseline_warmup_end"] = state.warmupEndSec
+			fields["baseline_end"] = state.baselineEndSec
+			fields["baseline_complete"] = state.completed
+		}
+	}
+	researchTraceGlobal("engine_anomaly_gate", dataTime, fields)
+}
