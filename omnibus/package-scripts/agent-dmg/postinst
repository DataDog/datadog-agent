#!/bin/sh
#
# Perform necessary datadog-agent setup steps after package is installed.
#
# The installer does the install, as for deb and rpm: `installer postinst datadog-agent dmg` sets up
# the Agent's account, directories, configuration, application, links and GUI, and loads its
# LaunchDaemons. See pkg/fleet/installer/packages/datadog_agent_darwin_dmg.go. This script only
# loads the Agent's LaunchDaemons itself when the installer is missing or fails.

INSTALL_DIR=/opt/datadog-agent

# On Mac, the real log folder is located under /opt/datadog-agent/logs, because MacOS upgrades delete /var/log
LOG_DIR=/opt/datadog-agent/logs

# Let's log the standard outputs of this script
LOG_FILE="$LOG_DIR/postinstall.log"
mkdir -vp $LOG_DIR
chmod 750 $LOG_DIR
exec > $LOG_FILE 2>&1

# The stable LaunchDaemons the Agent needs, in load order, and the root-owned directory the package
# ships plain copies of their definitions in. These copies are the very files the installer embeds
# (pkg/fleet/installer/packages/embedded/tmpl/gen/darwin), so the fallback below installs exactly
# what `installer postinst` would have. They live under embedded/, which stays root-owned, never
# under etc/, which belongs to the Agent's account: anything copied into /Library/LaunchDaemons is
# run by launchd as root.
FALLBACK_JOBS_DIR="$INSTALL_DIR/embedded/share/launchd"
FALLBACK_JOBS="com.datadoghq.procmgr com.datadoghq.agent com.datadoghq.sysprobe com.datadoghq.data-plane"

# install_fallback_launchdaemons installs and loads the Agent's stable LaunchDaemons without the
# installer: copy, chown, chmod, enable, bootstrap, as versions before the installer did. Every job
# is reloaded, even one already loaded from the shipped definition: it only runs after the installer
# failed, which may have left a job on its way out of the domain. Every job is attempted even if an
# earlier one fails; it returns non-zero if any of them is not loaded at the end.
install_fallback_launchdaemons() {
    failed=""
    for label in $FALLBACK_JOBS; do
        src="$FALLBACK_JOBS_DIR/$label.plist"
        dst="/Library/LaunchDaemons/$label.plist"
        if [ ! -f "$src" ] || [ -L "$src" ]; then
            echo "ERROR: $src is missing; cannot install the $label LaunchDaemon"
            failed="$failed $label"
            continue
        fi
        echo "# Installing $label as a system-wide LaunchDaemon (fallback)"
        launchctl bootout "system/$label" 2>/dev/null || true
        # bootout returns before the job has left the domain, and bootstrapping it before then fails.
        attempts=0
        while [ $attempts -lt 30 ] && launchctl print "system/$label" >/dev/null 2>&1; do
            sleep 1
            attempts=$((attempts + 1))
        done
        if launchctl print "system/$label" >/dev/null 2>&1; then
            echo "ERROR: $label is still loaded after bootout; not replacing its definition"
            failed="$failed $label"
            continue
        fi
        rm -f "$dst"
        cp -f "$src" "$dst"
        chown root:wheel "$dst"
        chmod 644 "$dst"
        launchctl enable "system/$label" 2>/dev/null || true
        if ! launchctl bootstrap system "$dst" 2>&1; then
            echo "ERROR: Failed to bootstrap $label."
            failed="$failed $label"
            continue
        fi
        launchctl kickstart "system/$label" 2>/dev/null || true
    done
    if [ -n "$failed" ]; then
        echo "ERROR: Could not install these LaunchDaemons:$failed"
        return 1
    fi
}

echo "# State at the beginning"
echo "## Agent version"
$INSTALL_DIR/bin/agent/agent version || true

# A LaunchDaemon the fallback can't load is reported in the install log but doesn't fail the
# install. This keeps the behavior of earlier versions, which only printed a warning when a
# bootstrap failed. Failing here would make macOS installs stricter than they have ever been, and
# would roll back the binaries this install just laid down, on every Mac it reaches.
INSTALLER_BIN="$INSTALL_DIR/embedded/bin/installer"
if [ -x "$INSTALLER_BIN" ]; then
    if "$INSTALLER_BIN" postinst datadog-agent dmg 2>&1; then
        echo "# The installer postinst succeeded"
    else
        echo "WARNING: The installer postinst failed; falling back to installing the Agent's LaunchDaemons directly. The configuration, permissions and GUI may be incomplete."
        install_fallback_launchdaemons
    fi
else
    echo "WARNING: $INSTALLER_BIN missing; falling back to installing the Agent's LaunchDaemons directly."
    install_fallback_launchdaemons
fi

echo "# State at the end"
echo "## Agent version"
$INSTALL_DIR/bin/agent/agent version || true

exit 0
