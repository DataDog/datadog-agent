#!/bin/sh
#
# Perform necessary datadog-agent setup steps before package is installed.
#

INSTALL_DIR=/opt/datadog-agent

# macOS deletes /var/log on OS upgrades, so the real log folder is
# /opt/datadog-agent/logs with a symlink from /var/log/datadog.
LOG_DIR=/opt/datadog-agent/logs

CONF_DIR="$INSTALL_DIR/etc"
AI_USAGE_DESKTOP_MONITOR_LABEL="com.datadoghq.ai-usage-agent.desktop-monitor"
OLD_AI_USAGE_DESKTOP_MONITOR_LABEL="com.datadoghq.ai-prompt-logger.desktop-monitor"

mkdir -p $LOG_DIR
chmod 750 $LOG_DIR

LOG_FILE="$LOG_DIR/preinstall.log"
exec > $LOG_FILE 2>&1

cleanup_per_user_installations() {
    echo '# Checking for legacy per-user installations'
    local failed=false

    for user_home in /Users/*; do
        [ -d "$user_home/Library/LaunchAgents" ] || continue
        local username
        username=$(basename "$user_home")
        [ "$username" = "Shared" ] && continue
        local uid
        uid=$(id -u "$username" 2>/dev/null) || continue
        [ "$uid" -ge 500 ] || continue

        local agent_plist="$user_home/Library/LaunchAgents/com.datadoghq.agent.plist"
        local gui_plist="$user_home/Library/LaunchAgents/com.datadoghq.gui.plist"

        if [ -f "$agent_plist" ] || [ -f "$gui_plist" ]; then
            echo "Per-user Datadog Agent installation detected for user '$username' (UID $uid)"

            # Stop services (best-effort — user may not be logged in)
            launchctl bootout "gui/$uid/com.datadoghq.agent" 2>/dev/null || true
            launchctl bootout "gui/$uid/com.datadoghq.gui" 2>/dev/null || true

            # Remove plists
            rm -f "$agent_plist"
            rm -f "$gui_plist"

            # Verify: plists must be gone AND services must no longer be registered.
            # launchctl bootout is asynchronous — poll until the services are
            # fully unregistered (1s intervals, 10s max) before declaring failure.
            if [ -f "$agent_plist" ] || [ -f "$gui_plist" ]; then
                echo "ERROR: Failed to remove per-user plists for user '$username'"
                failed=true
            else
                local attempts=0
                while [ $attempts -lt 10 ]; do  # 10 * 1s = 10 seconds
                    if ! launchctl print "gui/$uid/com.datadoghq.agent" >/dev/null 2>&1 &&
                       ! launchctl print "gui/$uid/com.datadoghq.gui" >/dev/null 2>&1; then
                        break
                    fi
                    sleep 1
                    attempts=$((attempts + 1))
                done
                if ! launchctl print "gui/$uid/com.datadoghq.agent" >/dev/null 2>&1 &&
                   ! launchctl print "gui/$uid/com.datadoghq.gui" >/dev/null 2>&1; then
                    echo "Cleaned up per-user installation for user '$username'"
                else
                    launchctl print "gui/$uid/com.datadoghq.agent" >/dev/null 2>&1 &&
                        echo "ERROR: Per-user agent service still registered with launchctl for user '$username' after 10s"
                    launchctl print "gui/$uid/com.datadoghq.gui" >/dev/null 2>&1 &&
                        echo "ERROR: Per-user GUI service still registered with launchctl for user '$username' after 10s"
                    failed=true
                fi
            fi
        fi
    done

    if [ "$failed" = true ]; then
        echo "ERROR: Could not fully remove per-user Datadog Agent installation(s)."
        echo "Please uninstall the Agent manually before installing this version:"
        echo "    https://docs.datadoghq.com/agent/supported_platforms/osx/#uninstall-the-agent"
        exit 1
    fi
}

cleanup_per_user_installations

# Stop running services and save config if an existing installation is present
if [ -e "$CONF_DIR/datadog.yaml" ]; then
    echo "# Existing installation detected"
    datadog-agent version || true

    # The installer daemon goes first and is waited for: while it runs it can start installer
    # commands, and, in builds that ran configuration experiments, the detached processes killed
    # below.
    stop_installer_daemons() {
        launchctl bootout system/com.datadoghq.installer 2>/dev/null || true
        launchctl bootout system/com.datadoghq.installer-exp 2>/dev/null || true
        attempts=0
        while [ $attempts -lt 30 ] && { launchctl print system/com.datadoghq.installer >/dev/null 2>&1 || launchctl print system/com.datadoghq.installer-exp >/dev/null 2>&1; }; do
            sleep 1
            attempts=$((attempts + 1))
        done
    }
    stop_installer_daemons

    # The detached processes a configuration experiment runs outside of any launchd job: the
    # watcher and the installer daemon hand-back. Either could otherwise swap jobs back in while
    # this upgrade replaces the binaries they run. Killed outright: whatever they leave half done is
    # undone by the bootouts below and by the postinstall script.
    pkill -9 -f "$INSTALL_DIR/embedded/bin/installer package-command datadog-agent (watchConfigExperiment|handBackInstaller)" 2>/dev/null || true

    # A detached process killed above may have loaded an installer daemon back while we waited for
    # the first bootout; nothing can load one now, so unload them again. As with the other jobs,
    # one that still won't leave is reported and doesn't fail the upgrade.
    stop_installer_daemons
    if launchctl print system/com.datadoghq.installer >/dev/null 2>&1 || launchctl print system/com.datadoghq.installer-exp >/dev/null 2>&1; then
        echo "WARNING: The installer daemon is still loaded after bootout."
    fi

    # Hand the teardown to the installed version, as the rpm preinst does: only it knows the jobs
    # it installed, including any this version no longer does. Its payload is still in place, since
    # this script runs before the new one is laid down. Bounded, because Installer.app shows no
    # progress while it waits; each job's bootout is itself bounded at 30 seconds.
    # See preRemoveDatadogAgent in pkg/fleet/installer/packages/datadog_agent_darwin.go
    OLD_INSTALLER_BIN="$INSTALL_DIR/embedded/bin/installer"
    if [ -x "$OLD_INSTALLER_BIN" ] && "$OLD_INSTALLER_BIN" is-prerm-supported >/dev/null 2>&1; then
        echo "# Running the installed version's pre-remove"
        "$OLD_INSTALLER_BIN" prerm --upgrade datadog-agent dmg 2>&1 &
        prerm_pid=$!
        attempts=0
        while [ $attempts -lt 180 ] && kill -0 $prerm_pid 2>/dev/null; do
            sleep 1
            attempts=$((attempts + 1))
        done
        if kill -0 $prerm_pid 2>/dev/null; then
            echo "WARNING: The installed version's pre-remove did not finish within 180s; stopping it."
            kill -9 $prerm_pid 2>/dev/null || true
            # Reaped quietly: the shell would otherwise log its own "Killed: 9" for it, and the
            # warning above already says what happened.
            wait $prerm_pid 2>/dev/null || true
        else
            wait $prerm_pid
            prerm_status=$?
            if [ $prerm_status -ne 0 ]; then
                echo "WARNING: The installed version's pre-remove failed (exit status $prerm_status)."
            fi
        fi
    fi

    # The jobs this version knows the Agent has run. They are booted out whether or not the
    # installed version's pre-remove ran: versions before the installer have none, and one that
    # failed may have left jobs behind. A job already gone is a no-op.
    echo '# Stopping running services'
    launchctl bootout system/com.datadoghq.procmgr 2>/dev/null || true
    launchctl bootout system/com.datadoghq.agent 2>/dev/null || true
    launchctl bootout system/com.datadoghq.sysprobe 2>/dev/null || true
    launchctl bootout system/com.datadoghq.data-plane 2>/dev/null || true

    # The experiment variants of the jobs only exist while a configuration experiment is running;
    # booting them out here is what keeps an upgrade from leaving an Agent behind that reads
    # etc-exp.
    launchctl bootout system/com.datadoghq.agent-exp 2>/dev/null || true
    launchctl bootout system/com.datadoghq.sysprobe-exp 2>/dev/null || true
    launchctl bootout system/com.datadoghq.data-plane-exp 2>/dev/null || true
    rm -vf /Library/LaunchDaemons/com.datadoghq.installer.plist
    rm -vf /Library/LaunchDaemons/com.datadoghq.installer-exp.plist
    rm -vf /Library/LaunchDaemons/com.datadoghq.agent-exp.plist
    rm -vf /Library/LaunchDaemons/com.datadoghq.sysprobe-exp.plist
    rm -vf /Library/LaunchDaemons/com.datadoghq.data-plane-exp.plist

    # Stop GUI for all logged-in users
    for logged_user in $(who | awk '{print $1}' | sort -u); do
        logged_uid=$(id -u "$logged_user" 2>/dev/null) || continue
        launchctl bootout "gui/$logged_uid/com.datadoghq.gui" 2>/dev/null || true
        launchctl bootout "gui/$logged_uid/$AI_USAGE_DESKTOP_MONITOR_LABEL" 2>/dev/null || true
        launchctl bootout "gui/$logged_uid/$OLD_AI_USAGE_DESKTOP_MONITOR_LABEL" 2>/dev/null || true
    done
    kill $(pgrep -f 'Datadog Agent.app') 2>/dev/null || true
    pkill -f 'ai-usage-agent-native-host.*--desktop-monitor' 2>/dev/null || true
    pkill -f 'ai-prompt-logger-native-host.*--desktop-monitor' 2>/dev/null || true

    # Save existing config for restoration in postinst.
    # All install-time staging data lives under a single root-only directory.
    INSTALL_STAGING_DIR="/private/var/root/datadog-install"
    SAVED_CONF_DIR="$INSTALL_STAGING_DIR/saved-conf"
    rm -rvf "$SAVED_CONF_DIR"
    mkdir -vp "$SAVED_CONF_DIR/conf.d"
    mkdir -vp "$SAVED_CONF_DIR/checks.d"
    chmod 700 "$INSTALL_STAGING_DIR"
    cp -vf $CONF_DIR/datadog.yaml "$SAVED_CONF_DIR/"
    cp -vf $CONF_DIR/system-probe.yaml "$SAVED_CONF_DIR/" 2>/dev/null || true
    cp -vfR $CONF_DIR/conf.d/* "$SAVED_CONF_DIR/conf.d" 2>/dev/null || true
    find "$SAVED_CONF_DIR/conf.d" '(' -name '*.yaml.example' -o -name '*.yaml.default' ')' -delete
    cp -vfR $CONF_DIR/checks.d/* "$SAVED_CONF_DIR/checks.d" 2>/dev/null || true
fi

# The account, the log link, the old files and the links are set up by the new version's installer,
# from the postinstall script: `installer postinst datadog-agent dmg`. See
# pkg/fleet/installer/packages/datadog_agent_darwin_dmg.go
exit 0
