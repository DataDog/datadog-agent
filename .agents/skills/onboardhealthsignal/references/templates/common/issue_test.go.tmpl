package __PKG__

import (
	"regexp"
	"strings"
	"testing"

	"github.com/DataDog/agent-payload/v5/healthplatform"
	"github.com/stretchr/testify/assert"
	"github.com/stretchr/testify/require"
)

var snakeCase = regexp.MustCompile(`^[a-z][a-z0-9_]*$`)

func TestIdentityConstants(t *testing.T) {
	assert.Regexp(t, `^[A-Z][a-zA-Z0-9 -]*$`, IssueName)
	assert.Equal(t, strings.ToLower(strings.ReplaceAll(IssueName, " ", "_")), IssueType)
	assert.Regexp(t, `^[a-z0-9]+(-[a-z0-9]+)*$`, IssueID)
}

func TestBuildIssue(t *testing.T) {
	tests := []struct {
		name            string
		context         map[string]string
		wantTitle       string
		wantDescription string
		wantFirstStep   string
		wantExtra       map[string]any
	}{
__ISSUE_TEST_CASES__
	}
	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			issue, err := __TYPE_STRUCT__{}.BuildIssue(tt.context)
			require.NoError(t, err)

			// BuildIssue never sets the issue ID; the runner or reporter does.
			assert.Empty(t, issue.Id)
			assert.Equal(t, IssueName, issue.IssueName)
			assert.Equal(t, IssueType, issue.IssueType)

			// Exact, instance-specific text; defaults are applied for empty and nil context.
			assert.Equal(t, tt.wantTitle, issue.Title)
			assert.Contains(t, issue.Description, tt.wantDescription)

			// Fields the backend requires; a missing one drops the report.
			assert.Equal(t, "__CATEGORY__", issue.Category)
			assert.Equal(t, "__LOCATION__", issue.Location)
			assert.Equal(t, "__SOURCE__", issue.Source)
			assert.Equal(t, healthplatform.IssueSeverity_ISSUE_SEVERITY___SEVERITY__, issue.Severity)

			require.NotNil(t, issue.Remediation)
			assert.NotEmpty(t, issue.Remediation.Summary)
			assert.Len(t, issue.Remediation.Steps, __STEP_COUNT__)
			require.NotEmpty(t, issue.Remediation.Steps)
			assert.Equal(t, tt.wantFirstStep, issue.Remediation.Steps[0].Text)
			for i, step := range issue.Remediation.Steps {
				assert.Equal(t, int32(i+1), step.Order, "step order must be contiguous and 1-indexed")
				assert.NotEmpty(t, step.Text)
			}

			require.NotNil(t, issue.Extra)
			extra := issue.Extra.AsMap()
			for key, want := range tt.wantExtra {
				assert.Equal(t, want, extra[key], "Extra[%q]", key)
			}
			for key := range extra {
				assert.Regexp(t, snakeCase, key, "Extra keys are snake_case on the wire")
			}
		})
	}
}
