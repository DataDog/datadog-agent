	"github.com/stretchr/testify/assert"
	"github.com/stretchr/testify/require"

__MODULE_TEST_CFG_IMPORT__	hostnamemock "github.com/DataDog/datadog-agent/comp/core/hostname/hostnameinterface/mock"
	"github.com/DataDog/datadog-agent/comp/healthplatform/issues"
)

// TestModuleWiring pins what the registry and scheduler see: the names, and
// which built-in check (if any) the module registers with its source and
// interval.
func TestModuleWiring(t *testing.T) {
	h, _ := hostnamemock.NewMock("node-a")
	deps := __MODULE_TEST_DEPS__
	m := NewModule(deps)

	assert.Equal(t, IssueName, m.IssueName())
	assert.Equal(t, IssueType, m.IssueType())

	issue, err := m.BuildIssue(nil)
	require.NoError(t, err)
	assert.Equal(t, IssueName, issue.IssueName)
	assert.Equal(t, IssueType, issue.IssueType)

__MODULE_TEST_CHECKS__
}
