// Run reports one issue per instance while the condition holds, and returns
// (nil, nil) when healthy. The scheduler resolves every issue ID that a run
// stops returning, so an instance that disappears resolves without extra code.
func (c *checker) Run() ([]runnerdef.IssueReport, error) {
	found, err := c.detect()
	if err != nil {
__DETECT_ERR_RESET__		return nil, err
	}
__RUN_FILTER__	if len(instances) == 0 {
		return nil, nil
	}
	reports := make([]runnerdef.IssueReport, 0, len(instances))
	for _, in := range instances {
		reports = append(reports, runnerdef.IssueReport{
			IssueID:   c.instanceIssueID(__ID_ARG__),
			IssueName: IssueName,
			Source:    "__SOURCE__",
			Context:   in.Context,
		})
	}
	return reports, nil
}

__STATE_METHODS__// instanceIssueID scopes the issue ID by the discriminator and, for several instances
// per host, by the instance key. The backend deduplicates Agent Health issues by
// ID, so a bare constant would collapse every host (or every instance) into one issue.
func (c *checker) instanceIssueID(__ID_PARAM__) string {
