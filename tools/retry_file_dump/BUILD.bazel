load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("//bazel/rules/go_package_metadata:defs.bzl", "go_package_metadata")

package(default_package_metadata = [":go_package_metadata"])

go_package_metadata(
    name = "go_package_metadata",
    module = "github.com/DataDog/datadog-agent/tools/retry_file_dump",
)

go_library(
    name = "retry_file_dump_lib",
    srcs = ["main.go"],
    importpath = "github.com/DataDog/datadog-agent/tools/retry_file_dump",
    visibility = ["//visibility:private"],
    deps = [
        "//comp/forwarder/defaultforwarder/internal/retry",
        "@org_golang_google_protobuf//proto",
    ],
)

go_binary(
    name = "retry_file_dump",
    embed = [":retry_file_dump_lib"],
    # This should never be in the final product.
    visibility = ["//visibility:private"],
)
