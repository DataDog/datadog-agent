#!/usr/bin/env bash
set -euo pipefail

# Check `bazelisk` properly bootstraps `bazel` or fail with instructions
if [ -z "${BAZEL_REAL-}" ] || [ "${BAZELISK_SKIP_WRAPPER-}" != true ]; then
  >&2 cat "$(dirname "$0")/bazelisk.md"
  exit 2
fi

# Ensure `XDG_CACHE_HOME` denotes a directory
if [ ! -d "${XDG_CACHE_HOME-}" ]; then
  if [ -n "${CI-}" ]; then
    >&2 echo "🔴 XDG_CACHE_HOME (${XDG_CACHE_HOME-}) must denote a directory in CI!"
    exit 2
  fi
  if [[ -e /.dockerenv || -e /run/.containerenv ]]; then
    >&2 echo "💡 To persist caches across restarts, please set XDG_CACHE_HOME pointing to a mounted directory, e.g.:"
    # shellcheck disable=SC2016
    >&2 echo '    docker run --env=XDG_CACHE_HOME=/cache --volume=~/.cache:/cache ...'
  fi
fi

# Ensure `bazel` & managed toolchains honor `XDG_CACHE_HOME`
extra_args=()
if [ -n "${XDG_CACHE_HOME-}" ]; then
  if [[ "$XDG_CACHE_HOME" != /* ]]; then
    >&2 echo "🔴 XDG_CACHE_HOME ($XDG_CACHE_HOME) must denote an absolute path!"
    exit 2
  fi
  export GOCACHE="$XDG_CACHE_HOME/go-build"
  export GOMODCACHE="$XDG_CACHE_HOME/go/mod"
  extra_args+=(--disk_cache="$XDG_CACHE_HOME/bazel/disk-cache")
  # https://github.com/bazelbuild/bazel/issues/26384
  [ "$XDG_CACHE_HOME" = "$(dirname "$(dirname "$0")")/.cache" ] && extra_args+=(--repo_contents_cache=)
  if [ -n "${CI-}" ] && [ -z "${GITHUB_ACTIONS-}" ]; then
    if [ -z "${BUILDBARN_ID_TOKEN-}" ]; then
      >&2 echo "🔴 BUILDBARN_ID_TOKEN must be populated in CI!"
      exit 2
    fi
    extra_args+=(--config=ci)
    # Edge cache is only reachable from inside the k8s cluster (Linux CI runners).
    if [ "$(uname -s)" = Linux ]; then
      extra_args+=(--config=cache:edge)
    else
      extra_args+=(--config=cache:frontend)
    fi
  fi
else
  # Without `XDG_CACHE_HOME`, fall back Go caches to official defaults so Go repo rules work under strict repo_env
  [ -z "${GOCACHE-}" ] && export GOCACHE=~/.cache/go-build
  if [ -z "${GOMODCACHE:-}" ]; then
    [ -n "${GOPATH-}" ] && gp="${GOPATH%%:*}" || gp=~/go
    export GOMODCACHE="$gp/pkg/mod"
    unset gp
  fi
fi

# Local developer remote cache selection (CI selects its own endpoint above).
if [ -z "${CI-}" ]; then
  remote_cache_select="$(dirname "$0")/../bazel/tools/remote-cache-select.sh"
  if [ -f "$remote_cache_select" ]; then
    # shellcheck source=/dev/null
    . "$remote_cache_select"
    cache_config=$(_remote_cache_config "$@") || :
    [ -n "$cache_config" ] && extra_args+=("$cache_config")
  fi
fi

startup_args=()
if [ -n "${CI-}" ] ; then
   # CI defaults
   startup_args+=(--max_idle_secs=300)  # 5 minutes
else
   # Interactive defaults
   startup_args+=(--max_idle_secs=28800)  # 8 hours
fi

# Splice extra_args in right after the bazel command
# "--startup cmd ..." -> "--startup cmd --config=ci ..."
if [[ $# -gt 0 && ${#extra_args[@]} -gt 0 ]]; then
  args=()
  cmd=
  for arg in "$@"; do
    args+=("$arg")
    if [[ -z "$cmd" && "$arg" != -* ]]; then
      cmd=$arg
      args+=("${extra_args[@]}")
    fi
  done
  set -- "${args[@]}"
fi


# Emulate the CPU limit containers should normally see via cgroup quota, currently inhibited on Datadog's k8s clusters:
# https://datadoghq.atlassian.net/wiki/spaces/cxg/pages/3473212607/Container+CPU+limits+in+internal+environments
if [ -n "${KUBERNETES_CPU_LIMIT-}" ] && [ "$(uname -s)" = Linux ]; then
  cpu_quota=$(awk '{print $1}' /sys/fs/cgroup/cpu.max) || cpu_quota=max
  if [ "$cpu_quota" = max ]; then
    pivot=$(ps -o psr= -p $$ | tr -d ' ') # pivot at this process' last executed CPU to spread the load
    cpus=$(python3 - <<EOF
from bisect import bisect_left
from math import ceil
from os import sched_getaffinity

limit = "$KUBERNETES_CPU_LIMIT"
max_cpus = ceil(float(limit[:-1]) / 1000 if limit.endswith("m") else float(limit))
allowed = sorted(sched_getaffinity(0))
i = bisect_left(allowed, $pivot)
print(",".join(str(cpu) for cpu in (allowed[i:] + allowed[:i])[:max_cpus]))
EOF
)
    exec taskset -c "$cpus" "$BAZEL_REAL" "${startup_args[@]}" "$@"
  fi
  >&2 echo "🟡 CPU limits are now visible via cgroup quota - please consider removing the taskset pinning from $0"
fi

exec "$BAZEL_REAL" "${startup_args[@]}" "$@"
